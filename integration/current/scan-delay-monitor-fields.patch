+// Put the received access code before the destination and leave the line free until there is a call.
+static bool monitor_air_fields(sbuf_t *b, const radio_view_t *v)
+{
+	if (!v->dmr.hear_all_latch)
+		return false;
+	uint32_t dst;
+	bool unit;
+#if CONFIG_P25
+	if (v->ch.mode == RADIO_MODE_P25 && (v->p25.flags & RADIO_P25_RX)) {
+		sb_str(b, "NAC ");
+		sb_hex(b, v->p25.nac, 3);
+		dst = v->p25.dst;
+		unit = (v->p25.flags & RADIO_P25_UNIT) != 0;
+	} else
+#endif
+#if CONFIG_NXDN
+	if (v->ch.mode == RADIO_MODE_NXDN && (v->nxdn.flags & RADIO_NXDN_RX)) {
+		sb_str(b, "RAN ");
+		sb_u32(b, v->nxdn.ran, 1);
+		dst = v->nxdn.dst;
+		unit = (v->nxdn.flags & RADIO_NXDN_UNIT) != 0;
+	} else
+#endif
+	{
+		(void)b;
+		return false;
+	}
+	if (dst != 0) {
+		sb_str(b, unit ? " ID " : " TG ");
+		sb_u32(b, dst, 1);
+	}
+	return true;
+}
