+static bool wait_rx_hz(uint32_t hz, uint32_t limit_ms)
+{
+	for (uint32_t t = 0; hw.rx_hz != hz && t < limit_ms; t += RADIO_POLL_MS) {
+		run(RADIO_POLL_MS);
+	}
+	return hw.rx_hz == hz;
+}
