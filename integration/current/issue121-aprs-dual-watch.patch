+static void timed_burst(const char *line, uint16_t flags)
+{
+	static uint8_t tones[768];
+	static int16_t audio[41000];
+	hdlc_enc_t e;
+	hdlc_enc_init(&e, tones, sizeof(tones));
+	CHECK(hdlc_enc_flags(&e, flags));
+	if (line != NULL) {
+		ax25_frame_t f;
+		uint8_t frame[AX25_FRAME_MAX];
+		CHECK(ax25_from_tnc2(line, strlen(line), &f));
+		size_t n = ax25_encode(&f, frame, sizeof(frame));
+		CHECK(n != 0 && hdlc_enc_frame(&e, frame, n) && hdlc_enc_flags(&e, 3));
+	}
+	afsk_mod_t m;
+	afsk_mod_init(&m, 8000);
+	brx.air_ms = now;
+	brx.s = audio;
+	brx.n = afsk_mod(&m, tones, e.nbits, 8000, audio, sizeof(audio) / sizeof(audio[0]));
+	CHECK(m.bit + 1u == e.nbits && brx.n > 8u * RADIO_SCAN_DUAL_MIN_DWELL_MS);
+}
