+// Yaesu Tables 4-3/4-4 and Figure 4-20: voice-only calls rotate through just
+// the CSD frames. FT is the last FN, and VW voice after its sub-header uses
+// FN0/FT0 rather than pretending that eight data frames follow.
+static void testTxVoiceSequence(void)
+{
+	static const struct { uint8_t dt; unsigned total, ft; } cases[] = {
+		{ YSF_DT_VD_MODE1, 5, 2 }, { YSF_DT_VD_MODE2, 8, 5 }, { YSF_DT_VOICE_FR, 10, 0 }
+	};
+
+	for (unsigned m = 0; m < sizeof cases / sizeof *cases; m++) {
+		ysf_tx_config c;
+		make_tx_cfg(&c, cases[m].dt);
+		c.data = NULL;
+		c.voice = NULL;
+		c.vw_subheader = c.dt == YSF_DT_VOICE_FR;
+		CHECK(ysf_tx_total_frames(&c) == cases[m].total, "voice-only total mode %u", c.dt);
+		for (unsigned fn = 0; fn < cases[m].total; fn++) {
+			uint8_t frame[YSF_FRAME_BYTES], dch[20], dch2[20];
+			ysf_fich f;
+			unsigned len = 99;
+			CHECK(ysf_tx_frame_build(&c, fn, frame) && ysf_frame_decode(frame, &f, dch, dch2, &len),
+			      "voice-only mode %u frame %u", c.dt, fn);
+			CHECK(f.cs == 2, "voice-only CS mode %u frame %u", c.dt, fn);
+			if (fn == 0 || fn == cases[m].total - 1) {
+				CHECK(len == 20 && !memcmp(dch, "DEST      SRC       ", 20),
+				      "voice-only header/terminator mode %u", c.dt);
+				continue;
+			}
+			unsigned cc = fn - 1;
+			if (c.dt == YSF_DT_VOICE_FR) {
+				CHECK(f.fn == 0 && f.ft == (cc == 0 ? 1 : 0), "vw voice FN/FT %u", cc);
+				if (cc == 0)
+					CHECK(len == 20 && !memcmp(dch, "REM1 REM2 REM3 REM4 ", 20), "vw CSD3");
+				else
+					CHECK(len == 0, "vw voice has no DCH %u", cc);
+			} else {
+				CHECK(f.fn == cc && f.ft == cases[m].ft, "voice-only FN/FT mode %u frame %u", c.dt, cc);
+				if (c.dt == YSF_DT_VD_MODE1 && cc == 2)
+					CHECK(!memcmp(dch, "REM1 REM2 REM3 REM4 ", 20), "vd1 voice-only CSD3");
+				if (c.dt == YSF_DT_VD_MODE2 && cc == 4)
+					CHECK(len == 10 && !memcmp(dch, "REM1 REM2 ", 10), "dn voice-only Rem1+2");
+				if (c.dt == YSF_DT_VD_MODE2 && cc == 5)
+					CHECK(len == 10 && !memcmp(dch, "REM3 REM4 ", 10), "dn voice-only Rem3+4");
+			}
+		}
+		CHECK(!ysf_tx_frame_build(&c, cases[m].total, (uint8_t[YSF_FRAME_BYTES]){ 0 }),
+		      "voice-only out of range mode %u", c.dt);
+	}
+}
