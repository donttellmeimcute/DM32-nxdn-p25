+// The D-STAR channel editor reads back the block written through the simulated storage job.
+int codeplug_tag_params(uint16_t number, const channel_t *ch, uint8_t *buf, uint16_t cap)
+{
+	const ui_air_conv_t *air = sim_air(number);
+	uint8_t packed[DSTAR_ROUTE_BYTES];
+	if (ch->kind != CODEPLUG_KIND_DSTAR || !air || !dstar_route_pack(&air->dstar, packed))
+		return -1;
+	memcpy(buf, packed, cap < sizeof packed ? cap : sizeof packed);
+	return sizeof packed;
