@@ -125,6 +125,17 @@ FXP_INLINE int64_t fxp_mul64(int32_t a, int32_t b) { return fxp_mul64_c(a, b); }
 FXP_INLINE int32_t fxp_mulshr(int32_t a, int32_t b, int s) { return fxp_mulshr_c(a, b, s); }
 #endif
 
+// A signed Q15 coefficient needs no 64-bit multiply on C-SKY without HI/LO.
+FXP_INLINE int32_t fxp_mul_q15(int32_t a, int16_t b)
+{
+#if defined(__csky__) && !FXP_HILO
+	// Split at the fractional boundary. The high product may wrap, as does the result.
+	return (int32_t)((uint32_t)(a >> 15) * (uint32_t)b + (uint32_t)(((a & 32767) * b) >> 15));
+#else
+	return fxp_mulshr(a, b, 15);
+#endif
+}
+
 // acc + a * b (wraps like a hardware accumulate)
 FXP_INLINE int64_t fxp_mac64(int64_t acc, int32_t a, int32_t b)
 {
