-	return c0 + fxp_mulshr(c1 - c0, (int32_t)(ph & 0x3FFFFFu), 22);
+	// Adjacent Q15 table values differ by at most 202: the product fits int32_t.
+	return c0 + (((c1 - c0) * (int32_t)(ph & 0x3FFFFFu)) >> 22);
 }
 
