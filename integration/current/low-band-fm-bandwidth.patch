+@pytest.mark.feature("fm")
+def test_receive_only_fm_vfo_bandwidth(radio):
+    need_vfo(radio, "FM")
+    if "66000000-88000000" not in radio.core().get("bands", "").split(","):
+        skip("no_hw", "the radio has no 66–88 MHz analog FM band")
+    with radio.vfo_session():
+        wide_before = radio.view(["channel"])["ch.bw"] == "25k"
+        try:
+            v = tune(radio, 70012500)
+            assert v.get("mode") == "fm" and v.get("bcast") == "0" and v.get("am") == "0", v
+            for wide, bw in ((False, "12k5"), (True, "25k")):
+                radio.link.bandwidth(wide)
+                radio.wait_for(lambda v: v.get("ch.bw") == bw and v.get("ch.rx_only") == "1",
+                               sections=("channel",), what=f"receive-only FM at {bw}")
+        finally:
+            radio.link.bandwidth(wide_before)
+            radio.wait_for(lambda v: v.get("ch.bw") == ("25k" if wide_before else "12k5"),
+                           sections=("channel",), what="VFO bandwidth restored")
