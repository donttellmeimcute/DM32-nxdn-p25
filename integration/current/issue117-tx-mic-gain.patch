+static void testTxMicGain(void)
+{
+	ambeVoiceInit(&audio, &cap_vocoder);
+	const dmr_voice_source_t *src = ambeVoiceSource();
+	ncap = 0;
+	src->begin(src->ctx);
+	memset(mic, 0, sizeof mic);
+	mic[0] = -1000;
+	mic[1] = 1000;
+	ambeVoiceSetMicGain(10);
+	block();
+	CHECK(cap_pcm[0][0] == -3164 && cap_pcm[0][1] == 3164, "quiet PCM gets the requested gain");
+
+	mic[0] = -20000;
+	mic[1] = 20000;
+	mic[2] = 10000;
+	block();
+	CHECK(cap_pcm[1][0] == -32734 && cap_pcm[1][1] == 32734 && cap_pcm[1][2] == 16367,
+	      "loud PCM keeps one linear gain for the whole block");
+	mic[0] = INT16_MIN;
+	mic[1] = INT16_MAX;
+	block();
+	CHECK(memcmp(mic, cap_pcm[2], sizeof mic) == 0, "full-scale PCM receives no extra gain");
+
+	ambeVoiceSetMicGain(0);
+	block();
+	CHECK(cap_pcm[3][0] == -10368 && cap_pcm[3][1] == 10367, "manual attenuation is preserved");
+	CHECK(ncap == 4, "each PCM block reached the vocoder (%d)", ncap);
+	src->end(src->ctx);
+	block();
+	ambeVoiceSetMicGain(5);
+	ambeVoiceInit(&audio, &vocoder);
+}
