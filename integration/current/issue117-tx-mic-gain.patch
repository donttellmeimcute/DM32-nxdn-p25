diff --git a/core/radio/mic_gain_pcm.h b/core/radio/mic_gain_pcm.h
new file mode 100644
index 0000000..38a3e6c
--- /dev/null
+++ b/core/radio/mic_gain_pcm.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef RADIO_MIC_GAIN_PCM_H
+#define RADIO_MIC_GAIN_PCM_H
+
+#include "radio/mic_gain.h"
+
+// The manual microphone gain steps in Q8, 2 dB per step and unity at step 5.
+static inline uint16_t mic_gain_step_q8(uint8_t step)
+{
+	static const uint16_t q8[MIC_GAIN_STEPS + 1] = { 81, 102, 128, 161, 203, 256, 322, 406, 511, 643, 810 };
+	return q8[step > MIC_GAIN_STEPS ? MIC_GAIN_STEPS : step];
+}
+
+// Reduce positive gain for the entire block when its peak would clip.
+// A block that already reached full scale is passed through at unity.
+static inline uint16_t mic_gain_limit_q8(const int16_t *pcm, unsigned count, uint16_t requested)
+{
+	if (requested <= 256u)
+		return requested;
+	uint32_t peak = 0;
+	for (unsigned i = 0; i < count; i++) {
+		int32_t sample = pcm[i];
+		uint32_t magnitude = (uint32_t)(sample < 0 ? -sample : sample);
+		if (magnitude > peak)
+			peak = magnitude;
+	}
+	if (peak * requested <= 32767u * 256u)
+		return requested;
+	uint32_t limit = (32767u * 256u) / peak;
+	return (uint16_t)(limit < 256u ? 256u : limit);
+}
+
+#endif
