diff --git a/tests/host/hrc7000DmrTest.c b/tests/host/hrc7000DmrTest.c
index 0ff327b..cd30685 100644
--- a/tests/host/hrc7000DmrTest.c
+++ b/tests/host/hrc7000DmrTest.c
@@ -487,6 +487,46 @@ static void test_tx_color_code(void)
 	CHECK(eng.cc_filter == -1 && REG(C7_LOCAL_CC) == (LOCAL_CC_ANY | 5u));
 }
 
+// Burst F with a same-channel single block is not reverse channel: its BPTC rows use even parity, so only F clears
+// PI on a privacy call; B-E keep it. The four already-encoded bytes go to the chip unchanged. The no-filler path
+// above keeps its RC encoder and privacy PI (VOICE_EMB_CTRL == 3).
+static void test_tx_single_block_pi(void)
+{
+	setup();
+	const dmr_config_t cfg = { .own_id = 1234, .cc = 1, .access = DMR_ACCESS_IMPOLITE };
+	hrc7000_dmr_configure(&eng, &cfg);
+	hrc7000_dmr_set_cc_filter(&eng, cfg.cc);
+	hrc7000_dmr_run(&eng);
+	CHECK(hrc7000_dmr_tx_begin(&eng, DMR_TIMING_OWN, 1, DMR_ACCESS_IMPOLITE));
+	dmr_tx_burst_t h = { .kind = DMR_BURST_VOICE_LC_HEADER, .len = 9 };
+	h.payload[2] = 0x40;	// DMR_SVC_PRIVACY
+	const uint8_t sb[4] = { 0x12, 0x34, 0x56, 0x78 };
+	hrc7000_dmr_set_burst_f_emb(&eng, sb);
+	CHECK(hrc7000_dmr_tx_queue(&eng, &h));
+	for (uint8_t i = 0; i < 6; i++) {
+		dmr_tx_burst_t b = voice(i, (uint8_t)(0x11 + i));
+		CHECK(hrc7000_dmr_tx_queue(&eng, &b));
+	}
+	static const uint8_t types[6] = { 0x08, 0x19, 0x2B, 0x3B, 0x4A, 0x58 };
+	uint8_t seen = 0;
+	for (int i = 0; i < 68; i++) {
+		tick(false);
+		tick(true);
+		if (REG(C7_LAYER2_TXRX_CTRL) == 0x80) {
+			for (uint8_t v = 0; v < 6; v++) {
+				if (REG(C7_LAYER2_SEND_TYPE) == types[v]) {
+					seen |= (uint8_t)(1u << v);
+					CHECK(REG(C7_VOICE_EMB_CTRL) == (v == 5 ? 0u : 1u));
+					if (v == 5)
+						CHECK(memcmp(&buf[C7_TX_RAM + 0x29], sb, sizeof sb) == 0);
+				}
+			}
+		}
+		count_kind(0xFF, NULL);
+	}
+	CHECK(seen == 0x3F);
+}
+
