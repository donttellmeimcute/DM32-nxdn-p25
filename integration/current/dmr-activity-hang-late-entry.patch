+// Recent activity belongs to the channel that heard it. Clear both the radio-wide timestamp and the DMR stack's
+// last-heard record, including when the next DMR channel has the same CC/TS and configure sees no RF change.
+static void test_activity_cleared_on_channel_change(void)
+{
+	dmr_start(false);
+	const radio_dmr_view_t *d = &sm.view.dmr;
+	hear_call(true, 201, 9991234, 2, 1, true);
+	CHECK(d->last_ms != 0 && d->last.src == 9991234 && sm.view.last_rx_ms != 0);
+
+	chans[1].mode = RADIO_MODE_DMR;
+	chans[1].rx_hz = 438600000;
+	chans[1].tx_hz = 433600000;
+	chans[1].color_code = 2;
+	chans[1].timeslot = 1;
+	reload_channel();
+	req(RREQ_ZONE_POS, 0);
+	CHECK(sm.view.channel_number == 1 && d->cc == 2 && d->ts == 1);
+	CHECK(d->last_ms == 0 && d->last.src == 0 && sm.view.last_rx_ms == 0);
+	run(50);	// the stack must not publish the old channel's record again
+	CHECK(d->last_ms == 0 && d->last.src == 0 && sm.view.last_rx_ms == 0);
+
+	req(RREQ_CH_STEP, 1);	// channel 2, FM
+	CHECK(sm.view.ch.mode == RADIO_MODE_FM && d->last_ms == 0 && sm.view.last_rx_ms == 0);
+	uint8_t thr = radio_sm_squelch_open_below(RADIO_SQUELCH_DEFAULT);
+	rx_signal(thr - 10, true);
+	poll_for(RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_RX);
+	rx_signal(thr + RADIO_SQL_HYST_DB, true);
+	poll_for(2 * RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_IDLE && sm.view.last_rx_ms != 0);
+	req(RREQ_VFO, 1);
+	CHECK(sm.view.vfo && sm.view.last_rx_ms == 0 && d->last_ms == 0);
+	req(RREQ_VFO, 0);
+	CHECK(!sm.view.vfo && sm.view.last_rx_ms == 0 && d->last_ms == 0);
+	setup_codeplug();
+}
