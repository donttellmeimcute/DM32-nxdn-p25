+// Voice PTT uses the same heading, timer and rows for each mode. The target and air settings come from the view.
+static void draw_tx(const radio_view_t *v, const ui_state_t *s)
+{
+	const ui_layout_t *L = &ui_layout;
+	const font_t *sm = L->small;
+	int w = gfx_width(), gap = L->row_h - sm->h;
+	char buf[64], timer[20], fit[48];
+	sbuf_t b;
+	const char *word = TR(STATE_TALKING, "TALKING");
+	const char *hint = TR(CALL_HINT_RELEASE_PTT, "Release PTT to stop");
+#if CONFIG_DMR
+	const radio_dmr_view_t *d = &v->dmr;
+	if (v->ch.mode == RADIO_MODE_DMR) {
+		switch (d->state) {
+		case RDMR_TX_WAIT:
+			word = d->rmo && !d->repeater_up ? TR(CALL_STATE_WAKING_RPT, "WAKING RPT") :
+				TR(CALL_STATE_WAITING, "WAITING");
+			break;
+		case RDMR_TX_PERMIT: word = TR(CALL_STATE_ADMITTED, "ADMITTED"); break;
+		case RDMR_TX_ENDING:
+			word = TR(CALL_STATE_ENDING, "ENDING");
+			hint = TR(CALL_HINT_FINISHING, "Finishing the call");
+			break;
+		default: break;
+		}
+	}
+#endif
+
+	gfx_clear(ui_col.bg);
+	int top = ui_draw_top(v, s, NULL, NULL);
+	sb_init(&b, timer, sizeof timer);
+	sb_mmss(&b, v->tx_elapsed_ms / 1000u);
+	if (v->tot_s) {
+		sb_chr(&b, '/');
+		sb_mmss(&b, v->tot_s);
+	}
+	int right = w - gfx_text_width(sm, timer);
+	const font_t *big = gfx_text_width(L->large, word) <= right - sm->w ? L->large : L->medium;
+	const font_t *target_font = gfx_height() >= UI_TALL_PX ? L->large : L->medium;
+	int spare = L->hint_y - top - big->h - target_font->h - 2 * sm->h - 4 * gap;
+	int y = top + gap + (spare > 0 ? spare / 3 : 0);
+	gfx_text_fit(big, word, right - sm->w, fit, sizeof fit);
+	gfx_text(big, 0, y, fit, ui_col.tx);
+	gfx_text(sm, right, y + big->ascent - sm->ascent, timer, ui_col.fg);
+	y += big->h;
+	if (gap) {
+		gfx_hline(0, y + gap / 2, w, ui_col.line);
+		y += gap;
+	}
+
+	sb_init(&b, buf, sizeof buf);
+	switch (v->ch.mode) {
+#if CONFIG_DMR
+	case RADIO_MODE_DMR:
+		sb_target_alts(&b, d->target_id, d->target_private, d->target_name, "");
+		break;
+#endif
+#if CONFIG_P25
+	case RADIO_MODE_P25:
+		sb_str(&b, (v->p25.flags & RADIO_P25_TALK_UNIT) ? "ID " : "TG ");
+		sb_u32(&b, v->p25.talk, 1);
+		break;
+#endif
+#if CONFIG_NXDN
+	case RADIO_MODE_NXDN:
+		sb_str(&b, (v->nxdn.flags & RADIO_NXDN_TALK_UNIT) ? "ID " : "TG ");
+		sb_u32(&b, v->nxdn.talk, 1);
+		break;
+#endif
+#if CONFIG_YSF
+	case RADIO_MODE_YSF:
+		sb_str(&b, v->ysf.talk);
+		break;
+#endif
+	default:
+		sb_freq(&b, v->ch.tx_hz);
+		sb_str(&b, " MHz");
+		break;
+	}
+	if (gfx_text_width(target_font, buf) > w)
+		target_font = L->medium;
+	y = call_line(target_font, y, buf, ui_col.fg) + gap;
+
+	sb_init(&b, buf, sizeof buf);
+	switch (v->ch.mode) {
+#if CONFIG_DMR
+	case RADIO_MODE_DMR:
+		if (d->target_private && d->target_id != 0xFFFFFFu) {
+			sb_str(&b, TR(CALL_BODY_PRIVATE_ID, "Private "));
+			sb_u32(&b, d->target_id, 1);
+			sb_chr(&b, ' ');
+		}
+		sb_str(&b, "TS");
+		sb_u32(&b, d->ts, 1);
+		sb_str(&b, " CC");
+		sb_u32(&b, d->cc, 1);
+		if (!d->target_private)
+			sb_str(&b, TR(CALL_BODY_TO_GROUP, " Group"));
+		if (d->rmo)
+			sb_str(&b, " RPT");
+		if (d->privacy)
+			sb_str(&b, " ENC");
+		break;
+#endif
+#if CONFIG_P25
+	case RADIO_MODE_P25:
+		sb_str(&b, "NAC ");
+		sb_hex(&b, v->p25.tx_nac, 3);
+		break;
+#endif
+#if CONFIG_NXDN
+	case RADIO_MODE_NXDN:
+		sb_str(&b, "RAN ");
+		sb_u32(&b, v->nxdn.tx_ran, 1);
+		sb_str(&b, (v->nxdn.flags & RADIO_NXDN_9600) ? " 9600" : " 4800");
+		break;
+#endif
+#if CONFIG_YSF
+	case RADIO_MODE_YSF:
+		sb_ysf_dg(&b, v->ysf.tx_dgid, v->ysf.tx_dt);
+		break;
+#endif
+	case RADIO_MODE_FM:
+		if (v->dtmf_digits[0] != '\0') {
+			sb_str(&b, "DTMF ");
+			sb_str(&b, v->dtmf_digits);
+		} else if (v->ch.tx_tone.type != TONE_NONE) {
+			sb_tone(&b, &v->ch.tx_tone);
+		}
+		break;
+	default: break;
+	}
+	if (buf[0])
+		call_line(sm, y, buf, ui_col.fg);
+	y += sm->h + gap;
+
+	sb_init(&b, buf, sizeof buf);
+	if (!v->vfo) {
+		sb_str(&b, v->ch.name);
+		sb_chr(&b, ' ');
+	} else if (v->ch.mode != RADIO_MODE_FM && v->ch.tx_hz) {
+		sb_freq(&b, v->ch.tx_hz);
+		sb_str(&b, " MHz ");
+	}
+	sb_str(&b, ui_power_name(v->power, v->ch.tx_hz));
+	call_line(sm, y, buf, ui_col.dim);
+	ui_draw_banner(s);
+	ui_draw_bottom(s, hint);
+}
