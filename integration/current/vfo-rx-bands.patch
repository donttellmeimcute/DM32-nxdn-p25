diff --git a/core/settings/settings.c b/core/settings/settings.c
index 117dfd2..2dcbf33 100644
--- a/core/settings/settings.c
+++ b/core/settings/settings.c
@@ -46,7 +46,7 @@ void settings_defaults(settings_t *s)
 	memset(s, 0, sizeof(*s));
 	s->squelch = SETTINGS_UNSET8;
 #if CONFIG_RX_EXT && CONFIG_RX_EXT_ON
-	s->cp_flags = SETTINGS_CP_RX_EXT;	// receive past the band table on from the first start (config/features.mk)
+	s->cp_flags = SETTINGS_CP_RX_EXT | SETTINGS_CP_RX_EXT_SET;
 #endif
 	s->vfo_power = SETTINGS_UNSET8;
 	s->vfo_ts = 1;
@@ -236,7 +236,15 @@ settings_load_t settings_init(void)
 	}
 	storage_unlock();
 	saved = live;
-	dirty = false;
+#if CONFIG_RX_EXT && CONFIG_RX_EXT_ON
+	// Older records only stored the on/off bit, so a saved zero overrode
+	// this build's default. Apply it once and persist the explicit choice.
+	if (board.rx_ext_count != 0 && (live.cp_flags & SETTINGS_CP_RX_EXT_SET) == 0) {
+		live.cp_flags |= SETTINGS_CP_RX_EXT | SETTINGS_CP_RX_EXT_SET;
+		changed_ms = 0; // the settings task can save this from boot
+	}
+#endif
+	dirty = live.cp_flags != saved.cp_flags;
 	return (settings_load_t)stats.load;
 }
 
diff --git a/core/settings/settings.h b/core/settings/settings.h
index 16ad729..da88c05 100644
--- a/core/settings/settings.h
+++ b/core/settings/settings.h
@@ -259,7 +259,8 @@ typedef struct {
 // cp_flags: the owner kept another firmware's codeplug as the radio's own ("Use anyway", docs/spec/codeplug-native.md
 // 2); app.c keeps it equal to codeplug_acceptance(), which a codeplug written by a CPS or TFTP drops
 #define SETTINGS_CP_ACCEPTED		0x01u
-#define SETTINGS_CP_RX_EXT		0x02u	// receive past the band table is on (not about the codeplug: the free bit here)
+#define SETTINGS_CP_RX_EXT		0x02u	// receive past the band table is on
+#define SETTINGS_CP_RX_EXT_SET		0x04u	// the boot default was applied or the owner changed the setting
 #define SETTINGS_T3_STUN		0x80u	// t3_stun: a stun is kept (bits 0-6 say on which system)
 #define SETTINGS_T3_KILLED		0x01u	// t3_kill: killed
 
diff --git a/core/ui/ui_screens.c b/core/ui/ui_screens.c
index d24ea0f..2a6e875 100644
--- a/core/ui/ui_screens.c
+++ b/core/ui/ui_screens.c
@@ -363,14 +363,36 @@ void ui_bands_text(char *out, size_t len, bool tx)
 {
 	sbuf_t b;
 	sb_init(&b, out, len);
-	for (int i = 0; i < board_band_count(); i++) {
-		if (tx && !board.bands[i].tx)
-			continue;	// a TX refusal lists only where it can transmit, not the receive-only ranges
+	uint8_t count = board_band_count();
+	uint32_t covered = 0;
+	for (;;) {
+		uint32_t lo = UINT32_MAX, hi = 0;
+		for (uint8_t i = 0; i < count; i++) {
+			const band_t *band = &board.bands[i];
+			if ((!tx || band->tx) && band->lo_hz > covered && band->lo_hz < lo) {
+				lo = band->lo_hz;
+				hi = band->hi_hz;
+			}
+		}
+		if (lo == UINT32_MAX)
+			break;
+		// The band table is in hardware order. Show its union in frequency
+		// order so the VFO hint fits and starts at the real lowest frequency.
+		uint32_t prev;
+		do {
+			prev = hi;
+			for (uint8_t i = 0; i < count; i++) {
+				const band_t *band = &board.bands[i];
+				if ((!tx || band->tx) && band->lo_hz <= hi && band->hi_hz > hi)
+					hi = band->hi_hz;
+			}
+		} while (hi != prev);
 		if (b.p != out)
 			sb_chr(&b, ' ');
-		sb_u32(&b, board.bands[i].lo_hz / 1000000u, 1);
+		sb_u32(&b, lo / 1000000u, 1);
 		sb_chr(&b, '-');
-		sb_u32(&b, board.bands[i].hi_hz / 1000000u, 1);
+		sb_u32(&b, hi / 1000000u, 1);
+		covered = hi;
 	}
 }
 
