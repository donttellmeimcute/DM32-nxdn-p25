diff --git a/tests/host/settingsTest.c b/tests/host/settingsTest.c
index 5187b8f..0060401 100644
--- a/tests/host/settingsTest.c
+++ b/tests/host/settingsTest.c
@@ -28,7 +28,9 @@ static const hal_flash_map_t map = {
 	.calibration_addr = 0x10000u, .calibration_size = 0x200u,
 };
 
-const board_t board = { .name = "test", .flash = &sim_flash, .power_count = 5 };
+static bool extended_rx_on;
+const board_t board = { .name = "test", .flash = &sim_flash, .power_count = 5,
+			.rx_ext_count = 1, .rx_ext_on = &extended_rx_on };
 
 static void boot(void)
 {
@@ -1179,11 +1181,41 @@ static void test_write_across_sectors(void)
 	CHECK(sim_flash_violations() == 0);
 }
 
+#if CONFIG_RX_EXT && CONFIG_RX_EXT_ON
+static void test_rx_default_upgrade(void)
+{
+	sim_flash_create(FLASH_SIZE, &map);
+	boot();
+	settings_t s;
+	settings_read(&s);
+	CHECK((s.cp_flags & (SETTINGS_CP_RX_EXT | SETTINGS_CP_RX_EXT_SET)) ==
+	      (SETTINGS_CP_RX_EXT | SETTINGS_CP_RX_EXT_SET));
+	// A pre-upgrade record where the default was off. Keep other flags.
+	settings_begin()->cp_flags = SETTINGS_CP_ACCEPTED;
+	settings_end(0);
+	CHECK(settings_flush());
+	boot();
+	settings_read(&s);
+	CHECK(s.cp_flags == (SETTINGS_CP_ACCEPTED | SETTINGS_CP_RX_EXT | SETTINGS_CP_RX_EXT_SET));
+	CHECK(settings_flush());
+	// A deliberate Off on this version survives all later boots.
+	settings_begin()->cp_flags &= (uint8_t)~SETTINGS_CP_RX_EXT;
+	settings_end(0);
+	CHECK(settings_flush());
+	boot();
+	settings_read(&s);
+	CHECK(s.cp_flags == (SETTINGS_CP_ACCEPTED | SETTINGS_CP_RX_EXT_SET));
+}
+#endif
+
 int main(void)
 {
 	test_journal_basic();
 	test_journal_cuts();
 	test_settings_basic();
+#if CONFIG_RX_EXT && CONFIG_RX_EXT_ON
+	test_rx_default_upgrade();
+#endif
 	test_settings_wear();
 	test_settings_cuts();
 	test_settings_versions();
