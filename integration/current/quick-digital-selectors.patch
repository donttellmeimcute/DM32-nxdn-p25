+			view.p25.tx_nac = (uint16_t)code;
+		air_quick_changed();
+		return true;
+	}
+#endif
+#if CONFIG_NXDN
+	if (view.ch.mode == RADIO_MODE_NXDN) {
+		if (code > RADIO_NXDN_RAN_MAX)
+			return false;
+		view.nxdn.rx_ran = (uint8_t)code;
+		if (code != 0)
+			view.nxdn.tx_ran = (uint8_t)code;
+		air_quick_changed();
+		return true;
+	}
+#endif
+#if CONFIG_YSF
+	if (view.ch.mode == RADIO_MODE_YSF) {
+		if (code > RADIO_YSF_DGID_USER_MAX)
+			return false;
+		view.ysf.rx_dgid = view.ysf.tx_dgid = (uint8_t)code;
+		air_quick_changed();
+		return true;
+	}
+#endif
+	(void)code;
+	return false;
+}
+
+bool ui_svc_air_target(uint32_t id)
+{
+	to_selected();
+	if (id == 0 || id > 0xFFFFu)
+		return false;
+#if CONFIG_P25
+	if (view.ch.mode == RADIO_MODE_P25) {
+		if (view.ch.kind == CODEPLUG_KIND_P25_TRUNK)
+			return false;
+		view.p25.talk = id;
+		view.p25.flags &= (uint8_t)~RADIO_P25_TALK_UNIT;
+		air_quick_changed();
+		return true;
+	}
+#endif
+#if CONFIG_NXDN
+	if (view.ch.mode == RADIO_MODE_NXDN) {
+		view.nxdn.talk = (uint16_t)id;
+		view.nxdn.flags &= (uint8_t)~RADIO_NXDN_TALK_UNIT;
+		air_quick_changed();
+		return true;
+	}
+#endif
+	return false;
+}
+
+bool ui_svc_ysf_destination(const char *dest)
+{
+#if CONFIG_YSF
+	if (dest == NULL || view.ch.mode != RADIO_MODE_YSF)
+		return false;
+	to_selected();
+	strncpy(view.ysf.talk, dest[0] == '\0' ? YSF_CP_DEST_ALL : dest, YSF_CALLSIGN_LEN);
+	view.ysf.talk[YSF_CALLSIGN_LEN] = '\0';
+	air_quick_changed();
+	return true;
+#else
+	(void)dest;
+	return false;
+#endif
+}
