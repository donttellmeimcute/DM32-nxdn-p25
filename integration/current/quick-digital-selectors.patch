+bool ui_svc_air_code(uint32_t code)
+{
+	radio_get_view(&ui_svc_view);
+	if (ui_svc_view.hotspot)
+		return false;
+#if CONFIG_P25
+	if (ui_svc_view.ch.mode == RADIO_MODE_P25) {
+		if (code > 0xFFFu || code == P25_NAC_REPEAT_ANY || ui_svc_view.ch.kind == CODEPLUG_KIND_P25_TRUNK)
+			return false;
+		radio_p25_settings_t s;
+		if (!radio_p25_in_force(&s)) {
+			if (ui_svc_view.ch.kind != CODEPLUG_KIND_NONE)
+				return false;
+			radio_p25_settings(&s);
+		}
+		s.rx_nac = (uint16_t)code;
+		if (code != P25_NAC_ANY)
+			s.tx_nac = (uint16_t)code;
+		radio_req_p25_quick(&s, RADIO_P25_QUICK_NAC);
+		return true;
+	}
+#endif
+#if CONFIG_NXDN
+	if (ui_svc_view.ch.mode == RADIO_MODE_NXDN) {
+		if (code > RADIO_NXDN_RAN_MAX)
+			return false;
+		radio_nxdn_settings_t s;
+		if (!radio_nxdn_in_force(&s)) {
+			if (ui_svc_view.ch.kind != CODEPLUG_KIND_NONE)
+				return false;
+			radio_nxdn_settings(&s);
+		}
+		s.rx_ran = (uint8_t)code;
+		if (code != 0)
+			s.tx_ran = (uint8_t)code;
+		radio_req_nxdn_quick(&s, RADIO_NXDN_QUICK_RAN);
+		return true;
+	}
+#endif
+#if CONFIG_YSF
+	if (ui_svc_view.ch.mode == RADIO_MODE_YSF) {
+		if (code > RADIO_YSF_DGID_USER_MAX)
+			return false;
+		radio_ysf_settings_t s;
+		if (!radio_ysf_in_force(&s)) {
+			if (ui_svc_view.ch.kind != CODEPLUG_KIND_NONE)
+				return false;
+			radio_ysf_settings(&s);
+		}
+		s.rx_dgid = (uint8_t)code;
+		if (code != 0)
+			s.tx_dgid = (uint8_t)code;
+		radio_req_ysf_quick(&s, RADIO_YSF_QUICK_DGID);
+		return true;
+	}
+#endif
+	(void)code;
+	return false;
+}
+
+bool ui_svc_air_target(uint32_t id)
+{
+	if (id == 0 || id > 0xFFFFu)
+		return false;
+	radio_get_view(&ui_svc_view);
+	if (ui_svc_view.hotspot)
+		return false;
+#if CONFIG_P25
+	if (ui_svc_view.ch.mode == RADIO_MODE_P25) {
+		if (ui_svc_view.ch.kind == CODEPLUG_KIND_P25_TRUNK)
+			return false;
+		radio_p25_settings_t s;
+		if (!radio_p25_in_force(&s)) {
+			if (ui_svc_view.ch.kind != CODEPLUG_KIND_NONE)
+				return false;
+			radio_p25_settings(&s);
+		}
+		s.unit_call = false;
+		s.tx_dst = id;
+		radio_req_p25_quick(&s, RADIO_P25_QUICK_TG);
+		return true;
+	}
+#endif
+#if CONFIG_NXDN
+	if (ui_svc_view.ch.mode == RADIO_MODE_NXDN) {
+		radio_nxdn_settings_t s;
+		if (!radio_nxdn_in_force(&s)) {
+			if (ui_svc_view.ch.kind != CODEPLUG_KIND_NONE)
+				return false;
+			radio_nxdn_settings(&s);
+		}
+		s.unit_call = false;
+		s.tx_dst = (uint16_t)id;
+		radio_req_nxdn_quick(&s, RADIO_NXDN_QUICK_TG);
+		return true;
+	}
+#endif
+	return false;
+}
+
+bool ui_svc_ysf_destination(const char *dest)
+{
+#if CONFIG_YSF
