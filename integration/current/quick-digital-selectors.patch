+	if (ui_svc_view.hotspot || ui_svc_view.ch.mode != RADIO_MODE_YSF)
+		return false;
+	radio_ysf_settings_t s;
+	if (!radio_ysf_in_force(&s)) {
+		if (ui_svc_view.ch.kind != CODEPLUG_KIND_NONE)
+			return false;
+		radio_ysf_settings(&s);
+	}
+	strncpy(s.dest, dest, YSF_CALLSIGN_LEN);
+	s.dest[YSF_CALLSIGN_LEN] = 0;
+	if (s.dest[0] == '\0')
