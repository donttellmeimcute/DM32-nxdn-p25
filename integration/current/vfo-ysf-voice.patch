 #if CONFIG_YSF
+#include "dmr/ambe/ambeFec.h"
+#include "ysf/ysf_engine.h"
+
+static void ysf_vfo_encode(const int16_t *pcm, uint8_t *bits)
+{
+	// Mark voice blocks that actually came from the simulated microphone.
+	if (pcm[0] != 0 || pcm[1] != 0) {
+		bits[3] = 1;
+		bits[VOCODER_BITS - 1] = 1;
+	}
+}
+
+static struct {
+	unsigned headers, voice;
+	uint8_t dt, dev;
+	char source[YSF_CALLSIGN_LEN + 1];
+} ysf_vfo_rx;
+
+static void ysf_vfo_rx_start(const ysf_call_t *call, void *ctx)
+{
+	(void)ctx;
+	ysf_vfo_rx.headers++;
+	ysf_vfo_rx.dt = call->fich.dt;
+	ysf_vfo_rx.dev = call->fich.dev;
+	strcpy(ysf_vfo_rx.source, call->src);
+}
+
+static void ysf_vfo_rx_voice(const uint8_t frame[AMBE_FRAME_BYTES], void *ctx)
+{
+	(void)ctx;
+	uint8_t bits[AMBE_PARAM_BITS];
+	if (ambeFecDecode(frame, bits, NULL) == 0 && bits[3] == 1 && bits[AMBE_PARAM_BITS - 1] == 1)
+		ysf_vfo_rx.voice++;
+}
+
+static void test_ysf_vfo_tx(void)
+{
+	static const char identity[] = "XE1ABC    DOWN      UP        ";
+	static const ysf_engine_hooks_t hooks = { .rx_start = ysf_vfo_rx_start, .rx_voice = ysf_vfo_rx_voice };
+	static ysf_engine_t receiver;
+
+	dmr_start(true);
+	sm.set.talk_permit = false;
+	kv_t3_set(CODEPLUG_KEY_MODE_SET + CODEPLUG_KIND_YSF, identity, sizeof identity - 1);
+	req(RREQ_VFO, 1);
+	CHECK(sm.view.vfo);
+	aud.feed = aud.feed_signal = air_clock_handoff = true;
+	v_encode_hook = ysf_vfo_encode;
+
+	for (uint8_t variant = VFO_VARIANT_FIRST; variant <= VFO_VARIANT_SECOND; variant++) {
+		bool narrow = variant == VFO_VARIANT_SECOND;
+		// Select the same two variants offered by the front panel.
+		CHECK(ui_svc_vfo_mode(RADIO_MODE_YSF, variant));
+		run(100);
+		CHECK(radio_ysf_running() && sm.view.ch.mode == RADIO_MODE_YSF);
+		memset(&ysf_vfo_rx, 0, sizeof ysf_vfo_rx);
+		ysf_engine_cfg_t config = { .dt = YSF_DT_VD_MODE2, .narrow = narrow, .silence = dmr_ambe_silence };
+		CHECK(ysf_engine_begin(&receiver, &fake_air1, &config, &hooks, NULL));
+
+		req(RREQ_PTT, 1);
+		run(1800);
+		CHECK(hw.keyed && sm.view.state == RS_TX && aud.started);
+		CHECK(ysf_vfo_rx.headers == 1 && strcmp(ysf_vfo_rx.source, "XE1ABC") == 0);
+		CHECK(ysf_vfo_rx.dt == YSF_DT_VD_MODE2 && ysf_vfo_rx.dev == (uint8_t)narrow);
+		CHECK(ysf_vfo_rx.voice > 50);
+		req(RREQ_PTT, 0);
+		run(500);
+		CHECK(!hw.keyed && !fair[0].on);
+		ysf_engine_end(&receiver);
+	}
+	v_encode_hook = NULL;
+	aud.feed = aud.feed_signal = air_clock_handoff = false;
+	kv_t3_clear();
+	req(RREQ_VFO, 0);
+	run(100);
+}
+
