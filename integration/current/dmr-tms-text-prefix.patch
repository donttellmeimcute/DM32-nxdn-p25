+static void testTMSTextUDP(void)
+{
+	uint8_t datagram[DMR_TMS_UDP_MAX + 2];
+	uint8_t *l4 = &datagram[1];
+	// UDP header, TMS header, CR LF, then both characters. Confirmed sends use this datagram builder.
+	const uint8_t expected[] = {
+		0x0F, 0xA7, 0x0F, 0xA7, 0x00, 0x16, 0x00, 0x00,
+		0x00, 0x0C, 0xE0, 0x00, 0x85, 0x04, 0x0D, 0x00, 0x0A, 0x00, 'A', 0x00, 'B', 0x00,
+	};
+	int length = dmrDataTMSUDP("AB", 5, true, l4);
+	CHECK(length == sizeof(expected) && memcmp(l4, expected, sizeof(expected)) == 0);
+
+	// Preserve the 140-character limit and leave the bytes adjacent to the caller's buffer untouched.
+	char text[142];
+	memset(text, 'X', sizeof(text) - 1);
+	text[139] = 'Z';
+	text[141] = '\0';
+	memset(datagram, 0xA5, sizeof(datagram));
+	length = dmrDataTMSUDP(text, 5, true, l4);
+	CHECK(length == DMR_TMS_UDP_MAX && length == 298);
+	CHECK(l4[4] == 0x01 && l4[5] == 0x2A && l4[8] == 0x01 && l4[9] == 0x20);
+	CHECK(datagram[0] == 0xA5 && datagram[sizeof(datagram) - 1] == 0xA5);
+	dmrDataTMS_t tms;
+	CHECK(dmrDataDecodeTMS(&l4[8], length - 8, &tms));
+	CHECK(strlen(tms.text) == 140 && memcmp(tms.text, text, 140) == 0);
+}
