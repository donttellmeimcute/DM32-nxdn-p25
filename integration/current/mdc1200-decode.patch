+#if RADIO_MDC_RX
+// --- MDC-1200 IDs received (radio-features.md 3.8): on an FM channel set to decode them, the board's receive audio
+// (hal_afsk_t rx, the path APRS listens on) runs through the decoder all the time the channel is received, squelch
+// open or not, and an ID heard shows as the last caller. The decoder's state and the sample buffer are the idle APRS
+// demodulator's: APRS has the audio path on its own frequency, and this gives way to it (aprs_rx_claims) ---
+
+_Static_assert(sizeof(mdc1200_dec_t) <= sizeof(afsk_demod_t), "the decoder fits the APRS demodulator's memory");
+_Static_assert(_Alignof(mdc1200_dec_t) <= _Alignof(afsk_demod_t), "the decoder is aligned as the APRS demodulator's memory");
+
+static bool mdc_rx_wanted(const radio_sm_t *sm)
+{
+	const channel_t *ch = &sm->view.ch;
+	const hal_afsk_t *h = board.afsk;
+	if (ch->mode != RADIO_MODE_FM || ch->ani_type != CODEPLUG_ANI_MDC1200 || !(ch->ani_opts & CODEPLUG_ANI_DECODE) ||
+	    sm->view.state == RS_TX || sm->view.state == RS_TX_DENIED || sm->ptt || sm->hotspot || sm->view.am ||
+	    sm->view.bcast || sm->aprs_phase != APRS_RF_OFF || h == NULL || h->rx_start == NULL || h->rx_read == NULL ||
+	    h->rx_rate_hz != MDC1200_DEC_RATE) {
+		return false;
+	}
+#if CONFIG_SCAN
+	if (scan_on(&sm->scan)) {
+		return false;	// the receiver hops: no burst would be whole
+	}
+#endif
+	return !aprs_rx_claims(ch->rx_hz);
+}
+
+static void mdc_rx_stop(radio_sm_t *sm)
+{
+	if (sm->mdc_rx) {
+		if (board.afsk->rx_stop != NULL) {
+			board.afsk->rx_stop();
+		}
+		sm->mdc_rx = false;
+	}
+}
+
+// Every poll, before APRS: it starts and stops with the channel, and what the board heard goes through the decoder
+static void mdc_rx_service(radio_sm_t *sm, uint32_t now_ms)
+{
+	if (!mdc_rx_wanted(sm)) {
+		mdc_rx_stop(sm);
+		return;
+	}
+	size_t size;
+	mdc1200_dec_t *dec = aprs_rx_scratch(&size);
+	if (!sm->mdc_rx) {
+		mdc1200_dec_init(dec);
+		sm->mdc_rx = board.afsk->rx_start();
+		if (!sm->mdc_rx) {
+			return;		// no memory for the audio now: the next poll tries again
+		}
+	}
+	uint16_t max, n;
+	int16_t *buf = aprs_rx_samples(&max);
+	while ((n = board.afsk->rx_read(buf, max)) != 0) {
+		mdc1200_packet_t p;
+		if (mdc1200_dec(dec, buf, n, &p) != 0) {
+			// Any burst names its sender: a PTT ID at either end of a transmission, or another message
+			sm->view.mdc.source = sm->view.mdc.last_source = p.unit;
+			sm->view.mdc.last_ms = now_ms != 0 ? now_ms : 1;
+			changed(sm);
+		}
+	}
+}
+#endif
