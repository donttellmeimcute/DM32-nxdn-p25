+// --- The receive decoder ---
+
+// The tones of a frame as it is (mdc1200_tones makes its own frame; this one takes a damaged one)
+static void frame_tones(const uint8_t *f, uint8_t *t)
+{
+	unsigned last = 1;
+	memset(t, 0, MDC1200_BURST_BYTES);
+	for (unsigned n = 0; n < MDC1200_BURST_BITS; n++) {
+		unsigned bit = (f[n / 8u] >> (7u - n % 8u)) & 1u;
+		if (bit == last) {
+			t[n / 8u] |= (uint8_t)(1u << (n % 8u));
+		}
+		last = bit;
+	}
+}
+
+static uint32_t lcg = 1;
+static double noise(void)	// about a unit normal: 12 uniform numbers
+{
+	double g = 0;
+	for (int j = 0; j < 12; j++) {
+		lcg = lcg * 1103515245u + 12345u;
+		g += (double)((lcg >> 8) & 0xFFFFu) / 65536.0 - 0.5;
+	}
+	return g;
+}
+
+// What a receiver hears of the tones: made at 48 kHz and taken every 6th sample from offset (so a bit's end falls
+// anywhere between samples), scaled, inverted, de-emphasized (750 us), with noise of sigma, between two silences.
+// Returns the samples written to out
+static size_t heard(const uint8_t *tones, int offset, double gain, bool invert, bool deemph, double sigma, int16_t *out)
+{
+	static int16_t hi[9000];
+	afsk_mod_t m;
+	afsk_mod_init(&m, 48000);
+	size_t n = afsk_mod_fsk(&m, tones, MDC1200_BURST_BITS, 20000, MDC1200_MARK_HZ, MDC1200_SPACE_HZ, hi, 9000);
+	size_t k = 0;
+	double y = 0, a = 1.0 / (1.0 + 8000.0 * 750e-6);
+	for (int i = 0; i < 400; i++) {
+		out[k++] = 0;
+	}
+	for (size_t i = (size_t)offset; i < n; i += 6) {
+		double x = hi[i] * gain * (invert ? -1.0 : 1.0);
+		if (deemph) {
+			y += a * (x * 6.0 - y);	// the gain makes up for the level the filter takes at these tones
+			x = y;
+		}
+		out[k++] = (int16_t)x;
+	}
+	for (int i = 0; i < 400; i++) {
+		out[k++] = 0;
+	}
+	for (size_t i = 0; i < k && sigma > 0; i++) {
+		double v = out[i] + noise() * sigma;
+		out[i] = (int16_t)(v > 32767 ? 32767 : v < -32768 ? -32768 : v);
+	}
+	return k;
+}
+
+// One burst through a fresh decoder: 1 when exactly that packet came out, 0 when nothing did, -1 for anything else
+static int hear(uint8_t arg, uint16_t unit, int offset, double gain, bool invert, bool deemph, double sigma)
+{
+	static int16_t pcm[2400];
+	uint8_t t[MDC1200_BURST_BYTES];
+	mdc1200_tones(MDC1200_OP_PTT_ID, arg, unit, t);
+	size_t n = heard(t, offset, gain, invert, deemph, sigma, pcm);
+	mdc1200_dec_t d;
+	mdc1200_packet_t p = { 0, 0, 0 };
+	mdc1200_dec_init(&d);
+	unsigned found = mdc1200_dec(&d, pcm, n, &p);
+	if (found == 0) {
+		return 0;
+	}
+	return found == 1 && p.op == MDC1200_OP_PTT_ID && p.arg == arg && p.unit == unit ? 1 : -1;
+}
+
+static void test_decode(void)
+{
+	static const uint16_t ids[] = { 0x0001, 0x0644, 0x1234, 0x8000, 0xA5A5, 0xBEEF, 0xFFFF };
