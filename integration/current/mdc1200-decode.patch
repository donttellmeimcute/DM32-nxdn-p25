+#if CONFIG_MDC1200 && CONFIG_APRS_RX
+bool aprs_rx_claims(uint32_t rx_hz)
+{
+	return aprs_s.rx_running || (aprs_s.cfg.rx_on && rx_hz != 0 && rx_hz == aprs_cfg_freq(&aprs_s.cfg));
+}
+
+void *aprs_rx_scratch(size_t *size)
+{
+	*size = sizeof(aprs_s.demod);
+	return &aprs_s.demod;
+}
+
+int16_t *aprs_rx_samples(uint16_t *n)
+{
+	*n = (uint16_t)(sizeof(aprs_s.rxbuf) / sizeof(aprs_s.rxbuf[0]));
+	return aprs_s.rxbuf;
+}
