+			pcm[i] = (int16_t)(v > 32767 ? 32767 : v < -32768 ? -32768 : v);
+		}
+		found += mdc1200_dec(&d, pcm, 200, &p);
+	}
+	memset(pcm, 0, sizeof(pcm));
+	found += mdc1200_dec(&d, pcm, 2400, &p);
+	CHECK(found == 0);
+}
+
 int main(void)
 {
 	test_crc();
 	test_frame();
 	test_tones();
 	test_audio();
+	test_decode();
 	printf("# mdc1200Test: %d checks, %s\n", checks, failures ? "FAILED" : "PASSED");
 	return failures ? 1 : 0;
 }
