+// The same for receive, for a decoder of another signaling on an FM channel APRS doesn't listen on: the board has one
+// receive audio path (hal_afsk_t rx) and APRS comes first.
+// APRS receive is set to listen on this RX frequency (listening now or about to): the audio path is its own
+bool aprs_rx_claims(uint32_t rx_hz);
+// The demodulator's memory (*size bytes) and its sample buffer (*n samples), lent while APRS doesn't listen
+void *aprs_rx_scratch(size_t *size);
+int16_t *aprs_rx_samples(uint16_t *n);
