 	return n == CODEPLUG_SYSTEM_NONE ? -1 : codeplug_kv_get((uint16_t)(CODEPLUG_KEY_SYS_KEY + n), buf, cap);
 }
 
+int codeplug_aes_key_step(uint8_t alg, int32_t current, int dir, uint16_t min, uint16_t max)
+{
+	uint8_t hdr[CODEPLUG_TRAFFIC_HDR];
+	codeplug_kv_cursor_t cursor;
+	uint16_t index;
+	int32_t best = dir > 0 ? (int32_t)max + 1 : (int32_t)min - 1;
+	if (dir < 0 && current < 0)
+		current = (int32_t)max + 1;
+	codeplug_kv_begin(&cursor, CODEPLUG_KEY_TRAFFIC, (uint16_t)(CODEPLUG_KEY_TRAFFIC + TRAFFIC_MAX - 1u));
+	int len;
+	while ((len = codeplug_kv_next(&cursor, &index, hdr, sizeof hdr)) >= 0) {
+		if (len != CODEPLUG_TRAFFIC_HDR + 32 || hdr[0] != CODEPLUG_SYSTEM_NONE || hdr[1] != alg)
+			continue;
+		uint16_t id = rec_rd16(&hdr[2]);
+		if (id >= min && id <= max && (dir > 0 ? id > current && id < best : id < current && id > best))
+			best = id;
+	}
+	return best < min || best > max ? -1 : (int)best;
+}
