+#if CONFIG_MONITOR_SCAN
+enum { MS_START, MS_BAND, MS_LO, MS_HI, MS_STEP, MS_RSSI, MS_FILTER, MS_CONFIG_COUNT };
+enum { MS_PAUSE, MS_SKIP, MS_SAVE, MS_STOP, MS_FREQ, MS_SIGNAL, MS_MODE, MS_CC, MS_TS, MS_TG, MS_ID,
+       MS_SOURCE, MS_ACTIVE_COUNT };
+static const uint32_t monitor_steps[] = { 6250, 12500, 25000, 50000, 100000 };
+static uint32_t monitor_lo, monitor_hi;
+static uint8_t monitor_band, monitor_step = 1, monitor_filter, monitor_edit, monitor_length;
+static int16_t monitor_threshold = -75;
+static char monitor_digits[UI_ENTRY_MAX + 1u];
+
+static bool monitor_supported_band(uint8_t i)
+{
+	const band_t *band = &board.bands[i];
+	return band->tx && band != board.manual_fm_tx_band && band->hi_hz > band->lo_hz;
+}
+
+static void monitor_set_band(uint8_t band)
+{
+	monitor_band = band;
+	monitor_lo = board.bands[band].lo_hz;
+	monitor_hi = board.bands[band].hi_hz;
+}
+
+static void monitor_enter(void)
+{
+	monitor_edit = 0;
+	if (monitor_lo != 0 && monitor_band < board_band_count() && monitor_supported_band(monitor_band))
+		return;
+	monitor_lo = 0;
+	for (uint8_t i = 0; i < board_band_count(); ++i) {
+		if (monitor_supported_band(i) &&
+		    (monitor_lo == 0 || (ui_view()->ch.rx_hz >= board.bands[i].lo_hz &&
+					 ui_view()->ch.rx_hz <= board.bands[i].hi_hz))) {
+			monitor_set_band(i);
+		}
+	}
+}
+
+static bool monitor_active(void)
+{
+	const radio_monitor_view_t *m = &ui_view()->monitor_scan;
+	return m->state != MC_OFF || m->restore_fault;
+}
+
+static const char *monitor_mode(uint8_t mode)
+{
+	switch (mode) {
+	case MC_FM: return "FM?";
+	case MC_DMR: return "DMR";
+	case MC_P25: return "P25 P1";
+	case MC_NXDN48: return "NXDN48";
+	case MC_NXDN96: return "NXDN96";
+	case MC_YSF: return "YSF";
+	case MC_M17: return "M17";
+	case MC_DSTAR: return "D-STAR";
+	case MC_CW: return "CW RSSI";
+	default: return TR(MSCAN_UNKNOWN, "Unidentified");
+	}
+}
+
+static uint8_t monitor_filter_count(void)
+{
+#if CONFIG_CW
+	return 4;
+#else
+	return 3;
+#endif
+}
+
+static const char *monitor_filter_name(void)
+{
+	switch (monitor_filter) {
+	case 1: return "FM";
+	case 2: return TR(MSCAN_DIGITAL, "Digital");
+	case 3: return "CW";
+	default: return TR(MSCAN_ALL, "All modes");
+	}
+}
+
+static const char *monitor_body(void)
+{
+	const radio_monitor_view_t *m = &ui_view()->monitor_scan;
+	if (m->restore_fault)
+		return TR(MSCAN_RESTORE_FAULT, "Restore failed. TX locked.");
+	switch (m->state) {
+	case MC_HELD: return TR(MSCAN_RECEIVING, "Listening. TX locked.");
+	case MC_PAUSED: return TR(MSCAN_PAUSED, "Paused. TX locked.");
+	case MC_VERIFY: return TR(MSCAN_VERIFYING, "Checking the signal");
+	case MC_LISTEN:
+	case MC_SETTLE: return TR(MSCAN_SWEEPING, "Sweeping. TX locked.");
+	default: return NULL;
+	}
+}
+
+static uint16_t monitor_count(void)
+{
+	return monitor_active() ? MS_ACTIVE_COUNT : MS_CONFIG_COUNT;
+}
+
+static void monitor_config_item(uint16_t i, ui_item_t *it)
+{
+	static const tr_id_t names[] = {
+		TRN(MSCAN_START, "Start sweep"), TRN(MSCAN_BAND, "Band"),
+		TRN(TOOLS_ROW_SCAN_LOW, "Scan low"), TRN(TOOLS_ROW_SCAN_HIGH, "Scan high"),
+		TRN(MSCAN_STEP, "Frequency step"), TRN(MSCAN_THRESHOLD, "RSSI threshold"), TRN(LABEL_MODE, "Mode"),
+	};
+	str_copy(it->label, sizeof it->label, tr(names[i]));
+	sbuf_t b;
+	sb_init(&b, it->value, sizeof it->value);
+	if (monitor_edit == i) {
+		it->flags |= UI_ITEM_EDIT;
+		if (i == MS_LO || i == MS_HI) {
+			sb_str(&b, monitor_digits);
+			sb_chr(&b, '_');
+			return;
+		}
+	}
+	switch (i) {
+	case MS_BAND:
+		if (monitor_lo != 0) {
+			sb_u32(&b, board.bands[monitor_band].lo_hz / 1000000u, 1);
+			sb_chr(&b, '-');
+			sb_u32(&b, board.bands[monitor_band].hi_hz / 1000000u, 1);
+			sb_str(&b, " MHz");
+		}
+		break;
+	case MS_LO: sb_freq(&b, monitor_lo); break;
+	case MS_HI: sb_freq(&b, monitor_hi); break;
+	case MS_STEP:
+		sb_u32(&b, monitor_steps[monitor_step] / 1000u, 1);
+		if (monitor_step < 2)
+			sb_str(&b, monitor_step == 0 ? ".25" : ".5");
+		sb_str(&b, " kHz");
+		break;
+	case MS_RSSI:
+		sb_i32(&b, monitor_threshold);
+		sb_str(&b, " dBm");
+		break;
+	case MS_FILTER: sb_str(&b, monitor_filter_name()); break;
+	default: break;
+	}
+}
+
+static void monitor_item(uint16_t i, ui_item_t *it)
+{
+	if (!monitor_active()) {
+		monitor_config_item(i, it);
+		return;
+	}
+	const radio_monitor_view_t *m = &ui_view()->monitor_scan;
+	sbuf_t b;
+	sb_init(&b, it->value, sizeof it->value);
+	const char *label;
+	switch (i) {
+	case MS_PAUSE:
+		label = m->state == MC_PAUSED || m->state == MC_HELD ? TR(MSCAN_CONTINUE, "Continue") : TR(MSCAN_PAUSE, "Pause");
+		break;
+	case MS_SKIP: label = TR(MSCAN_SKIP, "Skip frequency"); break;
+	case MS_SAVE:
+		label = m->state == MC_HELD && (m->mode == MC_UNKNOWN || m->mode == MC_CW) ?
+			TR(MSCAN_SAVE_FM, "Save as FM RX Only") : TR(MSCAN_SAVE, "Save RX Only");
+		if (m->state != MC_HELD)
+			it->flags |= UI_ITEM_DIM;
+		break;
+	case MS_STOP: label = TR(MSCAN_STOP, "Stop sweep"); break;
+	case MS_FREQ:
+		label = TR(APRS_LABEL_FREQUENCY, "Frequency");
+		sb_freq(&b, m->hz);
+		break;
+	case MS_SIGNAL:
+		label = "RSSI";
+		if (m->rssi_dbm >= -150 && m->rssi_dbm <= 0) {
+			sb_i32(&b, m->rssi_dbm);
+			sb_str(&b, " dBm");
+		}
+		break;
+	case MS_MODE:
+		label = TR(LABEL_MODE, "Mode");
+		sb_str(&b, monitor_mode(m->mode));
+		break;
+	case MS_CC:
+		label = "CC";
+		if (m->cc != UINT8_MAX)
+			sb_u32(&b, m->cc, 1);
+		break;
+	case MS_TS:
+		label = "TS";
+		if (m->ts != 0)
+			sb_u32(&b, m->ts, 1);
+		break;
+	case MS_TG:
+		label = "TG";
+		if (m->tg != UINT32_MAX)
+			sb_u32(&b, m->tg, 1);
+		break;
+	case MS_ID:
+		label = m->mode == MC_P25 ? "NAC" : m->mode == MC_YSF ? "DG-ID" :
+			m->mode == MC_M17 ? "CAN" : m->mode == MC_NXDN48 || m->mode == MC_NXDN96 ? "RAN" : "ID";
+		if (m->id != UINT16_MAX) {
+			if (m->mode == MC_P25)
+				sb_hex(&b, m->id, 3);
+			else
+				sb_u32(&b, m->id, 1);
+		}
+		break;
+	default:
+		label = TR(MSCAN_STATION, "Station");
+		sb_str(&b, m->source);
+		break;
+	}
+	str_copy(it->label, sizeof it->label, label);
+	if (i >= MS_FREQ)
+		it->flags |= UI_ITEM_DIM;
+	if (m->restore_fault && i != MS_STOP)
+		it->flags |= UI_ITEM_DIM;
+}
+
+static bool monitor_post_saved(uint16_t slot, const radio_monitor_view_t *m, channel_t *ch)
+{
+#if CONFIG_P25 || CONFIG_NXDN || CONFIG_YSF || CONFIG_DSTAR
+	ui_air_conv_t air = {0};
+#endif
+	switch (m->mode) {
+	case MC_UNKNOWN:
+	case MC_CW:
+	case MC_FM: ch->mode = RADIO_MODE_FM; break;
+#if CONFIG_DMR
+	case MC_DMR:
+		ch->mode = RADIO_MODE_DMR;
+		ch->color_code = m->cc <= 15u ? m->cc : 1u;
+		ch->timeslot = m->ts == 2u ? 2u : 1u;
+		break;
+#endif
+#if CONFIG_P25
+	case MC_P25:
+		ch->mode = RADIO_MODE_P25;
+		air.p25.rx_nac = m->id <= 0xFFFu ? m->id : P25_NAC_ANY;
+		air.p25.tx_nac = P25_NAC_DEFAULT;
+		return ui_svc_write_channel_air_own(slot, ch, 0, &air);
+#endif
+#if CONFIG_NXDN
+	case MC_NXDN48:
+	case MC_NXDN96:
+		ch->mode = RADIO_MODE_NXDN;
+		air.nxdn.rate9600 = m->mode == MC_NXDN96;
+		air.nxdn.rx_ran = m->id <= 63u ? (uint8_t)m->id : NXDN_CP_TX_RAN_DEFAULT;
+		air.nxdn.tx_ran = NXDN_CP_TX_RAN_DEFAULT;
+		return ui_svc_write_channel_air_own(slot, ch, 0, &air);
+#endif
+#if CONFIG_YSF
+	case MC_YSF:
+		ch->mode = RADIO_MODE_YSF;
+		air.ysf.rx_dgid = m->id <= 99u ? (uint8_t)m->id : 0;
+		air.ysf.narrow = m->narrow;
+		strcpy(air.ysf.dest, YSF_CP_DEST_ALL);
+		return ui_svc_write_channel_air_own(slot, ch, 0, &air);
+#endif
+#if CONFIG_M17 && (CONFIG_P25 || CONFIG_NXDN || CONFIG_YSF || CONFIG_DSTAR)
+	case MC_M17:
+		ch->mode = RADIO_MODE_M17;
+		air.m17.can = m->id <= 15u ? (uint8_t)m->id : 0;
+		strcpy(air.m17.dest, M17_DEST_ALL);
+		return ui_svc_write_channel_air_own(slot, ch, 0, &air);
+#endif
+#if CONFIG_DSTAR
+	case MC_DSTAR:
+		ch->mode = RADIO_MODE_DSTAR;
+		return ui_svc_write_channel_air_own(slot, ch, 0, &air);
+#endif
+	default: return false;
+	}
+	return ui_svc_write_channel(slot, ch, 0);
+}
+
+static void monitor_save(void)
+{
+	const radio_monitor_view_t *m = &ui_view()->monitor_scan;
+	if (m->state != MC_HELD)
+		return;
+	uint16_t slot = codeplug_free_channel();
+	if (slot == 0) {
+		ui_toast(TR(TOAST_NO_FREE_CHANNEL, "No free channel"));
+		return;
+	}
+	channel_t ch = { .rx_hz = m->hz, .tx_hz = m->hz, .rx_only = true, .bw = RADIO_BW_12K5,
+			 .power = CODEPLUG_POWER_DEFAULT, .system = CODEPLUG_SYSTEM_NONE };
+	sbuf_t b;
+	sb_init(&b, ch.name, sizeof ch.name);
+	sb_freq(&b, m->hz);
+#if CONFIG_DMR
+	if (m->tg != UINT32_MAX)
+		ch.contact = codeplug_contact_find_index(m->tg, true, NULL);
+#endif
+	if (monitor_post_saved(slot, m, &ch))
+		ui_toast(TR(MSCAN_SAVE_POSTED, "Saving RX-only channel"));
+	else
+		ui_toast(TR(TOAST_SAVE_FAILED, "Couldn't save: try again"));
+}
+
+static void monitor_select(uint16_t i, bool hold)
+{
+	(void)hold;
+	const radio_monitor_view_t *m = &ui_view()->monitor_scan;
+	if (monitor_active()) {
+		if (i == MS_STOP) {
+			radio_req_monitor_scan(RADIO_MONITOR_STOP);
+			ui_frame()->focus = 0;
+			ui_frame()->top = 0;
+		} else if (!m->restore_fault && i == MS_SAVE) {
+			monitor_save();
+		} else if (!m->restore_fault && i == MS_SKIP) {
+			radio_req_monitor_scan(RADIO_MONITOR_SKIP);
+		} else if (!m->restore_fault && i == MS_PAUSE) {
+			radio_req_monitor_scan(m->state == MC_PAUSED || m->state == MC_HELD ?
+				RADIO_MONITOR_RESUME : RADIO_MONITOR_PAUSE);
+		}
+		return;
+	}
+	if (i == MS_START) {
+		static const uint8_t filters[] = {
+#if CONFIG_CW
+			MC_BOTH | MC_MORSE,
+#else
+			MC_BOTH,
+#endif
+			MC_ANALOG, MC_DIGITAL, MC_MORSE,
+		};
+		const radio_view_t *v = ui_view();
+		bool idle = v->state == RS_IDLE && !v->hotspot && !v->scan && !radio_listen_band(v->ch.rx_hz);
+#if CONFIG_CW
+		idle = idle && !v->cw.active && !v->cw.preview && !v->cw.key_armed;
+#endif
+		if (!idle || monitor_lo == 0 || monitor_lo > monitor_hi ||
+		    !radio_req_monitor_scan_start(monitor_lo, monitor_hi, monitor_steps[monitor_step],
+						  monitor_threshold, filters[monitor_filter]))
+			ui_toast(TR(MSCAN_START_FAILED, "Sweep couldn't start"));
+		return;
+	}
+	monitor_edit = (uint8_t)i;
+	monitor_length = 0;
+	monitor_digits[0] = 0;
+	if (i == MS_LO || i == MS_HI)
+		ui_toast(TR(MSCAN_ENTER_FREQ, "Type MHz digits, then OK"));
+}
+
+static void monitor_adjust(int direction)
+{
+	switch (monitor_edit) {
+	case MS_BAND: {
+		uint8_t count = board_band_count();
+		uint8_t band = monitor_band;
+		for (uint8_t i = 0; i < count; ++i) {
+			band = (uint8_t)((band + count + direction) % count);
+			if (monitor_supported_band(band)) {
+				monitor_set_band(band);
+				break;
+			}
+		}
+		break;
+	}
+	case MS_STEP: {
+		const int count = sizeof monitor_steps / sizeof monitor_steps[0];
+		monitor_step = (uint8_t)((monitor_step + count + direction) % count);
+		break;
+	}
+	case MS_RSSI:
+		if (monitor_threshold + direction >= -120 && monitor_threshold + direction <= -30)
+			monitor_threshold = (int16_t)(monitor_threshold + direction);
+		break;
+	case MS_FILTER:
+		monitor_filter = (uint8_t)((monitor_filter + monitor_filter_count() + direction) % monitor_filter_count());
+		break;
+	default: break;
+	}
+}
+
+static bool monitor_key(const input_event_t *ev)
+{
+	if (monitor_edit == 0 || monitor_active())
+		return false;
+	bool frequency = monitor_edit == MS_LO || monitor_edit == MS_HI;
+	if (ev->gesture == GESTURE_PRESS && ev->action == ACT_BACK) {
+		monitor_edit = 0;
+		return true;
+	}
+	if (ev->gesture == GESTURE_PRESS && ev->action == ACT_SELECT) {
+		if (frequency && monitor_length) {
+			uint32_t value = ui_freq_entry_hz(monitor_digits, monitor_length);
+			if (value == 0)
+				return true;
+			if (monitor_band >= board_band_count() || !monitor_supported_band(monitor_band) || value < board.bands[monitor_band].lo_hz ||
+			    value > board.bands[monitor_band].hi_hz ||
+			    (monitor_edit == MS_LO ? value > monitor_hi : value < monitor_lo)) {
+				ui_toast(TR(MSCAN_WRONG_RANGE, "Frequency outside sweep band"));
+				return true;
+			}
+			if (monitor_edit == MS_LO)
+				monitor_lo = value;
+			else
+				monitor_hi = value;
+		}
+		monitor_edit = 0;
+		return true;
+	}
+	if (frequency && ev->gesture == GESTURE_PRESS && ev->action >= ACT_DIGIT_0 && ev->action <= ACT_DIGIT_9) {
+		ui_freq_entry_digit(monitor_digits, &monitor_length, (char)('0' + ev->action - ACT_DIGIT_0));
+		return true;
+	}
+	if (!frequency && (ev->gesture == GESTURE_PRESS || ev->gesture == GESTURE_REPEAT) &&
+	    (ev->action == ACT_NAV_UP || ev->action == ACT_NAV_DOWN)) {
+		monitor_adjust(ev->action == ACT_NAV_UP ? 1 : -1);
+		return true;
+	}
+	return false;
+}
+
+static const char *monitor_title(void)
+{
+	static char title[25];
+	const radio_monitor_view_t *m = &ui_view()->monitor_scan;
+	if (!monitor_active() || m->hz == 0)
+		return NULL;
+	sbuf_t b;
+	sb_init(&b, title, sizeof title);
+	sb_freq(&b, m->hz);
+	if (m->state == MC_HELD && m->mode != MC_UNKNOWN) {
+		sb_chr(&b, ' ');
+		sb_str(&b, monitor_mode(m->mode));
+	}
+	return title;
+}
+
+static void monitor_leave(void)
+{
+	radio_req_monitor_scan(RADIO_MONITOR_STOP);
+	monitor_edit = 0;
+}
