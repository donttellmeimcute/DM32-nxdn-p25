diff --git a/tests/host/uiSignalToolsTest.c b/tests/host/uiSignalToolsTest.c
new file mode 100644
index 0000000000000000000000000000000000000000..851105352780357af57683953d9d5a40938cb73f
--- /dev/null
+++ b/tests/host/uiSignalToolsTest.c
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <stdio.h>
+#include "sim/ui_sim.h"
+#include "radio/monitor_cw.h"
+
+static unsigned failures;
+
+#define CHECK(condition) do { \
+	if (!(condition)) { \
+		fprintf(stderr, "line %u: %s\n", __LINE__, #condition); \
+		++failures; \
+	} \
+} while (0)
+
+static bool run(const char *script)
+{
+	char message[160];
+	if (sim_run(script, message, sizeof message))
+		return true;
+	fprintf(stderr, "script %s: %s\n", script, message);
+	++failures;
+	return false;
+}
+
+static void monitor_test(const sim_geom_t *screen)
+{
+	sim_reset(screen, SIM_MAP_K);
+	const uint32_t previous = sim_view()->ch.rx_hz;
+	if (!run("vfokey quick ctx expect:screen=signal-tools ok expect:screen=monitor-scan"))
+		return;
+	if (!run("down down ok 1 4 4 ok up up ok wait:200"))
+		return;
+	CHECK(sim_view()->monitor_scan.hz == 144000000 && sim_view()->monitor_scan.state == MC_LISTEN);
+	CHECK(run("ptt ok"));
+	CHECK(sim_rec.tx_count == 0 && sim_view()->monitor_scan.state == MC_PAUSED);
+	CHECK(run("ok monhit:144012500 wait:200"));
+	CHECK(sim_view()->monitor_scan.state == MC_HELD);
+	CHECK(run("down down ok"));
+	channel_t saved;
+	CHECK(sim_rec.codeplug_writes == 1);
+	CHECK(codeplug_channel(41, &saved) && saved.rx_only && saved.rx_hz == 144012500 &&
+	      saved.rx_hz == saved.tx_hz && saved.color_code == 0 && saved.timeslot == 2);
+	CHECK(run("up ok wait:200"));
+	CHECK(sim_view()->monitor_scan.hz == 144025000 && sim_view()->monitor_scan.state == MC_LISTEN);
+	CHECK(run("long:back expect:screen=home"));
+	CHECK(sim_view()->monitor_scan.state == MC_OFF);
+	// The scanner's temporary hit is separate from the selected VFO/zone.
+	CHECK(sim_view()->ch.rx_hz != saved.rx_hz && previous != saved.rx_hz);
+}
+
+static void morse_test(const sim_geom_t *screen)
+{
+	sim_reset(screen, SIM_MAP_K);
+	if (!run("vfokey dlmode:fm quick 8 ctx expect:screen=signal-tools down ok expect:screen=morse"))
+		return;
+	CHECK(run("ok cwdecoded:CQ wait:200"));
+	CHECK(sim_view()->cw.active);
+	CHECK(run("down down ok up ok down ok up ok"));
+	CHECK(sim_view()->cw.wpm == 16 && sim_view()->cw.pitch_hz == 675);
+	CHECK(run("down ok mon"));
+	CHECK(sim_view()->cw.key_armed && !sim_view()->cw.preview && sim_rec.tx_count == 0);
+	CHECK(run("down ok wait:200"));
+	CHECK(sim_view()->cw.preview && sim_rec.tx_count == 0);
+	CHECK(run("long:back expect:screen=home"));
+	CHECK(!sim_view()->cw.active && !sim_view()->cw.preview && !sim_view()->cw.key_armed);
+}
+
+int main(void)
+{
+	const sim_geom_t *screen = sim_geom_find("160x128");
+	if (screen == NULL)
+		return 1;
+	monitor_test(screen);
+	morse_test(screen);
+	if (failures)
+		return 1;
+	puts("Monitor Scan and Morse UI flows passed");
+	return 0;
+}
