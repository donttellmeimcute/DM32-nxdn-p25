+static void morse_item(uint16_t i, ui_item_t *it)
+{
+	static const tr_id_t labels[] = {
+		TRN(MORSE_TOOL_RX, "Decode Morse"),
+		TRN(MORSE_TOOL_TEXT, "Decoded text"),
+		TRN(MORSE_TOOL_SPEED, "Speed"),
+		TRN(MORSE_TOOL_PITCH, "Sidetone"),
+		TRN(MORSE_TOOL_KEY, "Practice key"),
+		TRN(MORSE_TOOL_CQ, "Play CQ"),
