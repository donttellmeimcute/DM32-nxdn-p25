+		break;
+	case MORSE_SPEED:
+	case MORSE_PITCH: morse_edit = (uint8_t)i; break;
+	case MORSE_KEY:
+		if (ui_has_action(ACT_MONITOR))
+			radio_req_cw(CW_KEY_ARM, morse_speed, morse_pitch);
+		break;
+	case MORSE_CQ: radio_req_cw(CW_PREVIEW_CQ, morse_speed, morse_pitch); break;
+	case MORSE_CALL: radio_req_cw(CW_PREVIEW_CALL, morse_speed, morse_pitch); break;
+	case MORSE_73: radio_req_cw(CW_PREVIEW_73, morse_speed, morse_pitch); break;
+#if CONFIG_CHANNEL_EDIT
+	case MORSE_CUSTOM: ui_menu_text_open(morse_message, CODEPLUG_NAME_LEN, morse_play_text); break;
+#endif
+	default: break;
+	}
+}
+
+static bool morse_key(const input_event_t *ev)
+{
+	if (morse_edit == 0)
+		return false;
+	if (ev->gesture == GESTURE_PRESS && ev->action == ACT_BACK) {
+		morse_enter();
+		return true;
+	}
+	if (ev->gesture == GESTURE_PRESS && ev->action == ACT_SELECT) {
+		radio_req_cw(CW_CONFIG, morse_speed, morse_pitch);
+		morse_edit = 0;
+		return true;
+	}
+	if (ev->gesture != GESTURE_PRESS && ev->gesture != GESTURE_REPEAT && ev->action != ACT_ENC_STEP)
+		return false;
+	int dir = ev->action == ACT_NAV_UP ? 1 : ev->action == ACT_NAV_DOWN ? -1 :
+		ev->action == ACT_ENC_STEP ? ev->value : 0;
+	if (dir == 0)
+		return false;
+	if (morse_edit == MORSE_SPEED) {
+		int speed = morse_speed + dir;
+		morse_speed = (uint8_t)(speed < 5 ? 5 : speed > 40 ? 40 : speed);
+	} else {
+		int pitch = morse_pitch + dir * 25;
+		morse_pitch = (uint16_t)(pitch < 400 ? 400 : pitch > 1000 ? 1000 : pitch);
+	}
+	return true;
+}
+
+static void morse_leave(void) { radio_req_cw(CW_CANCEL, morse_speed, morse_pitch); }
