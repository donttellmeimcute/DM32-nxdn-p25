+	str_copy(it->label, sizeof it->label, tr(labels[i]));
+	sbuf_t b;
+	sb_init(&b, it->value, sizeof it->value);
+	switch (i) {
+	case MORSE_RX:
+		sb_str(&b, ui_view()->cw.active ? TR(VALUE_ON, "On") : TR(VALUE_OFF, "Off"));
+		break;
+	case MORSE_TEXT:
+		sb_str(&b, ui_view()->cw.text);
+		it->flags |= UI_ITEM_DIM;
+		break;
+	case MORSE_SPEED:
+		sb_u32(&b, morse_speed, 1);
+		sb_str(&b, " WPM");
+		break;
+	case MORSE_KEY:
+		sb_str(&b, ui_view()->cw.key_armed ? TR(VALUE_ON, "On") : TR(VALUE_OFF, "Off"));
+		if (!ui_has_action(ACT_MONITOR))
+			it->flags |= UI_ITEM_DIM;
+		break;
+	case MORSE_PITCH:
+		sb_u32(&b, morse_pitch, 1);
+		sb_str(&b, " Hz");
+		break;
+	default: break;
+	}
+	if (morse_edit == i && (i == MORSE_SPEED || i == MORSE_PITCH))
