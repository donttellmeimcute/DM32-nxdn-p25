diff --git a/core/ysf/ysf_codeplug.c b/core/ysf/ysf_codeplug.c
index b9e70c4..66cc3d9 100644
--- a/core/ysf/ysf_codeplug.c
+++ b/core/ysf/ysf_codeplug.c
@@ -48,7 +48,10 @@ void ysf_conv_decode(const uint8_t *b, int len, ysf_conv_t *out)
 	uint8_t tx = len >= 3 ? b[2] : 0u;
 
 	out->dt = (uint8_t)(f & YSF_CP_DT_MASK);
-	out->narrow = (f & YSF_CP_NARROW) != 0;
+	// Yaesu 4.2.1 pairs data type and deviation: only Voice FR (VW) is wide (2700 Hz); V/D mode 1,
+	// Data FR and DN are narrow (1350 Hz). A stored Wide bit on one of those is stale (the pre-fix
+	// default) and is ignored, so an old channel transmits Narrow without needing an edit.
+	out->narrow = out->dt != YSF_DT_VOICE_FR || (f & YSF_CP_NARROW) != 0;
 	if (rx > YSF_CP_DGID_MAX)
 		rx = 0;			// any DG-ID
 	out->rx_dgid = rx;
