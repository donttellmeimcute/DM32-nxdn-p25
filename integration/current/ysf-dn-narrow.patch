diff --git a/tests/host/ysfCodeplugTest.c b/tests/host/ysfCodeplugTest.c
index a91d9cf..18d04e4 100644
--- a/tests/host/ysfCodeplugTest.c
+++ b/tests/host/ysfCodeplugTest.c
@@ -179,13 +179,28 @@ static void test_conv_load(void)
 	t.flags = 0;
 	CHECK(codeplug_tag_write(11, "Zeroed", &t, NULL, 0));
 	CHECK(codeplug_channel(11, &c) && c.kind == CODEPLUG_KIND_YSF && c.rx_only);
-	CHECK(ysf_conv_load(11, &c, &cfg) && cfg.conv.dt == YSF_DT_VD_MODE1 && !cfg.conv.narrow &&
+	CHECK(ysf_conv_load(11, &c, &cfg) && cfg.conv.dt == YSF_DT_VD_MODE1 && cfg.conv.narrow &&
 	      cfg.conv.rx_dgid == 0 && cfg.conv.tx_dgid == 0 && strcmp(cfg.conv.dest, YSF_CP_DEST_ALL) == 0);
 	// A longer block from a newer writer: the fields known read as usual
 	uint8_t longer[16] = { 0x06, 0x7F, 0x85, 'X', 'E', '1', 'A', 'R', 'S', ' ', ' ', ' ', ' ', 1, 2, 3 };
 	t.flags = CODEPLUG_TAG_TX;
 	CHECK(codeplug_tag_write(11, "Zeroed", &t, longer, sizeof longer));
 	CHECK(codeplug_channel(11, &c) && ysf_conv_load(11, &c, &cfg) && cfg.conv.dt == YSF_DT_VD_MODE2 &&
 	      cfg.conv.narrow && cfg.conv.rx_dgid == 127 && cfg.conv.tx_dgid == 5 &&
 	      strcmp(cfg.conv.dest, "XE1ARS") == 0);
+	// A channel stored Wide before the Narrow default: V/D mode 1, Data FR and DN read Narrow anyway
+	// (Yaesu 4.2.1); only Voice FR honors a stored Wide bit
+	uint8_t stale[YSF_CP_CONV_LEN] = { 0x02, 0x7F, 0x85, 'G', '3', 'L', 'J', 'L', ' ', ' ', ' ', ' ', ' ' };
+	CHECK(codeplug_tag_write(11, "Zeroed", &t, stale, sizeof stale));
+	CHECK(codeplug_channel(11, &c) && ysf_conv_load(11, &c, &cfg) && cfg.conv.dt == YSF_DT_VD_MODE2 &&
+	      cfg.conv.narrow && cfg.conv.rx_dgid == 127 && cfg.conv.tx_dgid == 5 &&
+	      strcmp(cfg.conv.dest, "G3LJL") == 0);
+	stale[0] = 0x01;	// Data FR, stored Wide
+	CHECK(codeplug_tag_write(11, "Zeroed", &t, stale, sizeof stale));
+	CHECK(codeplug_channel(11, &c) && ysf_conv_load(11, &c, &cfg) && cfg.conv.dt == YSF_DT_DATA_FR &&
+	      cfg.conv.narrow);
+	stale[0] = 0x03;	// Voice FR, stored Wide: still Wide
+	CHECK(codeplug_tag_write(11, "Zeroed", &t, stale, sizeof stale));
+	CHECK(codeplug_channel(11, &c) && ysf_conv_load(11, &c, &cfg) && cfg.conv.dt == YSF_DT_VOICE_FR &&
+	      !cfg.conv.narrow);
 	// Another kind's channel, or a plain one: no set-up
