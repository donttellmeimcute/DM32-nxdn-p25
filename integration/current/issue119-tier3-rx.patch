+	      "one search for a stronger TSCC, got %u", (unsigned)ms.st.weak_leaves);
+	t3_csbk_t g = grant(T3_OP_TV_GRANT, 154, 2, TG_A, 1u);
+	send(&ms, 1, CC, &g);
+	CHECK(ms.state == T3_FOLLOW && ms.st.followed == 1 && last.slot == 2, "grant received after the weak search");
+}
