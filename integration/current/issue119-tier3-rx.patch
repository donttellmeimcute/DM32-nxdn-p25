+// With CRC rechecking enabled on a receive-only system, a valid MBC must still arrive in order with a valid
+// continuation on the control slot. The grant then tunes its own carrier and slot and plays the synthetic call.
+static void test_t3_mbc_rx(void)
+{
+	t3_cp_zone(T3_OPT_PRIVATE | T3_OPT_LISTEN_ONLY, 0, 0, NULL);
+	chans[7].accept_bad_crc = true;
+	req(RREQ_ZONE, 2);
+	t3_site_run(600);
+	CHECK(radio_t3v.state == T3_CAMPED && sim.cfg.recheck_headers);
+	const unsigned air = sim.air_count;
+	const uint32_t voice_hz = 451037500u;
+	t3_csbk_t g = { .op = T3_OP_TV_GRANT };
+	g.u.grant.lpcn = T3_LPCN_ABSOLUTE;
+	g.u.grant.slot = 2;
+	g.u.grant.dst = 201;
+	g.u.grant.src = 1000001u;
+	t3_cdef_t plan = { 3, 0, 23, 456037500u, voice_hz };
+	uint8_t cont[T3_CSBK_BYTES];
+	t3_cdef_build(&plan, g.op, cont);
+	dmr_burst_t head = { .kind = DMR_BURST_MBC_HEADER, .sync = DMR_SYNC_BS, .ts = 1, .cc = 2,
+			     .crc_ok = false, .in_step = true, .len = T3_CSBK_BYTES };
+	CHECK(t3_csbk_build(&g, T3_CRC_MASK_MBC_HDR, head.payload));
+	head.payload[3] ^= 0x08;
+
+	sim_rx(&head);
+	run(60);
+	t3_data_rx(DMR_BURST_MBC_CONT, cont, 2);
+	run(60);
+	CHECK(radio_t3v.state == T3_CAMPED && radio_t3v.followed == 0);
+	// Restart the header on TS1. A corrupt continuation fails even with header rechecking enabled.
+	sim_rx(&head);
+	run(60);
+	cont[4] ^= 1;
+	t3_data_rx(DMR_BURST_MBC_CONT, cont, 1);
+	run(60);
+	CHECK(radio_t3v.state == T3_CAMPED && radio_t3v.followed == 0 && radio_t3v.crc_bad >= 1);
+	cont[4] ^= 1;
+	sim_rx(&head);
+	run(60);
+	t3_data_rx(DMR_BURST_MBC_CONT, cont, 1);
+	run(100);
+	CHECK(radio_t3v.state == T3_FOLLOW && radio_t3v.followed == 1 && hw.rx_hz == voice_hz &&
+	      sm.view.ch.timeslot == 2 && sim.cc_filter == 3);
+	hear_call(true, 201, 1000001u, 3, 1, false);
+	CHECK(sm.view.dmr.state == RDMR_RX && sm.view.dmr.call.dst == 201);
+	t3_site_run(3000);
+	CHECK(radio_t3v.state == T3_CAMPED && hw.rx_hz == T3_RX_HZ && sim.air_count == air);
+	t3_cp_done();
+}
