+static void test_satcom_memory(void)
+{
+	start();
+	board_rx_ext_set(false);
+	req(RREQ_ZONE_POS, 2);
+	CHECK(hw.rx_hz == 146520000);
+	add(4, "Satcom", 255550000, 255550000, RADIO_MODE_FM);
+	chans[4].rx_only = true;
+	req(RREQ_ZONE_POS, 3);
+	CHECK(!sm.view.vfo && sm.view.channel_number == 4 && sm.view.zone_pos == 3);
+	CHECK(sm.view.ch.rx_hz == 255550000 && hw.rx_hz == 255550000);
+	ptt(true);
+	CHECK(sm.view.tx_deny == TXDENY_RX_ONLY && hw.tx_calls == 0);
+	ptt(false);
+	req(RREQ_ZONE_POS, 2);
+	req(RREQ_CH_STEP, 1);
+	CHECK(sm.view.channel_number == 4 && hw.rx_hz == 255550000);
+	CHECK(board_in_band(240000000, false) && board_in_band(270000000, false));
+	CHECK(!board_in_band(239999990, false) && !board_in_band(270000010, false));
+	CHECK(!board_in_band(255550000, true));
+	board_rx_ext_set(true);
+	CHECK(board_in_band(270000010, false) && !board_in_band(255550000, true));
+}
