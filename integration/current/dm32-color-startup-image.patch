+	if (gfx_bpp() >= 4 && map && map->openfw_eeprom + COLOR_SPLASH_ADDR + COLOR_SPLASH_BYTES <= board.flash->size) {
+		storage_lock();
+		bool color = draw_color_splash(map->openfw_eeprom + COLOR_SPLASH_ADDR, storage_crc32(0, splash_pixels, sizeof(splash_pixels)));
+		storage_unlock();
+		if (color)
