+// DM-32UV color asset at EEPROM image + 0xB000. The CRC ties it to the
+// legacy KV record, so an older CPS replacing that record takes effect.
+#define COLOR_SPLASH_ADDR 0xB000u
+#define COLOR_SPLASH_MAGIC 0x31424652u
+#define COLOR_EDGE 128u
+#define COLOR_SPLASH_BYTES (12u + 32u + COLOR_EDGE * COLOR_EDGE / 2u)
+
+static uint32_t splash_u32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static bool draw_color_splash(uint32_t addr, uint32_t legacy_crc)
+{
+	uint8_t header[12 + 32];
+	if (!board.flash->read(addr, header, sizeof(header)) || splash_u32(header) != COLOR_SPLASH_MAGIC ||
+	    splash_u32(header + 4) != legacy_crc)
+		return false;
+
+	color_t palette[16];
+	for (unsigned i = 0; i < 16; i++)
+		palette[i] = (color_t)(header[12 + 2 * i] | (header[13 + 2 * i] << 8));
+
+	int w = gfx_width(), h = gfx_height();
+	unsigned edge = (unsigned)(w < h ? w : h);
+	int left = (w - (int)edge) / 2, top = (h - (int)edge) / 2;
+	uint32_t crc = storage_crc32(0, header + 12, 32);
+	uint8_t row[COLOR_EDGE / 2];
+	gfx_clear(palette[0]); // the letterbox uses one of the image's 16 colors
+	addr += sizeof(header);
+	for (unsigned y = 0; y < COLOR_EDGE; y++, addr += sizeof(row)) {
+		if (!board.flash->read(addr, row, sizeof(row)))
+			return false;
+		crc = storage_crc32(crc, row, sizeof(row));
+		unsigned y0 = (y * edge + COLOR_EDGE - 1) / COLOR_EDGE;
+		unsigned y1 = ((y + 1) * edge + COLOR_EDGE - 1) / COLOR_EDGE;
+		if (y1 == y0)
+			continue;
+		unsigned x0 = 0;
+		for (unsigned x = 0; x < COLOR_EDGE; x++) {
+			unsigned x1 = ((x + 1) * edge + COLOR_EDGE - 1) / COLOR_EDGE;
+			unsigned index = (row[x / 2] >> ((x & 1) ? 0 : 4)) & 15u;
+			if (index != 0 && x1 != x0)
+				gfx_fill(left + (int)x0, top + (int)y0, (int)(x1 - x0), (int)(y1 - y0), palette[index]);
+			x0 = x1;
+		}
+	}
+	return crc == splash_u32(header + 8);
+}
