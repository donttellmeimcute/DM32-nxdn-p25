 static void set_roger(radio_settings_t *s) { s->roger_beep = true; }
 
+static void test_fm_mdc_roger(void)
+{
+	reset();
+	radio_settings_t s = sm.set;
+	s.roger_beep = RADIO_FM_ROGER_MDC;
+	s.fm_roger_mdc_id = 0xBEEF;
+	radio_sm_set_settings(&sm, &s, now);
+	radio_sm_init(&sm, now);
+	CHECK(sm.set.roger_beep == RADIO_FM_ROGER_MDC && sm.set.fm_roger_mdc_id == 0xBEEF);
+	req(RREQ_VFO_SET, CH_HZ);
+	CHECK(sm.view.vfo && sm.view.ch.mode == RADIO_MODE_FM);
+	req(RREQ_PTT, 1);
+	run(250);
+	CHECK(hw.starts == 0);
+	req(RREQ_PTT, 0);
+	CHECK(hw.starts == 1 && hw.keyed && mdc_sent(MDC1200_ARG_PTT_POST, 0xBEEF));
+	run(300);
+	CHECK(sm.view.state == RS_IDLE && !hw.keyed && hw.tone_hz == 0 && !sm.view.roger);
+
+	mdc_channel(CODEPLUG_ANI_POST, 0x1A2B);
+	radio_sm_set_settings(&sm, &s, now);
+	req(RREQ_PTT, 1);
+	run(250);
+	req(RREQ_PTT, 0);
+	CHECK(hw.starts == 1 && mdc_sent(MDC1200_ARG_PTT_POST, 0x1A2B));
+	run(500);
+	CHECK(hw.starts == 1 && sm.view.state == RS_IDLE && hw.tone_hz == 0);
+
+	reset();
+	s.fm_roger_mdc_id = 0;
+	radio_sm_set_settings(&sm, &s, now);
+	req(RREQ_PTT, 1);
+	run(250);
+	req(RREQ_PTT, 0);
+	CHECK(hw.starts == 0 && sm.view.state == RS_IDLE && !hw.keyed);
+}
