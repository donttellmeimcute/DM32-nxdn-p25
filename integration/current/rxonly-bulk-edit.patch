+test("Bulk Edit RX Only applies Yes and No to every selected channel without a false error", () => {
+	const m = empty();
+	m.channels.push(newChannel({ name: "One" }), newChannel({ name: "Two" }), newChannel({ name: "Three" }));
+	const c = bulkColumns("channels", m, t).find((x) => x.key === "rxOnly");
+	for (const want of [true, false]) {
+		let err = null;
+		// The same stop-on-error contract as app.js's bulkSet(). A concise setter returning true used to stop at row one.
+		for (const r of m.channels) {
+			err = c.set(r, want);
+			if (err) break;
+		}
+		assert.equal(err, undefined);
+		assert.deepEqual(m.channels.map((r) => r.rxOnly), [want, want, want]);
+	}
+});
