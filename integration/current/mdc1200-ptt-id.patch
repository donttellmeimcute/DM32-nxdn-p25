+	mdc_channel(CODEPLUG_ANI_PRE | CODEPLUG_ANI_POST, 0x1A2B);
+	req(RREQ_PTT, 1);
+	run(150);
+	CHECK(hw.starts == 1 && hw.stops == 0);
+	req(RREQ_PTT, 0);
+	CHECK(hw.stops == 1 && hw.starts == 2 && mdc_sent(MDC1200_ARG_PTT_POST, 0x1A2B) && sm.view.state == RS_TX);
+	run(250);
+	CHECK(sm.view.state == RS_IDLE);
+
+	// The roger beep follows the burst at the end
+	mdc_channel(CODEPLUG_ANI_POST, 0x1A2B);
+	radio_settings_t s = sm.set;
+	set_roger(&s);
+	radio_sm_set_settings(&sm, &s, now);
+	req(RREQ_PTT, 1);
+	run(500);
+	req(RREQ_PTT, 0);
