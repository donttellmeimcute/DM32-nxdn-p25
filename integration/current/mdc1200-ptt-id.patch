new file mode 100644
index 0000000..f158560
--- /dev/null
+++ b/tests/host/mdc1200Test.c
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+/*
+ * Host tests for the MDC-1200 burst encoder (core/mdc, docs/spec/radio-features.md 3.8): the CRC, the frame against
+ * a decoder written here from the format's rules (de-interleave, parity, CRC), the tone sequence, and the tones as
+ * audio through the 1200 baud modulator. The frame of op 01, argument 80, unit 1234 was also decoded by an
+ * independent MDC-1200 decoder from its audio at 8 kHz.
+ *
+ *   make -C tests/host
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include "aprs/afsk.h"
+#include "mdc/mdc1200.h"
+
+static int failures = 0, checks = 0;
+
+#define CHECK(cond) do { checks++; if (!(cond)) { failures++; printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); } } while (0)
+
+#define DATA_AT		(MDC1200_PREAMBLE_BYTES + MDC1200_SYNC_BYTES)
+#define DATA_BITS	(8u * MDC1200_DATA_BYTES)
+
+// A receiver's view of the coded bits: what was sent (high bit first) back to 7 bytes and whether parity and CRC hold
+static bool decode(const uint8_t *frame, uint8_t *op, uint8_t *arg, uint16_t *unit)
+{
+	uint8_t sent[DATA_BITS], bits[DATA_BITS];
+	for (unsigned n = 0; n < DATA_BITS; n++) {
+		sent[n] = (frame[DATA_AT + n / 8u] >> (7u - n % 8u)) & 1u;
+	}
+	// The interleaver sends the bits down 16 columns of 7: sent position 16 row + column holds bit 7 column + row
+	for (unsigned col = 0; col < 16u; col++) {
+		for (unsigned row = 0; row < 7u; row++) {
+			bits[row + 7u * col] = sent[16u * row + col];
+		}
+	}
+	// bits: 56 data bits, then 56 parity bits, each byte low bit first
+	for (unsigned n = 0; n < 56u; n++) {
+		unsigned p = bits[n];
+		if (n >= 2u) p ^= bits[n - 2u];
+		if (n >= 5u) p ^= bits[n - 5u];
+		if (n >= 6u) p ^= bits[n - 6u];
+		if (p != bits[56u + n]) {
+			return false;
+		}
+	}
+	uint8_t d[7] = { 0 };
+	for (unsigned n = 0; n < 56u; n++) {
+		d[n / 8u] |= (uint8_t)(bits[n] << (n % 8u));
+	}
+	uint16_t crc = mdc1200_crc(d, 4);
+	if (d[4] != (crc & 0xFFu) || d[5] != (crc >> 8) || d[6] != 0) {
+		return false;
+	}
+	*op = d[0];
+	*arg = d[1];
+	*unit = (uint16_t)((d[2] << 8) | d[3]);
+	return true;
+}
+
+static void test_crc(void)
+{
+	// CRC-16/KERMIT of "123456789" is 0x2189; this one is its complement
+	CHECK(mdc1200_crc((const uint8_t *)"123456789", 9) == 0xDE76);
+	CHECK(mdc1200_crc((const uint8_t *)"", 0) == 0xFFFF);
+}
+
+static void test_frame(void)
+{
+	static const uint8_t lead[DATA_AT] = { 0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0x07, 0x09, 0x2A, 0x44, 0x6F };
+	// PTT ID at the start from unit 1234, and at the end from unit BEEF
+	static const uint8_t pre_1234[MDC1200_DATA_BYTES] = {
+		0x8E, 0x94, 0x2A, 0x2E, 0x06, 0x99, 0x22, 0x04, 0x00, 0x1C, 0x18, 0xA2, 0x2C, 0x88,
+	};
+	static const uint8_t post_beef[MDC1200_DATA_BYTES] = {
+		0x92, 0x86, 0x0A, 0x01, 0x1A, 0x89, 0x3C, 0x35, 0x3E, 0x20, 0x38, 0x8E, 0x30, 0x96,
+	};
+	uint8_t f[MDC1200_BURST_BYTES];
+	mdc1200_frame(MDC1200_OP_PTT_ID, MDC1200_ARG_PTT_PRE, 0x1234, f);
+	CHECK(memcmp(f, lead, sizeof(lead)) == 0 && memcmp(f + DATA_AT, pre_1234, sizeof(pre_1234)) == 0);
+	mdc1200_frame(MDC1200_OP_PTT_ID, MDC1200_ARG_PTT_POST, 0xBEEF, f);
+	CHECK(memcmp(f, lead, sizeof(lead)) == 0 && memcmp(f + DATA_AT, post_beef, sizeof(post_beef)) == 0);
+
+	// Every field comes back, for IDs across the range
+	static const uint16_t ids[] = { 0x0001, 0x1234, 0x8000, 0xA5A5, 0xBEEF, 0xDFFF, 0xFFFF };
+	for (unsigned i = 0; i < sizeof(ids) / sizeof(ids[0]); i++) {
+		for (unsigned a = 0; a < 2u; a++) {
+			uint8_t op = 0xFF, arg = 0xFF, want = a ? MDC1200_ARG_PTT_PRE : MDC1200_ARG_PTT_POST;
+			uint16_t unit = 0;
+			mdc1200_frame(MDC1200_OP_PTT_ID, want, ids[i], f);
+			CHECK(decode(f, &op, &arg, &unit) && op == MDC1200_OP_PTT_ID && arg == want && unit == ids[i]);
+			// One bit wrong in the air is caught
+			f[DATA_AT + i] ^= 0x10;
+			CHECK(!decode(f, &op, &arg, &unit));
+		}
+	}
+}
+
+static void test_tones(void)
+{
+	uint8_t f[MDC1200_BURST_BYTES], t[MDC1200_BURST_BYTES];
+	mdc1200_frame(MDC1200_OP_PTT_ID, MDC1200_ARG_PTT_PRE, 0x1234, f);
+	CHECK(mdc1200_tones(MDC1200_OP_PTT_ID, MDC1200_ARG_PTT_PRE, 0x1234, t) == MDC1200_BURST_BITS);
+	// The preamble's bits alternate: every one sends the changing tone
+	for (unsigned i = 0; i < MDC1200_PREAMBLE_BYTES; i++) {
+		CHECK(t[i] == 0);
+	}
+	// After it: the repeating tone where a bit equals the one before, in the modulator's bit order
+	bool ok = true;
+	for (unsigned n = 1; n < MDC1200_BURST_BITS; n++) {
+		unsigned bit = (f[n / 8u] >> (7u - n % 8u)) & 1u, before = (f[(n - 1u) / 8u] >> (7u - (n - 1u) % 8u)) & 1u;
+		ok = ok && hdlc_tone_bit(t, n) == (bit == before);
+	}
+	CHECK(ok);
+}
+
+// The level of hz in n samples (a single-bin DFT)
+static double level(const int16_t *s, size_t n, double hz, double rate)
+{
+	double re = 0, im = 0;
+	for (size_t i = 0; i < n; i++) {
+		re += s[i] * cos(2.0 * M_PI * hz * (double)i / rate);
+		im += s[i] * sin(2.0 * M_PI * hz * (double)i / rate);
+	}
+	return sqrt(re * re + im * im) / (double)n;
+}
+
+static void test_audio(void)
+{
+	uint8_t t[MDC1200_BURST_BYTES];
+	static int16_t pcm[2000], bell[2000], same[2000];
+	uint16_t nbits = mdc1200_tones(MDC1200_OP_PTT_ID, MDC1200_ARG_PTT_PRE, 0x1234, t);
+	afsk_mod_t m;
+	afsk_mod_init(&m, 8000);
+	size_t n = afsk_mod_fsk(&m, t, nbits, 10000, MDC1200_MARK_HZ, MDC1200_SPACE_HZ, pcm, 2000);
+	CHECK(n == 1387);	// 208 bits at 1200 baud, 8 kHz
+	CHECK(afsk_mod_fsk(&m, t, nbits, 10000, MDC1200_MARK_HZ, MDC1200_SPACE_HZ, pcm + n, 2000 - n) == 0);
+	// The preamble (56 bits, 373 samples) is the 1800 Hz tone at the amplitude asked for
+	CHECK(level(pcm, 373, 1800, 8000) > 4500 && level(pcm, 373, 1200, 8000) < 300 && level(pcm, 373, 2200, 8000) < 300);
+	// A run of bits that repeat is 1200 Hz
+	memset(t, 0xFF, sizeof(t));
+	afsk_mod_init(&m, 8000);
+	n = afsk_mod_fsk(&m, t, 56, 10000, MDC1200_MARK_HZ, MDC1200_SPACE_HZ, pcm, 2000);
+	CHECK(level(pcm, n, 1200, 8000) > 4500 && level(pcm, n, 1800, 8000) < 300);
+	// No step where the tone changes: neighbors never differ by more than 1800 Hz moves the sine in a sample
+	memset(t, 0x33, sizeof(t));
+	afsk_mod_init(&m, 8000);
+	n = afsk_mod_fsk(&m, t, 200, 10000, MDC1200_MARK_HZ, MDC1200_SPACE_HZ, pcm, 2000);
+	int worst = 0;
+	for (size_t i = 1; i < n; i++) {
+		int d = pcm[i] - pcm[i - 1];
+		worst = d < 0 ? (-d > worst ? -d : worst) : (d > worst ? d : worst);
+	}
+	CHECK(worst <= 10000 * 2 * sin(M_PI * 1800.0 / 8000.0) + 100);
+	// The APRS modulator is the same one with Bell 202's tones
+	afsk_mod_init(&m, 8000);
+	size_t a = afsk_mod(&m, t, 200, 10000, bell, 2000);
+	afsk_mod_init(&m, 8000);
+	size_t b = afsk_mod_fsk(&m, t, 200, 10000, AFSK_MARK_HZ, AFSK_SPACE_HZ, same, 2000);
+	CHECK(a == b && a != 0 && memcmp(bell, same, a * sizeof(int16_t)) == 0);
+}
+
+int main(void)
+{
+	test_crc();
+	test_frame();
+	test_tones();
+	test_audio();
+	printf("# mdc1200Test: %d checks, %s\n", checks, failures ? "FAILED" : "PASSED");
+	return failures ? 1 : 0;
+}
