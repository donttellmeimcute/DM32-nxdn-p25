@@ -5605,10 +5613,94 @@ static inline void dtmf_cancel(radio_sm_t *sm, uint32_t now_ms) { (void)sm; (voi
 
 // --- FM transmit tones and the end of an FM transmission ---
 
+#if CONFIG_MDC1200
+// --- MDC-1200 PTT ID (radio-features.md 3.8): the channel's ID as a data burst at the start of a transmission, at
+// its end, or both. The board's AFSK sender plays the tones in place of the microphone (hal_afsk.h) ---
+
+enum { MDC_OFF = 0, MDC_PRE_WAIT, MDC_PRE, MDC_POST };	// radio_sm_t.mdc_phase
+
+// Carrier up this long before the first burst, so the far receiver's squelch is open for it; longer when it also
+// has to detect our sub-audio tone
+#define RADIO_MDC_PRETIME_MS		100u
+#define RADIO_MDC_PRETIME_TONE_MS	300u
+#define RADIO_MDC_SEND_MAX_MS		600u	// a burst is 173 ms: a sender still busy by now is stuck
+// hal_afsk_t level: about 3 kHz peak on a 25 kHz channel, half that on 12.5 kHz
+#define RADIO_MDC_LEVEL_25K		50u
+#define RADIO_MDC_LEVEL_12K5		25u
+
+static void fm_released(radio_sm_t *sm, bool roger, bool keyed, uint32_t now_ms);
+
+// The burst's tones, valid while it is sent. With APRS on FM built that is its transmit buffer: PTT ended any APRS
+// transmission (ptt_down), and none starts while this one lasts (aprs_can_start)
+static uint8_t *mdc_tone_buf(void)
+{
+#if CONFIG_APRS_AFSK
+	return aprs_rf_scratch();
+#else
+	static uint8_t buf[MDC1200_BURST_BYTES];
+	return buf;
+#endif
+}
+
+// The channel sends its ID at this point (CODEPLUG_ANI_PRE or _POST) and the board can
+static bool mdc_wanted(const radio_sm_t *sm, uint8_t when)
+{
+	const channel_t *ch = &sm->view.ch;
+	return ch->mode == RADIO_MODE_FM && ch->ani_type == CODEPLUG_ANI_MDC1200 && (ch->ani_opts & when) != 0 &&
+	       ch->ani_id != 0 && !sm->host_audio && !sm->hotspot && board.afsk != NULL && board.afsk->tx_start != NULL;
+}
+
+static bool mdc_send(radio_sm_t *sm, uint8_t arg, uint8_t phase, uint32_t now_ms)
+{
+	uint8_t *tones = mdc_tone_buf();
+	uint16_t n = mdc1200_tones(MDC1200_OP_PTT_ID, arg, sm->view.ch.ani_id, tones);
+	uint8_t level = sm->view.ch.bw == RADIO_BW_25K ? RADIO_MDC_LEVEL_25K : RADIO_MDC_LEVEL_12K5;
+	if (!board.afsk->tx_start(tones, n, MDC1200_BAUD, MDC1200_MARK_HZ, MDC1200_SPACE_HZ, level)) {
+		sm->mdc_phase = MDC_OFF;
+		return false;
+	}
+	sm->mdc_phase = phase;
+	sm->mdc_ms = now_ms;
+	return true;
+}
+
+// Whatever is on its way ends here: the microphone has the transmitter again
+static void mdc_cancel(radio_sm_t *sm)
+{
+	if (sm->mdc_phase == MDC_PRE || sm->mdc_phase == MDC_POST) {
+		board.afsk->tx_stop();
+	}
+	sm->mdc_phase = MDC_OFF;
+}
+
+// Every poll while transmitting with an ID on its way
+static void mdc_poll(radio_sm_t *sm, uint32_t now_ms)
+{
+	if (sm->mdc_phase == MDC_PRE_WAIT) {
+		uint32_t wait = sm->view.ch.tx_tone.type != TONE_NONE ? RADIO_MDC_PRETIME_TONE_MS : RADIO_MDC_PRETIME_MS;
+		if (now_ms - sm->tx_start_ms >= wait) {
+			mdc_send(sm, MDC1200_ARG_PTT_PRE, MDC_PRE, now_ms);
+		}
+		return;
+	}
+	if (board.afsk->tx_busy() && now_ms - sm->mdc_ms < RADIO_MDC_SEND_MAX_MS) {
+		return;
+	}
+	bool post = sm->mdc_phase == MDC_POST;
+	mdc_cancel(sm);
+	if (post) {
+		fm_released(sm, true, false, now_ms);	// the roger beep and the tail, as if PTT were let go now
+	}
+}
+#endif
+
 // Back to receive after an FM transmission (PTT released, roger beep done, burst released)
 // keyed: DMR per-burst keying is still armed (dmr_follow releases it), so no tx_off here
