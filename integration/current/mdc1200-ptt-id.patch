+	CHECK(hw.stops == 1 && sm.view.state == RS_TX);
+	req(RREQ_PTT, 0);
+	run(575);
+	CHECK(hw.starts == 2 && hw.stops == 1 && sm.view.state == RS_TX);
+	run(50);
+	CHECK(hw.stops == 2 && sm.view.state == RS_IDLE && !hw.keyed);
+
+	// The burst's tones are in the APRS transmit buffer: a beacon afterwards is whole
+	mdc_channel(CODEPLUG_ANI_PRE | CODEPLUG_ANI_POST, 0x1A2B);
+	aprs_set_test_call("N0TST");
+	req(RREQ_PTT, 1);
+	run(500);
+	req(RREQ_PTT, 0);
+	run(500);
+	CHECK(sm.view.state == RS_IDLE && hw.starts == 2 && nframes == 0);
