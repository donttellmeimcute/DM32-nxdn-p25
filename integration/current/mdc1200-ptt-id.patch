+	run(75);
+	CHECK(hw.starts == 0);
+	run(25);
+	CHECK(hw.starts == 1 && mdc_sent(MDC1200_ARG_PTT_PRE, 0x1A2B) && hw.level == 50 && hw.stops == 0);
+	run(150);
+	CHECK(hw.stops == 0);		// 173 ms on the air
+	run(50);
+	CHECK(hw.stops == 1 && sm.view.state == RS_TX && hw.keyed);
+	run(2000);
+	req(RREQ_PTT, 0);
+	run(RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_IDLE && !hw.keyed && hw.starts == 1);	// nothing at the end
+
+	// A 12.5 kHz channel: half the level. With a TX tone the far squelch needs longer
+	mdc_channel(CODEPLUG_ANI_PRE, 0x0001);
+	chan.bw = RADIO_BW_12K5;
+	chan.tx_tone = (subtone_t){ TONE_CTCSS, 1000 };
+	radio_sm_init(&sm, now);
+	req(RREQ_PTT, 1);
+	run(275);
+	CHECK(hw.starts == 0);
+	run(25);
+	CHECK(hw.starts == 1 && mdc_sent(MDC1200_ARG_PTT_PRE, 0x0001) && hw.level == 25);
+	req(RREQ_PTT, 0);		// let go during the burst: it is cut, the transmission ends
+	CHECK(hw.stops == 1 && sm.view.state == RS_IDLE);
+
+	// PTT let go before the burst started: none
+	mdc_channel(CODEPLUG_ANI_PRE, 0x1A2B);
+	req(RREQ_PTT, 1);
+	run(50);
+	req(RREQ_PTT, 0);
+	run(500);
+	CHECK(sm.view.state == RS_IDLE && hw.starts == 0);
+
