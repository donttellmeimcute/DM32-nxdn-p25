+	// MDC-1200, ID 0x1A2B, sent at the start and the end
+	ch.ani_type = CODEPLUG_ANI_MDC1200;
+	ch.ani_opts = CODEPLUG_ANI_PRE | CODEPLUG_ANI_POST;
+	ch.ani_id = 0x1A2B;
+	codeplug_openfw_encode(&ch, rec);
+	CHECK((rec[0x26] & 0x80) && rec[0x27] == 0xB1 && rec[0x28] == 0x1A && rec[0x29] == 0x2B);
+	CHECK(codeplug_openfw_decode(rec, &back));
+	CHECK(back.ani_type == CODEPLUG_ANI_MDC1200 && back.ani_opts == (CODEPLUG_ANI_PRE | CODEPLUG_ANI_POST));
+	CHECK(back.ani_id == 0x1A2B && back.dmr_id == 0);
+
+	// The decode option alone, and no ID: stored as it is
+	ch.ani_opts = CODEPLUG_ANI_DECODE;
+	ch.ani_id = 0;
+	codeplug_openfw_encode(&ch, rec);
+	CHECK(rec[0x27] == 0xC1 && rec[0x28] == 0 && rec[0x29] == 0);
+	CHECK(codeplug_openfw_decode(rec, &back) && back.ani_opts == CODEPLUG_ANI_DECODE && back.ani_id == 0);
