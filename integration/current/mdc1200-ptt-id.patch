+	mdc_channel(CODEPLUG_ANI_POST, 0xBEEF);
+	req(RREQ_PTT, 1);
+	run(1000);
+	CHECK(hw.starts == 0);
+	req(RREQ_PTT, 0);
+	CHECK(sm.view.state == RS_TX && hw.keyed && hw.starts == 1 && mdc_sent(MDC1200_ARG_PTT_POST, 0xBEEF));
+	run(150);
+	CHECK(sm.view.state == RS_TX && hw.keyed);
+	run(50);
+	CHECK(sm.view.state == RS_IDLE && !hw.keyed && hw.stops == 1 && hw.tx_off_calls == 1);
