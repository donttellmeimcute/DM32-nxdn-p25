+// The channel with an MDC-1200 ID, sent when opts says
+static void mdc_channel(uint8_t opts, uint16_t id)
+{
+	reset();
+	chan.ani_type = CODEPLUG_ANI_MDC1200;
+	chan.ani_opts = opts;
+	chan.ani_id = id;
+	radio_sm_init(&sm, now);
