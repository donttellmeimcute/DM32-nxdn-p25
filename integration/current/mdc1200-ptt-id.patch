+static void test_mdc_ptt_id(void)
+{
+	// A channel without an ID type: PTT sends nothing
+	reset();
+	req(RREQ_PTT, 1);
+	run(1000);
+	req(RREQ_PTT, 0);
+	run(500);
+	CHECK(sm.view.state == RS_IDLE && hw.starts == 0 && hw.tx_calls == 1);
+
+	// At the start: the carrier first, the burst 100 ms later at the 25 kHz level, then the microphone
+	mdc_channel(CODEPLUG_ANI_PRE, 0x1A2B);
