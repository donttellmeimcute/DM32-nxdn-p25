diff --git a/core/mdc/mdc1200.c b/core/mdc/mdc1200.c
new file mode 100644
index 0000000..6291a94
--- /dev/null
+++ b/core/mdc/mdc1200.c
@@ -0,0 +1,214 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* MDC-1200 burst encoder (mdc1200.h) */
+#include "mdc1200.h"
+
+#define DATA_BITS (8u * MDC1200_DATA_BYTES)  /* 112 */
+#define INTERLEAVE 16u                       /* bit n goes to 16 n mod 112, columns in turn */
+
+static const uint8_t sync_word[MDC1200_SYNC_BYTES] = { 0x07, 0x09, 0x2A, 0x44, 0x6F };
+
+uint16_t mdc1200_crc(const uint8_t *p, size_t n)
+{
+    uint16_t crc = 0;
+    while (n--) {
+        crc ^= *p++;
+        for (int i = 0; i < 8; i++) crc = (uint16_t)((crc >> 1) ^ ((crc & 1u) ? 0x8408u : 0u));
+    }
+    return (uint16_t)~crc;
+}
+
+void mdc1200_frame(uint8_t op, uint8_t arg, uint16_t unit, uint8_t frame[MDC1200_BURST_BYTES])
+{
+    uint8_t d[MDC1200_DATA_BYTES] = { op, arg, (uint8_t)(unit >> 8), (uint8_t)unit };
+    uint16_t crc = mdc1200_crc(d, 4);
+    d[4] = (uint8_t)crc;
+    d[5] = (uint8_t)(crc >> 8);
+    d[6] = 0;
+    /* Parity: each data bit (low bit first) gives one parity bit, the sum of it and the bits 2, 5 and 6 before it */
+    uint8_t sr = 0;
+    for (unsigned i = 0; i < 7u; i++) {
+        uint8_t par = 0;
+        for (unsigned j = 0; j < 8u; j++) {
+            sr = (uint8_t)((sr << 1) | ((d[i] >> j) & 1u));
+            par |= (uint8_t)(((sr ^ (sr >> 2) ^ (sr >> 5) ^ (sr >> 6)) & 1u) << j);
+        }
+        d[7u + i] = par;
+    }
+    uint8_t *out = frame;
+    for (unsigned i = 0; i < MDC1200_PREAMBLE_BYTES; i++) *out++ = 0x55;
+    for (unsigned i = 0; i < MDC1200_SYNC_BYTES; i++) *out++ = sync_word[i];
+    for (unsigned i = 0; i < MDC1200_DATA_BYTES; i++) out[i] = 0;
+    /* Interleave: bit n of the 112 (low bit first) is sent as bit 16 n mod 112, plus one for each time around */
+    unsigned k = 0, wrap = 0;
+    for (unsigned n = 0; n < DATA_BITS; n++) {
+        if ((d[n >> 3] >> (n & 7u)) & 1u) out[k >> 3] |= (uint8_t)(0x80u >> (k & 7u));
+        k += INTERLEAVE;
+        if (k >= DATA_BITS) k = ++wrap;
+    }
+}
+
+uint16_t mdc1200_tones(uint8_t op, uint8_t arg, uint16_t unit, uint8_t tones[MDC1200_BURST_BYTES])
+{
+    uint8_t frame[MDC1200_BURST_BYTES];
+    mdc1200_frame(op, arg, unit, frame);
+    /* The line starts as if a 1 came before: the first preamble bit (0) sends the changing tone like the rest */
+    unsigned last = 1;
+    for (unsigned i = 0; i < MDC1200_BURST_BYTES; i++) tones[i] = 0;
+    for (unsigned n = 0; n < MDC1200_BURST_BITS; n++) {
+        unsigned bit = (frame[n >> 3] >> (7u - (n & 7u))) & 1u;
+        if (bit == last) tones[n >> 3] |= (uint8_t)(1u << (n & 7u));
+        last = bit;
+    }
+    return (uint16_t)MDC1200_BURST_BITS;
+}
+
+/* --- Receive --- */
+
+#define SYNC_HI 0x07u
+#define SYNC_LO 0x092A446Fu
+#define SYNC_ERRORS 3u /* bits of the 40 that may differ */
+#define CLOCK_STEP ((uint32_t)(((uint64_t)MDC1200_BAUD << 32) / MDC1200_DEC_RATE))
+#define QUARTERS 4u /* where in a sample period the bit ended, in quarters */
+
+/* 127 sin(2 pi f t) at the samples before a bit's end, newest first: t = (q + 1/2) / 4 - 1 - tap sample periods,
+ * 0 where the sample is before the bit's start. [tone][q][tap] */
+static const int8_t kernel[2][QUARTERS][MDC1200_DEC_TAPS] = {
+    { /* 1200 Hz */
+        {  -93, -125,  -53,   62,  126,   86,    0 },
+        {  -71, -127,  -79,   34,  119,  106,    5 },
+        {  -44, -122, -100,    5,  106,  119,   34 },
+        {  -15, -111, -115,  -25,   86,  126,   62 },
+    },
+    { /* 1800 Hz */
+        { -120,  -60,  101,   92,  -73, -114,    0 },
+        {  -98,  -95,   68,  116,  -32, -126,   -7 },
+        {  -64, -118,   27,  127,   12, -123,  -51 },
+        {  -22, -127,  -17,  122,   55, -104,  -88 },
+    },
+};
+
+static unsigned ones(uint32_t v)
+{
+    unsigned n = 0;
+    for (; v != 0; v &= v - 1u) n++;
+    return n;
+}
+
+void mdc1200_dec_init(mdc1200_dec_t *d)
+{
+    unsigned char *p = (unsigned char *)d;
+    for (size_t i = 0; i < sizeof(*d); i++) p[i] = 0;
+}
+
+/* The 112 bits of a burst (as sent, high bit first) to a packet: false when they are not one */
+static int decode_data(const uint8_t *sent, mdc1200_packet_t *out)
+{
+    uint8_t d[MDC1200_DATA_BYTES] = { 0 };
+    /* the interleaver sent bit 7 col + row at position 16 row + col */
+    for (unsigned k = 0; k < DATA_BITS; k++) {
+        if ((sent[k >> 3] >> (7u - (k & 7u))) & 1u) {
+            unsigned n = 7u * (k % INTERLEAVE) + k / INTERLEAVE;
+            d[n >> 3] |= (uint8_t)(1u << (n & 7u));
+        }
+    }
+    /* Syndromes: each parity bit against the data bits it was made of. A data bit is in four of them (its own and
+     * those 2, 5 and 6 on), and no two data bits share more than one: a bit with three or more of its syndromes set
+     * is wrong (majority decoding, with the corrected bit taken out of the syndromes that follow) */
+    uint8_t syn[7];
+    uint8_t sr = 0;
+    for (unsigned i = 0; i < 7u; i++) {
+        uint8_t par = 0;
+        for (unsigned j = 0; j < 8u; j++) {
+            sr = (uint8_t)((sr << 1) | ((d[i] >> j) & 1u));
+            par |= (uint8_t)(((sr ^ (sr >> 2) ^ (sr >> 5) ^ (sr >> 6)) & 1u) << j);
+        }
+        syn[i] = par ^ d[7u + i];
+    }
+    static const uint8_t taps[4] = { 0, 2, 5, 6 };
+    for (unsigned n = 0; n < 56u; n++) {
+        unsigned votes = 0;
+        for (unsigned t = 0; t < 4u; t++) {
+            unsigned k = n + taps[t];
+            if (k < 56u && ((syn[k >> 3] >> (k & 7u)) & 1u)) votes++;
+        }
+        if (votes < 3u) continue;
+        d[n >> 3] ^= (uint8_t)(1u << (n & 7u));
+        for (unsigned t = 0; t < 4u; t++) {
+            unsigned k = n + taps[t];
+            if (k < 56u) syn[k >> 3] ^= (uint8_t)(1u << (k & 7u));
+        }
+    }
+    uint16_t crc = mdc1200_crc(d, 4);
+    if (d[4] != (uint8_t)crc || d[5] != (uint8_t)(crc >> 8)) return 0;
+    out->op = d[0];
+    out->arg = d[1];
+    out->unit = (uint16_t)((d[2] << 8) | d[3]);
+    return 1;
+}
+
+/* One bit at one timing. Returns 1 when it completed a burst */
+static int phase_bit(mdc1200_dec_t *d, mdc1200_dec_phase_t *p, unsigned bit, mdc1200_packet_t *out)
+{
+    if (p->count != 0) {
+        unsigned k = p->count - 1u;
+        if (bit ^ p->invert) p->bits[k >> 3] |= (uint8_t)(0x80u >> (k & 7u));
+        if (++p->count <= DATA_BITS) return 0;
+        p->count = 0;
+        if (decode_data(p->bits, out)) return 1;
+        d->bad++;
+        return 0;
+    }
+    p->sync_hi = (uint8_t)((p->sync_hi << 1) | (p->sync_lo >> 31));
+    p->sync_lo = (p->sync_lo << 1) | bit;
+    unsigned diff = ones(p->sync_lo ^ SYNC_LO) + ones((uint32_t)(p->sync_hi ^ SYNC_HI));
+    if (diff <= SYNC_ERRORS || diff >= 40u - SYNC_ERRORS) {
+        p->invert = diff > SYNC_ERRORS;
+        p->count = 1;
+        for (unsigned i = 0; i < MDC1200_DATA_BYTES; i++) p->bits[i] = 0;
+    }
+    return 0;
+}
+
+unsigned mdc1200_dec(mdc1200_dec_t *d, const int16_t *s, size_t n, mdc1200_packet_t *out)
+{
+    unsigned found = 0;
+    while (n--) {
+        /* High pass, corner near 250 Hz: y = a (y + x - x'), a = 0.836 in Q15. The 1800 Hz kernel is not free of
+         * DC (a cycle and a half), so hum and a sub-audio tone would lean on its bits */
+        int32_t x = *s++;
+        d->hp_y = (27394 * (d->hp_y + x - d->hp_x)) >> 15;
+        d->hp_x = (int16_t)x;
+        d->pos = (uint8_t)((d->pos + 1u) & 7u);
+        d->hist[d->pos] = (int16_t)(d->hp_y > 32767 ? 32767 : d->hp_y < -32768 ? -32768 : d->hp_y);
+        uint32_t before = d->clock;
+        d->clock += CLOCK_STEP;
+        for (unsigned k = 0; k < MDC1200_DEC_PHASES; k++) {
+            uint32_t off = (uint32_t)(0x100000000ull / MDC1200_DEC_PHASES) * k;
+            uint32_t now = d->clock + off;
+            if (now >= (uint32_t)(before + off)) continue; /* no wrap: this timing's bit goes on */
+            /* Its bit ended now / CLOCK_STEP of a sample period ago: the kernels for that quarter, over the samples
+             * before this one */
+            unsigned q = now / (CLOCK_STEP / QUARTERS); /* now < CLOCK_STEP: 32-bit arithmetic, no long division */
+            if (q >= QUARTERS) q = QUARTERS - 1u;
+            int32_t mark = 0, space = 0;
+            for (unsigned t = 0; t < MDC1200_DEC_TAPS; t++) {
+                int32_t v = d->hist[(d->pos - 1u - t) & 7u];
+                mark += v * kernel[0][q][t];
+                space += v * kernel[1][q][t];
+            }
+            int32_t am = mark < 0 ? -mark : mark, as = space < 0 ? -space : space;
+            unsigned bit = (am >= as ? mark : space) > 0;
+            if (phase_bit(d, &d->phase[k], bit, out)) {
+                /* the other timings hold the same burst: they start over with it */
+                for (unsigned j = 0; j < MDC1200_DEC_PHASES; j++) {
+                    d->phase[j].count = 0;
+                    d->phase[j].sync_lo = 0;
+                    d->phase[j].sync_hi = 0;
+                }
+                d->bursts++;
+                found++;
+            }
+        }
+    }
+    return found;
+}
diff --git a/core/mdc/mdc1200.h b/core/mdc/mdc1200.h
new file mode 100644
index 0000000..457ed9a
--- /dev/null
+++ b/core/mdc/mdc1200.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* MDC-1200 signaling on an analog FM channel: the data burst a radio sends to
+ * identify itself (PTT ID). 1200 bit/s, one tone per bit: 1200 Hz (one cycle)
+ * when the bit equals the one before it, 1800 Hz (a cycle and a half) when it
+ * differs. A burst is a preamble of alternating bits, a 40-bit sync word and
+ * 112 coded bits: op, argument, the 16-bit unit ID and a CRC, with their
+ * rate 1/2 convolutional parity, interleaved. This side builds the tone
+ * sequence of a burst; the board's modulator (hal_afsk.h) sends it. Plain C,
+ * no RTOS, no board. */
+#ifndef MDC1200_H
+#define MDC1200_H
+#include <stddef.h>
+#include <stdint.h>
+
+#define MDC1200_BAUD     1200u
+#define MDC1200_MARK_HZ  1200u  /* tone bit 1: the bit repeats */
+#define MDC1200_SPACE_HZ 1800u  /* tone bit 0: the bit changes */
+
+/* PTT ID: op 0x01, argument 0x80 at the start of a transmission, 0x00 at its end */
+#define MDC1200_OP_PTT_ID    0x01u
+#define MDC1200_ARG_PTT_PRE  0x80u
+#define MDC1200_ARG_PTT_POST 0x00u
+
+#define MDC1200_PREAMBLE_BYTES 7u
+#define MDC1200_SYNC_BYTES     5u
+#define MDC1200_DATA_BYTES     14u  /* 7 bytes and their parity */
+#define MDC1200_BURST_BYTES    (MDC1200_PREAMBLE_BYTES + MDC1200_SYNC_BYTES + MDC1200_DATA_BYTES)
+#define MDC1200_BURST_BITS     (8u * MDC1200_BURST_BYTES)  /* 208 bits: 173 ms on air */
+
+/* The CRC over op, argument and unit ID (CRC-16/CCITT bit-reversed, start 0, inverted) */
+uint16_t mdc1200_crc(const uint8_t *p, size_t n);
+
+/* The burst as it goes on air, before the tones: preamble, sync, coded data; sent high bit first */
+void mdc1200_frame(uint8_t op, uint8_t arg, uint16_t unit, uint8_t frame[MDC1200_BURST_BYTES]);
+
+/* The burst as a tone sequence for hal_afsk_t.tx_start: one bit per symbol, low bit first in each byte,
+ * 1 = MDC1200_MARK_HZ. Returns the number of symbols (MDC1200_BURST_BITS) */
+uint16_t mdc1200_tones(uint8_t op, uint8_t arg, uint16_t unit, uint8_t tones[MDC1200_BURST_BYTES]);
+
+/* --- Receive: a burst out of FM receive audio ---
+ *
+ * The tones are phase continuous and a bit lasts a whole cycle of 1200 Hz or a cycle and a half of 1800 Hz, so the
+ * wave ends each bit rising or falling as the bit is 1 or 0: the decoder reads that, one bit at a time, by
+ * correlating the bit's samples with both tones ending at the bit's end and taking the sign of the stronger. It does
+ * so at MDC1200_DEC_PHASES bit timings side by side (no clock recovery: the preamble is one steady tone), looks for
+ * the sync word in each (as sent or inverted: audio paths differ), then takes 112 bits, undoes the interleave,
+ * corrects errors with the parity bits and checks the CRC. 8 kHz samples only; integer; no RTOS, no board. */
+
+#define MDC1200_DEC_RATE   8000u
+#define MDC1200_DEC_PHASES 6u
+#define MDC1200_DEC_TAPS   7u   /* samples of one bit */
+
+typedef struct {
+    uint8_t op, arg;
+    uint16_t unit;
+} mdc1200_packet_t;
+
+typedef struct {
+    uint32_t sync_lo;       /* the last 40 bits, newest in bit 0 */
+    uint8_t sync_hi;
+    uint8_t invert;         /* the burst's bits arrive inverted */
+    uint8_t count;          /* 0: looking for the sync word; else data bits taken so far, plus one */
+    uint8_t bits[MDC1200_DATA_BYTES];   /* as sent, high bit first */
+} mdc1200_dec_phase_t;
+
+typedef struct {
+    int16_t hist[8];        /* the last samples, high passed */
+    uint8_t pos;
+    int16_t hp_x;           /* the input high pass: hum and sub-audio tones out */
+    int32_t hp_y;
+    uint32_t clock;         /* bit clock, 2^32 = one bit */
+    uint32_t bursts, bad;   /* bursts decoded; sync words found whose data failed the CRC */
+    mdc1200_dec_phase_t phase[MDC1200_DEC_PHASES];
+} mdc1200_dec_t;
+
+void mdc1200_dec_init(mdc1200_dec_t *d);
+/* n samples of receive audio. Returns how many bursts were decoded in them (0 or 1 unless n covers more than a
+ * burst); *out is the last one */
+unsigned mdc1200_dec(mdc1200_dec_t *d, const int16_t *s, size_t n, mdc1200_packet_t *out);
+
+#endif
