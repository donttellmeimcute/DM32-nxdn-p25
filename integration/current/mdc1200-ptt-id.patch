+
+// The last transmission of the AFSK sender was this MDC-1200 burst
+static bool mdc_sent(uint8_t arg, uint16_t id)
+{
+	uint8_t want[MDC1200_BURST_BYTES];
+	uint16_t n = mdc1200_tones(MDC1200_OP_PTT_ID, arg, id, want);
+	return hw.space == 1800 && hw.nbits == n && memcmp(hw.tones, want, sizeof(want)) == 0;
