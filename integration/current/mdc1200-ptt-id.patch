+	mdc_channel(CODEPLUG_ANI_PRE | CODEPLUG_ANI_POST, 0);
+	req(RREQ_PTT, 1);
+	run(500);
+	req(RREQ_PTT, 0);
+	run(500);
+	CHECK(sm.view.state == RS_IDLE && hw.starts == 0);
+
+	// Decode alone sends nothing
+	mdc_channel(CODEPLUG_ANI_DECODE, 0x1A2B);
+	req(RREQ_PTT, 1);
+	run(500);
+	req(RREQ_PTT, 0);
+	run(500);
+	CHECK(sm.view.state == RS_IDLE && hw.starts == 0);
+
+	// The sender refuses: the transmission is an ordinary one
+	mdc_channel(CODEPLUG_ANI_PRE | CODEPLUG_ANI_POST, 0x1A2B);
