+	run(200);
+	CHECK(sm.view.state == RS_TX && sm.view.roger && hw.tone_hz == RADIO_ROGER_HZ1 && hw.stops == 1);
+	run(1000);
+	CHECK(sm.view.state == RS_IDLE && !hw.keyed && hw.tone_hz == 0);
+
