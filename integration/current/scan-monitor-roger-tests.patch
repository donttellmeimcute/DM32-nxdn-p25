+static void test_dmr_roger(void)
+{
+	for (unsigned i = 0; i < 3; i++) {
+		start();
+		chans[6].no_beep = i == 2;
+		req(RREQ_ZONE_POS, 5);
+		radio_settings_t rs = sm.set;
+		rs.dmr_roger = i != 0;
+		rs.talk_permit = false;
+		radio_sm_set_settings(&sm, &rs, now);
+		settings_t stored;
+		settings_read(&stored);
+		CHECK(((stored.rs_flags & SETTINGS_RS_DMR_ROGER) != 0) == rs.dmr_roger);
+		beep_stats_t before, after;
+		beep_get_stats(&before);
+		req(RREQ_PTT, 1);
+		run(600);
+		CHECK(sm.view.dmr.state == RDMR_TX);
+		beep_get_stats(&after);
+		CHECK(after.played == before.played);
+		req(RREQ_PTT, 0);
+		run(1000);
+		beep_get_stats(&after);
+		CHECK(sm.view.state == RS_IDLE && !sm.dmr_keyed);
+		CHECK(after.played == before.played + (i == 1));
+		if (i == 1)
+			CHECK(after.last == BEEP_DMR_ROGER);
+	}
+	chans[6].no_beep = false;
 }

