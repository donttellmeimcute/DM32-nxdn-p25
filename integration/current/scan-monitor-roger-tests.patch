+static void test_dmr_scan_reply_delay(void)
+{
+	start();
+	req(RREQ_ZONE_POS, 4);
+	req(RREQ_SCAN, RSCAN_ZONE);
+	CHECK(sm.view.zone_pos == 5 && sm.view.ch.mode == RADIO_MODE_DMR);
+	run(RADIO_POLL_MS);
+	hear_call(9, 1, 1, false);
+	CHECK(sm.view.scan_phase == SCAN_PH_HOLD);
+
+	// Change the delay on a running scan, then hear two overs on the same frequency.
+	radio_settings_t rs = sm.set;
+	rs.scan_delay_ms = 5000;
+	radio_sm_set_settings(&sm, &rs, now);
+	settings_t stored;
+	settings_read(&stored);
+	CHECK(stored.rs_scan_delay_ms == 5000);
+	hear_call(9, 1, 1, true);
+	CHECK(sm.view.scan_phase == SCAN_PH_RESUME && sm.view.zone_pos == 5);
+	run(2900);
+	hear_call(9, 1, 1, true);
+	CHECK(sm.view.scan_phase == SCAN_PH_RESUME && sm.view.zone_pos == 5);
+	uint32_t waited = now - sm.scan.phase_ms;
+	run(5000 - waited - RADIO_POLL_MS);
+	CHECK(sm.view.scan_phase == SCAN_PH_RESUME && sm.view.zone_pos == 5);
+	run(RADIO_POLL_MS);
+	CHECK(sm.view.zone_pos != 5);
+	req(RREQ_SCAN, RSCAN_STOP);
+}
