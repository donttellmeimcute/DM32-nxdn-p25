 	CHECK(sm.view.state == RS_IDLE && !hw.audio);
 }
 
+// A stored channel squelch wins over the radio default. Zero is explicitly always open, temporary changes clear
+// back to it, and the codeplug's 1-21 scale maps onto the radio's 1-9 control.
+static void test_channel_squelch(void)
+{
+	setup_codeplug();
+	chans[1].squelch = CODEPLUG_SQUELCH_OPEN;
+	start();
+	CHECK(sm.view.squelch == 0 && !sm.view.temporary);
+	rx_signal(UINT8_MAX, true);
+	poll_for(RADIO_POLL_MS);
+	CHECK(sm.view.state == RS_RX && hw.audio);
+	boot();
+	CHECK(sm.view.squelch == 0 && !sm.view.temporary);
+
+	req(RREQ_ZONE_POS, 1);		// a default channel still follows the radio setting
+	CHECK(sm.view.squelch == RADIO_SQUELCH_DEFAULT);
+	req(RREQ_ZONE_POS, 0);
+	CHECK(sm.view.squelch == 0);
+	req(RREQ_SQUELCH, 1);
+	CHECK(sm.view.squelch == 1 && sm.view.temporary);
+	req(RREQ_SQUELCH, -1);		// back at the channel's own zero: no temporary change left
+	CHECK(sm.view.squelch == 0 && !sm.view.temporary);
+	req(RREQ_SQUELCH, 1);
+	req(RREQ_CLEAR_TEMP, 0);
+	CHECK(sm.view.squelch == 0 && !sm.view.temporary);
+
+	chans[1].squelch = 4;
+	req(RREQ_ZONE_POS, 1);
+	req(RREQ_ZONE_POS, 0);
+	CHECK(sm.view.squelch == 2);
+	chans[1].squelch = 21;
+	req(RREQ_ZONE_POS, 1);
+	req(RREQ_ZONE_POS, 0);
+	CHECK(sm.view.squelch == RADIO_SQUELCH_MAX);
+	chans[1].squelch = CODEPLUG_SQUELCH_DEFAULT;
+	req(RREQ_ZONE_POS, 1);
+	req(RREQ_ZONE_POS, 0);
+	CHECK(sm.view.squelch == RADIO_SQUELCH_DEFAULT && !sm.view.temporary);
+	chans[4].squelch = CODEPLUG_SQUELCH_OPEN;	// an unused byte on a digital channel changes nothing
+	req(RREQ_ZONE_POS, 3);
+	CHECK(sm.view.ch.mode == RADIO_MODE_DMR && sm.view.squelch == RADIO_SQUELCH_DEFAULT);
+	setup_codeplug();
+}
