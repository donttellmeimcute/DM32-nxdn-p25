+// The channel's stored FM squelch, or the radio default where it has none. The codeplug's 1-21 scale is qdmr's
+// 1-10 doubled; this radio's control stops at 9. CODEPLUG_SQUELCH_OPEN is deliberately level 0, not the default.
+static uint8_t channel_squelch(const radio_sm_t *sm, const channel_t *ch)
+{
+	if (sm->view.vfo || ch->mode != RADIO_MODE_FM || ch->squelch == CODEPLUG_SQUELCH_DEFAULT) {
+		return sm->base_squelch;
+	}
+	if (ch->squelch == CODEPLUG_SQUELCH_OPEN) {
+		return 0;
+	}
+	uint8_t level = (uint8_t)((ch->squelch + 1u) / 2u);
+	return level > RADIO_SQUELCH_MAX ? RADIO_SQUELCH_MAX : level;
+}
