 	CHECK(codeplug_zone_name(0, name) && strcmp(name, "All channels") == 0 && !codeplug_zone_name(1, name));
 }
 
+// The FM channel's squelch byte: the established default and levels round-trip, 22 is always open, and unknown
+// values retain the old fallback (open-firmware-cps.md 7.3.3)
+static void test_channel_squelch(void)
+{
+	uint8_t rec[CODEPLUG_OPENFW_CHANNEL_SIZE];
+	channel_t ch, back;
+	memset(rec, 0xFF, sizeof(rec));
+	memset(&ch, 0, sizeof(ch));
+	strcpy(ch.name, "Monitor");
+	ch.rx_hz = ch.tx_hz = 146520000;
+	ch.mode = RADIO_MODE_FM;
+	ch.timeslot = 1;
+	ch.power = CODEPLUG_POWER_DEFAULT;
+	for (uint8_t sq = 0; sq <= CODEPLUG_SQUELCH_OPEN; sq++) {
+		ch.squelch = sq;
+		codeplug_openfw_encode(&ch, rec);
+		CHECK(rec[0x37] == sq);
+		CHECK(codeplug_openfw_decode(rec, &back) && back.squelch == sq);
+	}
+	rec[0x37] = CODEPLUG_SQUELCH_OPEN + 1u;
+	CHECK(codeplug_openfw_decode(rec, &back) && back.squelch == 10);
+	ch.squelch = CODEPLUG_SQUELCH_OPEN + 1u;
+	codeplug_openfw_encode(&ch, rec);
+	CHECK(rec[0x37] == 10);
+}
+
