+#define MONITOR_PROBES (sizeof monitor_probes / sizeof *monitor_probes)
+
+static uint16_t monitor_probe_wait(const radio_sm_t *sm, const monitor_probe_t *p)
+{
+#if CONFIG_CW
+	if (p->mode == MC_CW)
+		return (uint16_t)(65u * mc_unit_ms(sm->monitor_wpm));
+#else
+	(void)sm;
+#endif
+	return p->ms;
+}
+
+static bool monitor_allowed(uint32_t hz, void *ctx)
+{
+	(void)ctx;
+	return board_in_band(hz, false) && board_tx_band(hz) >= 0 &&
+	       !board_manual_fm_tx_only(hz) && !radio_listen_band(hz);
+}
+
+static uint32_t monitor_first(const struct mc_cfg *cfg, uint32_t from)
+{
+	uint32_t result = 0;
+	for (uint8_t i = 0; i < board_band_count(); i++) {
+		const band_t *band = &board.bands[i];
+		if (!band->tx || band == board.manual_fm_tx_band)
+			continue;
+		uint32_t lo = band->lo_hz > from ? band->lo_hz : from;
+		uint32_t hi = band->hi_hz < cfg->hi ? band->hi_hz : cfg->hi;
+		if (lo > hi)
+			continue;
+		uint32_t rem = (lo - cfg->lo) % cfg->step;
+		uint32_t bump = rem ? cfg->step - rem : 0;
+		if (bump <= hi - lo && monitor_allowed(lo + bump, NULL) &&
+		    (!result || lo + bump < result))
+			result = lo + bump;
+	}
+	return result;
+}
+
+static uint32_t monitor_next(uint32_t old, const struct mc_cfg *cfg, void *ctx)
+{
+	(void)ctx;
+	uint32_t following = 0;
+	if (old >= cfg->lo && old <= cfg->hi && cfg->step <= cfg->hi - old)
+		following = monitor_first(cfg, old + cfg->step);
+	return following ? following : monitor_first(cfg, cfg->lo);
+}
+
+static bool monitor_mode_ready(const monitor_probe_t *p)
+{
+	switch (p->mode) {
+#if CONFIG_DMR
+	case MC_DMR: return board.dmr != NULL;
+#endif
+#if CONFIG_P25
+	case MC_P25: return p25_ok();
+#endif
+#if CONFIG_NXDN
+	case MC_NXDN48:
+	case MC_NXDN96: return (radio_nxdn_fit(p->mode == MC_NXDN96) & AIR_FIT_RX) != 0;
+#endif
+#if CONFIG_YSF
+	case MC_YSF: return (radio_ysf_fit(p->variant == (VFO_VARIANT_SECOND << 2)) & AIR_FIT_RX) != 0;
+#endif
+#if CONFIG_M17
+	case MC_M17: return m17_ok();
+#endif
+#if CONFIG_DSTAR
+	case MC_DSTAR: return dstar_ok();
+#endif
+#if CONFIG_CW
+	case MC_CW: return true;
+#endif
+	case MC_FM: return true;
+	default: return false;
+	}
+}
+
+static void monitor_metadata_clear(radio_monitor_view_t *v)
+{
+	v->id = UINT16_MAX;
+	v->cc = UINT8_MAX;
+	v->ts = 0;
+	v->tg = UINT32_MAX;
+	v->narrow = false;
+	v->source[0] = '\0';
+}
+
+static void monitor_view_update(radio_sm_t *sm)
+{
+	const struct mc_session *s = &sm->monitor_session;
+	const struct mc_scan *scan = &s->scan;
+	radio_monitor_view_t *v = &sm->view.monitor_scan;
+	v->state = scan->state;
+	v->mode = scan->mode;
+	v->hz = s->owns_rx ? scan->hz : 0;
+	v->restore_fault = s->restore_fault;
+	if (scan->peak > -160)
+		v->rssi_dbm = scan->peak;
+	changed(sm);
+}
+
+static bool monitor_acquire(void *ctx)
+{
+	radio_sm_t *sm = ctx;
+	if (sm->view.state != RS_IDLE || sm->ptt || sm->hotspot || sm->standby || sm->power_off_req ||
+	    BENCH_HELD(sm) || radio_listen_band(sm->view.ch.rx_hz) || board.radio->monitor_rx_only == NULL)
+		return false;
+#if CONFIG_CW
+	if (sm->view.cw.active || sm->view.cw.preview || sm->view.cw.key_armed)
+		return false;
+#endif
+#if CONFIG_SCAN
+	if (scan_on(&sm->scan))
+		return false;
+#endif
+#if CONFIG_DMR
+	if (sm->dmr_keyed || sm->sfr_rpt || sm->view.dmr.state != RDMR_IDLE || sm->view.dmr.reply_active)
+		return false;
+#endif
+#if CONFIG_DMR_TRUNK
+	if (sm->t3_on)
+		return false;
+#endif
+#if AIR_TRUNK
+	if (trunk_ops() != NULL)
+		return false;
+#endif
+#if CONFIG_AIR
+	if (sm->air_tx || sm->air_permit_ms)
+		return false;
+#endif
+#if CONFIG_FM && CONFIG_BEEP
+	if (sm->fm_permit_ms)
+		return false;
+#endif
+#if CONFIG_APRS_AFSK
+	if (sm->aprs_phase != APRS_RF_OFF)
+		return false;
+#endif
+#if CONFIG_DMR_ROAMING
+	// The roaming receiver may already be visiting a channel owned by its search.
+	if (roam_searching(&sm->roam))
+		return false;
+#endif
+	if (!board.radio->monitor_rx_only(true))
+		return false;
+
+	sm->monitor_saved_ch = sm->view.ch;
+	sm->monitor_saved_number = sm->view.channel_number;
+	sm->monitor_saved_vfo = sm->view.vfo;
+	sm->monitor_saved_open = sm->view.monitor;
+#if CONFIG_DMR
+	sm->monitor_saved_hear_all = sm->hear_all_latch;
+	sm->monitor_saved_manual = sm->manual;
+	sm->monitor_saved_one_shot = sm->one_shot;
+#endif
+	sm->view.vfo = false;
+	sm->view.channel_number = 0;
+#if CONFIG_APRS_RX
+	aprs_rx_stop();
+#endif
+#if RADIO_MDC_RX
+	mdc_rx_stop(sm);
+#endif
+	return true;
+}
+
+static bool monitor_restore(void *ctx)
+{
+	radio_sm_t *sm = ctx;
+	dmr_end(sm);
+	sm->view.ch = sm->monitor_saved_ch;
+	sm->view.channel_number = sm->monitor_saved_number;
+	sm->view.vfo = sm->monitor_saved_vfo;
+	sm->view.monitor = sm->monitor_saved_open;
+#if CONFIG_DMR
+	sm->hear_all_latch = sm->monitor_saved_hear_all;
+	sm->manual = sm->monitor_saved_manual;
+	sm->one_shot = sm->monitor_saved_one_shot;
+#endif
+	return tune(sm, sm->monitor_clock);
+}
+
+static void monitor_release(void *ctx)
+{
+	radio_sm_t *sm = ctx;
+	(void)board.radio->monitor_rx_only(false);
+	activity(sm, sm->monitor_clock);
+}
+
+static bool monitor_tune_profile(radio_sm_t *sm, uint32_t hz, const monitor_probe_t *profile)
+{
+	dmr_end(sm); // each probe starts with a new receiver, never the preceding decoder's view
+	sm->view.ch = (channel_t){ .rx_hz = hz, .tx_hz = hz, .bw = RADIO_BW_12K5,
+		.mode = profile ? profile->channel_mode : RADIO_MODE_FM, .rx_only = true,
+		.vfo_digital = CODEPLUG_MONITOR_PROBE | (profile ? profile->variant : 0),
+		.no_beep = true };
+	sm->view.monitor = profile && profile->mode == MC_DMR;
+#if CONFIG_DMR
+	sm->hear_all_latch = profile && profile->channel_mode != RADIO_MODE_FM;
+#endif
+	sm->monitor_fm_polls = 0;
+	if (!tune(sm, sm->monitor_clock))
+		return false;
+	sm->monitor_probe_ms = hal_millis();
+#if CONFIG_CW
+	if (profile && profile->mode == MC_CW)
+		cw_rx_init(&sm->monitor_cw, sm->monitor_wpm, sm->monitor_session.scan.cfg.threshold);
+#endif
+	return true;
+}
+
+static bool monitor_tune_rx(void *ctx, uint32_t hz, uint32_t generation)
+{
+	radio_sm_t *sm = ctx;
+	(void)generation;
+	monitor_metadata_clear(&sm->view.monitor_scan);
+	sm->view.monitor_scan.rssi_dbm = -160;
+	if (!monitor_tune_profile(sm, hz, NULL))
+		return false;
+	sm->monitor_session.scan.since = sm->monitor_probe_ms;
+	return true;
+}
+
+// Analog-only filtering still checks the available digital decoders, so a
+// verified digital burst cannot become an FM candidate.
+static bool monitor_pick_probe(radio_sm_t *sm)
+{
+	const struct mc_cfg *cfg = &sm->monitor_session.scan.cfg;
+	for (; sm->monitor_probe < MONITOR_PROBES; sm->monitor_probe++) {
+		const monitor_probe_t *p = &monitor_probes[sm->monitor_probe];
+		if (!monitor_mode_ready(p))
+			continue;
+		if (p->mode == MC_CW && !(cfg->filter & MC_MORSE))
+			continue;
+		if (p->mode != MC_CW && p->mode != MC_FM && !(cfg->filter & MC_BOTH))
+			continue;
+		return monitor_tune_profile(sm, sm->monitor_session.scan.hz, p);
+	}
+	return true;
+}
+
+static bool monitor_probe_rx(void *ctx, uint32_t generation, uint16_t enabled)
+{
+	radio_sm_t *sm = ctx;
+	(void)generation;
+	(void)enabled;
+	sm->monitor_probe = 0;
+	return monitor_pick_probe(sm);
+}
+
+static const struct mc_radio_ops monitor_ops = {
+	.acquire_rx = monitor_acquire, .restore_rx = monitor_restore, .release_rx = monitor_release,
+	.tune_rx = monitor_tune_rx, .probe_rx = monitor_probe_rx, .allowed = monitor_allowed,
+	.next_allowed = monitor_next,
+};
+
+bool radio_sm_monitor_start(radio_sm_t *sm, const struct mc_cfg *requested, uint32_t now_ms)
+{
+	if (!requested || sm->monitor_session.owns_rx)
+		return false;
+	struct mc_cfg cfg = *requested;
+#if CONFIG_CW
+	sm->monitor_wpm = mc_unit_ms(sm->view.cw.wpm) ? sm->view.cw.wpm : 20u;
+#endif
+	cfg.settle = MONITOR_SETTLE_MS;
+	cfg.dwell = MONITOR_DWELL_MS;
+	cfg.verify = 0;
+	cfg.enabled = 0;
+	for (uint8_t i = 0; i < MONITOR_PROBES; i++) {
+		const monitor_probe_t *p = &monitor_probes[i];
+		if (!monitor_mode_ready(p) || (p->mode == MC_CW && !(cfg.filter & MC_MORSE)))
+			continue;
+		cfg.enabled |= (uint16_t)(1u << p->mode);
+		cfg.verify += monitor_probe_wait(sm, p) + MONITOR_SETTLE_MS + 2u * RADIO_TICK_MS;
+	}
+	if (!(cfg.filter & MC_BOTH) && !(cfg.enabled & (1u << MC_CW)))
+		return false;
+	sm->monitor_clock = now_ms;
+	enum mc_action action = mc_session_start(&sm->monitor_session, &cfg, now_ms, &monitor_ops, sm);
+	monitor_view_update(sm);
+	return action == MC_TUNE;
+}
+
+static bool monitor_stop(radio_sm_t *sm, uint32_t now_ms)
+{
+	sm->monitor_clock = now_ms;
+	bool ok = mc_session_stop(&sm->monitor_session, &monitor_ops, sm);
+	monitor_view_update(sm);
+	return ok;
+}
+
+static void monitor_command(radio_sm_t *sm, int32_t cmd, uint32_t now_ms)
+{
+	if (cmd == RADIO_MONITOR_STOP) {
+		(void)monitor_stop(sm, now_ms);
+		return;
+	}
+	struct mc_session *s = &sm->monitor_session;
+	if (!s->owns_rx || s->restore_fault)
+		return;
+	sm->monitor_clock = now_ms;
+	if (cmd == RADIO_MONITOR_PAUSE && s->scan.state != MC_HELD) {
+		mc_session_pause(s);
+		board.radio->audio(false);
+		dmr_end(sm);
+	} else if (cmd == RADIO_MONITOR_SKIP || cmd == RADIO_MONITOR_RESUME) {
+		if (cmd == RADIO_MONITOR_SKIP)
+			mc_session_pause(s);
+		(void)mc_session_resume(s, now_ms, &monitor_ops, sm);
+	}
+	monitor_view_update(sm);
+}
+
+static uint8_t monitor_evidence(radio_sm_t *sm, const radio_status_t *st, uint32_t now_ms)
+{
+	radio_monitor_view_t *out = &sm->view.monitor_scan;
+	(void)out;
+	(void)now_ms;
+	switch (monitor_probes[sm->monitor_probe].mode) {
+#if CONFIG_DMR
+	case MC_DMR: {
+		const dmr_call_view_t *v = dmr_call_view();
+		if ((v->phase != DMR_CALL_PHASE_RX_VOICE && v->phase != DMR_CALL_PHASE_RX_BUSY) || !v->caller.src)
+			break;
+		if (dmr_call_rx_cc_known())
+			out->cc = v->rx_cc;
+		out->ts = v->rx_ts;
+		if (v->caller.group)
+			out->tg = v->caller.dst;
+		if (v->caller.alias[0]) {
+			memcpy(out->source, v->caller.alias, sizeof out->source - 1u);
+			out->source[sizeof out->source - 1u] = '\0';
+		}
+		return MC_DMR;
+	}
+#endif
+#if CONFIG_P25
+	case MC_P25:
+		if (sm->view.p25.flags & RADIO_P25_RX) {
+			out->id = sm->view.p25.nac;
+			if (sm->view.p25.dst && !(sm->view.p25.flags & RADIO_P25_UNIT))
+				out->tg = sm->view.p25.dst;
+			return MC_P25;
+		}
+		break;
+#endif
+#if CONFIG_NXDN
+	case MC_NXDN48:
+	case MC_NXDN96:
+		if ((sm->view.nxdn.flags & RADIO_NXDN_RX) && sm->view.nxdn.src) {
+			out->id = sm->view.nxdn.ran;
+			if (!(sm->view.nxdn.flags & RADIO_NXDN_UNIT))
+				out->tg = sm->view.nxdn.dst;
+			return (sm->view.nxdn.flags & RADIO_NXDN_9600) ? MC_NXDN96 : MC_NXDN48;
+		}
+		break;
+#endif
+#if CONFIG_YSF
+	case MC_YSF:
+		if (sm->view.ysf.flags & RADIO_YSF_RX) {
+			out->id = sm->view.ysf.dgid;
+			out->narrow = (sm->view.ysf.flags & RADIO_YSF_NARROW) != 0;
+			memcpy(out->source, sm->view.ysf.src, sizeof sm->view.ysf.src);
+			return MC_YSF;
+		}
+		break;
+#endif
+#if CONFIG_M17
+	case MC_M17:
+		if ((sm->view.m17.flags & RADIO_M17_RX) && sm->view.m17.src[0]) {
+			out->id = sm->view.m17.can;
+			memcpy(out->source, sm->view.m17.src, sizeof sm->view.m17.src);
+			return MC_M17;
+		}
+		break;
+#endif
+#if CONFIG_DSTAR
+	case MC_DSTAR:
+		if (sm->view.dstar.rx && sm->view.dstar.source[0]) {
+			memcpy(out->source, sm->view.dstar.source, sizeof sm->view.dstar.source);
+			return MC_DSTAR;
+		}
+		break;
+#endif
+#if CONFIG_CW
+	case MC_CW:
+		cw_rx_sample(&sm->monitor_cw, now_ms, st->rssi_dbm, st->rssi_dbm < 0);
+		if (cw_rx_evidence(&sm->monitor_cw))
+			return MC_CW;
+		break;
+#endif
+	case MC_FM:
+		// Sustained RF and a quiet discriminator indicate an analog candidate.
+		if (st->rssi_dbm < 0 && st->rssi_dbm >= sm->monitor_session.scan.cfg.threshold &&
+		    (st->carrier || st->noise < RADIO_SQL_OPEN_L1 - 12)) {
+			if (sm->monitor_fm_polls < 8u)
+				sm->monitor_fm_polls++;
+			if (sm->monitor_fm_polls >= 8u)
+				return MC_FM;
+		} else {
+			sm->monitor_fm_polls = 0;
+		}
+		break;
+	default:
+		break;
+	}
+	return MC_UNKNOWN;
+}
+
+static void monitor_tick(radio_sm_t *sm, uint32_t now_ms)
+{
+	struct mc_session *session = &sm->monitor_session;
+	struct mc_scan *scan = &session->scan;
+	if (session->restore_fault || scan->state == MC_PAUSED)
+		return;
+#if CONFIG_DMR
+	if (sm->dmr_running)
+		dmr_call_poll(now_ms);
+#endif
+#if CONFIG_AIR
+	if (air_running())
+		air_poll(sm);
+#endif
+	radio_status_t st;
+	board.radio->status(&st);
+	if (scan->state == MC_HELD) {
+		if (sm->view.ch.mode == RADIO_MODE_FM)
+			board.radio->audio(scan->mode != MC_CW && st.rssi_dbm < 0 && st.rssi_dbm >= scan->cfg.threshold);
+		if (now_ms - sm->monitor_clock >= 100u && scan->mode != MC_UNKNOWN && scan->mode != MC_FM &&
+		    scan->mode != MC_CW) {
+			sm->monitor_clock = now_ms;
+			if (monitor_evidence(sm, &st, now_ms) != MC_UNKNOWN)
+				changed(sm);
+		}
+		return;
+	}
+
+	sm->monitor_clock = now_ms;
+	struct mc_sample sample = { .tune_id = scan->tune_id, .rssi = st.rssi_dbm, .valid = st.rssi_dbm < 0 };
+	if (scan->state == MC_VERIFY && sm->monitor_probe < MONITOR_PROBES &&
+	    now_ms - sm->monitor_probe_ms >= MONITOR_SETTLE_MS) {
+		sample.evidence = monitor_evidence(sm, &st, now_ms);
+		if (sample.evidence != MC_UNKNOWN) {
+			if (!mc_match(&scan->cfg, sample.evidence)) {
+				monitor_command(sm, RADIO_MONITOR_SKIP, now_ms);
+				return;
+			}
+			// Valid synchronization or an already decoded header can arrive during a TDMA idle slot.
+			if (sample.rssi < scan->peak || !sample.valid)
+				sample.rssi = scan->peak;
+			sample.valid = true;
+		} else if (now_ms - sm->monitor_probe_ms >= monitor_probe_wait(sm, &monitor_probes[sm->monitor_probe]) +
+			   MONITOR_SETTLE_MS) {
+			sm->monitor_probe++;
+			if (!monitor_pick_probe(sm)) {
+				monitor_stop(sm, now_ms);
+				return;
+			}
+			// No more probes. The last profile was FM, so an unidentified hit can listen here.
+			if (sm->monitor_probe == MONITOR_PROBES)
+				scan->since = now_ms - scan->cfg.verify;
+		}
+	}
+	uint8_t before = scan->state;
+	enum mc_action action = mc_session_poll(session, now_ms, sample, &monitor_ops, sm);
+	if (action != MC_IDLE || before != scan->state)
+		monitor_view_update(sm);
+}
+#endif
