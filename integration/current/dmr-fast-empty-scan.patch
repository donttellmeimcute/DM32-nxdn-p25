+#if CONFIG_DMR
+// One extra RF reading on the existing 10 ms modem tick. Before the normal settle it can only veto a fast
+// skip. It never opens the squelch, starts a probe, or contributes to the learned noise floor.
+static void scan_dmr_early_sample(radio_sm_t *sm, uint32_t now_ms)
+{
+	scan_t *sc = &sm->scan;
+	uint32_t age = now_ms - sc->tuned_ms;
+	if ((sc->kind != SCAN_ZONE && sc->kind != SCAN_VFO) || sc->phase != SCAN_PH_LISTEN ||
+	    sm->view.ch.mode != RADIO_MODE_DMR || sm->view.monitor || sc->quiet_samples ||
+	    age < 7 || age > 16)
+		return;
+	uint16_t dwell = sc->kind == SCAN_ZONE ? sm->set.zone_scan_dwell_ms : sm->set.scan_dwell_ms;
+	if (dwell >= RADIO_SCAN_DMR_FALLBACK_MS)
+		return;
+	radio_status_t st;
+	board.radio->status(&st);
+	sc->quiet_samples = carrier_heard(sm, st.noise) || dmr_strength_heard(sm, st.rssi_dbm) ? -1 : 1;
+}
+#endif
+
 #if CONFIG_DUAL_WATCH
 // Dual watch on one receiver, in the wait after a signal (SCAN_PH_RESUME): the receiver stays for the reply, but after
 // each dwell there it looks at the other channel for one. A carrier only sets view.dual_busy. If the digital engine
@@ -5265,9 +5285,18 @@ static void scan_service(radio_sm_t *sm, const radio_status_t *st, uint32_t now_
 		if (rejected)
 			sc->heard = false;
 		uint16_t dwell = sc->kind == SCAN_ZONE ? sm->set.zone_scan_dwell_ms : sm->set.scan_dwell_ms;
-		// DMR's idle slot lasts 30 ms. Two 25 ms polls can both fall in it; three polls cannot.
-		if (dmr && dwell < RADIO_SCAN_DMR_DWELL_MS)
-			dwell = RADIO_SCAN_DMR_DWELL_MS;
+		if (dmr && dwell < RADIO_SCAN_DMR_FALLBACK_MS) {
+			uint32_t age = now_ms - sc->tuned_ms;
+			if (sc->quiet_samples == 1 && age >= RADIO_POLL_MS && age <= 30 && !carrier)
+				sc->quiet_samples = 2;
+			if (dwell < RADIO_SCAN_DMR_DWELL_MS)
+				dwell = RADIO_SCAN_DMR_DWELL_MS;
+			// Samples at 7-16, 25-30 and 50-52 ms leave at most 27 ms between readings around
+			// a 60 ms TDMA cycle. Use the original three polls if a tick was late or ambiguous.
+			if (sc->phase == SCAN_PH_LISTEN && age >= dwell && !rejected && !sc->heard &&
+			    !carrier && !sync && (sc->quiet_samples != 2 || age > 52))
+				dwell = RADIO_SCAN_DMR_FALLBACK_MS;
+		}
 		sc->cfg.dwell_ms = dwell < sc->cfg.settle_ms ? sc->cfg.settle_ms : dwell;
 	}
 	// A no-tone FM carrier still needs a poll for the squelch, which runs after this scan step.
@@ -10241,6 +10270,9 @@ void radio_sm_tick(radio_sm_t *sm, uint32_t now_ms)
 		dmr_call_poll(now_ms);
 		dmr_follow(sm, now_ms);
 		one_shot_follow(sm, now_ms);
+#if CONFIG_SCAN
+		scan_dmr_early_sample(sm, now_ms);
+#endif
 	}
 #if CONFIG_SFR
 	if (sm->sfr_rpt) {
