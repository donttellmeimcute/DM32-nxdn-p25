+static void test_fast_dmr_scan(void)
+{
+	// The transmitter is asynchronous. Check every millisecond phase, including a burst
+	// between the two regular polls, on both alignments of the 10 and 25 ms task clocks.
+	for (unsigned alignment = 0; alignment <= RADIO_POLL_MS; alignment += RADIO_POLL_MS) {
+		for (uint8_t offset = 0; offset < 60; offset++) {
+			start();
+			run(alignment);
+			req(RREQ_ZONE_POS, 4);
+			signal_on(0, 438500000, 120, no_tone);	// only RSSI follows the burst
+			hw.sig[0].tdma = true;
+			hw.sig[0].phase_ms = offset;
+			req(RREQ_SCAN, RSCAN_ZONE);
+			run(RADIO_SCAN_DMR_FALLBACK_MS);
+			CHECK(sm.view.zone_pos == 5 && sm.scan.phase == SCAN_PH_PROBE);
+		}
+	}
+	// Delay the modem tick past the early sample. The two regular polls cannot prove silence.
+	start();
+	req(RREQ_ZONE_POS, 4);
+	req(RREQ_SCAN, RSCAN_ZONE);
+	now += RADIO_POLL_MS;
+	radio_sm_poll(&sm, now);
+	run(RADIO_POLL_MS);
+	CHECK(sm.view.zone_pos == 5);
+	run(RADIO_POLL_MS);
+	CHECK(sm.view.zone_pos == 6);
+
+	start();
+	req(RREQ_VFO_SET, 146000000);
+	req(RREQ_MODE, RADIO_MODE_DMR);
+	req2(RREQ_SCAN_VFO, 146000000, 146100000);
+	CHECK(sm.view.scan == SCAN_VFO && sm.view.ch.mode == RADIO_MODE_DMR);
+	uint32_t first = sm.view.ch.rx_hz;
+	run(RADIO_POLL_MS);
+	CHECK(sm.view.ch.rx_hz == first);
+	run(RADIO_POLL_MS);
+	CHECK(sm.view.ch.rx_hz != first);
+}
