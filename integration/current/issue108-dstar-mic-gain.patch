diff --git a/tests/host/radioCoreTest.c b/tests/host/radioCoreTest.c
--- a/tests/host/radioCoreTest.c
+++ b/tests/host/radioCoreTest.c
@@ -12203,11 +12203,16 @@
 
 #if CONFIG_DSTAR
 #include "dstar/dv_engine.h"
+#include "dstar/ambe_wire.h"
+#include "radio/mic_gain.h"
 #include "hostlink/build_info.h"
 
 static struct {
 	dstar_header_t header;
 	unsigned headers, voice, speech, ends;
+	dstar_ambe_t decoder;
+	unsigned frames;
+	uint64_t energy;
 } dstar_far;
 
 static void dstar_far_start(const dstar_header_t *header, void *ctx)
@@ -12216,6 +12221,9 @@
 	if (header) {
 		dstar_far.header = *header;
 		dstar_far.headers++;
+		dstar_ambe_reset(&dstar_far.decoder);
+		dstar_far.frames = 0;
+		dstar_far.energy = 0;
 	}
 }
 
@@ -12225,6 +12233,13 @@
 	dstar_far.voice++;
 	if (memcmp(voice, dstar_silence, DSTAR_VOICE_BYTES) != 0)
 		dstar_far.speech++;
+	uint8_t raw[DSTAR_AMBE_BITS];
+	int16_t pcm[MBE_FRAME_LEN];
+	dstar_ambe_decode(&dstar_far.decoder, dstar_ambe_wire_decode(voice, raw) ? raw : NULL, pcm);
+	// Use the same steady portion of the test tone in each call.
+	if (++dstar_far.frames > 10 && dstar_far.frames <= 30)
+		for (unsigned i = 0; i < MBE_FRAME_LEN; i++)
+			dstar_far.energy += (uint32_t)((int32_t)pcm[i] * pcm[i]);
 }
 
 static void dstar_far_end(void *ctx) { (void)ctx; dstar_far.ends++; }
@@ -12282,6 +12297,23 @@
 	      !memcmp(dstar_far.header.ur, route, 8) && !memcmp(dstar_far.header.rpt1, route + 8, 8) &&
 	      !memcmp(dstar_far.header.rpt2, route + 16, 8));
 
+	// Manual gain must reach the far-end PCM when the board has no microphone gain hook.
+	uint8_t saved_gain = radio_mic_gain();
+	uint64_t energy[3];
+	for (unsigned i = 0; i < 3; i++) {
+		unsigned headers = dstar_far.headers;
+		radio_set_mic_gain((uint8_t)(i * MIC_GAIN_UNITY));
+		req(RREQ_PTT, 1);
+		run(1000);
+		req(RREQ_PTT, 0);
+		run(500);
+		CHECK(dstar_far.headers == headers + 1 && dstar_far.frames >= 30);
+		energy[i] = dstar_far.energy;
+	}
+	radio_set_mic_gain(saved_gain);
+	// Each five-step increase is 10 dB. Allow for quantization in the decoded energy.
+	CHECK(energy[0] > 0 && energy[1] > 6 * energy[0] && energy[1] < 16 * energy[0]);
+	CHECK(energy[2] > 6 * energy[1] && energy[2] < 16 * energy[1]);
 	// The external station transmits a DV reply and the handheld plays it.
 	dstar_header_t reply = dstar_far.header;
 	memcpy(reply.my, "N0CALL  ", 8);
