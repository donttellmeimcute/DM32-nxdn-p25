diff --git a/boards/dm32/freertos_board.h b/boards/dm32/freertos_board.h
index 1e1af46..551cf58 100644
--- a/boards/dm32/freertos_board.h
+++ b/boards/dm32/freertos_board.h
@@ -11,6 +11,15 @@
 // tests/hil/test_task_stacks.py asks for, and gives the rest to main RAM (the air MTU's 64-burst lists took the last
 // 1 KB from 34, the talk permit before keying 0.5 KB from 33). The debug link's tasks view reports the least free since
 // start (tasks.heap_min_free)
+#if CONFIG_AIR
 #define configTOTAL_HEAP_SIZE	(32 * 1024 + 512)
+#else
+// The DMR/FM call graph uses larger task frames with the additional digital modes omitted.
+// Add space for those stacks while keeping the same heap headroom.
+#define configTOTAL_HEAP_SIZE	(32 * 1024 + 512 + 1280)
+#define START_TASK_STACK	704
+#define RADIO_TASK_STACK	832
+#define UI_TASK_STACK_WORDS	688
+#endif
 
 #endif
