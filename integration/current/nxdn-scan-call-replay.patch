+			run(RADIO_POLL_MS);
+			CHECK(sm.view.scan == SCAN_VFO && sm.view.ch.mode == RADIO_MODE_NXDN && !sm.view.am);
+			CHECK((sm.view.ch.vfo_digital & VFO_DIG_NXDN_MASK) == variant && radio_nxdn_running());
+			CHECK(hw.rx_hz >= 137000000);
+		}
+		CHECK(hw.rx_hz < 140000000);  // wrapped without tuning any AM frequencies
+		req(RREQ_SCAN, RSCAN_STOP);
+		CHECK(sm.view.ch.mode == RADIO_MODE_NXDN);
+
+		// A user range straddling the boundary keeps the original frequency raster.
+		radio_sm_request(&sm, &(radio_req_t){ RREQ_SCAN_VFO, 136991000, 137040000 }, now);
+		CHECK(sm.scan.lo_hz == 137003500 && sm.scan.hi_hz == 137040000);
+		CHECK(sm.view.scan == SCAN_VFO && sm.view.ch.mode == RADIO_MODE_NXDN);
+		req(RREQ_SCAN, RSCAN_STOP);
+		radio_sm_request(&sm, &(radio_req_t){ RREQ_SCAN_VFO, 136975000, 136995000 }, now);
+		CHECK(sm.view.scan == 0 && sm.view.ch.mode == RADIO_MODE_NXDN);
+	}
+	fake_radio.rx_am = NULL;
+}
