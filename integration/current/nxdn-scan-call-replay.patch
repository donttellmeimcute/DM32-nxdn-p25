+++ b/core/radio/radio_nxdn.c
@@ -313,18 +313,40 @@ static void params_channel(const channel_t *ch, uint16_t number, nxdn_engine_cfg
 // ── Voice: the DMR side's voice path (ambeVoice.h), its sink on receive and its source on transmit. The hooks run in
 // the provider's task, which is the only one feeding that path while NXDN runs (the DMR stack is stopped); the
 // audio stream is started and stopped by the radio task (begin, end) ──
+#if CONFIG_DMR_REPLAY
+#define nxdn_voice_sink ambeVoiceNxdnSink
+
+static bool v_replay_eligible(const nxdn_call_t *c)
+{
+	return c->have_vcall && !c->late && !c->iv && c->vcall.cipher == NXDN_CIPHER_NONE &&
+	       c->vcall.call_type == NXDN_CALL_GROUP && c->vcall.src != NXDN_ID_NULL;
+}
+
+static void v_update(const nxdn_call_t *c, void *ctx)
+{
+	(void)ctx;
+	if (!v_replay_eligible(c))
+		ambeVoiceReplayNxdnReject();
+}
+#else
+#define nxdn_voice_sink ambeVoiceSink
+#endif
+
 static void v_start(const nxdn_call_t *c, void *ctx)
 {
-	const dmr_voice_sink_t *s = ambeVoiceSink();
+	const dmr_voice_sink_t *s = nxdn_voice_sink();
 
 	(void)c;
 	(void)ctx;
 	s->begin(NULL, s->ctx);
+#if CONFIG_DMR_REPLAY
+	ambeVoiceReplayNxdnBegin(v_replay_eligible(c));
+#endif
 }
 
 static void v_voice(const uint8_t ehr[NXDN_EHR_BYTES], void *ctx)
 {
-	const dmr_voice_sink_t *s = ambeVoiceSink();
+	const dmr_voice_sink_t *s = nxdn_voice_sink();
 
 	(void)ctx;
 	s->frame(ehr, s->ctx);
@@ -332,7 +354,7 @@ static void v_voice(const uint8_t ehr[NXDN_EHR_BYTES], void *ctx)
 
 static void v_end(void *ctx)
 {
-	const dmr_voice_sink_t *s = ambeVoiceSink();
+	const dmr_voice_sink_t *s = nxdn_voice_sink();
 
 	(void)ctx;
 	s->end(s->ctx);
@@ -372,6 +394,9 @@ static uint16_t v_key(uint8_t id, void *ctx)
 
 static const nxdn_engine_hooks_t voice_hooks = {
 	.rx_start = v_start, .rx_voice = v_voice, .rx_end = v_end, .tx_voice = v_tx,
+#if CONFIG_DMR_REPLAY
