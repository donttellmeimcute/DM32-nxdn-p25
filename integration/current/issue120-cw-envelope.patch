 	    BENCH_HELD(sm) || radio_listen_band(sm->view.ch.rx_hz) || board.radio->monitor_rx_only == NULL)
 		return false;
@@ -9702,6 +9710,183 @@ static void monitor_tick(radio_sm_t *sm, uint32_t now_ms)
 }
 #endif
 
+#if CONFIG_CW
+#define CW_ENVELOPE_DBM (-105)
+
+static bool cw_tool_available(const radio_sm_t *sm)
+{
+#if CONFIG_MONITOR_SCAN
+	if (sm->monitor_session.owns_rx)
+		return false;
+#endif
+	if (sm->standby || sm->hotspot || BENCH_HELD(sm) || sm->ptt || sm->view.scan ||
+	    sm->view.bcast || sm->view.am || sm->view.ch.mode != RADIO_MODE_FM ||
+	    sm->view.ch.bw != RADIO_BW_12K5 ||
+	    (sm->view.state != RS_IDLE && sm->view.state != RS_RX))
+		return false;
+#if CONFIG_APRS_AFSK
+	if (sm->aprs_phase != APRS_RF_OFF)
+		return false;
+#endif
+	return true;
+}
+
+static bool cw_tool_in_use(const radio_sm_t *sm)
+{
+	return sm->view.cw.active || sm->view.cw.preview || sm->view.cw.key_armed;
+}
+
+static void cw_tool_stop(radio_sm_t *sm)
+{
+	beep_morse_cancel();
+	sm->view.cw.active = false;
+	sm->view.cw.preview = false;
+	sm->view.cw.key_armed = false;
+	sm->view.cw.evidence = false;
+	changed(sm);
+}
+
+static void cw_tool_config(radio_sm_t *sm, uint32_t control)
+{
+	uint8_t wpm = (uint8_t)(control >> 8);
+	uint16_t pitch = (uint16_t)(control >> 16);
+	if (wpm >= MORSE_WPM_MIN && wpm <= MORSE_WPM_MAX && wpm != sm->view.cw.wpm) {
+		sm->view.cw.wpm = wpm;
+		cw_rx_init(&sm->cw_envelope, wpm, CW_ENVELOPE_DBM);
+		sm->view.cw.evidence = false;
+	}
+	if (pitch >= 400u && pitch <= 1000u)
+		sm->view.cw.pitch_hz = pitch;
+}
+
+static void cw_tool_preview(radio_sm_t *sm, const char *text, uint8_t len)
+{
+	if (!cw_tool_available(sm) || voice_streaming() || beep_morse_busy() ||
+	    (len != 0 && morse_units(text, len) == 0) || beep_level_now(sm) == 0) {
+		sm->view.cw.refused = true;
+		return;
+	}
+	beep_morse(text, len, sm->view.cw.wpm, sm->view.cw.pitch_hz, beep_level_now(sm));
+	sm->view.cw.preview = beep_morse_busy();
+	sm->cw_audio_guard = sm->cw_audio_guard || sm->view.cw.preview;
+	sm->view.cw.refused = !sm->view.cw.preview;
+}
+
+void radio_sm_cw_text(radio_sm_t *sm, const char *text, uint8_t len, uint32_t control)
+{
+#if CONFIG_MONITOR_SCAN
+	if (sm->monitor_session.owns_rx)
+		return;
+#endif
+	cw_tool_config(sm, control);
+	if (text != NULL && len != 0 && len <= MORSE_TEXT_MAX)
+		cw_tool_preview(sm, text, len);
+	else
+		sm->view.cw.refused = true;
+	changed(sm);
+}
+
+static void cw_tool_request(radio_sm_t *sm, uint32_t control)
+{
+	cw_tool_config(sm, control);
+	sm->view.cw.refused = false;
+	switch ((uint8_t)control) {
+	case CW_CONFIG:
+		break;
+	case CW_RX_START:
+		if (cw_tool_available(sm)) {
+			sm->cw_hz = sm->view.ch.rx_hz;
+			cw_rx_init(&sm->cw_envelope, sm->view.cw.wpm, CW_ENVELOPE_DBM);
+			sm->view.cw.text[0] = '\0';
+			sm->view.cw.evidence = false;
+			sm->view.cw.active = true;
+		} else {
+			sm->view.cw.refused = true;
+		}
+		break;
+	case CW_RX_STOP:
+		sm->view.cw.active = false;
+		sm->view.cw.evidence = false;
+		break;
+	case CW_CANCEL:
+		cw_tool_stop(sm);
+		return;
+	case CW_KEY_ARM:
+		if (sm->view.cw.key_armed) {
+			sm->view.cw.key_armed = false;
+			beep_morse_cancel();
+			sm->view.cw.preview = false;
+		} else if (cw_tool_available(sm)) {
+			sm->view.cw.key_armed = true;
+		} else {
+			sm->view.cw.refused = true;
+		}
+		break;
+	case CW_KEY_DOWN:
+		cw_tool_preview(sm, "", 0);
+		break;
+	case CW_KEY_UP:
+		beep_morse_cancel();
+		sm->view.cw.preview = false;
+		break;
+	case CW_PREVIEW_CQ:
+		cw_tool_preview(sm, "CQ CQ", 5);
+		break;
+	case CW_PREVIEW_73:
+		cw_tool_preview(sm, "73", 2);
+		break;
+	case CW_PREVIEW_CALL: {
+		char name[CODEPLUG_NAME_LEN + 1u];
+		codeplug_radio_name(name);
+		uint8_t len = 0;
+		while (len < CODEPLUG_NAME_LEN && name[len] != '\0')
+			len++;
+		if (len != 0)
+			cw_tool_preview(sm, name, len);
+		else
+			sm->view.cw.refused = true;
+		break;
+	}
+	default:
+		sm->view.cw.refused = true;
+		break;
+	}
+	changed(sm);
+}
+
+static void cw_tool_tick(radio_sm_t *sm, uint32_t now_ms)
+{
+	if (sm->cw_audio_guard && !permit_busy() && !beep_streaming())
+		sm->cw_audio_guard = false;
+	if (!cw_tool_in_use(sm))
+		return;
+	if (!cw_tool_available(sm) || (sm->view.cw.active && sm->cw_hz != sm->view.ch.rx_hz)) {
+		cw_tool_stop(sm);
+		return;
+	}
+	if (sm->view.cw.preview && !beep_morse_busy()) {
