+static void test_cw_rssi_edges(void)
+{
+	struct cw_rx rx;
+	CHECK(!cw_rx_init(&rx, 41, -105));
+	CHECK(!cw_rx_init(&rx, 20, -25));
+	CHECK(cw_rx_init(&rx, 20, -105));
+	// A dot across the tick wrap. The mark stays asserted in the 6 dB hysteresis band.
+	uint32_t begin = UINT32_MAX - 25u;
+	CHECK(cw_rx_sample(&rx, begin - 10u, -130, true) == 0);
+	CHECK(cw_rx_sample(&rx, begin, -90, true) == 0);
+	for (unsigned elapsed = 10; elapsed < 60; elapsed += 10)
+		CHECK(cw_rx_sample(&rx, begin + elapsed, -109, true) == 0);
+	CHECK(cw_rx_sample(&rx, begin + 60u, -130, true) == 0);
+	for (unsigned elapsed = 70; elapsed < 210; elapsed += 10)
+		CHECK(cw_rx_sample(&rx, begin + elapsed, -130, true) == 0);
+	CHECK(cw_rx_sample(&rx, begin + 210u, -130, true) == 'E');
+	CHECK(!cw_rx_evidence(&rx));
+	CHECK(cw_rx_sample(&rx, begin + 220u, -90, true) == 0);
+	CHECK(cw_rx_sample(&rx, begin + 300u, -130, true) == 0); // samples went missing
+	for (unsigned elapsed = 310; elapsed < 500; elapsed += 10)
+		CHECK(cw_rx_sample(&rx, begin + elapsed, -130, true) == 0);
+	CHECK(!cw_rx_evidence(&rx));
+}
+
+static void test_cw_tool(void)
+{
+	static const uint8_t speeds[] = { 5, 20, 40 };
+	static const char message[] = "CQ 73";
+	setup_codeplug();
+	start();
+	uint32_t hz = hw.rx_hz;
+	for (unsigned i = 0; i < sizeof speeds; i++) {
+		uint8_t wpm = speeds[i];
+		req(RREQ_CW_TOOL, (int32_t)cw_control_arg(wpm, 650, CW_RX_START));
+		CHECK(sm.view.cw.active && sm.view.cw.wpm == wpm && sm.view.cw.pitch_hz == 650);
+		morse_t sender;
+		morse_start(&sender, message, sizeof message - 1u, wpm, now + 300);
+		uint32_t end = now + 400u + (morse_units(message, sizeof message - 1u) + 8u) * sender.dot_ms;
+		while (now < end) {
+			hw.st.rssi_dbm = morse_poll(&sender, now) ? -75 : -130;
+			radio_sm_tick(&sm, now);
+			now += RADIO_TICK_MS;
+		}
+		CHECK(strncmp(sm.view.cw.text, message, sizeof message - 1u) == 0);
+		CHECK(sm.view.cw.evidence && hw.rx_hz == hz && !hw.keyed);
+		req(RREQ_CW_TOOL, CW_RX_STOP);
+		CHECK(!sm.view.cw.active && hw.rx_hz == hz);
+	}
+
+	// A carrier which never keys off does not yield Morse evidence. PTT exits the receive tool.
+	req(RREQ_CW_TOOL, CW_RX_START);
+	hw.st.rssi_dbm = -70;
+	run(2000);
+	CHECK(sm.view.cw.active && !sm.view.cw.evidence && sm.view.cw.text[0] == '\0');
+	int tx_calls = hw.tx_calls;
+	req(RREQ_PTT, 1);
+	req(RREQ_PTT, 0);
+	CHECK(!sm.view.cw.active && hw.tx_calls == tx_calls && hw.rx_hz == hz);
+
+	// The monitor button is only a local manual key while this tool has armed it.
+	req(RREQ_CW_TOOL, CW_KEY_ARM);
+	CHECK(sm.view.cw.key_armed);
+	req(RREQ_MONITOR, 1);
+	CHECK(sm.view.cw.preview && aud.started && !hw.keyed);
+	int16_t mic[AUDIO_BLOCK_SAMPLES] = {0}, spk[AUDIO_BLOCK_SAMPLES];
+	aud.cb(mic, spk, aud.ctx);
+	aud.cb(mic, spk, aud.ctx);
+	bool audible = false;
+	for (unsigned i = 0; i < AUDIO_BLOCK_SAMPLES; i++)
+		audible = audible || spk[i] != 0;
+	CHECK(audible);
+	req(RREQ_MONITOR, 0);
+	aud.cb(mic, spk, aud.ctx);
+	for (unsigned i = 0; i < AUDIO_BLOCK_SAMPLES; i++)
+		CHECK(spk[i] == 0);
+	CHECK(!sm.view.cw.preview && hw.tx_calls == tx_calls);
+
+	// Arbitrary text shares the local speaker path and is interrupted before ordinary PTT can key RF.
+	radio_sm_cw_text(&sm, "QTH", 3, cw_control_arg(30, 1000, CW_PREVIEW_TEXT));
+	CHECK(sm.view.cw.preview && sm.view.cw.wpm == 30 && sm.view.cw.pitch_hz == 1000);
+	req(RREQ_PTT, 1);
+	req(RREQ_PTT, 0);
+	CHECK(!sm.view.cw.key_armed && !sm.view.cw.preview && hw.tx_calls == tx_calls && hw.rx_hz == hz);
+	CHECK(sm.cw_audio_guard);
+	req(RREQ_PTT, 1);
+	req(RREQ_PTT, 0);
