diff --git a/core/radio/cw_rx.c b/core/radio/cw_rx.c
new file mode 100644
index 0000000..c04d3d1
--- /dev/null
+++ b/core/radio/cw_rx.c
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "radio/cw_rx.h"
+#include "radio/morse.h"
+
+#define RSSI_HYSTERESIS_DB 6
+
+bool cw_rx_init(struct cw_rx *rx, unsigned wpm, int16_t threshold_dbm)
+{
+	*rx = (struct cw_rx){ 0 };
+	if (wpm < MORSE_WPM_MIN || wpm > MORSE_WPM_MAX || threshold_dbm < -150 || threshold_dbm > -30)
+		return false;
+	rx->dot_ms = morse_dot_ms((uint8_t)wpm);
+	rx->threshold_dbm = threshold_dbm;
+	rx->code = 1;
+	return true;
+}
+
+static void reset_letter(struct cw_rx *rx)
+{
+	rx->code = 1;
+	rx->marks = 0;
+	rx->letters = 0;
+	rx->word_pending = false;
+}
+
+static char letter(uint8_t code)
+{
+	static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/-=?.,";
+	for (unsigned i = 0; alphabet[i] != '\0'; i++) {
+		if (morse_code(alphabet[i]) == code)
+			return alphabet[i];
+	}
+	return 0;
+}
+
+static char idle(struct cw_rx *rx, uint32_t units)
+{
+	if (rx->code > 1 && units >= 25u) {
+		uint8_t code = rx->code;
+		char c = letter(code);
+		rx->code = 1;
+		if (c == 0) {
+			reset_letter(rx);
+		} else {
+			if (rx->letters < UINT8_MAX)
+				rx->letters++;
+			uint8_t marks = 0;
+			for (; code > 1; code >>= 1)
+				marks++;
+			rx->marks = rx->marks > UINT8_MAX - marks ? UINT8_MAX : (uint8_t)(rx->marks + marks);
+			rx->word_pending = true;
+		}
+		return c;
+	}
+	if (rx->word_pending && units >= 65u) {
+		rx->word_pending = false;
+		return ' ';
+	}
+	return 0;
+}
+
+char cw_rx_sample(struct cw_rx *rx, uint32_t now_ms, int16_t rssi_dbm, bool valid)
+{
+	if (rx->dot_ms == 0)
+		return 0;
+	if (!valid || now_ms - rx->sampled_at > rx->dot_ms / 2u) {
+		rx->initialized = false;
+		reset_letter(rx);
+	}
+	if (!valid)
+		return 0;
+	rx->sampled_at = now_ms;
+	bool keyed = rssi_dbm >= rx->threshold_dbm - (rx->keyed && rx->initialized ? RSSI_HYSTERESIS_DB : 0);
+	if (!rx->initialized) {
+		rx->initialized = true;
+		rx->keyed = keyed;
+		rx->edge_at = now_ms;
+		rx->complete_mark = false;
+		return 0;
+	}
+	uint32_t span = now_ms - rx->edge_at;
+	// Clamp long idle spans before converting to tenths of a dot.
+	uint32_t units = span > 10u * rx->dot_ms ? 100u : span * 10u / rx->dot_ms;
+	if (keyed == rx->keyed)
+		return keyed ? 0 : idle(rx, units);
+	rx->keyed = keyed;
+	rx->edge_at = now_ms;
+	if (keyed) {
+		char c = idle(rx, units);
+		// Noise bursts separated by a gap below half a dot invalidate the current letter.
+		if (rx->code > 1 && units < 5u)
+			reset_letter(rx);
+		rx->complete_mark = true;
+		return c;
+	}
+	if (!rx->complete_mark)
+		return 0;
+	bool dash = units >= 23u && units <= 40u;
+	bool dot = units >= 5u && units <= 17u;
+	if ((!dot && !dash) || rx->code >= 64u) {
+		reset_letter(rx);
+		return 0;
+	}
+	rx->code = (uint8_t)(rx->code << 1 | (dash ? 1u : 0u));
+	return 0;
+}
+
+bool cw_rx_evidence(const struct cw_rx *rx)
+{
+	return rx->letters >= 2 && rx->marks >= 4;
+}
diff --git a/core/radio/cw_rx.h b/core/radio/cw_rx.h
new file mode 100644
index 0000000..a198382
--- /dev/null
+++ b/core/radio/cw_rx.h
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef RADIO_CW_RX_H
+#define RADIO_CW_RX_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+// RF envelope decoding for keyed carriers using fresh, unsmoothed RSSI.
+// It neither recovers a BFO beat nor distinguishes the source of keying.
+struct cw_rx {
+	uint32_t sampled_at;
+	uint32_t edge_at;
+	int16_t threshold_dbm;
+	uint16_t dot_ms;
+	uint8_t code;
+	uint8_t letters;
+	uint8_t marks;
+	bool initialized;
+	bool keyed;
+	bool complete_mark;
+	bool word_pending;
+};
+
+bool cw_rx_init(struct cw_rx *rx, unsigned wpm, int16_t threshold_dbm);
+// Returns a letter, a word separator, or zero. Invalid samples break continuity.
+char cw_rx_sample(struct cw_rx *rx, uint32_t now_ms, int16_t rssi_dbm, bool valid);
+bool cw_rx_evidence(const struct cw_rx *rx);
+
+#endif
