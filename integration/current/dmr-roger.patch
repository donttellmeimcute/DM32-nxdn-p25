diff --git a/core/radio/beep.c b/core/radio/beep.c
--- a/core/radio/beep.c
+++ b/core/radio/beep.c
@@ -29,6 +29,10 @@
 static const beep_seg_t p_permit[] = { { 1568, 40 }, { 1047, 40 }, { 1568, 40 }, { 1319, 40 } };
 static const beep_seg_t p_permit_dv[] = { { 910, 70 }, { 0, 20 }, { 910, 30 }, { 0, 20 }, { 910, 60 } };
 static const beep_seg_t p_deny[] = { { 300, 400 } };
+#if CONFIG_DMR
+// A descending chirp for PTT release, using the notes from the DMR permit.
+static const beep_seg_t p_dmr_roger[] = { { 1568, 40 }, { 1319, 40 }, { 1047, 60 } };
+#endif
 static const beep_seg_t p_call_end[] = { { 1200, 50 }, { 0, 30 }, { 900, 70 } };
 static const beep_seg_t p_tot[] = { { 1000, 100 }, { 0, 100 }, { 1000, 100 } };
 static const beep_seg_t p_batt_low[] = { { 800, 150 }, { 0, 100 }, { 600, 200 } };
@@ -57,6 +61,9 @@
 	[BEEP_TX_PERMIT] = PAT(p_permit),
 	[BEEP_TX_DENY] = PAT(p_deny),
 	[BEEP_CALL_END] = PAT(p_call_end),
+#if CONFIG_DMR
+	[BEEP_DMR_ROGER] = PAT(p_dmr_roger),
+#endif
 	[BEEP_TOT_WARN] = PAT(p_tot),
 	[BEEP_BATTERY_LOW] = PAT(p_batt_low),
 	[BEEP_BATTERY_CRIT] = PAT(p_batt_crit),
diff --git a/core/radio/radio_sm.c b/core/radio/radio_sm.c
--- a/core/radio/radio_sm.c
+++ b/core/radio/radio_sm.c
@@ -2181,6 +2181,9 @@
 	sfr_rpt_end(sm);
 #endif
 	dmr_call_ptt(false);
+#if CONFIG_BEEP
+	sm->dmr_roger_pending = false;
+#endif
 	dmr_call_stop();
 	ambeVoiceStop();
 	if (sm->dmr_keyed) {
@@ -2423,6 +2426,11 @@
 			sm->ts_pending = 0;	// taken or refused now, never left for a later transmission
 			dmr_set_timeslot(sm, ts, sm->hotspot);
 		}
+#if CONFIG_BEEP
+		if (sm->dmr_roger_pending && cv->tx_error == DMR_TX_OK && !sm->view.ch.no_beep)
+			beep(sm, BEEP_DMR_ROGER);
+		sm->dmr_roger_pending = false;
+#endif
 		if (cv->tx_error == DMR_TX_ERR_NO_REPEATER && !data) {	// a data sender hears about its own failure
 			// A short press goes on waking the repeater after the release: its failure still gets the deny tone and
 			// the deny flash
@@ -2598,6 +2606,9 @@
 		}
 		sm->dmr_keyed = true;
 	}
+#if CONFIG_BEEP
+	sm->dmr_roger_pending = false;
+#endif
 	one_shot_start(sm);
 	sm->view.state = RS_TX;
 	sm->view.tx_auto = false;
@@ -7261,6 +7272,10 @@
 #endif
 #if CONFIG_DMR
 	if (sm->dmr_running) {
+#if CONFIG_BEEP
+		sm->dmr_roger_pending = roger && sm->set.dmr_roger && !sm->view.tx_auto &&
+				       dmr_call_view()->phase == DMR_CALL_PHASE_TX_VOICE;
+#endif
 		dmr_call_ptt(false);
 		dmr_call_poll(now_ms);
 		if (sm->view.state == RS_TX) {
@@ -8119,6 +8134,7 @@
 	s->tot_warn_s = st->rs_tot_warn_s;
 	s->bcl = st->rs_bcl;
 	s->roger_beep = (st->rs_flags & SETTINGS_RS_ROGER_BEEP) != 0;
+	s->dmr_roger = (st->rs_flags & SETTINGS_RS_DMR_ROGER) != 0;
 	s->tx_inhibit = (st->rs_flags & SETTINGS_RS_TX_INHIBIT) != 0;
 	s->scan_priority = (st->rs_flags & SETTINGS_RS_SCAN_PRIORITY) != 0;
 	s->scan_beep = (st->rs_flags & SETTINGS_RS_SCAN_BEEP) != 0;
@@ -8153,7 +8169,8 @@
 	st->rs_flags = (uint8_t)((s->roger_beep ? SETTINGS_RS_ROGER_BEEP : 0) | (s->tx_inhibit ? SETTINGS_RS_TX_INHIBIT : 0) |
 				 (s->scan_priority ? SETTINGS_RS_SCAN_PRIORITY : 0) |
 				 (s->scan_beep ? SETTINGS_RS_SCAN_BEEP : 0) | (s->key_beep ? SETTINGS_RS_KEY_BEEP : 0) |
-				 (s->talk_permit ? 0 : SETTINGS_RS_NO_TALK_PERMIT) | SETTINGS_RS_SCAN_DWELL_SET);
+				 (s->talk_permit ? 0 : SETTINGS_RS_NO_TALK_PERMIT) | SETTINGS_RS_SCAN_DWELL_SET |
+				 (s->dmr_roger ? SETTINGS_RS_DMR_ROGER : 0));
 	st->rs_scan_resume = s->scan_resume;
 	st->rs_scan_hold_s = s->scan_hold_s;
 	st->rs_scan_delay_ms = s->scan_delay_ms;
