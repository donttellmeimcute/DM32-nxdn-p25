diff --git a/drivers/cal/baofeng/baofeng_cal.c b/drivers/cal/baofeng/baofeng_cal.c
index 9deadd4..5515a7a 100644
--- a/drivers/cal/baofeng/baofeng_cal.c
+++ b/drivers/cal/baofeng/baofeng_cal.c
@@ -209,6 +209,13 @@ uint16_t bf_cal_modcal(uint32_t hz)
 	if (b > 0xFFu) {
 		b = 0xFFu;
 	}
+	// UHF TX deviation trim, UHF only: a Pluto capture at 435 MHz on 2026-11-20 (YSF DN Narrow, 273 ms,
+	// 284 symbol centers, quality 65%) measured outer 1508 Hz against the 1350 Hz nominal (1.117x), and UHF
+	// reads high in every mode, so the error sits in the shared UHF calibration (K_UHF), not in any one
+	// mode's scaling -- VHF measures clean with the same ratios. 1350/1508 = 0.895 = 179/200.
+	if (hz > 299999990u) {
+		b = (b * 179u + 100u) / 200u;
+	}
 	return (uint16_t)(b << 8 | b);
 }
 
diff --git a/tests/host/baofengCalTest.c b/tests/host/baofengCalTest.c
