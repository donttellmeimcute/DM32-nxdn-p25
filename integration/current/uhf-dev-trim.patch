+	CHECK(bf_cal_modcal(435000000u) == 0x4545);		// 33479 / 435 = 76.96 -> 77, UHF trim x179/200 -> 69
+	CHECK(bf_cal_modcal(145000000u) == 0x6B6B);		// 15480 / 145 = 106.8 -> 107, VHF untrimmed
+	// The trim is a factor on the UHF branch only: 400/470 MHz scale the same way, VHF is untouched
+	CHECK(bf_cal_modcal(400000000u) == 0x4B4B);		// 33479 / 400 = 83.7 -> 84, x179/200 -> 75
+	CHECK(bf_cal_modcal(470000000u) == 0x4040);		// 33479 / 470 = 71.2 -> 71, x179/200 -> 64
+	CHECK(bf_cal_modcal(299999990u) == 0x3434);		// just below the split: VHF branch, untrimmed
