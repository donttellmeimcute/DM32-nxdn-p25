diff --git a/core/radio/mic_gain_pcm.h b/core/radio/mic_gain_pcm.h
index 38a3e6c..2f9262c 100644
--- a/core/radio/mic_gain_pcm.h
+++ b/core/radio/mic_gain_pcm.h
@@ -4,10 +4,10 @@
 
 #include "radio/mic_gain.h"
 
-// The manual microphone gain steps in Q8, 2 dB per step and unity at step 5.
+// Software AMBE gain in Q8. The top two steps add 12 and 16 dB for quiet microphones.
 static inline uint16_t mic_gain_step_q8(uint8_t step)
 {
-	static const uint16_t q8[MIC_GAIN_STEPS + 1] = { 81, 102, 128, 161, 203, 256, 322, 406, 511, 643, 810 };
+	static const uint16_t q8[MIC_GAIN_STEPS + 1] = { 81, 102, 128, 161, 203, 256, 322, 406, 511, 1019, 1615 };
 	return q8[step > MIC_GAIN_STEPS ? MIC_GAIN_STEPS : step];
 }
 
