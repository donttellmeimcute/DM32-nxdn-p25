+// A direct Group/CQ transmission uses ten asterisks on the air, as a Yaesu
+// radio does. "ALL" is the CPS/display spelling, not the CSD1 wire value.
+static void testTxGroupDest(void)
+{
+	static const uint8_t modes[] = { YSF_DT_VD_MODE1, YSF_DT_VD_MODE2, YSF_DT_VOICE_FR };
+
+	for (unsigned m = 0; m < sizeof modes; m++) {
+		ysf_tx_config c;
+		make_tx_cfg(&c, modes[m]);
+		c.data = NULL;
+		c.voice = NULL;
+		memcpy(c.dest, "ALL       ", 10);
+		for (unsigned fn = 0; fn < 10; fn += 9) {
+			uint8_t frame[YSF_FRAME_BYTES], dch[20];
+			ysf_fich f;
+			unsigned len = 0;
+			CHECK(ysf_tx_frame_build(&c, fn, frame) && ysf_frame_decode(frame, &f, dch, NULL, &len),
+			      "group header/terminator mode %u frame %u", modes[m], fn);
+			CHECK(len == 20 && !memcmp(dch, "**********SRC       ", 20),
+			      "group CSD1 mode %u frame %u", modes[m], fn);
+		}
+		if (modes[m] != YSF_DT_VOICE_FR) {
+			uint8_t frame[YSF_FRAME_BYTES], dch[20];
+			ysf_fich f;
+			unsigned len = 0;
+			unsigned fn = modes[m] == YSF_DT_VD_MODE2 ? 2 : 1;
+			CHECK(ysf_tx_frame_build(&c, fn, frame) && ysf_frame_decode(frame, &f, dch, NULL, &len),
+			      "group communication mode %u", modes[m]);
+			CHECK((modes[m] == YSF_DT_VD_MODE2 && len == 10 && !memcmp(dch, "SRC       ", 10)) ||
+			      (modes[m] == YSF_DT_VD_MODE1 && len == 20 && !memcmp(dch, "**********SRC       ", 20)),
+			      "group communication callsign mode %u", modes[m]);
+		}
+	}
+
+	// An explicitly addressed individual call must not be rewritten.
+	ysf_tx_config c;
+	make_tx_cfg(&c, YSF_DT_VD_MODE2);
+	c.cm = YSF_CM_INDIVIDUAL;
+	memcpy(c.dest, "ALL       ", 10);
+	uint8_t frame[YSF_FRAME_BYTES], dch[20];
+	ysf_fich f;
+	unsigned len = 0;
+	CHECK(ysf_tx_frame_build(&c, 0, frame) && ysf_frame_decode(frame, &f, dch, NULL, &len) &&
+	      len == 20 && !memcmp(dch, "ALL       SRC       ", 20), "individual destination unchanged");
+}
