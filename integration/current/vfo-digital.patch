+bool ui_svc_vfo_mode(uint8_t mode, uint8_t variant)
+{
+	if (mode == RADIO_MODE_NXDN)
+		view.ch.vfo_digital = (uint8_t)((view.ch.vfo_digital & ~VFO_DIG_NXDN_MASK) | variant);
+	if (mode == RADIO_MODE_YSF)
+		view.ch.vfo_digital = (uint8_t)((view.ch.vfo_digital & ~VFO_DIG_YSF_MASK) | (variant << 2));
+#if CONFIG_NXDN
+	if (mode == RADIO_MODE_NXDN)
+		view.nxdn.flags = variant == VFO_VARIANT_SECOND ? RADIO_NXDN_9600 : 0;
+#endif
+#if CONFIG_YSF
+	if (mode == RADIO_MODE_YSF)
+		view.ysf.flags = variant == VFO_VARIANT_SECOND ? RADIO_YSF_NARROW : 0;
+#endif
+	return ui_svc_mode(mode);
+}
+#if CONFIG_AIR_AES
+bool ui_svc_vfo_aes(uint8_t mode, int32_t kid)
+{
+	if (!view.vfo || mode != view.ch.mode)
+		return false;
+	if (mode == RADIO_MODE_DMR) {
+		view.ch.dmr_aes_kid = kid < 0 ? 0 : (uint8_t)kid;
+		view.ch.vfo_digital &= ~VFO_DIG_DMR_OFF;
+		if (kid == -1)
+			view.ch.vfo_digital |= VFO_DIG_DMR_OFF;
+	} else if (mode == RADIO_MODE_P25) {
+		view.ch.vfo_digital &= ~VFO_DIG_P25_AES;
+		if (kid >= 0) {
+			view.ch.vfo_digital |= VFO_DIG_P25_AES;
+			view.ch.vfo_p25_kid = (uint16_t)kid;
+		}
+	} else if (mode == RADIO_MODE_NXDN) {
+		view.ch.vfo_nxdn_key = (uint8_t)(kid + 1);
+	} else {
+		return false;
+	}
+	changed();
+	return true;
+}
+#endif
