+static void test_dm32_fm_squelch(void)
+{
+	static const struct { uint32_t hz; uint8_t signal, idle; } cases[] = {
+		{ 146520000u, 42, 52 }, { 446000000u, 34, 43 },
+	};
+	for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+		setup_codeplug();
+		chans[1].rx_hz = chans[1].tx_hz = cases[i].hz;
+		start();
+		rx_signal(fd6818_dm32_fm_noise(cases[i].idle, cases[i].hz), true);
+		poll_for(RADIO_POLL_MS);
+		CHECK(sm.view.state == RS_IDLE && !hw.audio);
+		CHECK(fd6818_noise(cases[i].signal) >= radio_sm_squelch_open_below(sm.view.squelch));
+		rx_signal(fd6818_dm32_fm_noise(cases[i].signal, cases[i].hz), true);
+		poll_for(RADIO_POLL_MS);
+		CHECK(sm.view.squelch == RADIO_SQUELCH_DEFAULT && sm.view.state == RS_RX && hw.audio);
+		rx_signal(fd6818_dm32_fm_noise(cases[i].idle, cases[i].hz), true);
+		poll_for(RADIO_SQL_CLOSE_POLLS * RADIO_POLL_MS);
+		CHECK(sm.view.state == RS_IDLE && !hw.audio);
+	}
+	setup_codeplug();
+}
