diff --git a/drivers/rf/fd6818/fd6818.h b/drivers/rf/fd6818/fd6818.h
index af3ec22..dcd5f89 100644
--- a/drivers/rf/fd6818/fd6818.h
+++ b/drivers/rf/fd6818/fd6818.h
@@ -166,6 +166,21 @@ static inline uint8_t fd6818_noise_plus(uint16_t r65, uint8_t offset)
 }
 static inline uint8_t fd6818_noise(uint16_t r65) { return fd6818_noise_plus(r65, FD6818_NOISE_OFFSET); }
 
+// Normalize the two normal FM bands to the core's squelch levels. The no-signal reference maps to 68, above
+// the level-1 close line. A quieter reading gains two core units for each raw unit below that reference.
+static inline uint8_t fd6818_dm32_fm_noise(uint16_t r65, uint32_t hz)
+{
+	int floor;
+	if (hz >= 136000000u && hz <= 174000000u)
+		floor = 52;	// below the lowest reported VHF idle noise
+	else if (hz >= 400000000u && hz <= 480000000u)
+		floor = 43;	// conservative UHF idle reference
+	else
+		return fd6818_noise(r65);
+	int noise = 68 + 2 * ((int)(r65 & 0xFFu) - floor);
+	return (uint8_t)(noise < 0 ? 0 : noise > UINT8_MAX ? UINT8_MAX : noise);
+}
