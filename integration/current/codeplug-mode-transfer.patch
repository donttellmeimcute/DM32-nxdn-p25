+import { areaForWrite } from "../static/js/codeplug/kv.js";
+import { channelModeRecord } from "../static/js/codeplug/channelmodes.js";
+
+test("YSF: writing an unchanged saved codeplug carries the channel tag and source callsign", () => {
+	const base = encode(ysfSample().m);
+	const file = encode(decode(base));
+	const radio = CodeplugImage.blank();
+	putArea(radio.bytes, [
+		{ key: 0x7001, value: Uint8Array.of(0xAB) },
+		{ key: MODE_KEY.tag + 2, value: Uint8Array.of(6, 0xFF, 0, 0, 0) },
+	]);
+	areaForWrite(file.bytes, radio.bytes, base.bytes, channelModeRecord);
+	const restored = decode(file);
+	assert.equal(restored.channels[0].kind, 6);
+	assert.equal(restored.channels[0].params.txDgid, 5);
+	assert.equal(restored.modeSettings[6].src, "XE1ARS");
+	assert.deepEqual(getValue(area(file), 0x7001), Uint8Array.of(0xAB));
+	assert.equal(getValue(area(file), MODE_KEY.tag + 2), null);
+});
