+static void test_bench_tx_band(void)
+{
+	start();
+	CHECK(!board_in_band(219999999, true) && board_in_band(220000000, true));
+	CHECK(board_in_band(225000000, true) && !board_in_band(225000001, true));
+	CHECK(!radio_sm_hotspot_freq_ok(223500000, 223500000));
+
+	req(RREQ_VFO_SET, 223500000);
+	run(100);
+	CHECK(sm.view.vfo && hw.rx_hz == 223500000);
+	ptt(true);
+	CHECK(sm.view.state == RS_TX && hw.tx_calls == 1 && hw.tx_hz == 223500000);
+	ptt(false);
+
+	req(RREQ_MODE, RADIO_MODE_DMR);
+	run(100);
+	CHECK(sm.view.ch.mode == RADIO_MODE_DMR);
+	ptt(true);
+	CHECK(sm.view.state == RS_TX_DENIED && sm.view.tx_deny == TXDENY_MODE && hw.tx_calls == 1);
+	ptt(false);
+
+	req(RREQ_MODE, RADIO_MODE_FM);
+	req(RREQ_VFO_SET, 220000000);
+	run(100);
+	CHECK(hw.rx_hz == 220000000);
+	ptt(true);
+	CHECK(sm.view.state == RS_TX && hw.tx_calls == 2 && hw.tx_hz == 220000000);
+	ptt(false);
+
+	chans[3].rx_hz = chans[3].tx_hz = 225000000;
+	req(RREQ_ZONE_POS, 2);
+	run(100);
+	ptt(true);
+	CHECK(sm.view.state == RS_TX && hw.tx_calls == 3 && hw.tx_hz == 225000000);
+	ptt(false);
+
+	req(RREQ_VFO_SET, 225012500);
+	run(100);
+	CHECK(hw.rx_hz == 225012500);
+	ptt(true);
+	CHECK(sm.view.state == RS_TX_DENIED && sm.view.tx_deny == TXDENY_BAND && hw.tx_calls == 3);
+	ptt(false);
+}
