+bool ui_svc_ysf_dt(uint8_t dt)
+{
+#if CONFIG_YSF
+	radio_get_view(&ui_svc_view);
+	if (!ui_svc_view.vfo || ui_svc_view.hotspot || ui_svc_view.ch.mode != RADIO_MODE_YSF ||
+	    (dt != YSF_DT_VD_MODE1 && dt != YSF_DT_VD_MODE2 &&
+	     !(CONFIG_P25 && CONFIG_IMBE && dt == YSF_DT_VOICE_FR)))
+		return false;
+	radio_ysf_settings_t s = { .dt = dt };
+	radio_req_ysf_quick(&s, RADIO_YSF_QUICK_DT);
+	return true;
+#else
+	(void)dt;
+	return false;
+#endif
+}
