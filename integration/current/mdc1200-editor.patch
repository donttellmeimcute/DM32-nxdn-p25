diff --git a/site/tests/csv.test.mjs b/site/tests/csv.test.mjs
index 0f6a137..bc902cb 100644
--- a/site/tests/csv.test.mjs
+++ b/site/tests/csv.test.mjs
@@ -167,3 +167,87 @@ test("unknown headers are listed, and a file of no table is refused", () => {
 	assert.equal(detect("Foo,Bar\n1,2\n"), null);
 	assert.throws(() => importTable(m, "Foo,Bar\n1,2\n"), { code: "not_a_table" });
 });
+
+// An FM channel's signaling ID (open-firmware-cps.md 7.3.3.2; the multi-mode derivative)
+test("FM signaling ID: record layout, CSV round trip, the other modes keep their own ID", async () => {
+	const { encodeChannel, decodeChannel, blankChannel } = await import("../static/js/codeplug/records.js");
+	// none: the bytes a channel without its own ID has
+	const plain = encodeChannel(newChannel({ name: "FM" }), blankChannel());
+	assert.deepEqual([plain[0x26] & 0x80, plain[0x27], plain[0x28], plain[0x29]], [0, 0x00, 0x16, 0x00]);
+	assert.deepEqual([decodeChannel(plain).aniType, decodeChannel(plain).aniId], [0, 0]);
+	// MDC-1200, ID 1A2B, sent at the start and the end
+	const mdc = newChannel({ name: "Dispatch", rxHz: 155475000, txHz: 155475000, aniType: 1, aniSend: 3, aniId: 0x1A2B });
+	const r = encodeChannel(mdc, blankChannel());
+	assert.deepEqual([r[0x26] & 0x80, r[0x27], r[0x28], r[0x29]], [0x80, 0xB1, 0x1A, 0x2B]);
+	const back = decodeChannel(r);
+	assert.deepEqual([back.aniType, back.aniSend, back.aniDecode, back.aniId, back.dmrId], [1, 3, false, 0x1A2B, 0]);
+	// the decode option is kept as it is
+	r[0x27] = 0xD1;
+	const dec = decodeChannel(r);
+	assert.deepEqual([dec.aniSend, dec.aniDecode], [1, true]);
+	assert.equal(encodeChannel(dec, r)[0x27], 0xD1);
+	// a type this version doesn't know reads as none, and its bytes stay as they are (saved again, they are written back);
+	// a DMR ID left on an FM channel is not a signaling ID and stays
+	r[0x27] = 0x97;
+	assert.deepEqual([decodeChannel(r).aniType, decodeChannel(r).dmrId], [0, 0x971A2B]);
+	assert.deepEqual([...encodeChannel(decodeChannel(r), r).slice(0x27, 0x2A)], [0x97, 0x1A, 0x2B]);
+	r.set([0x2F, 0x7D, 0x99], 0x27);
+	const left = decodeChannel(r);
+	assert.deepEqual([left.aniType, left.dmrId], [0, 0x2F7D99]);
+	assert.deepEqual([...encodeChannel(left, r).slice(0x27, 0x2A)], [0x2F, 0x7D, 0x99]);
+	// a kind's unit ID of 0x800000 or more reads as a signaling ID; channelmodes.js gives the bytes back as the number
+	// they were (a P25 or NXDN channel keeps its unit ID there)
+	const { aniByte } = await import("../static/js/codeplug/records.js");
+	r.set([0x91, 0x1A, 0x2B], 0x27);
+	const unit = decodeChannel(r);
+	assert.deepEqual([unit.aniType, unit.aniSend, unit.dmrId], [1, 1, 0]);
+	assert.equal(((aniByte(unit) << 16) | unit.aniId) >>> 0, 0x911A2B);
+	// a DMR channel's ID is its own: the FM fields are not written there
+	const dmr = encodeChannel({ ...mdc, mode: "dmr", dmrId: 3112345 }, blankChannel());
+	assert.deepEqual([...dmr.slice(0x27, 0x2A)], [0x2F, 0x7D, 0x99]);
+	assert.equal(decodeChannel(dmr).aniType, 0);
+
+	const m = empty();
+	m.channels.push({ ...mdc, number: 1 }, newChannel({ name: "FM", number: 2 }));
+	const text = exportTable(m, "channels");
+	const rows = parse(text);
+	const col = (row, name) => row[rows[0].indexOf(name)];
+	assert.deepEqual([col(rows[1], "ID Type"), col(rows[1], "Send ID"), col(rows[1], "MDC ID")], ["MDC-1200", "Both", "1A2B"]);
+	assert.deepEqual([col(rows[1], "Decode ID"), col(rows[2], "Decode ID")], ["No", ""]);
+	assert.deepEqual([col(rows[2], "ID Type"), col(rows[2], "Send ID"), col(rows[2], "MDC ID")], ["", "", ""]);
+	const n = empty();
+	assert.deepEqual(importTable(n, text).problems, []);
+	assert.deepEqual([n.channels[0].aniType, n.channels[0].aniSend, n.channels[0].aniId], [1, 3, 0x1A2B]);
+	assert.equal(n.channels[1].aniType, 0);
+	// typed by hand: the words in any case, the ID in hex; a blank cell keeps the value
+	const typed = empty();
+	const ok = importTable(typed, "Name,RX Frequency (MHz),ID Type,Send ID,MDC ID\nA,155.475,mdc-1200,start,beef\nB,155.475,,,\n");
+	assert.deepEqual(ok.problems, []);
+	// decode alone: a channel that only listens for IDs needs none of its own
+	const listen = empty();
+	assert.deepEqual(importTable(listen, "Name,RX Frequency (MHz),ID Type,Decode ID\nL,155.475,MDC-1200,yes\n").problems, []);
+	assert.deepEqual([listen.channels[0].aniType, listen.channels[0].aniDecode, listen.channels[0].aniSend, listen.channels[0].aniId], [1, true, 0, 0]);
+	const { encodeChannel: enc, blankChannel: blank } = await import("../static/js/codeplug/records.js");
+	assert.equal(enc(listen.channels[0], blank())[0x27], 0xC1);
+	assert.deepEqual([typed.channels[0].aniType, typed.channels[0].aniSend, typed.channels[0].aniId], [1, 1, 0xBEEF]);
+	assert.equal(typed.channels[1].aniType, 0);
+	const bad = importTable(empty(), "Name,RX Frequency (MHz),ID Type,MDC ID\nX,155.475,five-tone,12345\n");
+	assert.deepEqual(bad.problems.map((p) => p.code).sort(), ["bad_value", "range"]);
+});
+
+// model.encode writes a channel record only when a field it compares (CHANNEL_KEYS) differs from the image, so every
+// signaling ID field has to be compared: a change to only one of them must still reach the image
+test("FM signaling ID: changing any one field alone is written to the image", () => {
+	const first = sim();
+	const fm = first.channels.find((c) => c.mode === "fm");
+	assert.ok(fm, "the simulated codeplug has an FM channel");
+	Object.assign(fm, { aniType: 1, aniSend: 1, aniId: 0x1A2B });
+	let img = encode(first);
+	for (const change of [{ aniSend: 3 }, { aniDecode: true }, { aniId: 0xBEEF }, { aniType: 0 }]) {
+		const m = decode(img);
+		Object.assign(m.channels.find((c) => c.number === fm.number), change);
+		const next = encode(m);
+		assert.notDeepEqual(next.bytes, img.bytes, JSON.stringify(change));
+		img = next;
+	}
+});
