+
+test("an FM channel's signaling ID: its rows show once a type is chosen, the MDC-1200 ID is typed in hex", () => {
+	const form = channelForm(empty(), t);
+	const f = (key) => form.find((x) => x.key === key);
+	const fm = { mode: "fm", aniType: 0 }, mdc = { mode: "fm", aniType: 1 }, dmr = { mode: "dmr", aniType: 1 };
+	assert.deepEqual([fm, mdc, dmr].map((r) => f("aniType").show(r)), [true, true, false]);
+	assert.deepEqual([fm, mdc, dmr].map((r) => f("aniSend").show(r)), [false, true, false]);
+	assert.deepEqual([fm, mdc, dmr].map((r) => f("aniId").show(r)), [false, true, false]);
+	assert.deepEqual([fm, mdc, dmr].map((r) => f("aniDecode").show(r)), [false, true, false]);
+	assert.equal(f("aniDecode").type, "bool");
+	assert.deepEqual(f("aniType").options().map(([v]) => v), [0, 1]);
+	assert.deepEqual(f("aniSend").options().map(([v]) => v), [0, 1, 2, 3]);
+	const id = f("aniId");
+	assert.deepEqual([id.format(0), id.format(0x2B), id.format(0xBEEF)], ["", "002B", "BEEF"]);
+	const typed = (s) => {
+		const r = { aniId: 0x1234 };
+		return id.parse(r, "aniId", s) ?? r.aniId;
+	};
+	assert.deepEqual(["1a2b", " BEEF ", "0x10", "1", "", "  "].map(typed), [0x1A2B, 0xBEEF, 0x10, 1, 0, 0]);
+	for (const s of ["10000", "12G4", "-1", "any"]) assert.equal(typed(s), "editor.err.mdc_id", s);
+});
