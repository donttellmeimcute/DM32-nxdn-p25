diff --git a/core/ysf/ysf_codeplug.c b/core/ysf/ysf_codeplug.c
new file mode 100644
index 00000000..fc5c3ebc
--- /dev/null
+++ b/core/ysf/ysf_codeplug.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// YSF conventional channels in the codeplug (ysf_codeplug.h, docs/spec/ysf-codeplug.md)
+#include <string.h>
+#include "config.h"
+#include "ysf/ysf_codeplug.h"
+#include "codeplug/codeplug_tag.h"
+#include "codeplug/codeplug_records.h"
+
+#if CONFIG_YSF
+
+void ysf_callsign_pack(const char *s, uint8_t out[YSF_CALLSIGN_LEN])
+{
+	bool ended = s == NULL;
+
+	// A NUL ends the call sign: the rest are spaces (never read past it)
+	for (unsigned i = 0; i < YSF_CALLSIGN_LEN; i++) {
+		char c = ' ';
+		if (!ended) {
+			if (s[i] == '\0')
+				ended = true;
+			else
+				c = s[i];
+		}
+		out[i] = (uint8_t)(c >= 0x20 && c <= 0x7E ? c : ' ');
+	}
+}
+
+void ysf_callsign_unpack(const uint8_t b[YSF_CALLSIGN_LEN], char out[YSF_CALLSIGN_LEN + 1])
+{
+	unsigned n = 0;
+
+	for (unsigned i = 0; i < YSF_CALLSIGN_LEN; i++) {
+		char c = (char)b[i];
+		out[n++] = (c >= 0x20 && c <= 0x7E && c != '\0') ? c : ' ';
+	}
+	while (n > 0 && out[n - 1] == ' ')
+		n--;
+	out[n] = '\0';
+}
+
+void ysf_conv_decode(const uint8_t *b, int len, ysf_conv_t *out)
+{
+	uint8_t f = len >= 1 ? b[0] : 0u;
+	uint8_t rx = len >= 2 ? b[1] : 0u;
+	uint8_t tx = len >= 3 ? b[2] : 0u;
+
+	out->dt = (uint8_t)(f & YSF_CP_DT_MASK);
+	out->narrow = (f & YSF_CP_NARROW) != 0;
+	if (rx > YSF_CP_DGID_MAX)
+		rx = 0;			// any DG-ID
+	out->rx_dgid = rx;
+	// A TX DG-ID field: its value when set, else the RX DG-ID
+	if ((tx & YSF_CP_TX_DGID_SET) != 0)
+		out->tx_dgid = (uint8_t)(tx & YSF_CP_DGID_MAX);
+	else
+		out->tx_dgid = rx;
+	if (len > 3) {
+		// A short destination reads with its missing characters as spaces
+		uint8_t dest[YSF_CALLSIGN_LEN];
+		int n = len - 3 < (int)YSF_CALLSIGN_LEN ? len - 3 : (int)YSF_CALLSIGN_LEN;
+
+		memset(dest, ' ', sizeof dest);
+		memcpy(dest, &b[3], (size_t)n);
+		ysf_callsign_unpack(dest, out->dest);
+		if (out->dest[0] == '\0')
+			strcpy(out->dest, YSF_CP_DEST_ALL);
+	} else {
+		strcpy(out->dest, YSF_CP_DEST_ALL);
+	}
+}
+
+void ysf_conv_encode(const ysf_conv_t *c, uint8_t out[YSF_CP_CONV_LEN])
+{
+	uint8_t rx = c->rx_dgid <= YSF_CP_DGID_MAX ? c->rx_dgid : 0u;
+
+	out[0] = (uint8_t)((c->dt & YSF_CP_DT_MASK) | (c->narrow ? YSF_CP_NARROW : 0u));
+	out[1] = rx;
+	out[2] = c->tx_dgid == rx ? 0u : (uint8_t)(YSF_CP_TX_DGID_SET | (c->tx_dgid & YSF_CP_DGID_MAX));
+	if (c->dest[0] == '\0' || strcmp(c->dest, YSF_CP_DEST_ALL) == 0)
+		ysf_callsign_pack(YSF_CP_DEST_ALL, &out[3]);
+	else
+		ysf_callsign_pack(c->dest, &out[3]);
+}
+
+void ysf_identity_decode(const uint8_t *b, int len, ysf_identity_t *out)
+{
+	out->src[0] = out->down[0] = out->up[0] = '\0';
+	if (len >= (int)YSF_CALLSIGN_LEN)
+		ysf_callsign_unpack(&b[0], out->src);
+	if (len >= (int)(2u * YSF_CALLSIGN_LEN))
+		ysf_callsign_unpack(&b[YSF_CALLSIGN_LEN], out->down);
+	if (len >= (int)(3u * YSF_CALLSIGN_LEN))
+		ysf_callsign_unpack(&b[2u * YSF_CALLSIGN_LEN], out->up);
+}
+
+bool ysf_conv_load(uint16_t number, const channel_t *ch, ysf_conv_cfg_t *out)
+{
+	uint8_t b[YSF_CP_CONV_LEN + YSF_CP_IDENTITY_LEN + CODEPLUG_TAG_HEAD_MAX];
+	const int cap = (int)(sizeof b - CODEPLUG_TAG_HEAD_MAX);
+	int len, idlen;
+
+	if (ch->kind != CODEPLUG_KIND_YSF)
+		return false;
+	len = codeplug_tag_params(number, ch, b, (uint16_t)cap);
+	if (len < 0)
+		return false;
+	ysf_conv_decode(b, len < cap ? len : cap, &out->conv);
+	idlen = codeplug_mode_settings(CODEPLUG_KIND_YSF, b, YSF_CP_IDENTITY_LEN);
+	ysf_identity_decode(b, idlen < 0 ? 0 : idlen, &out->id);
+	return true;
+}
+
+bool ysf_conv_save(uint16_t number, const channel_t *ch, const ysf_conv_t *conv)
+{
+	channel_t c = *ch;
+	uint8_t blk[YSF_CP_CONV_LEN];
+	// A channel of the kind already keeps the system it names
+	uint8_t system = ch->kind == CODEPLUG_KIND_YSF ? ch->system : CODEPLUG_SYSTEM_NONE;
+	codeplug_tag_t t = { .kind = CODEPLUG_KIND_YSF, .system = system, .flags = ch->rx_only ? 0u : CODEPLUG_TAG_TX };
+
+	// The safe stand-in: DMR, receive only (the tag carries transmit allowed). Under a tag that says the base record
+	// is a channel of its own, codeplug_set_channel keeps that channel's mode instead
+	c.kind = CODEPLUG_KIND_YSF;
+	c.system = system;
+	c.mode = RADIO_MODE_DMR;
+	c.rx_only = true;
+	ysf_conv_encode(conv, blk);
+	// A tag of the kind that followed the record keeps its fallback, its other flags and what it stores after this
+	// block (an editor's or a later firmware's); else a new one
+	return codeplug_set_channel(number, &c) && (codeplug_tag_rewrite(number, c.name, &t, blk, sizeof blk) ||
+						     codeplug_tag_write(number, c.name, &t, blk, sizeof blk));
+}
+
+#endif	// CONFIG_YSF
diff --git a/core/ysf/ysf_codeplug.h b/core/ysf/ysf_codeplug.h
new file mode 100644
index 00000000..02f58353
--- /dev/null
+++ b/core/ysf/ysf_codeplug.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// YSF conventional channels in the codeplug (docs/spec/ysf-codeplug.md): the codec from the stored bytes to plain
+// structs the radio core sets the YSF engine up from. Bytes in, values out: no engine here. Built with CONFIG_YSF
+#ifndef YSF_CODEPLUG_H
+#define YSF_CODEPLUG_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "codeplug/codeplug.h"
+#include "ysf/ysf_frame.h"
+
+#define YSF_CP_DGID_MAX		127u
+#define YSF_CP_TX_DGID_SET	0x80u	// a stored TX DG-ID holds a value (clear: the RX DG-ID)
+#define YSF_CP_DEST_ALL		"ALL"	// the destination an all-spaces field reads as, and is written as
+
+// A conventional channel's parameter block (2)
+#define YSF_CP_CONV_LEN		13u
+#define YSF_CP_DT_MASK		0x03u	// byte 0 bits 0-1: the data type (YSF_DT_*)
+#define YSF_CP_NARROW		0x04u	// byte 0 bit 2: Narrow deviation, else Wide
+// The radio-wide identity record (1): three call signs of 10 ASCII characters each
+#define YSF_CP_IDENTITY_LEN	30u
+
+typedef struct {
+	uint8_t dt;		// YSF_DT_VD_MODE1, YSF_DT_DATA_FR, YSF_DT_VD_MODE2, YSF_DT_VOICE_FR
+	bool narrow;		// Narrow deviation (1350 Hz) instead of Wide (2700 Hz)
+	uint8_t rx_dgid;	// 0: any DG-ID
+	uint8_t tx_dgid;	// the DG-ID sent (FICH SC)
+	char dest[YSF_CALLSIGN_LEN + 1];	// the destination call sign, NUL-terminated ("ALL" when unset)
+} ysf_conv_t;
+
+// The radio-wide call signs: this radio's identity, NUL-terminated, empty when unset
+typedef struct {
+	char src[YSF_CALLSIGN_LEN + 1];
+	char down[YSF_CALLSIGN_LEN + 1];
+	char up[YSF_CALLSIGN_LEN + 1];
+} ysf_identity_t;
+
+// A call sign to its 10 stored bytes (space padded; an empty one is all spaces). A byte outside printable ASCII
+// reads as a space, and trailing spaces are trimmed on the way back; an all-spaces field reads as empty
+void ysf_callsign_pack(const char *s, uint8_t out[YSF_CALLSIGN_LEN]);
+void ysf_callsign_unpack(const uint8_t b[YSF_CALLSIGN_LEN], char out[YSF_CALLSIGN_LEN + 1]);
+// Decode len bytes of a block (a short one, or none, takes the defaults); never fails: a value out of range is read as
+// its default
+void ysf_conv_decode(const uint8_t *b, int len, ysf_conv_t *out);
+// The block for c (YSF_CP_CONV_LEN bytes): a TX DG-ID equal to the RX DG-ID is stored as "follows", a blank
+// destination as "ALL"
+void ysf_conv_encode(const ysf_conv_t *c, uint8_t out[YSF_CP_CONV_LEN]);
+// Decode len bytes of the radio-wide identity record (a short one, or none, leaves the rest empty); never fails
+void ysf_identity_decode(const uint8_t *b, int len, ysf_identity_t *out);
+
+// What a conventional call is set up from: the channel's block and the radio-wide call signs
+typedef struct {
+	ysf_conv_t conv;
+	ysf_identity_t id;
+} ysf_conv_cfg_t;
+// Channel number's set-up from its tag and the radio-wide record (read by codeplug_channel); false when it isn't a
+// live YSF channel
+bool ysf_conv_load(uint16_t number, const channel_t *ch, ysf_conv_cfg_t *out);
+// Write ch at number as a YSF channel (channel-modes.md 2.4): the base record in its safe stand-in shape,
+// then the tag with conv's block, transmit allowed unless ch->rx_only. A channel that is YSF already keeps its tag's
+// system, fallback, other flags and what its block holds after conv's (codeplug_tag_rewrite), and under a base-own
+// tag its record's own mode; else the tag is new.
+// Where a YSF channel is made from the radio's own settings (the VFO, a mode changed for now) or its block edited
+bool ysf_conv_save(uint16_t number, const channel_t *ch, const ysf_conv_t *conv);
+
+#endif
diff --git a/core/ysf/ysf_engine.c b/core/ysf/ysf_engine.c
new file mode 100644
index 00000000..bef63e4b
--- /dev/null
+++ b/core/ysf/ysf_engine.c
@@ -0,0 +1,628 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// YSF conventional voice and data on a channel (ysf_engine.h).
+#include "ysf_engine.h"
+
+#include <string.h>
+
+#include "air/air_syms.h"
+#include "ysf_voice.h"
+
+static bool half_rate(uint8_t dt)
+{
+	return dt == YSF_DT_VD_MODE1 || dt == YSF_DT_VD_MODE2;
+}
+
+const air_mode_t *ysf_engine_mode(bool narrow)
+{
+	return narrow ? &ysf_air_mode_narrow : &ysf_air_mode;
+}
+
+uint32_t ysf_engine_fit(const hal_air_t *air, bool narrow)
+{
+	return air_session_fit(air, ysf_engine_mode(narrow));
+}
+
+// ── Receive (provider's task) ──
+static void view_begin(ysf_engine_t *e) { e->seq++; }
+static void view_end(ysf_engine_t *e) { e->seq++; }
+
+// The DG-ID squelch, first cut (docs/spec/ysf.md): every call, or only the
+// ones to our code, to none, or to Break Out. Confirm against a real Yaesu
+// radio: whether a station that sets a DG-ID hears a transmission with
+// SC 0, and whether Break Out really opens every squelch.
+static bool wanted(const ysf_engine_t *e, const ysf_fich *f)
+{
+	if (!e->cfg.rx_dgid)
+		return true;
+	return f->sc == e->cfg.rx_dgid || f->sc == 0 || f->sc == 127;
+}
+
+// A callsign from the air: 10 characters, space-padded. n bytes are taken
+// (DN carries only the first 5 characters of Rem1..Rem4); trailing spaces
+// are trimmed, the result NUL-terminated. All spaces becomes empty.
+static void copy_call(char dst[YSF_CALLSIGN_LEN + 1], const uint8_t *data, unsigned n)
+{
+	unsigned len = n;
+
+	while (len && data[len - 1] == ' ')
+		len--;
+	memcpy(dst, data, len);
+	dst[len] = '\0';
+}
+
+static void merge_dch(ysf_engine_t *e, const ysf_rx_frame_t *f)
+{
+	ysf_call_t *c = &e->call;
+
+	if (!f->dch_len)
+		return;
+
+	if (f->fich.fi == YSF_FI_HEADER || f->fich.fi == YSF_FI_TERMINATOR) {
+		copy_call(c->dest, f->dch, 10);
+		copy_call(c->src, f->dch + 10, 10);
+		copy_call(c->down, f->dch2, 10);
+		copy_call(c->up, f->dch2 + 10, 10);
+		return;
+	}
+	switch (f->fich.dt) {
+	case YSF_DT_VD_MODE1:
+		if (f->fich.fn == 0) {
+			copy_call(c->dest, f->dch, 10);
+			copy_call(c->src, f->dch + 10, 10);
+		} else if (f->fich.fn == 1) {
+			copy_call(c->down, f->dch, 10);
+			copy_call(c->up, f->dch + 10, 10);
+		} else if (f->fich.fn == 2) {
+			copy_call(c->rem1, f->dch, 10);
+			copy_call(c->rem2, f->dch + 10, 10);
+		}
+		break;
+	case YSF_DT_VD_MODE2:
+		if (f->fich.fn == 0)
+			copy_call(c->dest, f->dch, 10);
+		else if (f->fich.fn == 1)
+			copy_call(c->src, f->dch, 10);
+		else if (f->fich.fn == 2)
+			copy_call(c->down, f->dch, 10);
+		else if (f->fich.fn == 3)
+			copy_call(c->up, f->dch, 10);
+		else if (f->fich.fn == 4) {
+			copy_call(c->rem1, f->dch, 5);
+			copy_call(c->rem2, f->dch + 5, 5);
+		} else if (f->fich.fn == 5) {
+			copy_call(c->rem3, f->dch, 5);
+			copy_call(c->rem4, f->dch + 5, 5);
+		}
+		break;
+	case YSF_DT_DATA_FR:
+		if (f->fich.fn == 0) {
+			copy_call(c->dest, f->dch, 10);
+			copy_call(c->src, f->dch + 10, 10);
+			copy_call(c->down, f->dch2, 10);
+			copy_call(c->up, f->dch2 + 10, 10);
+		} else if (f->fich.fn == 1) {
+			copy_call(c->rem1, f->dch, 10);
+			copy_call(c->rem2, f->dch + 10, 10);
+		}
+		break;
+	case YSF_DT_VOICE_FR:
+		if (ysf_vw_subheader(&f->fich)) {
+			copy_call(c->rem1, f->dch, 10);
+			copy_call(c->rem2, f->dch + 10, 10);
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+// One DCH data unit per frame, indexed as the TX data callback counts them
+// (ysf_tx.h): V/D-1 FN3..7 -> 0..4, DN FN6/7 -> 0..1, Data FR FN1 DCH-2 -> 0,
+// FN2..7 DCH-1/DCH-2 -> 2*FN-3 / 2*FN-2.
+static void data_units(ysf_engine_t *e, const ysf_rx_frame_t *f)
+{
+	if (!f->dch_len || !e->hooks.rx_data || f->fich.fi != YSF_FI_COMMUNICATION)
+		return;
+	switch (f->fich.dt) {
+	case YSF_DT_VD_MODE1:
+		if (f->fich.fn >= 3)
+			e->hooks.rx_data(e->ctx, f->fich.fn - 3, f->dch, 20);
+		break;
+	case YSF_DT_VD_MODE2:
+		if (f->fich.fn >= 6)
+			e->hooks.rx_data(e->ctx, f->fich.fn - 6, f->dch, 10);
+		break;
+	case YSF_DT_DATA_FR:
+		if (f->fich.fn == 1)
+			e->hooks.rx_data(e->ctx, 0, f->dch2, 20);
+		else if (f->fich.fn >= 2) {
+			e->hooks.rx_data(e->ctx, 2 * f->fich.fn - 3, f->dch, 20);
+			e->hooks.rx_data(e->ctx, 2 * f->fich.fn - 2, f->dch2, 20);
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+static void voice_blocks(ysf_engine_t *e, const ysf_rx_frame_t *f)
+{
+	unsigned played = 0;
+
+	if (!e->played || f->fich.fi != YSF_FI_COMMUNICATION)
+		return;
+	switch (f->fich.dt) {
+	case YSF_DT_VD_MODE1:
+		if (!e->hooks.rx_voice)
+			break;
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+			e->hooks.rx_voice(f->voice[b], e->ctx);
+			played++;
+		}
+		break;
+	case YSF_DT_VD_MODE2: {
+		uint8_t frame9[9];
+
+		if (!e->hooks.rx_voice)
+			break;
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+			ysf_voice_dn_to_frame(f->voice[b], frame9, NULL);
+			e->hooks.rx_voice(frame9, e->ctx);
+			played++;
+		}
+		break;
+	}
+	case YSF_DT_VOICE_FR: {
+		uint8_t imbe[FEC_IMBE88_BYTES];
+
+		if (!e->hooks.rx_vw)
+			break;
+		for (unsigned b = f->voice_first; b < YSF_BLOCKS; b++) {
+			uint8_t errs = ysf_voice_vw_decode(f->voice[b], imbe);
+
+			e->hooks.rx_vw(imbe, errs, e->ctx);
+			played++;
+		}
+		break;
+	}
+	default:
+		break;	// Data FR has no voice
+	}
+	if (played) {
+		e->call.voice_frames += played;
+		view_begin(e);
+		e->view.rx_voice_frames += played;
+		view_end(e);
+	}
+}
+
+static void rx_fields(ysf_engine_t *e, bool start)
+{
+	bool play = wanted(e, &e->call.fich);
+
+	view_begin(e);
+	e->view.rx = e->call;
+	e->view.rx_active = true;
+	e->view.rx_played = play;
+	if (start)
+		e->view.rx_calls++;
+	view_end(e);
+	if (play && !e->played) {
+		e->played = true;
+		if (e->hooks.rx_start)
+			e->hooks.rx_start(&e->call, e->ctx);
+	} else if (play) {
+		if (e->hooks.rx_update)
+			e->hooks.rx_update(&e->call, e->ctx);
+	} else if (e->played) {
+		// A field that came in late says the call is not for us after all
+		e->played = false;
+		if (e->hooks.rx_end)
+			e->hooks.rx_end(e->ctx);
+	}
+}
+
+static void start_call(ysf_engine_t *e, const ysf_rx_frame_t *f, bool late)
+{
+	memset(&e->call, 0, sizeof e->call);
+	e->call.fich = f->fich;
+	e->call.late = late;
+	e->call.frames = 1;
+	e->played = false;
+	merge_dch(e, f);
+}
+
+static void end_call(ysf_engine_t *e)
+{
+	view_begin(e);
+	e->view.rx_active = false;
+	e->view.rx_played = false;
+	view_end(e);
+	if (e->played && e->hooks.rx_end)
+		e->hooks.rx_end(e->ctx);
+	e->played = false;
+}
+
+static void on_frame(const ysf_rx_frame_t *f, void *ctx)
+{
+	ysf_engine_t *e = ctx;
+	bool start;
+
+	view_begin(e);
+	e->view.rx_frames++;
+	view_end(e);
+	// A DG-ID the squelch does not take ends the call in hand: it is a
+	// different transmission, not a continuation of this one.
+	if (!wanted(e, &f->fich)) {
+		view_begin(e);
+		e->view.rx_rejects++;
+		view_end(e);
+		if (e->view.rx_active)
+			end_call(e);
+		return;
+	}
+	if (f->fich.fi == YSF_FI_TEST)
+		return;
+	if (e->recheck) {
+		e->recheck = false;
+		if (e->view.rx_active && !wanted(e, &e->call.fich))
+			end_call(e);
+	}
+	// A different DG-ID or voice format starts a new call.
+	if (e->view.rx_active && (f->fich.sc != e->call.fich.sc ||
+				 f->fich.dt != e->call.fich.dt))
+		end_call(e);
+	switch (f->fich.fi) {
+	case YSF_FI_HEADER:
+		if (e->view.rx_active)
+			end_call(e);
+		start_call(e, f, false);
+		rx_fields(e, true);
+		break;
+	case YSF_FI_COMMUNICATION:
+		start = !e->view.rx_active;
+		if (start) {
+			start_call(e, f, true);
+			rx_fields(e, true);
+		} else {
+			e->call.fich = f->fich;
+			e->call.frames++;
+			merge_dch(e, f);
+		}
+		data_units(e, f);
+		voice_blocks(e, f);
+		if (!start)
+			rx_fields(e, false);
+		break;
+	case YSF_FI_TERMINATOR:
+		if (e->view.rx_active) {
+			e->call.fich = f->fich;
+			e->call.frames++;
+			merge_dch(e, f);
+			rx_fields(e, false);
+			end_call(e);
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+static void on_lost(void *ctx)
+{
+	ysf_engine_t *e = ctx;
+
+	if (e->view.rx_active)
+		end_call(e);
+}
+
+static const ysf_rx_sink_t sink = { on_frame, on_lost };
+
+// ── Transmit ──
+// The sequence builder's voice callback: the staged 9-byte AMBE frames
+// become the frame's voice blocks. V/D-1 takes them as they are, DN converts
+// them, and VW protects and interleaves full-rate IMBE.
+static void tx_voice_cb(void *ctx, unsigned frame_no, unsigned block, uint8_t *vch, unsigned vch_len)
+{
+	ysf_engine_t *e = ctx;
+
+	(void)frame_no;
+	switch (e->cfg.dt) {
+	case YSF_DT_VD_MODE1:
+		if (vch_len == 9)
+			memcpy(vch, e->buf.tx.stage[block], 9);
+		break;
+	case YSF_DT_VD_MODE2:
+		if (vch_len == 13)
+			ysf_voice_dn_from_frame(e->buf.tx.stage[block], vch);
+		break;
+	case YSF_DT_VOICE_FR:
+		ysf_voice_vw_encode(e->buf.tx.stage[e->txcfg.vw_subheader ? block - YSF_VW_SUBHEADER_FIRST_VOICE : block], vch);
+		break;
+	default:
+		if (vch_len)
+			memset(vch, 0, vch_len);
+		break;
+	}
+}
+
+static void tx_data_wrap(void *ctx, unsigned index, uint8_t out[20])
+{
+	ysf_engine_t *e = ctx;
+
+	if (e->hooks.tx_data)
+		e->hooks.tx_data(e->ctx, index, out);
+	else
+		memset(out, 0, 20);
+}
+
+// Pull every voice block the encoder has made into the staging ring (two
+// frames). The encoder makes blocks at real-time rate, a frame needs five
+// at once, and the ring is what lets the two rates meet: tx_fill tops it up
+// on every call, so a frame is built from blocks collected over time, not
+// from whatever the encoder happened to have made at that instant.
+static void top_up(ysf_engine_t *e)
+{
+	bool vw = e->cfg.dt == YSF_DT_VOICE_FR;
+	bool (*next)(uint8_t *, void *) = vw ? e->hooks.tx_vw : half_rate(e->cfg.dt) ? e->hooks.tx_voice : NULL;
+
+	if (!next)
+		return;
+	while (e->sq_n < 10) {
+		uint8_t *dst = e->buf.tx.sq[(e->sq_head + e->sq_n) % 10];
+
+		if (!next(dst, e->ctx))
+			return;
+		e->sq_n++;
+	}
+}
+
+// Stage the five voice blocks of the next communication frame. Blocks
+// already staged for the frame in hand stay staged (stage_n): a wait is
+// resumed, never re-fetched, so the encoder's blocks are taken once, in
+// order. A block the encoder has not made yet is waited for as long as the
+// air can spare: once less than the provider's lead plus one more chunk is
+// queued, silence goes instead. Before the transmitter is on nothing is
+// lost by waiting.
+static bool stage_voice(ysf_engine_t *e)
+{
+	const hal_air_t *air = e->session.air;
+	uint16_t lead = (uint16_t)(((uint32_t)air->tx_lead_ms * e->mode->profile.sym_rate) / 1000 +
+				   air->tx_chunk_syms);
+	bool must = air_session_tx_state(&e->session) != AIR_TX_PRIMING &&
+		    air_session_tx_queued(&e->session) < lead;
+
+	bool vw = e->cfg.dt == YSF_DT_VOICE_FR;
+	unsigned blocks = e->txcfg.vw_subheader ?
+		YSF_BLOCKS - YSF_VW_SUBHEADER_FIRST_VOICE : YSF_BLOCKS;
+	unsigned size = vw ? FEC_IMBE88_BYTES : 9;
+	const uint8_t *silence = vw ? e->cfg.silence_vw : e->cfg.silence;
+	bool source = vw ? e->hooks.tx_vw != NULL : e->hooks.tx_voice != NULL;
+
+	for (; e->stage_n < blocks; e->stage_n++) {
+		unsigned b = e->stage_n;
+
+		if (e->sq_n) {
+			memcpy(e->buf.tx.stage[b], e->buf.tx.sq[e->sq_head], size);
+			e->sq_head = (uint8_t)((e->sq_head + 1) % 10);
+			e->sq_n--;
+			continue;
+		}
+		if (!source || must) {
+			memcpy(e->buf.tx.stage[b], silence, size);
+			view_begin(e);
+			e->view.tx_filler++;
+			view_end(e);
+		} else {
+			return false;	// wait: the queue is deep enough to coast
+		}
+	}
+	e->stage_n = 0;
+	return true;
+}
+
+// Pack a built frame's bytes into dibits (4 per byte, MSB first), the form
+// the session queues.
+static void pack_dibits(const uint8_t *frame, uint8_t *packed)
+{
+	memset(packed, 0, YSF_FRAME_DIBITS / 4);
+	for (unsigned i = 0; i < YSF_FRAME_DIBITS; i++)
+		air_sym_put(packed, (uint16_t)i, (uint8_t)((frame[i / 4] >> (6 - 2 * (i % 4))) & 3u));
+}
+
+// Build the next sequence frame: 0 header, 1..8 communication (FN cycles
+// 0..7, repeated while PTT is held), 9 terminator. False when the frame
+// waits for voice. After the key, a communication frame is still built while
+// voice the encoder already made waits in the ring: the tail of the over is
+// sent, not dropped, and the terminator follows once the ring is empty. The
+// tail is at most the ring (10 blocks in sq, 5 staged: 3 frames), so past the
+// bound below the voice source is still feeding, and waiting for it would
+// hold the transmitter on until the radio is switched off: the terminator is
+// forced and the rest of the ring is dropped. A normal over drains in at most
+// 3 frames, so the bound never fires there.
+#define YSF_TX_STOP_MAX_FRAMES	10u	// communication frames built after the key, at most
+static bool build_next(ysf_engine_t *e)
+{
+	unsigned seq;
+
+	if (e->frame_no == 0)
+		seq = 0;	// header
+	else if (e->tx_stop && !e->tx_ended &&
+		 ((e->sq_n == 0 && e->stage_n == 0) || e->stop_frames >= YSF_TX_STOP_MAX_FRAMES))
+		seq = 9;	// terminator: no voice left to drain, or the drain is stuck
+	else
+		seq = e->frame_no;	// 1..8, communication
+	if (seq >= 1 && seq <= 8 &&
+	    (half_rate(e->cfg.dt) || e->cfg.dt == YSF_DT_VOICE_FR) && !stage_voice(e))
+		return false;
+	if (!ysf_tx_frame_build(&e->txcfg, seq, e->buf.tx.txframe))
+		return false;	// unknown mode: nothing to send
+	pack_dibits(e->buf.tx.txframe, e->buf.tx.dibits);
+	e->dib_pos = 0;
+	if (seq == 0) {
+		e->frame_no = 1;
+		e->tx_started = true;
+	} else if (seq == 9) {
+		e->tx_ended = true;
+	} else {
+		e->txcfg.vw_subheader = false;
+		e->frame_no = e->frame_no >= 8 ? 1 : e->frame_no + 1;
+		if (e->tx_stop && e->stop_frames < 255)
+			e->stop_frames++;
+	}
+	return true;
+}
+
+// Symbols to the session while its queue has room
+static void tx_fill(void *ctx)
+{
+	ysf_engine_t *e = ctx;
+
+	top_up(e);
+	for (;;) {
+		uint16_t space, n;
+
+		if (e->tx_ended && e->dib_pos >= YSF_FRAME_DIBITS) {
+			air_session_tx_finish(&e->session);
+			return;
+		}
+		if (e->dib_pos >= YSF_FRAME_DIBITS && !build_next(e))
+			return;
+		space = air_session_tx_space(&e->session);
+		if (!space)
+			return;
+		n = (uint16_t)(YSF_FRAME_DIBITS - e->dib_pos);
+		if (n > space)
+			n = space;
+		if (!air_session_tx(&e->session, e->buf.tx.dibits, e->dib_pos, n))
+			return;
+		e->dib_pos += n;
+	}
+}
+
+static const air_session_ops_t ops = { tx_fill, NULL };
+
+// The sequence builder's config follows the engine's: cs/sql/voip are 0
+// (RF, DG-ID squelch on), cycles is 1 (the engine repeats the CC block
+// itself while PTT is held).
+static void refresh_txcfg(ysf_engine_t *e)
+{
+	e->txcfg.dt = e->cfg.dt;
+	e->txcfg.dev = e->cfg.narrow ? 1 : 0;
+	e->txcfg.cm = e->cfg.cm;
+	e->txcfg.mr = e->cfg.mr;
+	e->txcfg.cs = 0;
+	e->txcfg.sql = 0;
+	e->txcfg.voip = 0;
+	e->txcfg.dgid = e->cfg.tx_dgid;
+	memcpy(e->txcfg.dest, e->cfg.dest, YSF_CALLSIGN_LEN);
+	memcpy(e->txcfg.src, e->cfg.src, YSF_CALLSIGN_LEN);
+	memcpy(e->txcfg.down, e->cfg.down, YSF_CALLSIGN_LEN);
+	memcpy(e->txcfg.up, e->cfg.up, YSF_CALLSIGN_LEN);
+	memcpy(e->txcfg.rem1, e->cfg.rem1, YSF_CALLSIGN_LEN);
+	memcpy(e->txcfg.rem2, e->cfg.rem2, YSF_CALLSIGN_LEN);
+	memcpy(e->txcfg.rem3, e->cfg.rem3, YSF_CALLSIGN_LEN);
+	memcpy(e->txcfg.rem4, e->cfg.rem4, YSF_CALLSIGN_LEN);
+}
+
+bool ysf_engine_begin(ysf_engine_t *e, const hal_air_t *air, const ysf_engine_cfg_t *cfg,
+		      const ysf_engine_hooks_t *hooks, void *ctx)
+{
+	memset(e, 0, sizeof *e);
+	e->cfg = *cfg;
+	e->hooks = *hooks;
+	e->ctx = ctx;
+	e->mode = ysf_engine_mode(cfg->narrow);
+	e->txcfg.data = tx_data_wrap;
+	e->txcfg.voice = tx_voice_cb;
+	e->txcfg.ctx = e;
+	e->txcfg.cycles = 1;
+	refresh_txcfg(e);
+	ysf_rx_init(&e->rx, &sink, e);
+	return air_session_open(&e->session, air, e->mode, &e->rx, e->buf.rx.frame, e->buf.rx.soft, YSF_FRAME_DIBITS,
+				&ops, e);
+}
+
+void ysf_engine_end(ysf_engine_t *e)
+{
+	air_session_close(&e->session);
+}
+
+void ysf_engine_retuned(ysf_engine_t *e)
+{
+	air_session_retuned(&e->session);
+}
+
+void ysf_engine_set(ysf_engine_t *e, const ysf_engine_cfg_t *cfg)
+{
+	bool narrow = e->cfg.narrow;
+	uint8_t dt = e->cfg.dt;
+
+	e->cfg = *cfg;
+	e->cfg.narrow = narrow;	// the mode is the session's: a new deviation is a new session
+	e->cfg.dt = dt;		// ... and so is a new mode (the voice path follows it)
+	refresh_txcfg(e);
+	e->recheck = true;
+}
+
+bool ysf_engine_tx_prepare(ysf_engine_t *e)
+{
+	const uint8_t *silence = e->cfg.dt == YSF_DT_VOICE_FR ? e->cfg.silence_vw : e->cfg.silence;
+
+	if (!air_session_is_open(&e->session) || !(e->session.fit & AIR_FIT_TX) || !silence)
+		return false;
+	if (air_session_tx_state(&e->session) == AIR_TX_IDLE) {
+		e->frame_no = 0;
+		e->dib_pos = YSF_FRAME_DIBITS;
+		e->tx_started = false;
+		e->tx_stop = false;
+		e->tx_ended = false;
+		e->stop_frames = 0;
+		e->stage_n = 0;	// a new over: no staged frame, no queued blocks
+		e->sq_head = 0;
+		e->sq_n = 0;
+		refresh_txcfg(e);
+		e->txcfg.vw_subheader = e->cfg.dt == YSF_DT_VOICE_FR;
+	}
+	return air_session_tx_prime(&e->session);
+}
+
+bool ysf_engine_tx_go(ysf_engine_t *e)
+{
+	if (!air_session_tx_go(&e->session))
+		return false;
+	e->view.tx_calls++;
+	return true;
+}
+
+void ysf_engine_tx_stop(ysf_engine_t *e)
+{
+	e->tx_stop = true;
+}
+
+void ysf_engine_tx_abort(ysf_engine_t *e)
+{
+	air_session_tx_abort(&e->session);
+}
+
+air_tx_state_t ysf_engine_tx_state(const ysf_engine_t *e)
+{
+	return air_session_tx_state(&e->session);
+}
+
+void ysf_engine_tx_clear(ysf_engine_t *e)
+{
+	air_session_tx_clear(&e->session);
+}
+
+void ysf_engine_view(const ysf_engine_t *e, ysf_engine_view_t *out)
+{
+	uint8_t s;
+
+	do {
+		s = e->seq;
+		*out = e->view;
+	} while ((s & 1) || s != e->seq);
+	out->tx = air_session_tx_state(&e->session);
+}
diff --git a/core/ysf/ysf_engine.h b/core/ysf/ysf_engine.h
new file mode 100644
index 00000000..3bd4ff51
--- /dev/null
+++ b/core/ysf/ysf_engine.h
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// YSF conventional voice and data on a channel (docs/spec/ysf.md): the
+// frame layer (ysf_rx.h) on an air interface session (core/air/air_session.h).
+// The radio core begins it on a YSF channel and ends it on leaving; in
+// between it receives calls, hands their voice frames to a sink, and
+// transmits when the radio core says so. No RTOS call: the radio core's task
+// and the provider's task use it as air_session.h describes, voice frames
+// cross to and from the audio side through the caller's hooks.
+//
+// Voice is half-rate AMBE+2, one 9-byte DMR-format frame per 20 ms block,
+// both ways (ysf_voice.c): V/D-1 passes the VCH bytes through, DN converts
+// them to and from its tripled/whitened/interleaved field. VW uses the
+// separate full-rate hooks with 11-byte IMBE speech parameters.
+#ifndef YSF_ENGINE_H
+#define YSF_ENGINE_H
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "air/air_session.h"
+#include "ysf_frame.h"
+#include "ysf_rx.h"
+#include "ysf_tx.h"
+#include "fec/imbe88.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// A call, as the radio glue sees it: the FICH fields and the callsigns the
+// DCHs carried (10 characters each on the air, NUL-terminated here, trailing
+// spaces trimmed; empty when not heard yet). DN carries only the first 5
+// characters of Rem1..Rem4.
+typedef struct {
+	ysf_fich fich;
+	char dest[YSF_CALLSIGN_LEN + 1];
+	char src[YSF_CALLSIGN_LEN + 1];
+	char down[YSF_CALLSIGN_LEN + 1];
+	char up[YSF_CALLSIGN_LEN + 1];
+	char rem1[YSF_CALLSIGN_LEN + 1];
+	char rem2[YSF_CALLSIGN_LEN + 1];
+	char rem3[YSF_CALLSIGN_LEN + 1];
+	char rem4[YSF_CALLSIGN_LEN + 1];
+	bool late;		// started mid-call (no header heard)
+	uint32_t frames;	// frames of this call
+	uint32_t voice_frames;	// voice blocks played
+} ysf_call_t;
+
+typedef struct {
+	uint8_t dt;		// DT mode to transmit (and to expect voice in)
+	bool narrow;		// Narrow deviation (1350 Hz) instead of Wide (2700 Hz)
+	uint8_t rx_dgid;	// DG-ID to listen for: 0 = all
+	uint8_t tx_dgid;	// DG-ID to send (FICH SC)
+	uint8_t cm;		// YSF_CM_GROUP / RADIO_ID / INDIVIDUAL
+	uint8_t mr;		// YSF_MR_DIRECT / DOWNLINK_FREE / DOWNLINK_BUSY
+	char dest[YSF_CALLSIGN_LEN];
+	char src[YSF_CALLSIGN_LEN];
+	char down[YSF_CALLSIGN_LEN];
+	char up[YSF_CALLSIGN_LEN];
+	char rem1[YSF_CALLSIGN_LEN];
+	char rem2[YSF_CALLSIGN_LEN];
+	char rem3[YSF_CALLSIGN_LEN];
+	char rem4[YSF_CALLSIGN_LEN];
+	const uint8_t *silence;	// a 9-byte AMBE silence frame (the DMR one)
+	const uint8_t *silence_vw; // 11-byte packed IMBE silence for VW
+} ysf_engine_cfg_t;
+
+typedef struct {
+	// Receive, from the provider's task. start: a call we take began (its
+	// fields may still fill in: update). voice: a 9-byte DMR-format AMBE
+	// frame, one per 20 ms block. data: one DCH data unit (20 bytes, DN
+	// 10), indexed as the TX data callback counts them (ysf_tx.h).
+	void (*rx_start)(const ysf_call_t *c, void *ctx);
+	void (*rx_update)(const ysf_call_t *c, void *ctx);
+	void (*rx_voice)(const uint8_t vch[9], void *ctx);
+	void (*rx_end)(void *ctx);
+	void (*rx_data)(void *ctx, unsigned index, const uint8_t *data, unsigned len);
+	// Transmit, from the provider's task: the next 9-byte AMBE frame, false
+	// when none is ready. NULL: every block is `silence`
+	bool (*tx_voice)(uint8_t vch[9], void *ctx);
+	// Transmit: one data unit (20 bytes, DN uses the first 10), indexed as
+	// ysf_tx.h counts them. NULL: data units are zero-filled
+	void (*tx_data)(void *ctx, unsigned index, uint8_t out[20]);
+	void (*rx_vw)(const uint8_t imbe[FEC_IMBE88_BYTES], uint8_t errs, void *ctx);
+	bool (*tx_vw)(uint8_t imbe[FEC_IMBE88_BYTES], void *ctx);
+} ysf_engine_hooks_t;
+
+typedef struct {
+	bool rx_active;	// a call is being received (whether or not it is played)
+	bool rx_played;
+	ysf_call_t rx;		// its fields; kept after it ends (the last call heard)
+	air_tx_state_t tx;
+	uint32_t rx_calls;
+	uint32_t rx_rejects;	// frames dropped by the DG-ID squelch
+	uint32_t tx_calls;
+	uint32_t tx_filler;	// silence blocks sent because the encoder had none ready
+	uint32_t rx_frames;	// frames accepted after sync and FICH validation
+	uint32_t rx_voice_frames;	// voice blocks played
+} ysf_engine_view_t;
+
+typedef struct {
+	air_session_t session;
+	const air_mode_t *mode;
+	ysf_rx_t rx;
+	ysf_engine_cfg_t cfg;
+	ysf_engine_hooks_t hooks;
+	void *ctx;
+	ysf_tx_config txcfg;	// the sequence builder's config (refreshed on prepare)
+	// The frame buffers, receive and transmit, share storage: the radio is half-duplex, so a transmission
+	// discards any partial received frame (unreceivable while transmitting), and reception never runs while
+	// a frame is being built. A frame assembled from the shared bytes still has to pass sync and FICH
+	// (ysf_rx.c), so a clobbered partial frame is rejected as noise, not played. The two sides apart cost
+	// 975 bytes of RAM; shared they cost 600.
+	union {
+		struct {	// receive: the framer's frame and its soft values
+			uint8_t frame[YSF_FRAME_BYTES];
+			int8_t soft[YSF_FRAME_DIBITS];
+		} rx;
+		struct {	// transmit: the built frame, its dibits, the staged voice blocks
+			uint8_t txframe[YSF_FRAME_BYTES];
+			uint8_t dibits[YSF_FRAME_DIBITS / 4];
+			uint8_t stage[YSF_BLOCKS][FEC_IMBE88_BYTES];
+			uint8_t sq[10][FEC_IMBE88_BYTES];
+		} tx;
+	} buf;
+	uint16_t dib_pos;	// next dibit to queue from dibits[]
+	unsigned frame_no;	// next sequence frame to build (0 header, 1..8 CC, 9 terminator)
+	bool tx_started;	// the header is queued
+	volatile bool tx_stop;	// the radio core let go: end at the next frame boundary
+	bool tx_ended;		// ... and the terminator is queued
+	ysf_call_t call;	// the call being tracked
+	bool played;		// the call in hand passes the squelch
+	volatile bool recheck;	// ysf_engine_set changed what passes it
+	volatile uint8_t seq;	// odd while the provider's task writes view
+	uint8_t stage_n;	// blocks already staged for the frame in hand
+	uint8_t sq_head;	// next block to take from sq
+	uint8_t sq_n;		// blocks held in sq
+	uint8_t stop_frames;	// communication frames built since tx_stop: the terminator is forced past the bound
+	ysf_engine_view_t view;
+} ysf_engine_t;
+
+// The mode for a deviation
+const air_mode_t *ysf_engine_mode(bool narrow);
+// What the board's provider gives YSF: AIR_FIT_xxx, 0 = this board can't
+uint32_t ysf_engine_fit(const hal_air_t *air, bool narrow);
+// Start on the tuned channel (the board in its digital mode, its DMR stack stopped). False: no provider, no fit
+bool ysf_engine_begin(ysf_engine_t *e, const hal_air_t *air, const ysf_engine_cfg_t *cfg,
+		      const ysf_engine_hooks_t *hooks, void *ctx);
+void ysf_engine_end(ysf_engine_t *e);
+// The receiver is on a new frequency: what it held is dropped
+void ysf_engine_retuned(ysf_engine_t *e);
+// Change what is received and sent while running (a DG-ID or callsign change that needs no retune; not the mode
+// or the deviation). Not while transmitting
+void ysf_engine_set(ysf_engine_t *e, const ysf_engine_cfg_t *cfg);
+
+// Transmit (the radio core's task). prepare: the header is queued; then hal_radio_t.tx(), then go. stop: the
+// operator let go: the frame on air is finished and a terminator sent. state: AIR_TX_DONE = switch the
+// transmitter off (hal_radio_t.tx_off), then clear
+bool ysf_engine_tx_prepare(ysf_engine_t *e);
+bool ysf_engine_tx_go(ysf_engine_t *e);
+void ysf_engine_tx_stop(ysf_engine_t *e);
+void ysf_engine_tx_abort(ysf_engine_t *e);
+air_tx_state_t ysf_engine_tx_state(const ysf_engine_t *e);
+void ysf_engine_tx_clear(ysf_engine_t *e);
+
+// A copy of the state for the radio core's task
+void ysf_engine_view(const ysf_engine_t *e, ysf_engine_view_t *out);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/core/ysf/ysf_frame.c b/core/ysf/ysf_frame.c
new file mode 100644
index 00000000..79c07669
--- /dev/null
+++ b/core/ysf/ysf_frame.c
@@ -0,0 +1,634 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// Ported from the host prototype (src/ysf/ysf_frame.c in donttellmeimcute/DM32-nxdn-p25):
+// the frame layer is unchanged except for style (tabs, // comments). The
+// VCH/VeCH blocks are still filled with the deterministic pattern here;
+// the engine (ysf_engine.c) overwrites them with real half-rate AMBE+2
+// voice (ysf_voice.c) before the frame goes out, and reads them back on RX.
+// YSF frame layer. Provenance, piece by piece (MMDVMHost commit f030273edfa103b9797ccd9407184dadf2138491,
+// cloned 2026-11-18):
+//
+// - Frame sync, FICH field layout and getters: YSFDefines.h / YSFFICH.cpp.
+// - FICH FEC chain (CRC-16 -> 4x Golay(24,12,8) -> +4 zero bits -> conv R=1/2
+//   K=5 -> interleave M=5 dibits, N=10): YSFFICH.cpp encode()/decode().
+// - DCH chains (V/D-1: 160 data + CRC + 4 tail -> conv -> 360, interleave
+//   M=9 dibits N=20; DN: 80 data + CRC + 4 tail -> conv -> 200, interleave
+//   M=5 N=20; DCH layout inside the 5 payload blocks): YSFPayload.cpp
+//   processHeaderData() / processVDMode1Data() / processVDMode2Data().
+// - Convolutional encoder and 16-state Viterbi decoder: YSFConvolution.cpp,
+//   ported literally (branch tables, tie rule, chainback).
+// - CRC-16 (poly x^16+x^12+x^5+1, init 0, inverted at the end): CRC.cpp
+//   CCRC::addCCITT162 / checkCCITT162 (table CCITT16_TABLE2); here computed
+//   bitwise, which is the same polynomial and the same bit order.
+// - Whitening: YSFPayload.cpp WHITENING_DATA (20 fixed bytes) vs the Yaesu
+//   PN(9,5) LFSR, seed 0x1C9: the sequence is generated here from the LFSR
+//   (right-shifting register, output bit 0, feedback bit0 ^ bit4 into bit 8,
+//   bits packed MSB first) and the test compares it byte by byte with
+//   MMDVM's table. All 20 bytes agree (checked 2026-11-18).
+// - Golay(24,12,8): MMDVM carries it only as tables (ENCODING_TABLE_24128,
+//   4096 entries; DECODING_TABLE_23127, 2048 entries; both in Golay24128.cpp,
+//   from the Morelos-Zaragoza code). The tables were NOT copied here. Instead
+//   the code is implemented algebraically from the standard cyclic
+//   Golay(23,12,7) with MMDVM's generator polynomial GENPOL 0xC75
+//   (x^11+x^10+x^6+x^5+x^4+x^2+1), data in bits 22..11, parity in bits 10..0,
+//   plus the even-parity extension bit as bit 0; decode is syndrome decoding
+//   (the (23,12) Golay code is perfect: every 11-bit syndrome maps to exactly
+//   one error pattern of weight <= 3). Verified against MMDVM's tables for
+//   all 4096 codewords (encode) and all 2048 syndromes (decode) before this
+//   file was written.
+// - Interleave tables: literal copies of MMDVM's INTERLEAVE_TABLE (YSFFICH.cpp)
+//   and INTERLEAVE_TABLE_9_20 / INTERLEAVE_TABLE_5_20 (YSFPayload.cpp),
+//   extracted mechanically from the MMDVM sources. They also follow the
+//   formula table[i] = 40*(i%M) + 2*(i/M) (M = 5 or 9), which was checked
+//   against the literals.
+//
+// Two MMDVM discrepancies are followed as the spec, not as MMDVM:
+// - MR is 3 bits (Yaesu Table 4-1); MMDVM writes 3 bits (setMR) but reads
+//   only 2 (getMR masks & 0x03). Here the getter returns all 3.
+// - CS (byte 0, bits 5..4) and SQL (byte 3, bit 7) have no MMDVM getters;
+//   both are carried here.
+//
+// DCH order note (MMDVM, not Yaesu prose): the CRC is computed over the
+// whitened data -- whiten first, then CRC, then convolution. The decoder
+// checks the CRC before de-whitening, mirroring MMDVM exactly.
+#include "ysf_frame.h"
+#include <string.h>
+
+const uint8_t ysf_sync_bytes[YSF_SYNC_BYTES] = { 0xD4, 0x71, 0xC9, 0x63, 0x4D };
+
+// --- bit helpers (MSB first, as MMDVM's BIT_MASK_TABLE) ---
+static int get_bit(const uint8_t *p, unsigned i) { return (p[i >> 3] >> (7 - (i & 7))) & 1; }
+static void put_bit(uint8_t *p, unsigned i, int b)
+{
+	if (b) p[i >> 3] |= (uint8_t)(0x80u >> (i & 7));
+	else p[i >> 3] &= (uint8_t)~(0x80u >> (i & 7));
+}
+
+// --- CRC-16/CCITT-FALSE variant: poly 0x1021, init 0, inverted at the end ---
+static uint16_t crc16(const uint8_t *data, size_t n)
+{
+	uint16_t crc = 0;
+	for (size_t i = 0; i < n; i++) {
+		crc ^= (uint16_t)data[i] << 8;
+		for (unsigned k = 0; k < 8; k++) crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021) : (uint16_t)(crc << 1);
+	}
+	return (uint16_t)~crc;
+}
+// data[n-2..n-1] hold the CRC, big-endian (high byte first), as MMDVM writes it.
+static void crc16_add(uint8_t *data, size_t n)
+{
+	uint16_t c = crc16(data, n - 2);
+	data[n - 2] = (uint8_t)(c >> 8);
+	data[n - 1] = (uint8_t)c;
+}
+static bool crc16_check(const uint8_t *data, size_t n)
+{
+	uint16_t c = crc16(data, n - 2);
+	return (uint8_t)(c >> 8) == data[n - 2] && (uint8_t)c == data[n - 1];
+}
+
+// --- Golay(24,12,8): algebraic, generator 0xC75 ---
+#define GOLAY_GENPOL 0xC75u  // x^11+x^10+x^6+x^5+x^4+x^2+1
+#define GOLAY_X11 0x800u
+#define GOLAY_X22 0x400000u
+#define GOLAY_MASK12 0xfffff800u
+
+// Remainder of pattern modulo GENPOL (MMDVM's get_syndrome_23127).
+static uint32_t golay_syndrome(uint32_t pattern)
+{
+	uint32_t aux = GOLAY_X22;
+	if (pattern >= GOLAY_X11) {
+		while (pattern & GOLAY_MASK12) {
+			while (!(aux & pattern)) aux >>= 1;
+			pattern ^= (aux / GOLAY_X11) * GOLAY_GENPOL;
+		}
+	}
+	return pattern;
+}
+
+static unsigned popcount32(uint32_t v)
+{
+	unsigned n = 0;
+	while (v) { n += v & 1u; v >>= 1; }
+	return n;
+}
+
+uint32_t ysf_golay_encode(uint32_t data12)
+{
+	uint32_t code23 = ((data12 & 0xFFFu) << 11) | golay_syndrome((data12 & 0xFFFu) << 11);
+// extension bit: even overall parity
+	return (code23 << 1) | (popcount32(code23) & 1u);
+}
+
+bool ysf_golay_decode(uint32_t code24, uint32_t *data12)
+{
+	uint32_t syndrome = golay_syndrome(code24 >> 1);
+// Find the weight <= 3 error pattern with this syndrome. The code is
+// perfect, so exactly one exists: errors in the parity bits only, one
+// or two data bits plus parity bits, or three data bits.
+	uint32_t err = 0;
+	bool found = false;
+	if (popcount32(syndrome) <= 3) {
+		err = syndrome;
+		found = true;
+	} else {
+// The data bits are positions 11..22 of the 23-bit word, the parity
+// bits 0..10. A weight <= 3 pattern has 0, 1, 2 or 3 data bits; the
+// rest are parity bits, which the syndrome names directly.
+		for (unsigned i = 11; i < 23 && !found; i++) {
+			uint32_t s = syndrome ^ golay_syndrome(1u << i);
+			if (popcount32(s) <= 2) {
+				uint32_t cand = (1u << i) | s;
+				if (popcount32(cand) <= 3 && golay_syndrome(cand) == syndrome) { err = cand; found = true; }
+			}
+		}
+		for (unsigned i = 11; i < 23 && !found; i++) {
+			for (unsigned j = i + 1; j < 23 && !found; j++) {
+				uint32_t s = syndrome ^ golay_syndrome(1u << i) ^ golay_syndrome(1u << j);
+				if (popcount32(s) <= 1) {
+					uint32_t cand = (1u << i) | (1u << j) | s;
+					if (popcount32(cand) <= 3 && golay_syndrome(cand) == syndrome) { err = cand; found = true; }
+				}
+			}
+		}
+// Three data bits and no parity bit: the three columns must cancel
+// the syndrome exactly. (Without this stage, three adjacent data
+// bits were missed: the MMDVM oracle caught it, 220 patterns per
+// codeword.)
+		for (unsigned i = 11; i < 23 && !found; i++) {
+			for (unsigned j = i + 1; j < 23 && !found; j++) {
+				for (unsigned k = j + 1; k < 23 && !found; k++) {
+					if ((golay_syndrome(1u << i) ^ golay_syndrome(1u << j) ^ golay_syndrome(1u << k)) == syndrome) {
+						err = (1u << i) | (1u << j) | (1u << k);
+						found = true;
+					}
+				}
+			}
+		}
+	}
+	if (!found) return false;  // unreachable for a perfect code; defensive
+	uint32_t out = code24 ^ (err << 1);
+// Validity: the 24-bit word is an extended Golay codeword (even overall
+// parity), so the corrected word must have even parity -- unless the
+// extension bit itself was one of the errors. The 23-bit pattern err
+// does not cover bit 0, so an odd-parity corrected word is still valid
+// when err has weight <= 2 (the flipped parity bit is the third error);
+// weight 3 with odd parity would be four errors, which is not correctable.
+	bool valid = (popcount32(syndrome) < 3) || !(popcount32(out) & 1u) || (popcount32(err) <= 2);
+	*data12 = out >> 12;
+	return valid;
+}
+
+// --- Convolutional code R=1/2, K=5: G1 = 1+x^3+x^4, G2 = 1+x+x^2+x^4 ---
+// Literal port of MMDVM's CYSFConvolution (YSFConvolution.cpp).
+static const uint8_t branch_table1[8] = { 0, 0, 0, 0, 1, 1, 1, 1 };
+static const uint8_t branch_table2[8] = { 0, 1, 1, 0, 0, 1, 1, 0 };
+
+typedef struct {
+	uint16_t metrics1[16], metrics2[16];
+	uint16_t *old_metrics, *new_metrics;
+	uint16_t decisions[180];  // one 16-bit word per decoded dibit
+	uint16_t *dp;
+} ysf_viterbi;
+
+static void viterbi_start(ysf_viterbi *v)
+{
+	memset(v->metrics1, 0, sizeof v->metrics1);
+	memset(v->metrics2, 0, sizeof v->metrics2);
+	v->old_metrics = v->metrics1;
+	v->new_metrics = v->metrics2;
+	v->dp = v->decisions;
+}
+
+static void viterbi_decode(ysf_viterbi *v, uint8_t s0, uint8_t s1)
+{
+	uint16_t word = 0;
+	for (uint8_t i = 0; i < 8; i++) {
+		uint8_t j = (uint8_t)(i * 2);
+		uint16_t metric = (uint16_t)((branch_table1[i] ^ s0) + (branch_table2[i] ^ s1));
+		uint16_t m0 = (uint16_t)(v->old_metrics[i] + metric);
+		uint16_t m1 = (uint16_t)(v->old_metrics[i + 8] + (2 - metric));
+		uint8_t decision0 = (m0 >= m1) ? 1 : 0;
+		v->new_metrics[j] = decision0 ? m1 : m0;
+		m0 = (uint16_t)(v->old_metrics[i] + (2 - metric));
+		m1 = (uint16_t)(v->old_metrics[i + 8] + metric);
+		uint8_t decision1 = (m0 >= m1) ? 1 : 0;
+		v->new_metrics[j + 1] = decision1 ? m1 : m0;
+		word |= (uint16_t)((decision1 << (j + 1)) | (decision0 << j));
+	}
+	*v->dp++ = word;
+	uint16_t *tmp = v->old_metrics;
+	v->old_metrics = v->new_metrics;
+	v->new_metrics = tmp;
+}
+
+static void viterbi_chainback(ysf_viterbi *v, uint8_t *out, unsigned nbits)
+{
+	uint32_t state = 0;
+	while (nbits-- > 0) {
+		v->dp--;
+		uint32_t i = state >> (9 - 5);  // K = 5
+		uint8_t bit = (uint8_t)((*v->dp >> i) & 1u);
+		state = (bit << 7) | (state >> 1);
+		put_bit(out, nbits, bit);
+	}
+}
+
+static void conv_encode(const uint8_t *in, uint8_t *out, unsigned nbits)
+{
+	uint8_t d1 = 0, d2 = 0, d3 = 0, d4 = 0;
+	unsigned k = 0;
+	for (unsigned i = 0; i < nbits; i++) {
+		uint8_t d = (uint8_t)get_bit(in, i);
+		uint8_t g1 = (uint8_t)((d + d3 + d4) & 1);
+		uint8_t g2 = (uint8_t)((d + d1 + d2 + d4) & 1);
+		d4 = d3;
+		d3 = d2;
+		d2 = d1;
+		d1 = d;
+		put_bit(out, k++, g1);
+		put_bit(out, k++, g2);
+	}
+}
