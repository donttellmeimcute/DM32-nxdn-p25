+// Digital monitor on P25: the monitor key's release latches it, and the squelch then hears every NAC and every call
+// (a talk group, another NAC, a unit call to someone else); the second release and a retune take it off again
+static void test_p25_monitor(void)
+{
+	const radio_p25_view_t *v = &sm.view.p25;
+	radio_p25_settings_t s;
+	p25_voice_stats_t vs;
+
+	setup_codeplug_p25();
+	start();
+	p25_defaults();
+	aud.feed = true;
+	req(RREQ_ZONE_POS, 2);
+	p25VoiceGetStats(&vs);
+	uint32_t heard = vs.rx_in;	// frames the voice path took so far (the stream's own state outlives start())
+	radio_p25_settings(&s);
+	s.rx_tgid = 5;		// selective: talk group 5 on our NAC
+	radio_req_p25_settings(&s);
+	far_begin(0x123, 1003, false, 77);	// another system, another talk group
+	far_call(400);
+	CHECK(sm.view.state == RS_IDLE && !sm.view.dmr.hear_all_latch);
+
+	req(RREQ_MONITOR, 1);			// the press does nothing (as on DMR): the release toggles
+	run(30);
+	CHECK(!sm.view.dmr.hear_all_latch);
+	req(RREQ_MONITOR, 0);
+	run(50);
+	CHECK(sm.view.dmr.hear_all_latch && radio_p25_running());
+	far_begin(0x123, 1003, false, 77);
+	CHECK(p25_engine_tx_prepare(&far_eng) && p25_engine_tx_go(&far_eng));
+	far_tx = true;
+	run(600);
+	CHECK(sm.view.state == RS_RX && (v->flags & RADIO_P25_PLAYED) && v->nac == 0x123 && v->dst == 77);
+	CHECK(hw.led[LED_GREEN]);
+	p25VoiceGetStats(&vs);
+	CHECK(vs.rx_in > heard);		// its voice reached the voice path
+	heard = vs.rx_in;
+	p25_engine_tx_stop(&far_eng);
+	run(600);
+	// A unit call to someone else plays too
+	far_begin(P25_NAC_DEFAULT, 1004, true, 4242);
+	CHECK(p25_engine_tx_prepare(&far_eng) && p25_engine_tx_go(&far_eng));
+	far_tx = true;
+	run(600);
+	CHECK((v->flags & (RADIO_P25_PLAYED | RADIO_P25_UNIT)) == (RADIO_P25_PLAYED | RADIO_P25_UNIT) && v->dst == 4242);
+	p25_engine_tx_stop(&far_eng);
+	run(600);
+
+	req(RREQ_MONITOR, 1);
+	req(RREQ_MONITOR, 0);			// off again: the squelch is the channel's
+	run(50);
+	CHECK(!sm.view.dmr.hear_all_latch);
+	p25VoiceGetStats(&vs);
+	heard = vs.rx_in;
+	far_begin(0x123, 1003, false, 77);
+	far_call(400);
+	p25VoiceGetStats(&vs);
+	CHECK(sm.view.state == RS_IDLE && vs.rx_in == heard);
+	// The latch is the channel's: a retune drops it
+	req(RREQ_MONITOR, 0);
+	run(50);
+	CHECK(sm.view.dmr.hear_all_latch);
+	req(RREQ_ZONE_POS, 1);
+	run(50);
+	CHECK(!sm.view.dmr.hear_all_latch);
+	p25_defaults();
+	far_stop();
+	aud.feed = false;
+}
