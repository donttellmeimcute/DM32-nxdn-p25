+// --- dibits <-> bytes ---
+void ysf_bytes_to_dibits(const uint8_t *bytes, size_t nbytes, uint8_t *dibits)
+{
+	for (size_t i = 0; i < nbytes; i++)
+		for (unsigned k = 0; k < 4; k++) dibits[4 * i + k] = (uint8_t)((bytes[i] >> (6 - 2 * k)) & 3u);
+}
+
+void ysf_dibits_to_bytes(const uint8_t *dibits, size_t ndibits, uint8_t *bytes)
+{
+	size_t nbytes = ndibits / 4;
+	memset(bytes, 0, nbytes);
+	for (size_t i = 0; i < ndibits; i++) {
+		bytes[i / 4] |= (uint8_t)(dibits[i] << (6 - 2 * (i % 4)));
+	}
+}
+
+// --- sync search ---
+static const uint8_t sync_dibits[20] = { 3, 1, 1, 0, 1, 3, 0, 1, 3, 0, 2, 1, 1, 2, 0, 3, 1, 0, 3, 1 };
+
+unsigned ysf_sync_errors(const uint8_t sync5[YSF_SYNC_BYTES])
+{
+	unsigned errors = 0;
+	for (unsigned i = 0; i < YSF_SYNC_BYTES; i++) {
+		uint8_t x = (uint8_t)(sync5[i] ^ ysf_sync_bytes[i]);
+		while (x) { errors += x & 1u; x >>= 1; }
+	}
+	return errors;
+}
+
+size_t ysf_find_sync(const uint8_t *dibits, size_t ndibits, unsigned max_errors)
+{
+	if (ndibits < 20) return SIZE_MAX;
+	for (size_t pos = 0; pos + 20 <= ndibits; pos++) {
+		unsigned errors = 0;
+		for (unsigned i = 0; i < 20; i++) {
+			uint8_t x = (uint8_t)(dibits[pos + i] ^ sync_dibits[i]);
+			errors += (x & 1u) + ((x >> 1) & 1u);
+			if (errors > max_errors) break;
+		}
+		if (errors <= max_errors) return pos;
+	}
+	return SIZE_MAX;
+}
+
+// --- whole frames ---
+// Deterministic voice-block filler: xorshift32, fixed seed, so a built frame
+// is reproducible. This is NOT voice: no AMBE is implemented in this phase.
+static void fill_voice(uint8_t *p, size_t n)
+{
+	uint32_t s = 0x59534621u;  // "YSF!"
+	for (size_t i = 0; i < n; i++) {
+		s ^= s << 13; s ^= s >> 17; s ^= s << 5;
+		p[i] = (uint8_t)(s >> 24);
+	}
+}
+
+// Payload layout per 20 ms block (18 bytes):
+//   V/D-1 / Data FR (DT 0/1): [DCH1 9][VCH 9]
+//   V/D-2 (DN, DT 2):         [DCH2 5][VCH 9][VeCH 4]
+//   Voice FR (DT 3):          [VCH 18] (no DCH)
+// A header or terminator carries two DCH1s: DCH1 in bytes 0..8 of each block,
+// DCH2 in bytes 9..17 (MMDVM's processHeaderData gathers both).
+void ysf_frame_build(const ysf_fich *f, const uint8_t *dch, const uint8_t *dch2_or_null,
+					 uint8_t frame[YSF_FRAME_BYTES])
+{
+	memcpy(frame, ysf_sync_bytes, YSF_SYNC_BYTES);
+	ysf_fich_encode(f, frame + YSF_SYNC_BYTES);
+	uint8_t *payload = frame + YSF_SYNC_BYTES + YSF_FICH_BYTES;
+// The header and the terminator are mode-independent: two DCH1s (CSD1 +
+// CSD2), as MMDVM's writeHeader/processHeaderData always use the 9_20
+// DCH1 pair whatever the DT -- and YSFControl calls processHeaderData on
+// terminator frames too. Only communication frames follow the DT layout.
+	if (f->fi == YSF_FI_HEADER || f->fi == YSF_FI_TERMINATOR) {
+		uint8_t air[45], air2[45];
+		ysf_dch1_encode(dch, air);
+		if (dch2_or_null != NULL) ysf_dch1_encode(dch2_or_null, air2);
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+			memcpy(payload + 18 * b, air + 9 * b, 9);
+			if (dch2_or_null != NULL) memcpy(payload + 18 * b + 9, air2 + 9 * b, 9);
+			else fill_voice(payload + 18 * b + 9, 9);
+		}
+		return;
+	}
+	if (f->dt == YSF_DT_VD_MODE2) {
+		uint8_t air[25];
+		ysf_dch2_encode(dch, air);
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+			memcpy(payload + 18 * b, air + 5 * b, 5);
+			fill_voice(payload + 18 * b + 5, 13);
+		}
+	} else if (f->dt == YSF_DT_VOICE_FR) {
+		fill_voice(payload, YSF_PAYLOAD_BYTES);
+		if (ysf_vw_subheader(f)) {
+			ysf_dch1_encode(dch, payload);	// 45 contiguous bytes, then nine reserved bytes
+			memset(payload + 45, 0, 9);
+		}
+	} else if (f->dt == YSF_DT_DATA_FR && dch2_or_null != NULL) {
+// Data FR communication frame: two DCH1s, DCH-1 in bytes 0..8 of each
+// block, DCH-2 in bytes 9..17 (MMDVM's processDataFRModeData gathers
+// both).
+		uint8_t air[45], air2[45];
+		ysf_dch1_encode(dch, air);
+		ysf_dch1_encode(dch2_or_null, air2);
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+			memcpy(payload + 18 * b, air + 9 * b, 9);
+			memcpy(payload + 18 * b + 9, air2 + 9 * b, 9);
+		}
+	} else {
+		uint8_t air[45];
+		ysf_dch1_encode(dch, air);
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+			memcpy(payload + 18 * b, air + 9 * b, 9);
+			fill_voice(payload + 18 * b + 9, 9);
+		}
+	}
+}
+
+bool ysf_frame_decode_fich(const uint8_t frame[YSF_FRAME_BYTES], ysf_fich *f)
+{
+	return ysf_sync_errors(frame) <= YSF_SYNC_MAX_ERRORS &&
+	       ysf_fich_decode(frame + YSF_SYNC_BYTES, f);
+}
+
+bool ysf_frame_decode_dch(const uint8_t frame[YSF_FRAME_BYTES], const ysf_fich *f, uint8_t dch[20],
+			  uint8_t *dch2_or_null, unsigned *dch_len_or_null)
+{
+	const uint8_t *payload = frame + YSF_SYNC_BYTES + YSF_FICH_BYTES;
+	unsigned dch_len = 0;
+	bool ok = true;
+	if (f->fi == YSF_FI_HEADER || f->fi == YSF_FI_TERMINATOR) {
+		uint8_t air[45], air2[45];
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+			memcpy(air + 9 * b, payload + 18 * b, 9);
+			memcpy(air2 + 9 * b, payload + 18 * b + 9, 9);
+		}
+		ok = ysf_dch1_decode(air, dch);
+		if (ok && dch2_or_null != NULL) ok = ysf_dch1_decode(air2, dch2_or_null);
+		dch_len = 20;
+	} else if (f->dt == YSF_DT_VD_MODE2) {
+		uint8_t air[25];
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) memcpy(air + 5 * b, payload + 18 * b, 5);
+		uint8_t tmp[10];
+		ok = ysf_dch2_decode(air, tmp);
+		if (ok) memcpy(dch, tmp, 10);
+		dch_len = 10;
+	} else if (f->dt == YSF_DT_VOICE_FR) {
+		if (ysf_vw_subheader(f)) {
+			ok = ysf_dch1_decode(payload, dch);
+			dch_len = 20;
+		}
+	} else if (f->dt == YSF_DT_DATA_FR) {
+// Data FR communication frame: two DCH1s, DCH-1 in bytes 0..8 of each
+// block, DCH-2 in bytes 9..17.
+		uint8_t air[45], air2[45];
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+			memcpy(air + 9 * b, payload + 18 * b, 9);
+			memcpy(air2 + 9 * b, payload + 18 * b + 9, 9);
+		}
+		ok = ysf_dch1_decode(air, dch);
+		if (ok && dch2_or_null != NULL) ok = ysf_dch1_decode(air2, dch2_or_null);
+		dch_len = 20;
+	} else {
+		uint8_t air[45];
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) memcpy(air + 9 * b, payload + 18 * b, 9);
+		ok = ysf_dch1_decode(air, dch);
+		dch_len = 20;
+	}
+	if (dch_len_or_null != NULL) *dch_len_or_null = dch_len;
+	return ok;
+}
+
+bool ysf_frame_decode(const uint8_t frame[YSF_FRAME_BYTES], ysf_fich *f, uint8_t dch[20],
+		      uint8_t *dch2_or_null, unsigned *dch_len_or_null)
+{
+	return ysf_frame_decode_fich(frame, f) &&
+	       ysf_frame_decode_dch(frame, f, dch, dch2_or_null, dch_len_or_null);
+}
diff --git a/core/ysf/ysf_frame.h b/core/ysf/ysf_frame.h
new file mode 100644
index 00000000..82419463
--- /dev/null
+++ b/core/ysf/ysf_frame.h
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// YSF frame layer: FICH and DCH (data channel) encode/decode, frame sync
+// search, and whole-frame assembly, for the firmware (ported from the
+// host prototype in src/ysf/ysf_frame.h).
+//
+// Algorithms and tables ported literally from MMDVMHost
+// (YSFFICH.cpp, YSFPayload.cpp, YSFConvolution.cpp, CRC.cpp, Golay24128.cpp;
+// see ysf_frame.c for the exact provenance of each piece), following Yaesu
+// "Amateur Radio Digital Standards" Rev. 1.02. The one piece MMDVMHost only
+// carries as tables is the Golay(24,12,8) decode: it is implemented here
+// algebraically from the standard cyclic Golay(23,12,7) code with MMDVM's
+// generator polynomial, and verified against MMDVM's tables (see the note in
+// ysf_frame.c).
+//
+// Frame (960 bits / 100 ms): [FS 40][FICH 200][payload 720]. No public YSF
+// test vectors exist, so the test vectors are generated by this file's own
+// encoder: the tests prove the demodulator and decoder against themselves,
+// not against real air captures.
+//
+// Voice: the VCH/VeCH blocks of a built frame are filled here with a
+// deterministic pseudo-random pattern (fill_voice in ysf_frame.c), not AMBE;
+// the engine (ysf_engine.c) overwrites them with real half-rate AMBE+2
+// voice (ysf_voice.c) before the frame goes out, and reads them back on RX.
+// Integer arithmetic only, no allocation.
+#ifndef YSF_FRAME_H
+#define YSF_FRAME_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+	YSF_FRAME_BITS = 960,  // bits per frame
+	YSF_FRAME_BYTES = 120,  // 960 bits
+	YSF_FRAME_DIBITS = 480,  // 2 bits per symbol
+	YSF_SYNC_BITS = 40,
+	YSF_SYNC_BYTES = 5,
+	YSF_FICH_BITS = 200,
+	YSF_FICH_BYTES = 25,
+	YSF_PAYLOAD_BYTES = 90,  // 5 blocks x 18 bytes
+	YSF_BLOCK_BYTES = 18,
+	YSF_BLOCKS = 5,
+	YSF_VW_SUBHEADER_FIRST_VOICE = 3,
+	YSF_CALLSIGN_LEN = 10
+};
+
+// Frame sync D471C9634D, MSB first (Yaesu section 4.2.1(3); MMDVM YSF_SYNC_BYTES)
+extern const uint8_t ysf_sync_bytes[YSF_SYNC_BYTES];
+
+// Sync tolerance, in bits: the first symbols of a transmission are still
+// acquiring (timing/levels), so the sync usually arrives with one or two bit
+// errors even when the FICH and DCH behind it are clean. The frame is really
+// validated by the FICH and DCH CRCs, so a small sync tolerance only admits
+// frames whose FEC already checks out.
+enum { YSF_SYNC_MAX_ERRORS = 4 };
+
+// FICH field values (Yaesu Table 4-1)
+enum {
+	YSF_FI_HEADER = 0, YSF_FI_COMMUNICATION = 1, YSF_FI_TERMINATOR = 2, YSF_FI_TEST = 3,
+	YSF_DT_VD_MODE1 = 0, YSF_DT_DATA_FR = 1, YSF_DT_VD_MODE2 = 2, YSF_DT_VOICE_FR = 3,
+	YSF_CM_GROUP = 0, YSF_CM_RADIO_ID = 1, YSF_CM_INDIVIDUAL = 3,
+	YSF_MR_DIRECT = 0, YSF_MR_DOWNLINK_FREE = 1, YSF_MR_DOWNLINK_BUSY = 2
+};
+
+// The 32 info bits of the FICH, MSB->LSB:
+// FI(2) CS(2) CM(2) BN(2) BT(2) FN(3) FT(3) rsv(1) Dev(1) MR(3) VoIP(1) DT(2) SQL(1) SC(7).
+// MMDVM reads MR as 2 bits and exposes neither CS nor SQL; this layer follows
+// the spec (MR 3 bits, CS and SQL present). Dev: 0 = Wide, 1 = Narrow.
+// SC is the DG-ID: 0 = none, 1..126 = codes, 127 = Break Out.
+typedef struct {
+	uint8_t fi;  // 2 bits
+	uint8_t cs;  // 2 bits
+	uint8_t cm;  // 2 bits
+	uint8_t bn;  // 2 bits
+	uint8_t bt;  // 2 bits
+	uint8_t fn;  // 3 bits
+	uint8_t ft;  // 3 bits
+	uint8_t dev;  // 1 bit
+	uint8_t mr;  // 3 bits
+	uint8_t voip;  // 1 bit
+	uint8_t dt;  // 2 bits
+	uint8_t sql;  // 1 bit
+	uint8_t sc;  // 7 bits: DG-ID
+} ysf_fich;
+
+// FICH encode: fields -> 25 transmitted bytes (200 bits, sync excluded).
+// FICH decode: 25 bytes -> fields; false when the Golay decode or the CRC-16 fails.
+void ysf_fich_encode(const ysf_fich *f, uint8_t out[YSF_FICH_BYTES]);
+bool ysf_fich_decode(const uint8_t in[YSF_FICH_BYTES], ysf_fich *f);
+
+// DCH, V/D-1 / Data FR / HC / TC: 20 data bytes -> 45 transmitted bytes
+// (360 bits). DCH, V/D-2 (DN): 10 data bytes -> 25 transmitted bytes (200 bits).
+// Decode returns false when the CRC-16 fails. The CRC covers the whitened
+// data (MMDVM's order: whiten first, then CRC, then convolution).
+void ysf_dch1_encode(const uint8_t data[20], uint8_t out[45]);
+bool ysf_dch1_decode(const uint8_t in[45], uint8_t data[20]);
+void ysf_dch2_encode(const uint8_t data[10], uint8_t out[25]);
+bool ysf_dch2_decode(const uint8_t in[25], uint8_t data[10]);
+
+// Whitening sequence PN(9,5), 9-bit register, initial value 0x1C9, reset per
+// unit (Yaesu section 4.5(2)(b)). Generates the 20 bytes MMDVM carries as the
+// fixed WHITENING_DATA table; the test compares the two byte by byte.
+void ysf_whitening_generate(uint8_t out[20]);
+
+// Dibits <-> bytes, MSB first (dibit 0 = bits 7..6 of byte 0).
+void ysf_bytes_to_dibits(const uint8_t *bytes, size_t nbytes, uint8_t *dibits);
+void ysf_dibits_to_bytes(const uint8_t *dibits, size_t ndibits, uint8_t *bytes);
+
+// Frame sync search in a dibit stream: the first position whose 20 sync
+// dibits differ from D471C9634D in at most max_errors bits (each dibit can
+// contribute 0, 1 or 2 errors), or SIZE_MAX when none is found.
+size_t ysf_find_sync(const uint8_t *dibits, size_t ndibits, unsigned max_errors);
+
+// Bit errors between five bytes and the frame sync.
+unsigned ysf_sync_errors(const uint8_t sync5[YSF_SYNC_BYTES]);
+
+// VW's first communication frame has a CSD3 sub-header followed by just two voice blocks.
+static inline bool ysf_vw_subheader(const ysf_fich *f)
+{
+	return f->dt == YSF_DT_VOICE_FR && f->fi == YSF_FI_COMMUNICATION && f->fn == 0 && f->ft == 1;
+}
+
+// Build one whole 120-byte frame (sync + FICH + payload) from FICH fields and
+// DCH data. dt selects the payload layout: DT 0/1 -> one DCH1 (20 bytes) per
+// frame, DT 2 -> one DCH2 (10 bytes) per frame, DT 3 -> no DCH. For a header
+// or terminator (fi == YSF_FI_HEADER or YSF_FI_TERMINATOR) the layout is
+// mode-independent: two DCH1s, dch2_or_null carrying the second (CSD2:
+// downlink + uplink); for communication frames it is ignored, except in Data
+// FR (DT 1), where it carries the second DCH1 (DCH-2) of the frame. The
+// VW sub-header carries one contiguous DCH1 before the reserved and voice slots. The
+// VCH/VeCH blocks are filled with a deterministic pseudo-random pattern, not
+// voice. dch is the first DCH's data (CSD1 for a header / FN0).
+void ysf_frame_build(const ysf_fich *f, const uint8_t *dch, const uint8_t *dch2_or_null,
+					 uint8_t frame[YSF_FRAME_BYTES]);
+
+// The FICH identifies the voice layout independently of the DCH checksum.
+bool ysf_frame_decode_fich(const uint8_t frame[YSF_FRAME_BYTES], ysf_fich *f);
+bool ysf_frame_decode_dch(const uint8_t frame[YSF_FRAME_BYTES], const ysf_fich *f, uint8_t dch[20],
+			  uint8_t *dch2_or_null, unsigned *dch_len_or_null);
+
+// Decode one whole 120-byte frame: checks the sync bytes, decodes the FICH,
+// then decodes the DCH the frame carries (a header or terminator always
+// carries two DCH1s, 20 bytes each, the second going to dch2_or_null when
+// non-NULL; a Data FR communication frame also carries two DCH1s, DCH-1 and
+// DCH-2, the second going to dch2_or_null when non-NULL; a V/D-1 or DN
+// communication frame carries one DCH, 20 bytes for DT 0/1, 10 for DT 2,
+// none for DT 3). Returns false when the sync, the FICH, or the DCH fails.
+// dch_len_or_null receives the first DCH length in bytes (20, 10 or 0).
+bool ysf_frame_decode(const uint8_t frame[YSF_FRAME_BYTES], ysf_fich *f, uint8_t dch[20],
+					  uint8_t *dch2_or_null, unsigned *dch_len_or_null);
+
+// Golay(24,12,8) extended code, exposed for the tests. encode: 12 data bits
+// -> 24-bit codeword. decode: 24-bit word -> 12 data bits; false when the
+// word is not a correctable codeword (MMDVM's validity rule).
+uint32_t ysf_golay_encode(uint32_t data12);
+bool ysf_golay_decode(uint32_t code24, uint32_t *data12);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/core/ysf/ysf_rx.c b/core/ysf/ysf_rx.c
new file mode 100644
index 00000000..fc45f454
--- /dev/null
+++ b/core/ysf/ysf_rx.c
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// YSF on the air interface: the profile and the framer hooks. The frame is
+// validated here (sync, FICH, DCH); the call tracking lives in ysf_engine.c.
+#include "ysf_rx.h"
+
+#include <string.h>
+
+#include "ysf_voice.h"
+#include "../../hal/hal_radio.h"
+
+void ysf_rx_init(ysf_rx_t *r, const ysf_rx_sink_t *sink, void *ctx)
+{
+	memset(r, 0, sizeof *r);
+	r->sink = *sink;
+	r->ctx = ctx;
+}
+
+static void rx_frame(const air_frame_t *f, void *ctx)
+{
+	ysf_rx_t *r = ctx;
+	const uint8_t *frame = f->hard;	// four dibits per byte, MSB first
+	ysf_rx_frame_t out = {0};
+
+	if (f->nsyms != YSF_FRAME_DIBITS || !ysf_frame_decode_fich(frame, &out.fich)) {
+		r->fich_fail++;
+		return;
+	}
+	if (!ysf_frame_decode_dch(frame, &out.fich, out.dch, out.dch2, &out.dch_len)) {
+		r->dch_fail++;
+		out.dch_len = 0;
+		// The CRC covers data only. Keep call boundaries and independently coded voice.
+		if (out.fich.fi == YSF_FI_COMMUNICATION && out.fich.dt == YSF_DT_DATA_FR)
+			return;
+	}
+	out.t_us = f->t_us;
+	out.rssi_dbm = f->rssi_dbm;
+	// Only communication frames carry voice blocks: a header or terminator
+	// holds two DCH1s where the voice would be.
+	if (out.fich.fi == YSF_FI_COMMUNICATION) {
+		out.voice_first = ysf_vw_subheader(&out.fich) ? YSF_VW_SUBHEADER_FIRST_VOICE : 0;
+		for (unsigned b = out.voice_first; b < YSF_BLOCKS; b++) {
+			unsigned len = ysf_voice_get(frame, out.fich.dt, b, out.voice[b]);
+
+			if (b == out.voice_first)
+				out.voice_len = (uint8_t)len;
+		}
+	}
+	r->frames++;
+	if (r->sink.frame)
+		r->sink.frame(&out, r->ctx);
+}
+
+static void rx_lost(void *ctx)
+{
+	ysf_rx_t *r = ctx;
+
+	if (r->sink.lost)
+		r->sink.lost(r->ctx);
+}
+
+// The profile, shared by the two modes except for the deviation.
+#define YSF_PROFILE(dev_hz) \
+	.sym_rate = 4800, \
+	.levels = 4, \
+	.shape = AIR_SHAPE_RRC, \
+	.shape_param = 20, \
+	.dev_outer_hz = (dev_hz), \
+	.timing = AIR_TIMING_CONTINUOUS, \
+	.bw = RADIO_BW_12K5, \
+	.sync_every_syms = YSF_FRAME_DIBITS, \
+	.sync_any_syms = YSF_FRAME_DIBITS, \
+	.idle = 0xD4, \
+	.nsyncs = 1, \
+	.sync = { { .id = 0, .nsyms = 20, .max_errs = 2, .frame_at = 0, \
+		    .syms = { 0xD4, 0x71, 0xC9, 0x63, 0x4D } } }
+
+const air_mode_t ysf_air_mode = {
+	.name = "YSF",
+	.profile = {
+		YSF_PROFILE(2700),	// Wide: +-2700/+-900 Hz
+	},
+	.frame_syms = YSF_FRAME_DIBITS,
+	.head_syms = 0,		// no head hook: fixed-length frames
+	.lost_frames = 4,		// N2 (Yaesu 4.2.1(6))
+	.rx_frame = rx_frame,
+	.rx_lost = rx_lost,
+};
+
+const air_mode_t ysf_air_mode_narrow = {
+	.name = "YSF Narrow",
+	.profile = {
+		YSF_PROFILE(1350),	// Narrow: +-1350/+-450 Hz
+	},
+	.frame_syms = YSF_FRAME_DIBITS,
+	.head_syms = 0,
+	.lost_frames = 4,
+	.rx_frame = rx_frame,
+	.rx_lost = rx_lost,
+};
diff --git a/core/ysf/ysf_rx.h b/core/ysf/ysf_rx.h
new file mode 100644
index 00000000..6011e7d6
--- /dev/null
+++ b/core/ysf/ysf_rx.h
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// YSF on the air interface (core/air): the air_mode_t profile and the
+// framer hooks, over the soft modem (RX) and the HR_C7000 native 4FSK slot
+// engine (TX). The receive chain is the 8 kHz FM copy -> air_softmodem ->
+// air_framer -> this layer -> the engine's call tracking (ysf_engine.c).
+//
+// Profile (Yaesu Rev. 1.02): 4800 symbols/s, 4 levels, RRC 0.2, Wide
+// +-2700/+-900 Hz (dev_outer_hz 2700) or Narrow +-1350/+-450 Hz (1350), a
+// 20-symbol frame sync D471C9634D at the start of every 480-symbol frame,
+// no head hook (fixed-length frames), lost after 4 missed syncs (N2).
+// The sync tolerance is 2 symbols (up to 4 bit errors); the frame is really
+// validated by the FICH CRC. The DCH CRC controls whether its data is used.
+#ifndef YSF_RX_H
+#define YSF_RX_H
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "air/air_framer.h"
+#include "ysf_frame.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// One decoded frame, handed to the sink during the framer's rx_frame
+// callback. The voice blocks are copied out of the frame here, so nothing
+// in this struct points at the framer's buffer: the sink may keep it.
+typedef struct {
+	ysf_fich fich;
+	uint8_t dch[20];	// first DCH's data (CSD1 / DN unit / DT unit)
+	uint8_t dch2[20];	// second DCH (CSD2 / Data FR DCH-2), zeros when none
+	unsigned dch_len;	// first DCH length in bytes: 20, 10 or 0 (absent or failed CRC)
+	uint8_t voice[YSF_BLOCKS][18];	// voice bytes per 20 ms block (communication frames only;
+					// header/terminator frames carry DCHs there instead, voice_len 0)
+	uint8_t voice_first; // first voice block (three slots hold the VW sub-header and reserved data)
+	uint8_t voice_len;	// bytes per voice block: 0, 9, 13 or 18
+	uint32_t t_us;		// framer time of the frame's sync
+	int16_t rssi_dbm;
+} ysf_rx_frame_t;
+
+typedef struct {
+	void (*frame)(const ysf_rx_frame_t *f, void *ctx);
+	void (*lost)(void *ctx);
+} ysf_rx_sink_t;
+
+typedef struct {
+	ysf_rx_sink_t sink;
+	void *ctx;
+	uint32_t frames;	// frames delivered to the engine
+	uint32_t fich_fail;	// frames dropped: sync or FICH bad
+	uint32_t dch_fail;	// frames with valid FICH and failed DCH CRC
+} ysf_rx_t;
+
+void ysf_rx_init(ysf_rx_t *r, const ysf_rx_sink_t *sink, void *ctx);
+
+// The air modes, Wide (2700 Hz) and Narrow (1350 Hz). The engine picks one.
+extern const air_mode_t ysf_air_mode;
+extern const air_mode_t ysf_air_mode_narrow;
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/core/ysf/ysf_tx.c b/core/ysf/ysf_tx.c
new file mode 100644
index 00000000..d0deb8da
--- /dev/null
+++ b/core/ysf/ysf_tx.c
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// YSF transmitter: sequence builder (one frame at a time). See ysf_tx.h for
+// the sequence tables (Yaesu Tables 4-3/4-4, MMDVM YSFPayload.cpp). The host
+// prototype's streamer (ysf_tx_init / ysf_tx_dibits / ysf_tx_samples, which
+// feeds dibits through ysf_mod) is NOT ported: the firmware streams dibits
+// through the air session (air_session_tx) to the HR_C7000 native 4FSK slot
+// engine, so the engine (ysf_engine.c) calls ysf_tx_frame_build once per
+// frame instead.
+#include "ysf_tx.h"
+#include <string.h>
+
+unsigned ysf_tx_total_frames(const ysf_tx_config *cfg)
+{
+	return 2u + 8u * (cfg->cycles ? cfg->cycles : 1u);
+}
+
+// Voice-block length of one 20 ms block in this mode.
+static unsigned voice_len(uint8_t dt)
+{
+	switch (dt) {
+	case YSF_DT_VD_MODE1: return 9;  // VCH
+	case YSF_DT_VD_MODE2: return 13;  // VCH 9 + VeCH 4
+	case YSF_DT_VOICE_FR: return 18;  // VCH
+	default: return 0;  // Data FR: no voice blocks
+	}
+}
+
+// Where the voice bytes of block b start inside the 90-byte payload.
+static unsigned voice_off(uint8_t dt, unsigned b)
+{
+	switch (dt) {
+	case YSF_DT_VD_MODE1: return 18 * b + 9;
+	case YSF_DT_VD_MODE2: return 18 * b + 5;
+	case YSF_DT_VOICE_FR: return 18 * b;
+	default: return 0;
+	}
+}
+
+static void csd1(const ysf_tx_config *c, uint8_t out[20])
+{
+	memcpy(out, c->dest, 10);
+	memcpy(out + 10, c->src, 10);
+}
+
+static void csd2(const ysf_tx_config *c, uint8_t out[20])
+{
+	memcpy(out, c->down, 10);
+	memcpy(out + 10, c->up, 10);
+}
+
+static void csd3(const ysf_tx_config *c, uint8_t out[20])
+{
+	memcpy(out, c->rem1, 10);
+	memcpy(out + 10, c->rem2, 10);
+}
+
+// One 10-byte DN data unit: Dest / Src / Down / Up / Rem1+2 / Rem3+4.
+static void dn_unit(const ysf_tx_config *c, unsigned fn, uint8_t out[10])
+{
+	switch (fn) {
+	case 0: memcpy(out, c->dest, 10); break;
+	case 1: memcpy(out, c->src, 10); break;
+	case 2: memcpy(out, c->down, 10); break;
+	case 3: memcpy(out, c->up, 10); break;
+	case 4: memcpy(out, c->rem1, 5); memcpy(out + 5, c->rem2, 5); break;
+	default: memcpy(out, c->rem3, 5); memcpy(out + 5, c->rem4, 5); break;
+	}
+}
+
+static void data_unit(const ysf_tx_config *c, unsigned index, uint8_t out[20])
+{
+	if (c->data) c->data(c->ctx, index, out);
+	else memset(out, 0, 20);
+}
+
+bool ysf_tx_frame_build(const ysf_tx_config *cfg, unsigned frame_no, uint8_t frame[YSF_FRAME_BYTES])
+{
+	unsigned cycles = cfg->cycles ? cfg->cycles : 1u;
+	unsigned total = 2u + 8u * cycles;
+	if (frame_no >= total) return false;
+	switch (cfg->dt) {
+	case YSF_DT_VD_MODE1: case YSF_DT_DATA_FR: case YSF_DT_VD_MODE2: case YSF_DT_VOICE_FR:
+		break;
+	default:
+		return false;
+	}
+	ysf_fich f;
+	memset(&f, 0, sizeof f);
+	f.cs = cfg->cs;
+	f.cm = cfg->cm;
+	f.dev = cfg->dev;
+	f.mr = cfg->mr;
+	f.voip = cfg->voip;
+	f.dt = cfg->dt;
+	f.sql = cfg->sql;
+	f.sc = cfg->dgid;
+// Header and terminator: FI 0 / 2, FN 0, CSD1 + CSD2, mode-independent.
+	if (frame_no == 0 || frame_no == total - 1) {
+		f.fi = frame_no == 0 ? YSF_FI_HEADER : YSF_FI_TERMINATOR;
+		f.fn = 0;
+		uint8_t d1[20], d2[20];
+		csd1(cfg, d1);
+		csd2(cfg, d2);
+		ysf_frame_build(&f, d1, d2, frame);
+		return true;
+	}
+// Communication frames: FN cycles 0..7, data index counts DT units.
+	unsigned fn = (frame_no - 1) % 8;
+	f.fi = YSF_FI_COMMUNICATION;
+	f.fn = (uint8_t)fn;
+	f.ft = 7;	// final index of the eight communication frames in the block
+	if (cfg->dt == YSF_DT_VOICE_FR && cfg->vw_subheader && frame_no == 1)
+		f.ft = 1;	// identify the CSD3 sub-header
+	uint8_t dch[20], dch2[20];
+	memset(dch, 0, sizeof dch);
+	memset(dch2, 0, sizeof dch2);
+	const uint8_t *second = NULL;
+	switch (cfg->dt) {
+	case YSF_DT_VD_MODE1:
+		if (fn == 0) csd1(cfg, dch);
+		else if (fn == 1) csd2(cfg, dch);
+		else if (fn == 2) csd3(cfg, dch);
+		else data_unit(cfg, fn - 3, dch);  // FN3..7 = DT1..DT5
+		break;
+	case YSF_DT_VD_MODE2:
+		if (fn < 6) dn_unit(cfg, fn, dch);
+		else data_unit(cfg, fn - 6, dch);  // FN6/7 = DT1/DT2, first 10 bytes
+		break;
+	case YSF_DT_DATA_FR:
+		if (fn == 0) {
+			csd1(cfg, dch);
+			csd2(cfg, dch2);
+			second = dch2;
+		} else if (fn == 1) {
+			csd3(cfg, dch);
+			data_unit(cfg, 0, dch2);  // DT1
+			second = dch2;
+		} else {
+			data_unit(cfg, 2 * fn - 3, dch);  // DT2, DT4, ... DT12
+			data_unit(cfg, 2 * fn - 2, dch2);  // DT3, DT5, ... DT13
+			second = dch2;
+		}
+		break;
+	default:  // VW has DCH only in the sub-header
+		if (ysf_vw_subheader(&f))
+			csd3(cfg, dch);
+		break;
+	}
+	ysf_frame_build(&f, dch, second, frame);
+// Voice blocks: overwrite the deterministic filler with the caller's
+// bytes (or zeros when there is no callback). Header/terminator have no
+// voice blocks; Data FR has none either.
+	unsigned vlen = voice_len(cfg->dt);
+	if (vlen) {
+		uint8_t *payload = frame + YSF_SYNC_BYTES + YSF_FICH_BYTES;
+		for (unsigned b = ysf_vw_subheader(&f) ? YSF_VW_SUBHEADER_FIRST_VOICE : 0; b < YSF_BLOCKS; b++) {
+			uint8_t *vch = payload + voice_off(cfg->dt, b);
+			if (cfg->voice) cfg->voice(cfg->ctx, frame_no, b, vch, vlen);
+			else memset(vch, 0, vlen);
+		}
+	}
+	return true;
+}
\ No newline at end of file
diff --git a/core/ysf/ysf_tx.h b/core/ysf/ysf_tx.h
new file mode 100644
index 00000000..620305cc
--- /dev/null
+++ b/core/ysf/ysf_tx.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// YSF transmitter, firmware: builds a whole transmission (header ->
+// communication frames FN 0..7 -> terminator), one frame at a time. Mirror
+// of the RX frame layer (ysf_frame.h): the TX chain is
+//
+//   ysf_tx_config (callsigns, mode, DG-ID)
+//     -> ysf_tx_frame_build() (FICH + DCH rotation + voice blocks)
+//     -> ysf_frame_build() (sync + FICH + DCH encode)
+//     -> ysf_bytes_to_dibits() -> air_session_tx() (HR_C7000 native 4FSK
+//        slot engine, 4800 sym/s, RRC 0.2; the deviation lives in the air
+//        profile, ysf_air_mode / ysf_air_mode_narrow)
+//
+// The host prototype (src/ysf/ysf_tx.h) also has a streamer (ysf_tx_init /
+// ysf_tx_dibits / ysf_tx_samples) that feeds dibits through ysf_mod, the
+// 8 kHz sample modulator. That streamer is NOT ported: the engine
+// (ysf_engine.c) calls ysf_tx_frame_build once per frame and paces the
+// frames itself, so it can wait for voice from the vocoder instead of
+// sending silence when the talker has not spoken yet.
+//
+// Frame sequence (Yaesu Fig. 4-1; MMDVM YSFControl.cpp / YSFPayload.cpp):
+// one header (FI 0), eight communication frames (FI 1, FN 0..7), one
+// terminator (FI 2). Longer transmissions repeat the communication block
+// (cycles > 1). FICH: FT gives the last FN and BN/BT are 0; DT is
+// the configured mode on every frame; Dev selects Wide (0) / Narrow (1);
+// SC is the DG-ID.
+//
+// DCH rotation per mode (Yaesu Tables 4-3/4-4; MMDVM processVDMode1Data /
+// processVDMode2Data / processDataFRModeData):
+//   V/D-1 (DT 0): FN0=CSD1 (Dest+Src), FN1=CSD2 (Down+Up), FN2=CSD3
+//     (Rem1+Rem2), FN3..7 = data DT1..DT5 (20 bytes each).
+//   DN (DT 2): FN0=Dest, FN1=Src, FN2=Down, FN3=Up, FN4=Rem1+Rem2 (5 bytes
+//     each), FN5=Rem3+Rem4, FN6/7 = data DT1/DT2 (10 bytes each).
+//   Data FR (DT 1): FN0: DCH-1=CSD1, DCH-2=CSD2; FN1: DCH-1=CSD3,
+//     DCH-2=DT1; FN2..7: DCH-1/DCH-2 = DT2/DT3 .. DT12/DT13 (20 bytes each).
+//   VW (DT 3): optionally send CSD3 and two voice blocks in the first CC
+//     (FT=1/FN=0). Subsequent communication frames carry five voice blocks.
+// The header and the terminator always carry CSD1 + CSD2 (two DCH1s),
+// whatever the mode (MMDVM writeHeader / processHeaderData).
+//
+// Voice: the caller supplies the voice bytes of each 20 ms block through the
+// voice callback (9 bytes V/D-1, 13 bytes DN: VCH 9 + VeCH 4, 18 bytes VW).
+// With no callback the voice blocks are all zero: a deterministic test
+// payload, NOT a valid AMBE silence frame. The engine (ysf_engine.c)
+// supplies AMBE+2 for V/D-1 and DN, and IMBE-compatible full-rate voice for VW.
+//
+// Integer arithmetic only, no allocation.
+#ifndef YSF_TX_H
+#define YSF_TX_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include "ysf_frame.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Data units: the data callback fills one unit (20 bytes; DN uses the first
+// 10). index counts DT units from 0 (DT1): V/D-1 FN3..7 -> 0..4, DN FN6/7 ->
+// 0..1, Data FR FN1 DCH-2 .. FN7 DCH-2 -> 0..12.
+typedef void (*ysf_tx_data_fn)(void *ctx, unsigned index, uint8_t out[20]);
+// Voice blocks: fills one 20 ms block's voice bytes (vch_len: 9 V/D-1,
+// 13 DN, 18 VW). frame_no is the sequence frame number (1..8*cycles,
+// communication frames only). The VW sub-header calls back only for blocks 3 and 4.
+typedef void (*ysf_tx_voice_fn)(void *ctx, unsigned frame_no, unsigned block,
+								uint8_t *vch, unsigned vch_len);
+
+typedef struct {
+	uint8_t dt;  // YSF_DT_VD_MODE1 / DATA_FR / VD_MODE2 / VOICE_FR
+	uint8_t dev;  // 0 = Wide (+-2700/+-900 Hz), 1 = Narrow (+-1350/+-450 Hz)
+	uint8_t cm;  // YSF_CM_GROUP / RADIO_ID / INDIVIDUAL
+	uint8_t mr;  // YSF_MR_DIRECT / DOWNLINK_FREE / DOWNLINK_BUSY
+	uint8_t cs;  // 2 bits, usually 0
+	uint8_t sql;  // 0 = DG-ID squelch enabled, 1 = disabled
+	uint8_t voip;  // 0 = RF, 1 = VoIP
+	uint8_t dgid;  // FICH SC: 0 = none, 1..126 = codes, 127 = Break Out
+	char dest[YSF_CALLSIGN_LEN];
+	char src[YSF_CALLSIGN_LEN];
+	char down[YSF_CALLSIGN_LEN];
+	char up[YSF_CALLSIGN_LEN];
+	char rem1[YSF_CALLSIGN_LEN];
+	char rem2[YSF_CALLSIGN_LEN];
+	char rem3[YSF_CALLSIGN_LEN];
+	char rem4[YSF_CALLSIGN_LEN];
+	bool vw_subheader;  // send the CSD3 sub-header in the first VW communication frame
+	unsigned cycles;  // communication-block repeats, >= 1 (1 = 10 frames)
+	ysf_tx_data_fn data;  // NULL: data units are zero-filled
+	ysf_tx_voice_fn voice;  // NULL: voice blocks are zero-filled (test payload, not AMBE)
+	void *ctx;
+} ysf_tx_config;
+
+// Total frames of a transmission: 2 + 8 * cycles (header + cycles x 8 CC + terminator).
+unsigned ysf_tx_total_frames(const ysf_tx_config *cfg);
+
+// Build one frame of the sequence: frame_no 0 = header, 1..8*cycles =
+// communication (FN (frame_no-1) % 8), last = terminator. False when
+// frame_no is out of range or the mode is unknown.
+bool ysf_tx_frame_build(const ysf_tx_config *cfg, unsigned frame_no, uint8_t frame[YSF_FRAME_BYTES]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/core/ysf/ysf_voice.c b/core/ysf/ysf_voice.c
new file mode 100644
index 00000000..e77292e3
--- /dev/null
+++ b/core/ysf/ysf_voice.c
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// YSF voice: half-rate AMBE+2 between a decoded YSF frame and the 9-byte
+// DMR-format AMBE frame the vocoder path speaks. See ysf_voice.h for what
+// is verified and what is not.
+#include "ysf_voice.h"
+
+#include <string.h>
+
+#include "../dmr/ambe/ambeFec.h"
+
+// Bit helpers, MSB first (the same order as ysf_frame.c).
+static int get_bit(const uint8_t *p, unsigned i) { return (p[i >> 3] >> (7 - (i & 7))) & 1; }
+static void put_bit(uint8_t *p, unsigned i, int b)
+{
+	if (b) p[i >> 3] |= (uint8_t)(0x80u >> (i & 7));
+	else p[i >> 3] &= (uint8_t)~(0x80u >> (i & 7));
+}
+
+unsigned ysf_voice_len(uint8_t dt)
+{
+	switch (dt) {
+	case YSF_DT_VD_MODE1: return 9;	// VCH
+	case YSF_DT_VD_MODE2: return 13;	// VCH 9 + VeCH 4
+	case YSF_DT_VOICE_FR: return 18;	// VCH
+	default: return 0;			// Data FR: no voice blocks
+	}
+}
+
+unsigned ysf_voice_get(const uint8_t frame[YSF_FRAME_BYTES], uint8_t dt, unsigned block, uint8_t out[18])
+{
+	unsigned len = ysf_voice_len(dt);
+
+	if (block >= YSF_BLOCKS || !len)
+		return 0;
+	// Payload layout per 20 ms block (18 bytes): V/D-1 [DCH1 9][VCH 9],
+	// DN [DCH2 5][VCH 9][VeCH 4], VW [VCH 18].
+	const uint8_t *payload = frame + YSF_SYNC_BYTES + YSF_FICH_BYTES + 18 * block;
+	switch (dt) {
+	case YSF_DT_VD_MODE1: memcpy(out, payload + 9, 9); break;
+	case YSF_DT_VD_MODE2: memcpy(out, payload + 5, 13); break;
+	default: memcpy(out, payload, 18); break;
+	}
+	return len;
+}
+
+// DN voice interleave, 26x4 over the 104 bits: TABLE[i] = 4*(i mod 26) + (i div 26)
+// (MMDVM AMBEFEC::regenerateYSFDN; Yaesu Fig. 4-32).
+static unsigned dn_table(unsigned i) { return 4 * (i % 26) + (i / 26); }
+
+void ysf_voice_dn_to_frame(const uint8_t field[13], uint8_t frame9[9], unsigned *errors)
+{
+	uint8_t vch[13];
+	uint8_t white[20];
+	uint8_t params[AMBE_PARAM_BITS];
+	unsigned errs = 0;
+
+	// De-interleave: vch[i] = field[TABLE[i]].
+	memset(vch, 0, sizeof vch);
+	for (unsigned i = 0; i < 104; i++)
+		put_bit(vch, i, get_bit(field, dn_table(i)));
+	// De-whiten with the first 13 bytes of the PN(9,5) sequence.
+	ysf_whitening_generate(white);
+	for (unsigned i = 0; i < 13; i++)
+		vch[i] ^= white[i];
+	// The first 27 parameters are tripled: majority vote. A non-unanimous
+	// triplet counts as one error (MMDVM counts it the same way).
+	for (unsigned k = 0; k < 27; k++) {
+		unsigned ones = (unsigned)get_bit(vch, 3 * k) + (unsigned)get_bit(vch, 3 * k + 1) +
+				(unsigned)get_bit(vch, 3 * k + 2);
+
+		params[k] = ones >= 2 ? 1 : 0;
+		if (ones != 0 && ones != 3)
+			errs++;
+	}
+	// The last 22 parameters are direct: bits 81..102.
+	for (unsigned k = 27; k < 49; k++)
+		params[k] = (uint8_t)get_bit(vch, k + 54);
+	// Bit 103 is padding: ignored.
+	if (errors)
+		*errors = errs;
+	ambeFecEncode(params, frame9);
+}
+
+void ysf_voice_dn_from_frame(const uint8_t frame9[9], uint8_t field[13])
+{
+	uint8_t params[AMBE_PARAM_BITS];
+	uint8_t vch[13];
+	uint8_t white[20];
+
+	ambeFecDecode(frame9, params, NULL);
+	memset(vch, 0, sizeof vch);
+	for (unsigned k = 0; k < 27; k++) {
+		put_bit(vch, 3 * k, params[k]);
+		put_bit(vch, 3 * k + 1, params[k]);
+		put_bit(vch, 3 * k + 2, params[k]);
+	}
+	for (unsigned k = 27; k < 49; k++)
+		put_bit(vch, k + 54, params[k]);
+	// Bit 103 stays 0 (padding).
+	ysf_whitening_generate(white);
+	for (unsigned i = 0; i < 13; i++)
+		vch[i] ^= white[i];
+	// Interleave: field[TABLE[i]] = vch[i].
+	memset(field, 0, 13);
+	for (unsigned i = 0; i < 104; i++)
+		put_bit(field, dn_table(i), get_bit(vch, i));
+}
+
+
+// VW air bit for each consecutive bit in the eight IMBE codewords (MSB first).
+// Same permutation as MMDVMHost AMBEFEC::regenerateIMBE and DSD-FME fr_interleave.
+static const uint8_t vw_interleave[144] = {
+	  0,   7,  12,  19,  24,  31,  36,  43,  48,  55,  60,  67,
+	 72,  79,  84,  91,  96, 103, 108, 115, 120, 127, 132, 139,
+	  1,   6,  13,  18,  25,  30,  37,  42,  49,  54,  61,  66,
+	 73,  78,  85,  90,  97, 102, 109, 114, 121, 126, 133, 138,
+	  2,   9,  14,  21,  26,  33,  38,  45,  50,  57,  62,  69,
+	 74,  81,  86,  93,  98, 105, 110, 117, 122, 129, 134, 141,
+	  3,   8,  15,  20,  27,  32,  39,  44,  51,  56,  63,  68,
+	 75,  80,  87,  92,  99, 104, 111, 116, 123, 128, 135, 140,
+	  4,  11,  16,  23,  28,  35,  40,  47,  52,  59,  64,  71,
+	 76,  83,  88,  95, 100, 107, 112, 119, 124, 131, 136, 143,
+	  5,  10,  17,  22,  29,  34,  41,  46,  53,  58,  65,  70,
+	 77,  82,  89,  94, 101, 106, 113, 118, 125, 130, 137, 142,
+};
+static const uint8_t vw_word_bits[8] = { 23, 23, 23, 23, 15, 15, 15, 7 };
+
+uint8_t ysf_voice_vw_decode(const uint8_t field[18], uint8_t imbe[FEC_IMBE88_BYTES])
+{
+	uint32_t words[8] = {0};
+	unsigned k = 0;
+
+	for (unsigned i = 0; i < 8; i++)
+		for (unsigned b = 0; b < vw_word_bits[i]; b++)
+			words[i] = (words[i] << 1) | (uint32_t)get_bit(field, vw_interleave[k++]);
+	return fec_imbe88_decode(words, imbe);
+}
+
+void ysf_voice_vw_encode(const uint8_t imbe[FEC_IMBE88_BYTES], uint8_t field[18])
+{
+	uint32_t words[8];
+	unsigned k = 0;
+
+	fec_imbe88_encode(imbe, words);
+	memset(field, 0, 18);
+	for (unsigned i = 0; i < 8; i++)
+		for (unsigned b = vw_word_bits[i]; b > 0; b--)
+			put_bit(field, vw_interleave[k++], (words[i] >> (b - 1)) & 1u);
+}
diff --git a/core/ysf/ysf_voice.h b/core/ysf/ysf_voice.h
new file mode 100644
index 00000000..c8b79cc7
--- /dev/null
+++ b/core/ysf/ysf_voice.h
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// YSF voice: half-rate AMBE+2 (49 parameter bits) between a decoded YSF
+// frame and the 9-byte DMR-format AMBE frame the vocoder path speaks.
+//
+// V/D-1 (DT 0): the 72-bit VCH is exactly the DMR AMBE+2 3600x2450 frame
+// (same code words, same interleaving; core/dmr/ambe/ambeFec.c), so its
+// bytes pass through untouched. DN (DT 2): the 104-bit voice field (VCH 72
+// + VeCH 32, block bits 40..143) carries the 49 parameters raw: the first
+// 27 parameters tripled, the last 22 direct, one zero pad bit, whitened
+// with the first 13 bytes of the PN(9,5) sequence and interleaved 26x4
+// (MMDVM AMBEFEC::regenerateYSFDN / AMBEFEC.cpp; Yaesu Fig. 4-32).
+//
+// What is NOT verified here: that the 49 YSF parameters are semantically
+// the same AMBE+2 parameters the DVSI blob expects. The channel mapping is
+// proven against MMDVMHost (see the test), the parameter semantics are not:
+// no public YSF voice vector or air capture exists to prove them against.
+//
+// VW (DT 3) uses the IMBE-compatible 88-bit speech data, with its own permutation
+// of the Golay/Hamming-protected bits.
+#ifndef YSF_VOICE_H
+#define YSF_VOICE_H
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "ysf_frame.h"
+#include "fec/imbe88.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Voice bytes of one 20 ms block in this mode: V/D-1 9, DN 13, VW 18,
+// Data FR 0.
+unsigned ysf_voice_len(uint8_t dt);
+
+// Voice bytes of block `block` (0..4) of a decoded frame, into out (18
+// bytes). Returns the length (0, 9, 13 or 18); 0 when the mode has no voice
+// blocks or the block is out of range.
+unsigned ysf_voice_get(const uint8_t frame[YSF_FRAME_BYTES], uint8_t dt, unsigned block, uint8_t out[18]);
+
+// DN voice field (13 bytes: VCH 9 + VeCH 4) -> 9-byte DMR-format AMBE frame:
+// de-interleave, de-whiten, majority vote per triplet, ambeFecEncode.
+// errors counts the non-unanimous triplets (NULL to ignore); the pad bit
+// (bit 103) is ignored -- MMDVM notes it is apparently not always 0 on air.
+void ysf_voice_dn_to_frame(const uint8_t field[13], uint8_t frame9[9], unsigned *errors);
+
+// 9-byte DMR-format AMBE frame -> DN voice field: ambeFecDecode, triplicate
+// the first 27 parameters, whiten, interleave. The pad bit is sent as 0.
+void ysf_voice_dn_from_frame(const uint8_t frame9[9], uint8_t field[13]);
+
+// VW: 18 bytes on air, 11 packed vocoder bytes. Decode returns the IMBE FEC error byte.
+uint8_t ysf_voice_vw_decode(const uint8_t field[18], uint8_t imbe[FEC_IMBE88_BYTES]);
+void ysf_voice_vw_encode(const uint8_t imbe[FEC_IMBE88_BYTES], uint8_t field[18]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
