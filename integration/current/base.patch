+// Whether saving takes away what a stored channel of a kind carries beyond what the new mode brings: a system or a
+// fallback (a trunked channel's), or its own mode's tag where the copy is a plain channel again. Replacing P25's,
+// NXDN's or AM's tag by another of those is what the user asked for with the Mode row
+static bool ced_drops_tag(void)
+{
+	if (ced_orig.kind == CODEPLUG_KIND_NONE || ced_ch.kind == ced_orig.kind)
+		return false;
+	bool trunk = ced_orig.kind == CODEPLUG_KIND_DMR_TRUNK || ced_orig.kind == CODEPLUG_KIND_P25_TRUNK;
+	bool to_mode = ced_ch.kind == CODEPLUG_KIND_AM || ced_is_p25(&ced_ch) || ced_is_nxdn(&ced_ch) || ced_is_ysf(&ced_ch);
+	return trunk || !to_mode;
