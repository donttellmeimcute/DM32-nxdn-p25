+// ── A YSF call through the tap, the modem, the framer and the receive hooks ──
+static ysf_rx_frame_t ysf_got[16];
+static uint8_t ysf_ngot, ysf_nlost;
+static uint8_t ysf_voice_want[10][YSF_BLOCKS][9];
+
+static void ysf_on_frame(const ysf_rx_frame_t *f, void *ctx)
+{
+	(void)ctx;
+	if (ysf_ngot < 16)
+		ysf_got[ysf_ngot++] = *f;
+}
+
+static void ysf_on_lost(void *ctx)
+{
+	(void)ctx;
+	ysf_nlost++;
+}
+
+static void ysf_tx_data_cb(void *ctx, unsigned index, uint8_t out[20])
+{
+	(void)ctx;
+	for (unsigned k = 0; k < 20; k++)
+		out[k] = (uint8_t)(0x40 + index);
+}
+
+static void ysf_tx_voice_cb(void *ctx, unsigned frame_no, unsigned block, uint8_t *vch, unsigned vch_len)
+{
+	(void)ctx;
+	if (frame_no >= 1 && frame_no <= 8 && block < YSF_BLOCKS && vch_len == 9)
+		memcpy(vch, ysf_voice_want[frame_no][block], 9);
+}
+
+static void testYsfCall(void)
+{
+	static uint8_t fbuf[YSF_FRAME_BYTES];
+	static int8_t fsoft[YSF_FRAME_DIBITS];
+	static const ysf_rx_sink_t sink = { ysf_on_frame, ysf_on_lost };
+	ysf_tx_config cfg;
+	ysf_rx_t rx;
+	air_framer_t fr;
+	air_softmodem_t m;
+	air_profile_t p = ysf_air_mode.profile;
+	static const struct { double cpk, off, sigma; uint16_t told, quiet; uint8_t frames_min; const char *what; } t[] = {
+		{ 2000, 0, 0, 2000, 0, 10, "clean" },
+		{ 1700, 800, 250, 2000, 0, 9, "low, offset, noise" },
+		{ 2000, -500, 350, 0, 0, 9, "unknown scale, noise" },
+		{ 2000, -500, 100, 0, 4000, 10, "unknown scale, quiet carrier first" },
+	};
+	uint32_t at[10], call_from, call_to;
+
+	// The transmission: header, 8 communication frames, terminator, V/D-1
+	memset(&cfg, 0, sizeof cfg);
+	cfg.dt = YSF_DT_VD_MODE1;
+	cfg.cm = YSF_CM_GROUP;
+	cfg.mr = YSF_MR_DIRECT;
+	cfg.dgid = 7;
+	memcpy(cfg.dest, "CQ        ", 10);
+	memcpy(cfg.src, "XE1ARS    ", 10);
+	memcpy(cfg.down, "DOWN      ", 10);
+	memcpy(cfg.up, "UP        ", 10);
+	memcpy(cfg.rem1, "REM1      ", 10);
+	memcpy(cfg.rem2, "REM2      ", 10);
+	cfg.cycles = 1;
+	cfg.data = ysf_tx_data_cb;
+	cfg.voice = ysf_tx_voice_cb;
+	for (unsigned fn = 1; fn <= 8; fn++)
+		for (unsigned b = 0; b < YSF_BLOCKS; b++)
+			for (unsigned k = 0; k < 9; k++)
+				ysf_voice_want[fn][b][k] = (uint8_t)(fn * 41 + b * 11 + k);
+	air_n = 0;
+	for (unsigned fn = 0; fn < 10; fn++) {
+		uint8_t frame[YSF_FRAME_BYTES];
+
+		CHECK(ysf_tx_frame_build(&cfg, fn, frame), "ysf tx frame %u builds", fn);
+		at[fn] = air_n;
+		ysf_bytes_to_dibits(frame, YSF_FRAME_BYTES, air + air_n);
+		air_n += YSF_FRAME_DIBITS;
+	}
+	call_from = 0;
+	call_to = air_n;
+	modulate(&p, 0);
+
+	for (uint8_t i = 0; i < sizeof(t) / sizeof(t[0]); i++) {
+		static int16_t all[WAVE_MAX / 30 + 16000];
+		uint32_t n = 0, lead = 6000, phase = 3 + 8 * i, first, last;
+		uint8_t bad_voice = 0;
+
+		sample_tap(8000, phase, 3600, t[i].cpk, t[i].off, t[i].sigma);
+		first = (uint32_t)((sym_at(&p, call_from) - phase - LPF_HALF) / 30);
+		last = (uint32_t)((sym_at(&p, call_to - 1) - phase - LPF_HALF) / 30);
+		for (uint32_t j = 0; j < lead; j++)
+			all[n++] = (int16_t)lround(t[i].off + 2.5 * t[i].cpk * gauss());
+		for (uint32_t j = 0; j < t[i].quiet; j++)
+			all[n++] = (int16_t)lround(t[i].off + t[i].sigma * gauss());
+		for (uint32_t j = first; j <= last; j++)
+			all[n++] = tap[j];
+		for (uint32_t j = 0; j < 4000; j++)
+			all[n++] = (int16_t)lround(t[i].off + 2.5 * t[i].cpk * gauss());
+
+		ysf_ngot = ysf_nlost = 0;
+		ysf_rx_init(&rx, &sink, NULL);
+		air_framer_init(&fr, &ysf_air_mode, &rx, fbuf, fsoft, YSF_FRAME_DIBITS);
+		CHECK(air_softmodem_rx_open(&m, &p, 8000, t[i].told, on_chunk, NULL), "open");
+		out_reset();
+		out_framer = &fr;
+		for (uint32_t from = 0; from < n; from += 256)
+			air_softmodem_rx(&m, all + from, (uint16_t)(n - from < 256 ? n - from : 256), T0 + from * 125u);
+		out_framer = NULL;
+		CHECK(ysf_ngot >= t[i].frames_min && ysf_ngot <= 10, "%s: %u frames", t[i].what, ysf_ngot);
+		if (ysf_ngot < t[i].frames_min)
+			continue;
+		for (uint8_t g = 0; g < ysf_ngot; g++) {
+			const ysf_rx_frame_t *f = &ysf_got[g];
+			uint8_t fn = f->fich.fi == YSF_FI_HEADER ? 0 : f->fich.fi == YSF_FI_TERMINATOR ? 9 :
+								   (uint8_t)(f->fich.fn + 1);
+			double want = (lead + t[i].quiet - (double)first) * 125 + model_us(phase, sym_at(&p, at[fn]));
+			double d = (double)(uint32_t)(f->t_us - T0) - want;
+
+			CHECK(fabs(d) < 30, "%s frame %u: time off %.0f us", t[i].what, fn, d);
+			CHECK(f->fich.dt == YSF_DT_VD_MODE1 && f->fich.sc == 7, "%s frame %u: fich", t[i].what, fn);
+			if (fn == 0) {
+				CHECK(f->fich.fi == YSF_FI_HEADER && f->dch_len == 20 &&
+				      !memcmp(f->dch, "CQ        XE1ARS    ", 20) &&
+				      !memcmp(f->dch2, "DOWN      UP        ", 20), "%s: header", t[i].what);
+			} else if (fn == 9) {
+				CHECK(f->fich.fi == YSF_FI_TERMINATOR && f->dch_len == 20 &&
+				      !memcmp(f->dch, "CQ        XE1ARS    ", 20), "%s: terminator", t[i].what);
+			} else {
+				unsigned cc = fn - 1;
+
+				CHECK(f->fich.fi == YSF_FI_COMMUNICATION && f->fich.fn == cc, "%s cc %u fn", t[i].what,
+				      cc);
+				if (cc == 0)
+					CHECK(!memcmp(f->dch, "CQ        XE1ARS    ", 20), "%s: fn0 csd1", t[i].what);
+				else if (cc == 1)
+					CHECK(!memcmp(f->dch, "DOWN      UP        ", 20), "%s: fn1 csd2", t[i].what);
+				else if (cc == 2)
+					CHECK(!memcmp(f->dch, "REM1      REM2      ", 20), "%s: fn2 csd3", t[i].what);
+				else
+					CHECK(f->dch[0] == 0x40 + cc - 3, "%s: fn%u data", t[i].what, cc);
+				for (unsigned b = 0; b < YSF_BLOCKS; b++)
+					if (f->voice_len != 9 || memcmp(f->voice[b], ysf_voice_want[fn][b], 9))
+						bad_voice++;
+			}
