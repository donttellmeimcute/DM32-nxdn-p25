diff --git a/tests/host/voiceCipherTest.c b/tests/host/voiceCipherTest.c
new file mode 100644
index 00000000..b36fd8b0
--- /dev/null
+++ b/tests/host/voiceCipherTest.c
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// AES-256 voice keystreams against vectors this firmware did not make: P25 (TIA-102.AAAD-A layout) against the masks
+// OP25 computes for one key and MI (as this fork's earlier patch series carried them), NXDN against the standard's
+// own test vectors (TS 1-D 7.2.1.3 frames, TS 1-A 7.2.1.1 tone, TS 1-A 6.4.1.2 VCALL_IV).
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "p25/p25.h"
+#include "nxdn/nxdn.h"
+#include "nxdn/nxdn_aes.h"
+
+static void unhex(const char *s, uint8_t *out, unsigned n)
+{
+	for (unsigned i = 0; i < n; i++) {
+		unsigned x;
+		assert(sscanf(s + 2 * i, "%2x", &x) == 1);
+		out[i] = (uint8_t)x;
+	}
+}
+
+// What is XORed into each of the 18 IMBE frames (u0..u7 packed MSB first) of the superframe
+static void p25_vectors(void)
+{
+	static const char *const masks[18] = {
+		"f571cb029a93aeff9bdb7b", "317fb85b09f548d7ce6193", "144ce08f62a453abe5e540",
+		"c10a3e2f54f7692d707ebf", "dfe31ccf53509c890c30c3", "3c9dd5d2671c98b57138bf",
+		"05ae2f2250d471b0f2c337", "873be6db55a512f359c9a8", "173eaf102f8aa448c5d899",
+		"b1511bb4e71228410744a3", "89da845232d10771333120", "7577848f2626a4aa396a6f",
+		"b9af2090cf197ceee18570", "d381089575f6fa21aa6247", "8025feceda2a8c8f72f360",
+		"2c95e8a6bc8b450969574c", "e8f7b5321e62fab980355b", "f396bcc07e65b93586017f",
+	};
+	uint8_t key[32], mi[8], want[11], got[11];
+	aes_ofb_t ofb;
+
+	unhex("0123456789abcdef23456789abcdef01456789abcdef01236789abcdef012345", key, 32);
+	unhex("1234567890abcdef", mi, 8);
+	// The MI LFSR: two steps of the same MI as OP25 makes them
+	p25_aes_mi_next(mi);
+	unhex("6fe2802aa403828b", want, 8);
+	assert(memcmp(mi, want, 8) == 0);
+	p25_aes_mi_next(mi);
+	unhex("ff35b1909449b835", want, 8);
+	assert(memcmp(mi, want, 8) == 0);
+	unhex("1234567890abcdef", mi, 8);
+	for (unsigned ldu = 0; ldu < 2; ldu++) {
+		p25_aes_start(&ofb, key, mi, ldu != 0);
+		for (unsigned n = 0; n < 9; n++) {
+			memset(got, 0, sizeof got);
+			if (n == 8)
+				aes_ofb_skip(&ofb, 2);	// as p25_call.c does: the LSD's two octets
+			aes_ofb_xor(&ofb, got, sizeof got);
+			unhex(masks[9 * ldu + n], want, sizeof want);
+			assert(memcmp(got, want, sizeof got) == 0);
+		}
+	}
+}
+
+static void nxdn_vectors(void)
+{
+	// TS 1-D 7.2.1.3, EHR: the 1031 Hz tone pattern encrypted over two superframes, one line a VCH
+	static const char *const frames[NXDN_AES_SESSION_VCH] = {
+		"BD4503BDC7F187AF31", "72FFC7506DB58330D0", "5C0BC6F1471DDE572B", "17D7202AF5EA342472",
+		"4AEF6528DA8145E9BD", "916D09EC70C2D7E5FC", "15A25D968FD1A7F14E", "DB6E471655BBA93502",
+		"6579296763DCF3F8CD", "4E97E1AB77B9C8E5C8", "A1390C285695DB3667", "BBAE0D4F69A2FC8AFF",
+		"2D60701DF171C735B7", "F40E8FB1BB3F9A558D", "7485751FE484A653BB", "644E705B916A310BCF",
+		"50DD37B40C5EBD3638", "6CB7C18B179DB8F2CB", "49245FCEB8D050735F", "7E2D9F89A6ED1FA25F",
+		"E894C53A4D7B5AFBBF", "2CB7A7B4B827B6BD42", "D1F438BC58B930432B", "664A0B0155CBE78BBC",
+		"C683C9BAE6002F0D04", "E8D8D9ACDA07ADE722", "79B5E87D9E41418C13", "E220F3E27131907C6B",
+		"2948D6C1C2EFA230C0", "73B3D3BCFA3E3BB0C7", "00D78E91160FD8FA75", "0FA9A6E8D5160D1F3C",
+	};
+	uint8_t key[32], iv[8], next[8], want[10], got[10], tone[9];
+
+	unhex("ABCDEF0123456789CDEF0123456789ABEF0123456789ABCD0123456789ABCDEF", key, 32);
+	unhex("ABCDEF1234567890", iv, 8);
+	memcpy(next, iv, 8);
+	aes_voice_iv_next(next);
+	unhex("8B8DDEEB890F4CF1", want, 8);
+	assert(memcmp(next, want, 8) == 0);
+	unhex("CEA8FE83ACC458200A", tone, 9);	// TS 1-A 7.2.1.1, with its FEC
+	for (unsigned n = 0; n < NXDN_AES_SESSION_VCH; n++) {
+		memcpy(got, tone, 9);
+		nxdn_aes_vch(key, iv, n, got);
+		unhex(frames[n], want, 9);
+		if (memcmp(got, want, 9)) {
+			fprintf(stderr, "NXDN standard frame %u differs\n", n);
+			assert(0);
+		}
+		got[0] ^= 0x80;	// a channel error in C0 (air bit 0): the Golay code corrects it before decrypting
+		nxdn_aes_vch(key, iv, n, got);
+		assert(memcmp(got, tone, 9) == 0);
+	}
+	// VCALL_IV: type in octet 0, IV in 1-8, so a SACCH superframe (72 bits) carries all of it
+	nxdn_viv_build(iv, got);
+	unhex("03ABCDEF123456789000", want, 10);
+	assert(memcmp(got, want, 10) == 0);
+	memset(next, 0, sizeof next);
+	assert(nxdn_viv_parse(got, next) && memcmp(next, iv, 8) == 0);
+	got[0] = NXDN_MSG_VCALL;
+	assert(!nxdn_viv_parse(got, next));
+}
+
+int main(void)
+{
+	p25_vectors();
+	nxdn_vectors();
+	puts("voiceCipherTest: P25 18 reference masks, NXDN 32 standard frames and VCALL_IV passed");
+	return 0;
+}
diff --git a/tests/host/ysfCodeplugTest.c b/tests/host/ysfCodeplugTest.c
new file mode 100644
index 00000000..a91d9cf9
--- /dev/null
+++ b/tests/host/ysfCodeplugTest.c
@@ -0,0 +1,306 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// Copyright (c) 2026 lyra XE1POC (changes)
+// YSF in the codeplug (core/ysf/ysf_codeplug.c, docs/spec/ysf-codeplug.md) on a simulated NOR flash: the shared
+// vectors (tests/vectors/channel-modes.txt, also read by the Codeplug Editor's tests), defaults, zeroed and short
+// blocks, a channel's set-up from its tag, the radio-wide record and its record, and a channel written from the radio
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "codeplug/codeplug.h"
+#include "codeplug/codeplug_kv.h"
+#include "codeplug/codeplug_tag.h"
+#include "codeplug/codeplug_records.h"
+#include "ysf/ysf_codeplug.h"
+#include "storage/storage.h"
+#include "sim/sim_flash.h"
+
+static int failures;
+
+#define CHECK(cond) do { if (!(cond)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
+
+void storage_lock(void) {}
+void storage_unlock(void) {}
+
+// The board's air interface (core/radio/radio_ysf.c in the firmware): whether the radio runs kind 6 here
+static bool fits;
+bool radio_ysf_fits(void) { return fits; }
+
+#define FLASH_SIZE	0x200000u
+
+static const hal_flash_map_t map = {
+	.settings_addr = 0x11000u, .settings_size = 0x8000u, .journal_addr = 0x19000u,
+	.openfw_eeprom = 0, .openfw_flash = 0x20000u, .openfw_end = FLASH_SIZE,
+	.calibration_addr = 0x10000u, .calibration_size = 0x200u,
+};
+
+static band_t bands[] = { { 136000000, 174000000, true }, { 400000000, 900000000, true } };
+
+const board_t board = { .name = "test", .bands = bands, .band_count = 2, .power_count = 9, .flash = &sim_flash };
+
+static void fresh(void)
+{
+	sim_flash_create(FLASH_SIZE, &map);
+	CHECK(storage_init());
+	codeplug_init();
+}
+
+static int unhex(const char *s, uint8_t *out, int max)
+{
+	int n = 0;
+
+	if (strcmp(s, "-") == 0)
+		return 0;
+	while (s[0] != '\0' && s[1] != '\0' && n < max) {
+		char b[3] = { s[0], s[1], 0 };
+		out[n++] = (uint8_t)strtoul(b, NULL, 16);
+		s += 2;
+	}
+	return n;
+}
+
+static uint32_t h(const char *s) { return (uint32_t)strtoul(s, NULL, 16); }
+
+static const char *call(const char *s) { return strcmp(s, "-") == 0 ? "" : s; }
+
+// The shared vectors of kind 6 against the codec
+static void test_vectors(void)
+{
+	FILE *f = fopen("../vectors/channel-modes.txt", "r");
+	char line[256];
+	int counted = 0;
+
+	CHECK(f != NULL);
+	if (f == NULL)
+		return;
+	while (fgets(line, sizeof line, f) != NULL) {
+		char *w[8] = { 0 };
+		char *rest = NULL;
+		uint8_t b[64];
+		int n = 0;
+
+		line[strcspn(line, "\r\n")] = '\0';
+		if (line[0] == '#' || line[0] == '\0')
+			continue;
+		for (char *p = strtok_r(line, " ", &rest); p != NULL && n < 8; p = strtok_r(NULL, " ", &rest))
+			w[n++] = p;
+		if (strcmp(w[0], "ysfconv") == 0) {
+			ysf_conv_t c;
+			ysf_conv_decode(b, unhex(w[1], b, sizeof b), &c);
+			CHECK(c.dt == h(w[2]) && c.narrow == (h(w[3]) != 0) && c.rx_dgid == h(w[4]) && c.tx_dgid == h(w[5]) &&
+			      strcmp(c.dest, w[6]) == 0);
+		} else if (strcmp(w[0], "ysfenc") == 0) {
+			ysf_conv_t c = { (uint8_t)h(w[1]), h(w[2]) != 0, (uint8_t)h(w[3]), (uint8_t)h(w[4]), "" };
+			uint8_t e[YSF_CP_CONV_LEN];
+			strcpy(c.dest, w[5]);
+			ysf_conv_encode(&c, e);
+			CHECK(unhex(w[6], b, sizeof b) == YSF_CP_CONV_LEN && memcmp(e, b, YSF_CP_CONV_LEN) == 0);
+		} else if (strcmp(w[0], "ysfident") == 0) {
+			ysf_identity_t id;
+			ysf_identity_decode(b, unhex(w[1], b, sizeof b), &id);
+			CHECK(strcmp(id.src, call(w[2])) == 0 && strcmp(id.down, call(w[3])) == 0 &&
+			      strcmp(id.up, call(w[4])) == 0);
+		} else {
+			continue;
+		}
+		counted++;
+	}
+	fclose(f);
+	CHECK(counted >= 20);
+}
+
+static channel_t make(const char *name, uint32_t rx, uint32_t tx)
+{
+	channel_t c;
+
+	memset(&c, 0, sizeof c);
+	strncpy(c.name, name, CODEPLUG_NAME_LEN);
+	c.rx_hz = rx;
+	c.tx_hz = tx;
+	c.mode = RADIO_MODE_DMR;
+	c.rx_only = true;
+	c.power = CODEPLUG_POWER_DEFAULT;
+	c.color_code = 1;
+	c.timeslot = 1;
+	c.system = CODEPLUG_SYSTEM_NONE;
+	return c;
+}
+
+static void test_conv_load(void)
+{
+	ysf_conv_t yc = { .dt = YSF_DT_VD_MODE2, .narrow = true, .rx_dgid = 127, .tx_dgid = 5, .dest = "XE1ARS" };
+	uint8_t blk[YSF_CP_CONV_LEN];
+	codeplug_tag_t t = { .kind = CODEPLUG_KIND_YSF, .system = CODEPLUG_SYSTEM_NONE, .flags = CODEPLUG_TAG_TX };
+	ysf_conv_cfg_t cfg;
+	channel_t c;
+
+	fresh();
+	c = make("YSF Ops", 439250000, 434250000);
+	CHECK(codeplug_set_channel(10, &c));
+	ysf_conv_encode(&yc, blk);
+	CHECK(codeplug_tag_write(10, "YSF Ops", &t, blk, sizeof blk));
+	CHECK(codeplug_channel(10, &c) && c.kind == CODEPLUG_KIND_YSF && !c.rx_only);
+	// Run where the board's air interface carries YSF, parked elsewhere, whatever the codec says
+	fits = false;
+	CHECK(!codeplug_kind_built(CODEPLUG_KIND_YSF) && strcmp(codeplug_kind_name(c.kind), "YSF") == 0);
+	fits = true;
+	CHECK(codeplug_kind_built(CODEPLUG_KIND_YSF));
+
+	CHECK(ysf_conv_load(10, &c, &cfg));
+	CHECK(cfg.conv.dt == YSF_DT_VD_MODE2 && cfg.conv.narrow && cfg.conv.rx_dgid == 127 && cfg.conv.tx_dgid == 5 &&
+	      strcmp(cfg.conv.dest, "XE1ARS") == 0);
+	// No radio-wide record yet: the call signs are empty
+	CHECK(cfg.id.src[0] == '\0' && cfg.id.down[0] == '\0' && cfg.id.up[0] == '\0');
+	// The radio-wide record: the source, downlink and uplink call signs
+	{
+		uint8_t rec[YSF_CP_IDENTITY_LEN];
+
+		memset(rec, ' ', sizeof rec);
+		memcpy(&rec[0], "XE1ARS", 6);
+		memcpy(&rec[10], "XE1ARS", 6);
+		memcpy(&rec[20], "XE1RPT", 6);
+		CHECK(codeplug_kv_set((uint16_t)(CODEPLUG_KEY_MODE_SET + CODEPLUG_KIND_YSF), rec, sizeof rec));
+		CHECK(ysf_conv_load(10, &c, &cfg) && strcmp(cfg.id.src, "XE1ARS") == 0 &&
+		      strcmp(cfg.id.down, "XE1ARS") == 0 && strcmp(cfg.id.up, "XE1RPT") == 0);
+		// A short record leaves the rest empty
+		CHECK(codeplug_kv_set((uint16_t)(CODEPLUG_KEY_MODE_SET + CODEPLUG_KIND_YSF), rec, 10));
+		CHECK(ysf_conv_load(10, &c, &cfg) && strcmp(cfg.id.src, "XE1ARS") == 0 && cfg.id.down[0] == '\0' &&
+		      cfg.id.up[0] == '\0');
+		// A record of all spaces reads empty
+		memset(rec, ' ', sizeof rec);
+		CHECK(codeplug_kv_set((uint16_t)(CODEPLUG_KEY_MODE_SET + CODEPLUG_KIND_YSF), rec, sizeof rec));
+		CHECK(ysf_conv_load(10, &c, &cfg) && cfg.id.src[0] == '\0' && cfg.id.down[0] == '\0' &&
+		      cfg.id.up[0] == '\0');
+	}
+
+	// A tag without a block: the defaults, receive only
+	c = make("Zeroed", 439300000, 439300000);
+	CHECK(codeplug_set_channel(11, &c));
+	t.flags = 0;
+	CHECK(codeplug_tag_write(11, "Zeroed", &t, NULL, 0));
+	CHECK(codeplug_channel(11, &c) && c.kind == CODEPLUG_KIND_YSF && c.rx_only);
+	CHECK(ysf_conv_load(11, &c, &cfg) && cfg.conv.dt == YSF_DT_VD_MODE1 && !cfg.conv.narrow &&
+	      cfg.conv.rx_dgid == 0 && cfg.conv.tx_dgid == 0 && strcmp(cfg.conv.dest, YSF_CP_DEST_ALL) == 0);
+	// A longer block from a newer writer: the fields known read as usual
+	uint8_t longer[16] = { 0x06, 0x7F, 0x85, 'X', 'E', '1', 'A', 'R', 'S', ' ', ' ', ' ', ' ', 1, 2, 3 };
+	t.flags = CODEPLUG_TAG_TX;
+	CHECK(codeplug_tag_write(11, "Zeroed", &t, longer, sizeof longer));
+	CHECK(codeplug_channel(11, &c) && ysf_conv_load(11, &c, &cfg) && cfg.conv.dt == YSF_DT_VD_MODE2 &&
+	      cfg.conv.narrow && cfg.conv.rx_dgid == 127 && cfg.conv.tx_dgid == 5 &&
+	      strcmp(cfg.conv.dest, "XE1ARS") == 0);
+	// Another kind's channel, or a plain one: no set-up
+	channel_t plain = make("Plain", 439400000, 439400000);
+	CHECK(codeplug_set_channel(12, &plain) && codeplug_channel(12, &plain) && !ysf_conv_load(12, &plain, &cfg));
+	t.kind = CODEPLUG_KIND_P25;
+	plain = make("P25", 439500000, 439500000);
+	CHECK(codeplug_set_channel(13, &plain) && codeplug_tag_write(13, "P25", &t, NULL, 0));
+	CHECK(codeplug_channel(13, &plain) && plain.kind == CODEPLUG_KIND_P25 && !ysf_conv_load(13, &plain, &cfg));
+}
+
+// A YSF channel written from the radio (2.4): the safe stand-in first, then a new tag; an edit after lets it follow
+static void test_conv_save(void)
+{
+	ysf_conv_t yc = { .dt = YSF_DT_VD_MODE1, .rx_dgid = 12, .tx_dgid = 13, .dest = "CQ" };
+	codeplug_tag_t t = { .kind = 0x77, .system = CODEPLUG_SYSTEM_NONE, .flags = CODEPLUG_TAG_TX };
+	ysf_conv_cfg_t back;
+	codeplug_tag_t rt;
+	channel_t c, r, old;
+
+	fresh();
+	c = make("Save", 439250000, 434250000);
+	c.mode = RADIO_MODE_YSF;	// as the radio core runs it
+	c.rx_only = false;
+	// Over a plain channel with a stale tag of another kind at the number: the tag is replaced
+	old = make("Old", 439250000, 439250000);
+	CHECK(codeplug_set_channel(30, &old));
+	CHECK(codeplug_tag_write(30, "Old", &t, NULL, 0));
+	CHECK(ysf_conv_save(30, &c, &yc));
+	CHECK(codeplug_channel(30, &r) && r.kind == CODEPLUG_KIND_YSF && !r.rx_only && r.mode == RADIO_MODE_DMR);
+	CHECK(codeplug_tag_read(30, &rt) && rt.kind == CODEPLUG_KIND_YSF && rt.system == CODEPLUG_SYSTEM_NONE &&
+	      (rt.flags & CODEPLUG_TAG_TX) != 0 && (rt.flags & CODEPLUG_TAG_BASE_OWN) == 0);
+	CHECK(ysf_conv_load(30, &r, &back) && back.conv.dt == YSF_DT_VD_MODE1 && back.conv.rx_dgid == 12 &&
+	      back.conv.tx_dgid == 13 && strcmp(back.conv.dest, "CQ") == 0);
+	// The record underneath is the stand-in: a reader that knows no tags sees DMR, receive only
+	codeplug_tag_remove(30);
+	CHECK(codeplug_channel(30, &r) && r.kind == CODEPLUG_KIND_NONE && r.mode == RADIO_MODE_DMR && r.rx_only);
+	CHECK(ysf_conv_save(30, &c, &yc) && codeplug_channel(30, &r) && r.kind == CODEPLUG_KIND_YSF);
+	// Renamed from the radio: the tag follows, its block kept
+	strcpy(r.name, "Saved");
+	r.rx_only = true;
+	CHECK(codeplug_set_channel(30, &r) && codeplug_channel(30, &r) && r.kind == CODEPLUG_KIND_YSF && r.rx_only);
+	CHECK(ysf_conv_load(30, &r, &back) && back.conv.rx_dgid == 12);
+	// A copy at another number takes the tag
+	CHECK(codeplug_set_channel(31, &r) && codeplug_tag_copy(30, 31, &r));
+	CHECK(codeplug_channel(31, &r) && r.kind == CODEPLUG_KIND_YSF && ysf_conv_load(31, &r, &back) &&
+	      back.conv.tx_dgid == 13);
+	// Receive only from the radio: the tag says so
+	c.rx_only = true;
+	CHECK(ysf_conv_save(32, &c, &yc) && codeplug_channel(32, &r) && r.kind == CODEPLUG_KIND_YSF && r.rx_only);
+	// The block edited on a channel that is YSF already (the channel editor's DG-ID, data type and destination):
+	// the tag keeps its system, its fallback, its other flags and what its block holds after this firmware's
+	{
+		uint8_t longer[YSF_CP_CONV_LEN + 3];
+		uint8_t raw[sizeof longer + CODEPLUG_TAG_HEAD_MAX];
+		codeplug_tag_t kt = { .kind = CODEPLUG_KIND_YSF, .system = 2, .fb_chan = 30, .fb_check = 0x1234,
+				      .flags = CODEPLUG_TAG_FALLBACK | 0x40u };
+		ysf_conv_t ed = { .dt = YSF_DT_VD_MODE2, .narrow = true, .rx_dgid = 21, .tx_dgid = 22, .dest = "XE1ARS" };
+		channel_t base = make("Keep", 439250000, 434250000);
+
+		ysf_conv_encode(&yc, longer);
+		memcpy(&longer[YSF_CP_CONV_LEN], "\xA1\xA2\xA3", 3);
+		CHECK(codeplug_set_channel(33, &base) && codeplug_tag_write(33, "Keep", &kt, longer, sizeof longer));
+		CHECK(codeplug_channel(33, &r) && r.kind == CODEPLUG_KIND_YSF && r.system == 2 && r.rx_only);
+		strcpy(r.name, "Kept");
+		r.rx_only = false;
+		r.mode = RADIO_MODE_YSF;
+		CHECK(ysf_conv_save(33, &r, &ed));
+		CHECK(codeplug_channel(33, &r) && r.kind == CODEPLUG_KIND_YSF && r.system == 2 && !r.rx_only &&
+		      r.mode == RADIO_MODE_DMR && strcmp(r.name, "Kept") == 0);
+		CHECK(codeplug_tag_read(33, &rt) && rt.flags == (CODEPLUG_TAG_FALLBACK | CODEPLUG_TAG_TX | 0x40u) &&
+		      rt.fb_chan == 30 && rt.fb_check == 0x1234 && rt.len == CODEPLUG_TAG_HEAD_MAX + sizeof longer);
+		CHECK(ysf_conv_load(33, &r, &back) && back.conv.dt == YSF_DT_VD_MODE2 && back.conv.narrow &&
+		      back.conv.rx_dgid == 21 && back.conv.tx_dgid == 22 && strcmp(back.conv.dest, "XE1ARS") == 0);
+		CHECK(codeplug_tag_params(33, &r, raw, sizeof longer) == (int)sizeof longer &&
+		      memcmp(&raw[YSF_CP_CONV_LEN], "\xA1\xA2\xA3", 3) == 0);
+	}
+	// A mixed channel: its record is an FM channel of its own (wide, transmitting), its tag the YSF side (receive
+	// only). The DG-ID edited on the radio, which holds the channel as it runs (YSF, narrow, the tag's receive only):
+	// the FM side stays as stored, and so does the tag's flag that says the record is its own
+	{
+		uint8_t blk[YSF_CP_CONV_LEN];
+		codeplug_tag_t mt = { .kind = CODEPLUG_KIND_YSF, .flags = CODEPLUG_TAG_BASE_OWN };
+		ysf_conv_t ed = { .dt = YSF_DT_VD_MODE2, .narrow = true, .rx_dgid = 21, .tx_dgid = 22, .dest = "XE1ARS" };
+		channel_t fm = make("Mixed", 439300000, 434300000);
+
+		fm.mode = RADIO_MODE_FM;
+		fm.bw = RADIO_BW_25K;
+		fm.rx_only = false;
+		ysf_conv_encode(&yc, blk);
+		CHECK(codeplug_set_channel(34, &fm) && codeplug_tag_write(34, "Mixed", &mt, blk, sizeof blk));
+		CHECK(codeplug_channel(34, &r) && r.kind == CODEPLUG_KIND_YSF && r.rx_only && r.mode == RADIO_MODE_FM &&
+		      r.bw == RADIO_BW_25K);
+		r.mode = RADIO_MODE_YSF;
+		r.bw = RADIO_BW_12K5;
+		CHECK(ysf_conv_save(34, &r, &ed));
+		CHECK(codeplug_channel(34, &r) && r.kind == CODEPLUG_KIND_YSF && r.rx_only && r.mode == RADIO_MODE_FM &&
+		      r.bw == RADIO_BW_25K && r.tx_hz == 434300000);
+		CHECK(codeplug_tag_read(34, &rt) && rt.flags == CODEPLUG_TAG_BASE_OWN);
+		CHECK(ysf_conv_load(34, &r, &back) && back.conv.rx_dgid == 21 && back.conv.tx_dgid == 22);
+		CHECK(codeplug_tag_remove(34) && codeplug_channel(34, &r) && r.kind == CODEPLUG_KIND_NONE && !r.rx_only &&
+		      r.mode == RADIO_MODE_FM && r.bw == RADIO_BW_25K);
+	}
+}
+
+int main(void)
+{
+	test_vectors();
+	test_conv_load();
+	test_conv_save();
+	sim_flash_free();
+	if (failures) {
+		printf("ysfCodeplugTest: %d failure(s)\n", failures);
+		return 1;
+	}
+	printf("ysfCodeplugTest: all passed\n");
+	return 0;
+}
diff --git a/tests/host/ysfEngineTest.c b/tests/host/ysfEngineTest.c
new file mode 100644
index 00000000..41b4f690
--- /dev/null
+++ b/tests/host/ysfEngineTest.c
@@ -0,0 +1,595 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// The YSF engine (core/ysf/ysf_engine.c) and the air interface session under
+// it: two engines on two made-up providers whose transmit queues feed each
+// other's receivers a chunk at a time. A call from one is heard by the other
+// with its fields and its voice in order, in V/D-1 and in DN; an encoder that
+// stalls is covered with silence and never underruns the air; late entry; the
+// DG-ID squelch; an abort; narrow deviation. Voice frames are valid AMBE
+// frames (ambeFecEncode of random parameters), so the DN path converts real
+// channel frames, not patterns.
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ysf/ysf_engine.h"
+#include "ysf/ysf_voice.h"
+#include "air/air_syms.h"
+#include "dmr/ambe/ambeFec.h"
+
+static int failures, checks;
+#define CHECK(c, ...) do { checks++; if (!(c)) { failures++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static uint32_t rng_state = 0x59534621u;
+static uint32_t rng(void)
+{
+	rng_state ^= rng_state << 13;
+	rng_state ^= rng_state >> 17;
+	rng_state ^= rng_state << 5;
+	return rng_state;
+}
+
+// ── Two providers, each other's far end. A chunk is 30 ms of symbols at the session's rate ──
+#define CHUNK_MAX	144
+#define DEPTH		4
+typedef struct {
+	air_event_cb_t cb;
+	void *ctx;
+	bool open, on, begun_ev;
+	uint16_t chunk;
+	air_tx_chunk_t q[DEPTH];
+	uint8_t qn;
+	uint32_t underruns, sent_syms, now_us;
+	bool keyed;
+	uint32_t keyed_violations;
+} prov_t;
+static prov_t prov[2];
+
+static void ev(prov_t *p, uint8_t kind, const air_chunk_t *c)
+{
+	air_event_t e = { .kind = kind, .t_us = p->now_us, .chunk = c };
+
+	if (p->cb)
+		p->cb(&e, p->ctx);
+}
+
+static void deliver(prov_t *to, const uint8_t *syms, uint16_t n)
+{
+	int8_t soft[CHUNK_MAX];
+	air_chunk_t c = { .t_us = to->now_us, .nsyms = n, .sync_at = -1, .hard = syms, .soft = soft };
+
+	for (uint16_t i = 0; i < n; i++)
+		soft[i] = (int8_t)(32 * air_sym_level(air_sym_get(syms, i)));
+	if (to->open && !to->on)
+		ev(to, AIR_EV_RX, &c);
+}
+
+static void step(uint8_t i)
+{
+	prov_t *p = &prov[i], *far = &prov[i ^ 1];
+
+	p->now_us += 30000;
+	if (!p->on) {
+		if (!far->on) {
+			uint8_t noise[CHUNK_MAX / 4];
+
+			for (uint8_t k = 0; k < sizeof(noise); k++)
+				noise[k] = (uint8_t)rng();
+			deliver(p, noise, p->chunk);
+		}
+		return;
+	}
+	if (!p->keyed)
+		p->keyed_violations++;
+	if (!p->begun_ev) {
+		p->begun_ev = true;
+		ev(p, AIR_EV_TX_STARTED, NULL);
+	}
+	if (!p->qn) {
+		uint8_t idle[CHUNK_MAX / 4];
+
+		memset(idle, 0xD4, sizeof(idle));	// the YSF idle dibit pattern
+		p->underruns++;
+		deliver(far, idle, p->chunk);
+		ev(p, AIR_EV_TX_UNDERRUN, NULL);
+		return;
+	}
+	air_tx_chunk_t c = p->q[0];
+
+	memmove(p->q, p->q + 1, (size_t)(--p->qn) * sizeof(c));
+	p->sent_syms += c.nsyms;
+	deliver(far, c.syms, c.nsyms);
+	if (c.flags & AIR_TX_LAST) {
+		p->on = false;
+		ev(p, AIR_EV_TX_DONE, NULL);
+	} else {
+		ev(p, AIR_EV_TX_SPACE, NULL);
+	}
+}
+
+// The board's answer: YSF (4800 symbols/s, one sync), nothing else
+static uint32_t p_fit(const air_profile_t *pr)
+{
+	return pr->sym_rate == 4800 && pr->nsyncs == 1 ? AIR_FIT_RX | AIR_FIT_TX | AIR_FIT_SOFT : 0;
+}
+static bool p_open(uint8_t i, const air_profile_t *pr, air_event_cb_t cb, void *ctx)
+{
+	memset(&prov[i], 0, sizeof(prov[i]));
+	prov[i].cb = cb;
+	prov[i].ctx = ctx;
+	prov[i].open = true;
+	prov[i].chunk = (uint16_t)(pr->sym_rate * 3 / 100);
+	return true;
+}
+static void p_close(uint8_t i) { prov[i].open = prov[i].on = false; prov[i].cb = NULL; }
+static bool p_begin(uint8_t i) { if (!prov[i].qn) return false; prov[i].on = true; prov[i].begun_ev = false; return true; }
+static bool p_queue(uint8_t i, const air_tx_chunk_t *c)
+{
+	if (prov[i].qn == DEPTH)
+		return false;
+	prov[i].q[prov[i].qn++] = *c;
+	return true;
+}
+static void p_end(uint8_t i) { if (prov[i].qn) prov[i].q[prov[i].qn - 1].flags |= AIR_TX_LAST; }
+static void p_abort(uint8_t i) { prov[i].qn = 0; prov[i].on = false; ev(&prov[i], AIR_EV_TX_DONE, NULL); }
+
+#define PROVIDER(i) \
+	static bool open##i(const air_profile_t *pr, air_event_cb_t cb, void *ctx) { return p_open(i, pr, cb, ctx); } \
+	static void close##i(void) { p_close(i); } \
+	static void restart##i(void) { } \
+	static bool begin##i(void) { return p_begin(i); } \
+	static bool queue##i(const air_tx_chunk_t *c) { return p_queue(i, c); } \
+	static uint8_t space##i(void) { return (uint8_t)(DEPTH - prov[i].qn); } \
+	static void end##i(void) { p_end(i); } \
+	static void abort##i(void) { p_abort(i); } \
+	static uint32_t now##i(void) { return prov[i].now_us; } \
+	static hal_air_t air##i = { p_fit, open##i, close##i, restart##i, begin##i, queue##i, space##i, end##i, abort##i, \
+				    now##i, NULL, NULL, NULL, NULL, 72, DEPTH, 60, 100 };
+PROVIDER(0)
+PROVIDER(1)
+
+// ── The two radios ──
+// The DMR AMBE silence frame (core/dmr/call/dmr_call.c): a valid frame, as the voice path needs
+static const uint8_t silence[9] = { 0xB9, 0xE8, 0x81, 0x52, 0x61, 0x73, 0x00, 0x2A, 0x6B };
+#define VMAX	240
+typedef struct {
+	ysf_engine_t e;
+	uint8_t starts, updates, ends;
+	ysf_call_t call;
+	uint8_t voice[VMAX][9];
+	uint16_t nvoice;
+	uint8_t enc[VMAX][9];
+	uint16_t enc_made, enc_taken;
+	bool stuck;		// the encoder never stops: h_tx_voice keeps returning blocks after the key
+	uint8_t data[16][20];
+	uint8_t data_len[16];
+	uint16_t ndata;
+} radio_t;
+static radio_t r[2];
+
+static void h_start(const ysf_call_t *c, void *ctx) { radio_t *x = ctx; x->starts++; x->call = *c; }
+static void h_update(const ysf_call_t *c, void *ctx) { radio_t *x = ctx; x->updates++; x->call = *c; }
+static void h_end(void *ctx) { radio_t *x = ctx; x->ends++; }
+static void h_voice(const uint8_t vch[9], void *ctx)
+{
+	radio_t *x = ctx;
+
+	if (x->nvoice < VMAX)
+		memcpy(x->voice[x->nvoice++], vch, 9);
+}
+static void h_data(void *ctx, unsigned index, const uint8_t *data, unsigned len)
+{
+	radio_t *x = ctx;
+
+	if (index < 16 && x->ndata < 16) {
+		memcpy(x->data[x->ndata], data, len);
+		x->data_len[x->ndata] = (uint8_t)len;
+		x->ndata++;
+	}
+}
+static bool h_tx_voice(uint8_t vch[9], void *ctx)
+{
+	radio_t *x = ctx;
+
+	if (x->stuck) {
+		memcpy(vch, silence, 9);	// the encoder never stops: blocks keep coming after the key
+		return true;
+	}
+	if (x->enc_taken == x->enc_made)
+		return false;
+	memcpy(vch, x->enc[x->enc_taken++], 9);
+	return true;
+}
+static void h_tx_data(void *ctx, unsigned index, uint8_t out[20])
+{
+	(void)ctx;
+	for (unsigned k = 0; k < 20; k++)
+		out[k] = (uint8_t)index;
+}
+static const ysf_engine_hooks_t hooks = { .rx_start = h_start, .rx_update = h_update, .rx_voice = h_voice,
+					   .rx_end = h_end, .rx_data = h_data, .tx_voice = h_tx_voice,
+					   .tx_data = h_tx_data };
+
+static void encode(radio_t *x, uint8_t n)
+{
+	while (n-- && x->enc_made < VMAX) {
+		uint8_t bits[AMBE_PARAM_BITS];
+
+		for (uint8_t k = 0; k < AMBE_PARAM_BITS; k++)
+			bits[k] = (uint8_t)(rng() & 1u);
+		ambeFecEncode(bits, x->enc[x->enc_made]);
+		x->enc_made++;
+	}
+}
+
+static void begin(uint8_t i, const ysf_engine_cfg_t *cfg, const ysf_engine_hooks_t *h)
+{
+	hal_air_t *air = i ? &air1 : &air0;
+
+	memset(&r[i], 0, sizeof(r[i]));
+	air->tx_chunk_syms = (uint16_t)(ysf_engine_mode(cfg->narrow)->profile.sym_rate * 3 / 100);
+	CHECK(ysf_engine_begin(&r[i].e, air, cfg, h, &r[i]), "radio %u begins", i);
+}
+
+static void steps(uint16_t n)
+{
+	while (n--) {
+		step(0);
+		step(1);
+	}
+}
+
+// Radio 0 transmits: `n` chunk periods with the key down (the encoder makes 3 blocks per 2 periods, none during
+// stall_from..stall_to), then lets go and runs until the air is quiet. Returns the periods it took
+static uint16_t over(uint16_t n_key, uint16_t stall_from, uint16_t stall_to)
+{
+	uint16_t n = 0;
+
+	CHECK(ysf_engine_tx_prepare(&r[0].e), "the header is queued");
+	CHECK(ysf_engine_tx_state(&r[0].e) == AIR_TX_PRIMING && !prov[0].on, "primed, not sending");
+	prov[0].keyed = true;
+	CHECK(ysf_engine_tx_go(&r[0].e), "go");
+	for (; n < 600; n++) {
+		if (n == n_key)
+			ysf_engine_tx_stop(&r[0].e);
+		if (n < n_key && !(n >= stall_from && n < stall_to))
+			encode(&r[0], (uint8_t)(1 + (n & 1)));
+		steps(1);
+		if (ysf_engine_tx_state(&r[0].e) == AIR_TX_DONE) {
+			prov[0].keyed = false;
+			ysf_engine_tx_clear(&r[0].e);
+			break;
+		}
+	}
+	steps(20);
+	return n;
+}
+
+// The blocks heard against the blocks made: the made ones in order (silence between them is filler), from the
+// first heard. Returns the number out of order or wrong
+static uint16_t check_order(const radio_t *rx, const radio_t *tx, uint16_t *first)
+{
+	uint16_t bad = 0, k = 0, i = 0;
+
+	while (i < rx->nvoice && !memcmp(rx->voice[i], silence, 9))
+		i++;
+	while (k < tx->enc_made && i < rx->nvoice && memcmp(rx->voice[i], tx->enc[k], 9))
+		k++;	// a late entry: the first ones are missing
+	*first = k;
+	for (; i < rx->nvoice; i++) {
+		if (!memcmp(rx->voice[i], silence, 9))
+			continue;
+		if (k >= tx->enc_made || memcmp(rx->voice[i], tx->enc[k++], 9))
+			bad++;
+	}
+	return bad;
+}
+
+static ysf_engine_cfg_t base_cfg(uint8_t dt, bool narrow)
+{
+	ysf_engine_cfg_t cfg = { .dt = dt, .narrow = narrow, .rx_dgid = 0, .tx_dgid = 7,
+				 .cm = YSF_CM_GROUP, .mr = YSF_MR_DIRECT, .silence = silence };
+
+	memcpy(cfg.dest, "CQ        ", 10);
+	memcpy(cfg.src, "XE1ARS    ", 10);
+	memcpy(cfg.down, "DOWN      ", 10);
+	memcpy(cfg.up, "UP        ", 10);
+	memcpy(cfg.rem1, "REM1      ", 10);
+	memcpy(cfg.rem2, "REM2      ", 10);
+	memcpy(cfg.rem3, "REM3      ", 10);
+	memcpy(cfg.rem4, "REM4      ", 10);
+	return cfg;
+}
+
+static void testCall(uint8_t dt, bool narrow)
+{
+	ysf_engine_cfg_t cfg = base_cfg(dt, narrow);
+	ysf_engine_view_t v;
+	uint16_t n, first, bad;
+	const char *name = dt == YSF_DT_VD_MODE1 ? "V/D-1" : "DN";
+
+	CHECK(ysf_engine_fit(&air0, narrow) == (AIR_FIT_RX | AIR_FIT_TX | AIR_FIT_SOFT) &&
+	      ysf_engine_fit(NULL, false) == 0, "fit");
+	begin(0, &cfg, &hooks);
+	begin(1, &cfg, &hooks);
+	steps(10);
+	CHECK(r[0].starts == 0 && r[1].starts == 0, "%s: noise starts no call", name);
+
+	n = over(100, 0, 0);	// 3 s
+	// The end: the frame in hand finished and a terminator (100 ms), plus the queue's lead (60 ms + one chunk).
+	// Filler: a block waits for its voice only while the queue holds more than its lead, so the first ones and
+	// the last (a frame finished after the key) may be silence
+	CHECK(n > 100 && n < 112, "%s: the over ended %u periods after 100", name, n);
+	CHECK(prov[0].underruns == 0 && prov[0].keyed_violations == 0 && r[0].e.session.stats.tx_underruns == 0,
+	      "%s: underruns %u, keyed outside permission %u", name, prov[0].underruns, prov[0].keyed_violations);
+	ysf_engine_view(&r[0].e, &v);
+	CHECK(v.tx == AIR_TX_IDLE && v.tx_calls == 1 && v.tx_filler <= 40, "%s: sender's view: tx %u calls %u filler %u",
+	      name, v.tx, v.tx_calls, v.tx_filler);
+	CHECK(r[1].starts == 1 && r[1].ends == 1 && !r[1].call.late && !strcmp(r[1].call.dest, "CQ") &&
+	      !strcmp(r[1].call.src, "XE1ARS") && !strcmp(r[1].call.down, "DOWN") &&
+	      !strcmp(r[1].call.up, "UP") && !strcmp(r[1].call.rem1, "REM1") &&
+	      !strcmp(r[1].call.rem2, "REM2") && r[1].call.fich.dt == dt && r[1].call.fich.sc == 7 &&
+	      r[1].call.fich.dev == (narrow ? 1 : 0),
+	      "%s: heard: starts %u ends %u dest %s src %s", name, r[1].starts, r[1].ends, r[1].call.dest,
+	      r[1].call.src);
+	bad = check_order(&r[1], &r[0], &first);
+	CHECK(bad == 0 && first == 0 && r[0].enc_taken == r[0].enc_made && r[1].nvoice % 5 == 0 &&
+	      r[1].nvoice == r[0].enc_made + v.tx_filler,
+	      "%s: blocks made %u heard %u, %u wrong, filler %u", name, r[0].enc_made, r[1].nvoice, bad,
+	      v.tx_filler);
+	ysf_engine_view(&r[1].e, &v);
+	CHECK(!v.rx_active && v.rx_calls == 1 && !strcmp(v.rx.dest, "CQ") && v.rx_frames >= 10,
+	      "%s: receiver's view after the call", name);
+	CHECK(r[0].starts == 0, "%s: the sender did not hear itself", name);
+	CHECK(r[1].ndata >= 2, "%s: data units heard %u", name, r[1].ndata);
+	printf("  %s%s: %u voice blocks sent, %u heard, over ended %u periods after the key\n", name,
+	       narrow ? " narrow" : "", r[0].enc_made, r[1].nvoice, n - 100);
+
+	// The encoder stalls for 300 ms mid-over: silence fills in, the air never runs dry
+	r[1].starts = r[1].ends = 0;
+	r[1].nvoice = 0;
+	r[1].ndata = 0;
+	r[0].enc_made = r[0].enc_taken = 0;
+	over(60, 20, 30);
+	ysf_engine_view(&r[0].e, &v);
+	CHECK(prov[0].underruns == 0 && v.tx_filler >= 10 && v.tx_filler <= 40, "%s: stall: underruns %u filler %u",
+	      name, prov[0].underruns, v.tx_filler);
+	CHECK(r[1].starts == 1 && r[1].ends == 1 && check_order(&r[1], &r[0], &first) == 0,
+	      "%s: stall: starts %u ends %u", name, r[1].starts, r[1].ends);
+
+	// The encoder never stops after the key: the terminator is forced past the bound, so the over still ends
+	// (without it the transmitter would stay on until the radio is switched off)
+	r[1].starts = r[1].ends = 0;
+	r[1].nvoice = 0;
+	r[1].ndata = 0;
+	r[0].enc_made = r[0].enc_taken = 0;
+	r[0].stuck = false;
+	CHECK(ysf_engine_tx_prepare(&r[0].e), "prime");
+	prov[0].keyed = true;
+	CHECK(ysf_engine_tx_go(&r[0].e), "go");
+	for (n = 0; n < 600; n++) {
+		if (n == 100) {
+			ysf_engine_tx_stop(&r[0].e);
+			r[0].stuck = true;	// the voice source keeps feeding after the key
+		}
+		if (n < 100)
+			encode(&r[0], (uint8_t)(1 + (n & 1)));
+		steps(1);
+		if (ysf_engine_tx_state(&r[0].e) == AIR_TX_DONE) {
+			prov[0].keyed = false;
+			ysf_engine_tx_clear(&r[0].e);
+			break;
+		}
+	}
+	steps(20);
+	CHECK(n > 100 && n < 170 && prov[0].underruns == 0,
+	      "%s: stuck encoder: the over ended %u periods after 100, underruns %u", name, n,
+	      prov[0].underruns);
+	CHECK(r[1].starts == 1 && r[1].ends == 1 && check_order(&r[1], &r[0], &first) == 0,
+	      "%s: stuck encoder: starts %u ends %u", name, r[1].starts, r[1].ends);
+	r[0].stuck = false;
+
+	// Late entry: radio 1 opens its session 1 s into the over. Its voice starts at a frame's end, in order (the
+	// queue's lead of about 90 ms puts the frame on air at 990 ms a few blocks back)
+	ysf_engine_end(&r[1].e);
+	r[0].enc_made = r[0].enc_taken = 0;
+	CHECK(ysf_engine_tx_prepare(&r[0].e), "prime");
+	prov[0].keyed = true;
+	CHECK(ysf_engine_tx_go(&r[0].e), "go");
+	for (n = 0; n < 300; n++) {
+		if (n == 33)
+			begin(1, &cfg, &hooks);
+		if (n == 100)
+			ysf_engine_tx_stop(&r[0].e);
+		if (n < 100)
+			encode(&r[0], (uint8_t)(1 + (n & 1)));
+		steps(1);
+		if (ysf_engine_tx_state(&r[0].e) == AIR_TX_DONE) {
+			prov[0].keyed = false;
+			ysf_engine_tx_clear(&r[0].e);
+			break;
+		}
+	}
+	steps(20);
+	bad = check_order(&r[1], &r[0], &first);
+	printf("  %s late entry at 990 ms: first block heard %u of %u (%u ms of voice), %u wrong\n", name, first,
+	       r[0].enc_made, first * 20, bad);
+	CHECK(r[1].starts == 1 && r[1].call.late && r[1].ends == 1 && bad == 0 && first >= 40 && first <= 70,
+	      "%s: late entry: starts %u late %u first %u", name, r[1].starts, r[1].call.late, first);
+	ysf_engine_end(&r[0].e);
+	ysf_engine_end(&r[1].e);
+}
+
+static void testSquelch(void)
+{
+	ysf_engine_cfg_t cfg = base_cfg(YSF_DT_VD_MODE1, false);
+	ysf_engine_view_t v;
+
+	// A DG-ID the squelch does not take: the call is not even seen (its
+	// frames are dropped before any call starts)
+	begin(0, &cfg, &hooks);
+	cfg.rx_dgid = 8;
+	begin(1, &cfg, &hooks);
+	CHECK(ysf_engine_tx_prepare(&r[0].e), "prime");
+	prov[0].keyed = true;
+	CHECK(ysf_engine_tx_go(&r[0].e), "go");
+	for (uint8_t k = 0; k < 20; k++) {
+		encode(&r[0], (uint8_t)(1 + (k & 1)));
+		steps(1);
+	}
+	ysf_engine_view(&r[1].e, &v);
+	CHECK(!v.rx_active && !v.rx_played && v.rx_rejects > 0 && r[1].starts == 0 && r[1].nvoice == 0,
+	      "another DG-ID: active %d played %d rejects %u heard %u", v.rx_active, v.rx_played, v.rx_rejects,
+	      r[1].nvoice);
+	// The operator switches to that DG-ID mid-call: the next frames open the squelch (late entry)
+	cfg.rx_dgid = 7;
+	ysf_engine_set(&r[1].e, &cfg);
+	for (uint8_t k = 0; k < 20; k++) {
+		encode(&r[0], (uint8_t)(1 + (k & 1)));
+		steps(1);
+	}
+	CHECK(r[1].starts == 1 && r[1].call.late && r[1].nvoice >= 5, "our DG-ID now: starts %u heard %u",
+	      r[1].starts, r[1].nvoice);
+	// Abort: off the air at once, the far end sees the signal go
+	ysf_engine_tx_abort(&r[0].e);
+	CHECK(ysf_engine_tx_state(&r[0].e) == AIR_TX_DONE && !prov[0].on, "aborted");
+	prov[0].keyed = false;
+	ysf_engine_tx_clear(&r[0].e);
+	steps(30);
+	ysf_engine_view(&r[1].e, &v);
+	CHECK(r[1].ends == 1 && !v.rx_active, "the far end's call ended after the abort: %u", r[1].ends);
+
+	// A closed engine refuses
+	ysf_engine_end(&r[0].e);
+	CHECK(!ysf_engine_tx_prepare(&r[0].e), "closed: no transmit");
+	ysf_engine_end(&r[1].e);
+}
+
+static void send_frame(const uint8_t frame[YSF_FRAME_BYTES])
+{
+	for (unsigned i = 0; i < YSF_FRAME_DIBITS; i += CHUNK_MAX) {
+		unsigned remaining = YSF_FRAME_DIBITS - i;
+
+		deliver(&prov[1], frame + i / 4, remaining < CHUNK_MAX ? remaining : CHUNK_MAX);
+	}
+}
+
+static void testBadData(uint8_t dt)
+{
+	ysf_engine_cfg_t cfg = base_cfg(dt, false);
+	ysf_fich fich = { .fi = YSF_FI_HEADER, .sc = 7, .dt = dt };
+	const uint8_t csd1[20] = "DEST      SOURCE    ";
+	const uint8_t csd2[20] = "DOWN      UP        ";
+	uint8_t frame[YSF_FRAME_BYTES];
+
+	begin(1, &cfg, &hooks);
+	ysf_frame_build(&fich, csd1, csd2, frame);
+	send_frame(frame);
+	CHECK(!strcmp(r[1].e.call.src, "SOURCE"), "call header gives the source");
+
+	fich.fi = YSF_FI_COMMUNICATION;
+	fich.ft = 7;
+	fich.fn = dt == YSF_DT_VD_MODE2 ? 6 : 3;
+	ysf_frame_build(&fich, csd1, NULL, frame);
+	for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+		unsigned dch_bytes = dt == YSF_DT_VD_MODE2 ? 5 : 9;
+		uint8_t *payload = frame + YSF_SYNC_BYTES + YSF_FICH_BYTES + 18 * b;
+
+		memset(payload, 0, dch_bytes);
+		if (dt == YSF_DT_VD_MODE2)
+			ysf_voice_dn_from_frame(silence, payload + dch_bytes);
+		else
+			memcpy(payload + dch_bytes, silence, sizeof silence);
+	}
+	send_frame(frame);
+	CHECK(r[1].e.rx.dch_fail == 1 && r[1].ndata == 0, "bad data is counted and never delivered");
+	CHECK(r[1].nvoice == YSF_BLOCKS && !strcmp(r[1].e.call.src, "SOURCE"),
+	      "bad data leaves all five voice blocks and the callsign intact");
+	for (unsigned b = 0; b < YSF_BLOCKS && b < r[1].nvoice; b++)
+		CHECK(!memcmp(r[1].voice[b], silence, sizeof silence), "voice block %u survives unchanged", b);
+	ysf_engine_end(&r[1].e);
+}
+
+static const uint8_t vw_silence[FEC_IMBE88_BYTES] = { 0xD8 };
+static uint16_t vw_made, vw_taken, vw_heard;
+static uint8_t vw_rx[VMAX][FEC_IMBE88_BYTES];
+
+static void vw_params(uint16_t sample, uint8_t imbe[FEC_IMBE88_BYTES])
+{
+	for (unsigned i = 0; i < FEC_IMBE88_BYTES; i++)
+		imbe[i] = (uint8_t)(3u * sample + i * 17u);
+}
+
+static bool vw_encode(uint8_t imbe[FEC_IMBE88_BYTES], void *ctx)
+{
+	(void)ctx;
+	if (vw_taken == vw_made)
+		return false;
+	vw_params(vw_taken++, imbe);
+	return true;
+}
+
+static void vw_play(const uint8_t imbe[FEC_IMBE88_BYTES], uint8_t errs, void *ctx)
+{
+	(void)ctx;
+	CHECK(errs == 0, "VW channel FEC succeeds");
+	if (vw_heard < VMAX)
+		memcpy(vw_rx[vw_heard++], imbe, FEC_IMBE88_BYTES);
+}
+
+static void testVW(bool narrow)
+{
+	ysf_engine_cfg_t cfg = base_cfg(YSF_DT_VOICE_FR, narrow);
+	ysf_engine_hooks_t vw = hooks;
+	uint16_t n;
+	uint16_t heard = 0;
+
+	vw.rx_vw = vw_play;
+	vw.tx_vw = vw_encode;
+	cfg.silence_vw = vw_silence;
+	vw_made = vw_taken = vw_heard = 0;
+	begin(0, &cfg, &vw);
+	begin(1, &cfg, &vw);
+	CHECK(ysf_engine_tx_prepare(&r[0].e), "VW primes");
+	prov[0].keyed = true;
+	CHECK(ysf_engine_tx_go(&r[0].e), "VW keys");
+	for (n = 0; n < 115; n++) {
+		if (n < 80)
+			vw_made += (uint16_t)(1 + (n & 1));
+		if (n == 80)
+			ysf_engine_tx_stop(&r[0].e);
+		steps(1);
+		if (ysf_engine_tx_state(&r[0].e) == AIR_TX_DONE)
+			break;
+	}
+	CHECK(n < 115 && prov[0].underruns == 0 && r[1].ends == 1, "VW tail terminates cleanly");
+	for (unsigned i = 0; i < vw_heard; i++) {
+		uint8_t expected[FEC_IMBE88_BYTES];
+
+		if (!memcmp(vw_rx[i], vw_silence, sizeof vw_silence))
+			continue;
+		vw_params(heard++, expected);
+		CHECK(!memcmp(vw_rx[i], expected, sizeof expected), "VW keeps block order at %u", i);
+	}
+	CHECK(vw_taken == vw_made && heard == vw_made && vw_heard % 5 == 2,
+	      "VW all %u blocks heard (%u with filler), exactly one two-block sub-header", vw_made, vw_heard);
+	CHECK(r[1].starts == 1 && r[1].nvoice == 0 && r[1].ndata == 0 &&
+	      !strcmp(r[1].call.rem1, "REM1") && !strcmp(r[1].call.rem2, "REM2"),
+	      "VW preserves CSD3 and uses only the full-rate voice hooks");
+	ysf_engine_end(&r[0].e);
+	ysf_engine_end(&r[1].e);
+}
+
+int main(void)
+{
+	testCall(YSF_DT_VD_MODE1, false);
+	testCall(YSF_DT_VD_MODE2, false);
+	testCall(YSF_DT_VD_MODE1, true);
+	testSquelch();
+	testBadData(YSF_DT_VD_MODE1);
+	testBadData(YSF_DT_VD_MODE2);
+	testVW(false);
+	testVW(true);
+	printf("ysfEngineTest: %d checks, %d failed\n", checks, failures);
+	return failures ? 1 : 0;
+}
diff --git a/tests/host/ysfTest.c b/tests/host/ysfTest.c
new file mode 100644
index 00000000..ae98cb3b
--- /dev/null
+++ b/tests/host/ysfTest.c
@@ -0,0 +1,502 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 lyra XE1POC
+// The YSF frame layer (core/ysf/ysf_frame.c), the sequence builder
+// (core/ysf/ysf_tx.c) and the voice layer (core/ysf/ysf_voice.c): whitening
+// against MMDVM's table, Golay round-trips, FICH/DCH encode/decode with bit
+// errors, whole-frame build/decode for every mode, the TX sequence and DCH
+// rotation, and the DN voice field round-trip through ambeFec. No public YSF
+// test vectors exist: the vectors are generated by this file's own encoder,
+// so the tests prove the layers against themselves, not against real air
+// captures (docs/spec/ysf.md).
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ysf/ysf_frame.h"
+#include "ysf/ysf_tx.h"
+#include "ysf/ysf_voice.h"
+#include "dmr/ambe/ambeFec.h"
+
+static int failures, checks;
+#define CHECK(c, ...) do { checks++; if (!(c)) { failures++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static uint32_t rng_state = 0x59534621u;
+static uint32_t rng(void)
+{
+	rng_state ^= rng_state << 13;
+	rng_state ^= rng_state >> 17;
+	rng_state ^= rng_state << 5;
+	return rng_state;
+}
+
+static void fill_rand(uint8_t *p, size_t n)
+{
+	while (n--)
+		*p++ = (uint8_t)rng();
+}
+
+static void flip_bit(uint8_t *p, unsigned i)
+{
+	p[i >> 3] ^= (uint8_t)(0x80u >> (i & 7));
+}
+
+static bool fich_equal(const ysf_fich *a, const ysf_fich *b)
+{
+	return a->fi == b->fi && a->cs == b->cs && a->cm == b->cm && a->bn == b->bn && a->bt == b->bt &&
+	       a->fn == b->fn && a->ft == b->ft && a->dev == b->dev && a->mr == b->mr && a->voip == b->voip &&
+	       a->dt == b->dt && a->sql == b->sql && a->sc == b->sc;
+}
+
+static void testWhitening(void)
+{
+	// MMDVM's WHITENING_DATA table (YSFPayload.cpp), byte for byte
+	static const uint8_t want[20] = { 0x93, 0xD7, 0x51, 0x21, 0x9C, 0x2F, 0x6C, 0xD0,
+					  0xEF, 0x0F, 0xF8, 0x3D, 0xF1, 0x73, 0x20, 0x94,
+					  0xED, 0x1E, 0x7C, 0xD8 };
+	uint8_t out[20];
+
+	ysf_whitening_generate(out);
+	CHECK(!memcmp(out, want, 20), "whitening differs from MMDVM's table");
+}
+
+static void testGolay(void)
+{
+	for (uint32_t d = 0; d < 4096; d++) {
+		uint32_t got;
+
+		CHECK(ysf_golay_decode(ysf_golay_encode(d), &got) && got == d, "golay %u round-trip", d);
+		if (failures)
+			return;
+	}
+	// One, two and three bit errors are corrected (the (24,12,8) code
+	// corrects 3); the data comes back whole
+	for (unsigned trial = 0; trial < 200; trial++) {
+		uint32_t d = rng() & 0xFFFu, c = ysf_golay_encode(d), got;
+
+		for (unsigned nerr = 1; nerr <= 3; nerr++) {
+			uint32_t bad = c;
+
+			for (unsigned k = 0; k < nerr; k++)
+				bad ^= 1u << (rng() % 24);
+			// (the flips may land twice on one bit: only test when they are distinct)
+			if (__builtin_popcount(c ^ bad) != (int)nerr)
+				continue;
+			CHECK(ysf_golay_decode(bad, &got) && got == d, "golay %u errors, trial %u", nerr, trial);
+		}
+	}
+}
+
+static void testFich(void)
+{
+	for (unsigned trial = 0; trial < 20; trial++) {
+		ysf_fich f = { .fi = (uint8_t)(rng() & 3u), .cs = (uint8_t)(rng() & 3u),
+			       .cm = (uint8_t)(rng() & 3u), .bn = (uint8_t)(rng() & 3u),
+			       .bt = (uint8_t)(rng() & 3u), .fn = (uint8_t)(rng() % 8u),
+			       .ft = (uint8_t)(rng() % 8u), .dev = (uint8_t)(rng() & 1u),
+			       .mr = (uint8_t)(rng() % 8u), .voip = (uint8_t)(rng() & 1u),
+			       .dt = (uint8_t)(rng() & 3u), .sql = (uint8_t)(rng() & 1u),
+			       .sc = (uint8_t)(rng() % 128u) };
+		uint8_t air[YSF_FICH_BYTES];
+		ysf_fich got;
+
+		ysf_fich_encode(&f, air);
+		CHECK(ysf_fich_decode(air, &got) && fich_equal(&f, &got), "fich trial %u round-trip", trial);
+		// A few bit errors in the 200-bit FICH are corrected
+		for (unsigned nerr = 1; nerr <= 3; nerr++) {
+			uint8_t bad[YSF_FICH_BYTES];
+
+			memcpy(bad, air, sizeof bad);
+			for (unsigned k = 0; k < nerr; k++)
+				flip_bit(bad, rng() % 200);
+			CHECK(ysf_fich_decode(bad, &got) && fich_equal(&f, &got), "fich %u errors, trial %u", nerr,
+			      trial);
+		}
+	}
+	// A FICH full of garbage does not decode
+	{
+		uint8_t air[YSF_FICH_BYTES];
+		ysf_fich got;
+
+		fill_rand(air, sizeof air);
+		CHECK(!ysf_fich_decode(air, &got), "random FICH decodes");
+	}
+}
+
+static void testDch(void)
+{
+	for (unsigned trial = 0; trial < 20; trial++) {
+		uint8_t data[20], air[45], got[20];
+
+		fill_rand(data, sizeof data);
+		ysf_dch1_encode(data, air);
+		CHECK(ysf_dch1_decode(air, got) && !memcmp(data, got, 20), "dch1 trial %u round-trip", trial);
+		for (unsigned nerr = 1; nerr <= 2; nerr++) {
+			uint8_t bad[45];
+
+			memcpy(bad, air, sizeof bad);
+			for (unsigned k = 0; k < nerr; k++)
+				flip_bit(bad, rng() % 360);
+			CHECK(ysf_dch1_decode(bad, got) && !memcmp(data, got, 20), "dch1 %u errors, trial %u", nerr,
+			      trial);
+		}
+	}
+	for (unsigned trial = 0; trial < 20; trial++) {
+		uint8_t data[10], air[25], got[10];
+
+		fill_rand(data, sizeof data);
+		ysf_dch2_encode(data, air);
+		CHECK(ysf_dch2_decode(air, got) && !memcmp(data, got, 10), "dch2 trial %u round-trip", trial);
+		for (unsigned nerr = 1; nerr <= 2; nerr++) {
+			uint8_t bad[25];
+
+			memcpy(bad, air, sizeof bad);
+			for (unsigned k = 0; k < nerr; k++)
+				flip_bit(bad, rng() % 200);
+			CHECK(ysf_dch2_decode(bad, got) && !memcmp(data, got, 10), "dch2 %u errors, trial %u", nerr,
+			      trial);
+		}
+	}
+}
+
+static void testSyncDibits(void)
+{
+	uint8_t bytes[8] = { 0xD4, 0x71, 0xC9, 0x63, 0x4D, 0xAA, 0x55, 0x00 };
+	uint8_t dibits[32], back[8];
+
+	ysf_bytes_to_dibits(bytes, 8, dibits);
+	ysf_dibits_to_bytes(dibits, 32, back);
+	CHECK(!memcmp(bytes, back, 8), "dibits round-trip");
+	CHECK(ysf_sync_errors(ysf_sync_bytes) == 0, "sync errors of itself");
+	{
+		uint8_t one[5];
+
+		memcpy(one, ysf_sync_bytes, 5);
+		one[0] ^= 0x01;
+		CHECK(ysf_sync_errors(one) == 1, "sync errors with one bit flipped");
+		memcpy(one, ysf_sync_bytes, 5);
+		one[0] ^= 0xFF;
+		CHECK(ysf_sync_errors(one) == 8, "sync errors with a byte flipped");
+	}
+	// The sync at an offset in a dibit stream is found; with two bit errors
+	// it is still found inside the tolerance; without one it is not
+	{
+		uint8_t stream[60];
+
+		for (unsigned i = 0; i < sizeof stream; i++)
+			stream[i] = (uint8_t)(rng() & 3u);
+		ysf_bytes_to_dibits(ysf_sync_bytes, YSF_SYNC_BYTES, stream + 7);
+		CHECK(ysf_find_sync(stream, 60, YSF_SYNC_MAX_ERRORS) == 7, "sync found at 7");
+		stream[7] ^= 1;
+		stream[8] ^= 2;
+		CHECK(ysf_find_sync(stream, 60, YSF_SYNC_MAX_ERRORS) == 7, "sync found with 2 bit errors");
+		for (unsigned i = 0; i < sizeof stream; i++)
+			stream[i] = (uint8_t)(rng() & 3u);
+		CHECK(ysf_find_sync(stream, 60, YSF_SYNC_MAX_ERRORS) == SIZE_MAX, "no sync in noise");
+	}
+}
+
+static void testFrame(void)
+{
+	static const uint8_t dt[4] = { YSF_DT_VD_MODE1, YSF_DT_DATA_FR, YSF_DT_VD_MODE2, YSF_DT_VOICE_FR };
+	static const unsigned dch_len[4] = { 20, 20, 10, 0 };
+
+	for (unsigned m = 0; m < 4; m++) {
+		for (unsigned fi = 0; fi < 3; fi++) {
+			ysf_fich f = { .fi = (uint8_t)fi, .dt = dt[m], .fn = 3, .cm = YSF_CM_GROUP,
+				       .mr = YSF_MR_DIRECT, .sc = 42 };
+			uint8_t dch[20], dch2[20], frame[YSF_FRAME_BYTES];
+			ysf_fich got;
+			uint8_t out[20], out2[20];
+			unsigned len = 99;
+
+			fill_rand(dch, 20);
+			fill_rand(dch2, 20);
+			ysf_frame_build(&f, dch, dch2, frame);
+			CHECK(ysf_frame_decode(frame, &got, out, out2, &len) && fich_equal(&f, &got) &&
+			      len == (fi == YSF_FI_HEADER || fi == YSF_FI_TERMINATOR ? 20 : dch_len[m]),
+			      "frame dt %u fi %u", dt[m], fi);
+			if (fi == YSF_FI_HEADER || fi == YSF_FI_TERMINATOR) {
+				CHECK(!memcmp(dch, out, 20) && !memcmp(dch2, out2, 20), "frame dt %u fi %u dch", dt[m],
+				      fi);
+			} else if (dt[m] == YSF_DT_VD_MODE2) {
+				CHECK(!memcmp(dch, out, 10), "frame dn dch");
+			} else if (dt[m] == YSF_DT_VOICE_FR) {
+				CHECK(len == 0, "frame vw dch_len");
+			} else {
+				CHECK(!memcmp(dch, out, 20), "frame dt %u dch", dt[m]);
+			}
+		}
+	}
+	// A frame whose sync is smashed does not decode; one with a few bit
+	// errors in the payload still does
+	{
+		ysf_fich f = { .fi = YSF_FI_COMMUNICATION, .dt = YSF_DT_VD_MODE1, .fn = 1 };
+		uint8_t dch[20] = { 0 }, frame[YSF_FRAME_BYTES], bad[YSF_FRAME_BYTES];
+		ysf_fich got;
+		uint8_t out[20];
+
+		ysf_frame_build(&f, dch, NULL, frame);
+		memcpy(bad, frame, sizeof bad);
+		for (unsigned k = 0; k < 5; k++)
+			flip_bit(bad, k);
+		CHECK(!ysf_frame_decode(bad, &got, out, NULL, NULL), "smashed sync decodes");
+		memcpy(bad, frame, sizeof bad);
+		for (unsigned k = 0; k < 3; k++)
+			flip_bit(bad, 400 + k * 7);
+		CHECK(ysf_frame_decode(bad, &got, out, NULL, NULL) && fich_equal(&f, &got),
+		      "payload with 3 bit errors decodes");
+	}
+}
+
+// ── The sequence builder ──
+static unsigned tx_data_seen;
+
+static void tx_data_cb(void *ctx, unsigned index, uint8_t out[20])
+{
+	(void)ctx;
+	for (unsigned k = 0; k < 20; k++)
+		out[k] = (uint8_t)index;
+	tx_data_seen++;
+}
+
+static uint8_t tx_voice_frame[8][YSF_BLOCKS][9];
+static unsigned tx_voice_seen;
+
+static void tx_voice_cb(void *ctx, unsigned frame_no, unsigned block, uint8_t *vch, unsigned vch_len)
+{
+	(void)ctx;
+	tx_voice_seen++;
+	if (frame_no >= 1 && frame_no <= 8 && block < YSF_BLOCKS) {
+		if (vch_len == 9)
+			memcpy(vch, tx_voice_frame[frame_no - 1][block], 9);
+		else if (vch_len == 13)
+			ysf_voice_dn_from_frame(tx_voice_frame[frame_no - 1][block], vch);
+		else if (vch_len == 18)
+			memset(vch, 0, 18);
+	}
+}
+
+static void make_tx_cfg(ysf_tx_config *c, uint8_t dt)
+{
+	memset(c, 0, sizeof *c);
+	c->dt = dt;
+	c->cm = YSF_CM_GROUP;
+	c->mr = YSF_MR_DIRECT;
+	c->dgid = 7;
+	memcpy(c->dest, "DEST      ", 10);
+	memcpy(c->src, "SRC       ", 10);
+	memcpy(c->down, "DOWN      ", 10);
+	memcpy(c->up, "UP        ", 10);
+	memcpy(c->rem1, "REM1      ", 10);
+	memcpy(c->rem2, "REM2      ", 10);
+	memcpy(c->rem3, "REM3      ", 10);
+	memcpy(c->rem4, "REM4      ", 10);
+	c->cycles = 1;
+	c->data = tx_data_cb;
+	c->voice = tx_voice_cb;
+}
+
+static void testTx(void)
+{
+	ysf_tx_config c;
+
+	CHECK(ysf_tx_total_frames(&(ysf_tx_config){ .cycles = 0 }) == 10, "total frames, cycles 0");
+	CHECK(ysf_tx_total_frames(&(ysf_tx_config){ .cycles = 1 }) == 10, "total frames, cycles 1");
+	CHECK(ysf_tx_total_frames(&(ysf_tx_config){ .cycles = 2 }) == 18, "total frames, cycles 2");
+	CHECK(ysf_tx_total_frames(&(ysf_tx_config){ .cycles = 3 }) == 26, "total frames, cycles 3");
+
+	// The voice frames the callback serves: valid AMBE frames from random
+	// parameters, so the DN path has something real to convert
+	for (unsigned fn = 0; fn < 8; fn++)
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+			uint8_t params[AMBE_PARAM_BITS];
+
+			for (unsigned k = 0; k < AMBE_PARAM_BITS; k++)
+				params[k] = (uint8_t)(rng() & 1u);
+			ambeFecEncode(params, tx_voice_frame[fn][b]);
+		}
+
+	// V/D-1: header, FN 0..7, terminator; DCH rotation CSD1/CSD2/CSD3/DT1..5
+	make_tx_cfg(&c, YSF_DT_VD_MODE1);
+	for (unsigned fn = 0; fn < 10; fn++) {
+		uint8_t frame[YSF_FRAME_BYTES];
+		ysf_fich f;
+		uint8_t dch[20], dch2[20];
+		unsigned len = 99;
+
+		tx_data_seen = 0;
+		CHECK(ysf_tx_frame_build(&c, fn, frame), "vd1 frame %u builds", fn);
+		CHECK(ysf_frame_decode(frame, &f, dch, dch2, &len), "vd1 frame %u decodes", fn);
+		CHECK(f.dt == YSF_DT_VD_MODE1 && f.sc == 7 && f.cm == YSF_CM_GROUP, "vd1 frame %u fich", fn);
+		if (fn == 0) {
+			CHECK(f.fi == YSF_FI_HEADER && f.fn == 0 && !memcmp(dch, "DEST      SRC       ", 20) &&
+			      !memcmp(dch2, "DOWN      UP        ", 20), "vd1 header dch");
+		} else if (fn == 9) {
+			CHECK(f.fi == YSF_FI_TERMINATOR && f.fn == 0 && !memcmp(dch, "DEST      SRC       ", 20),
+			      "vd1 terminator dch");
+		} else {
+			unsigned cc = fn - 1;
+
+			CHECK(f.fi == YSF_FI_COMMUNICATION && f.fn == cc && f.ft == 7, "vd1 cc %u fn/ft", cc);
+			if (cc == 0)
+				CHECK(!memcmp(dch, "DEST      SRC       ", 20), "vd1 fn0 csd1");
+			else if (cc == 1)
+				CHECK(!memcmp(dch, "DOWN      UP        ", 20), "vd1 fn1 csd2");
+			else if (cc == 2)
+				CHECK(!memcmp(dch, "REM1      REM2      ", 20), "vd1 fn2 csd3");
+			else
+				CHECK(dch[0] == cc - 3 && tx_data_seen == 1, "vd1 fn%u data unit %u", cc, cc - 3);
+			// The voice blocks are the staged AMBE frames, byte for byte
+			for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+				uint8_t vch[18];
+
+				CHECK(ysf_voice_get(frame, YSF_DT_VD_MODE1, b, vch) == 9 &&
+				      !memcmp(vch, tx_voice_frame[cc][b], 9), "vd1 cc %u block %u voice", cc, b);
+			}
+		}
+	}
+	CHECK(!ysf_tx_frame_build(&c, 10, (uint8_t[YSF_FRAME_BYTES]){ 0 }), "vd1 frame 10 out of range");
+	CHECK(!ysf_tx_frame_build(&(ysf_tx_config){ .dt = 4 }, 0, (uint8_t[YSF_FRAME_BYTES]){ 0 }),
+	      "unknown dt builds");
+
+	// DN: FN0..5 callsign units (5+5 on FN4/5), FN6/7 data; the voice field
+	// converts back to the staged AMBE frames
+	make_tx_cfg(&c, YSF_DT_VD_MODE2);
+	for (unsigned fn = 0; fn < 10; fn++) {
+		uint8_t frame[YSF_FRAME_BYTES];
+		ysf_fich f;
+		uint8_t dch[20];
+		unsigned len = 99;
+
+		CHECK(ysf_tx_frame_build(&c, fn, frame) && ysf_frame_decode(frame, &f, dch, NULL, &len),
+		      "dn frame %u", fn);
+		if (fn == 0 || fn == 9) {
+			CHECK(len == 20 && !memcmp(dch, "DEST      SRC       ", 20), "dn header/term dch");
+			continue;
+		}
+		CHECK(len == 10 && f.fn == fn - 1 && f.ft == 7, "dn cc %u dch_len/fn/ft", fn - 1);
+		switch (fn - 1) {
+		case 0: CHECK(!memcmp(dch, "DEST      ", 10), "dn fn0 dest"); break;
+		case 1: CHECK(!memcmp(dch, "SRC       ", 10), "dn fn1 src"); break;
+		case 2: CHECK(!memcmp(dch, "DOWN      ", 10), "dn fn2 down"); break;
+		case 3: CHECK(!memcmp(dch, "UP        ", 10), "dn fn3 up"); break;
+		case 4: CHECK(!memcmp(dch, "REM1 REM2 ", 10), "dn fn4 rem1+2"); break;
+		case 5: CHECK(!memcmp(dch, "REM3 REM4 ", 10), "dn fn5 rem3+4"); break;
+		case 6: CHECK(dch[0] == 0, "dn fn6 data unit 0"); break;
+		case 7: CHECK(dch[0] == 1, "dn fn7 data unit 1"); break;
+		}
+		for (unsigned b = 0; b < YSF_BLOCKS; b++) {
+			uint8_t field[18], back[9];
+
+			CHECK(ysf_voice_get(frame, YSF_DT_VD_MODE2, b, field) == 13, "dn cc %u block %u len",
+			      fn - 1, b);
+			ysf_voice_dn_to_frame(field, back, NULL);
+			CHECK(!memcmp(back, tx_voice_frame[fn - 1][b], 9), "dn cc %u block %u voice", fn - 1, b);
+		}
+	}
+
+	// Data FR: FN0 CSD1+CSD2, FN1 CSD3+DT1, FN2..7 DT pairs; no voice
+	make_tx_cfg(&c, YSF_DT_DATA_FR);
+	for (unsigned fn = 0; fn < 10; fn++) {
+		uint8_t frame[YSF_FRAME_BYTES];
+		ysf_fich f;
+		uint8_t dch[20], dch2[20];
+		unsigned len = 99;
+
+		CHECK(ysf_tx_frame_build(&c, fn, frame) && ysf_frame_decode(frame, &f, dch, dch2, &len),
+		      "datafr frame %u", fn);
+		if (fn == 0 || fn == 9)
+			continue;
+		CHECK(len == 20 && ysf_voice_len(YSF_DT_DATA_FR) == 0, "datafr cc %u", fn - 1);
+		if (fn - 1 == 0)
+			CHECK(!memcmp(dch, "DEST      SRC       ", 20) && !memcmp(dch2, "DOWN      UP        ", 20),
+			      "datafr fn0");
+		else if (fn - 1 == 1)
+			CHECK(!memcmp(dch, "REM1      REM2      ", 20) && dch2[0] == 0, "datafr fn1");
+		else
+			CHECK(dch[0] == 2 * (fn - 1) - 3 && dch2[0] == 2 * (fn - 1) - 2, "datafr fn%u data",
+			      fn - 1);
+	}
+
+	// VW: no DCH in communication frames
+	make_tx_cfg(&c, YSF_DT_VOICE_FR);
+	for (unsigned fn = 1; fn < 9; fn++) {
+		uint8_t frame[YSF_FRAME_BYTES];
+		ysf_fich f;
+		uint8_t dch[20];
+		unsigned len = 99;
+
+		CHECK(ysf_tx_frame_build(&c, fn, frame) && ysf_frame_decode(frame, &f, dch, NULL, &len) &&
+		      len == 0, "vw cc %u", fn - 1);
+	}
+}
+
+// ── The DN voice field ──
+static void testVoiceDn(void)
+{
+	CHECK(ysf_voice_len(YSF_DT_VD_MODE1) == 9, "voice len vd1");
+	CHECK(ysf_voice_len(YSF_DT_VD_MODE2) == 13, "voice len dn");
+	CHECK(ysf_voice_len(YSF_DT_VOICE_FR) == 18, "voice len vw");
+	CHECK(ysf_voice_len(YSF_DT_DATA_FR) == 0, "voice len datafr");
+
+	for (unsigned trial = 0; trial < 200; trial++) {
+		uint8_t params[AMBE_PARAM_BITS], frame9[9], field[13], back[9], params2[AMBE_PARAM_BITS];
+		unsigned errs = 99;
+
+		for (unsigned k = 0; k < AMBE_PARAM_BITS; k++)
+			params[k] = (uint8_t)(rng() & 1u);
+		ambeFecEncode(params, frame9);
+		ysf_voice_dn_from_frame(frame9, field);
+		ysf_voice_dn_to_frame(field, back, &errs);
+		ambeFecDecode(back, params2, NULL);
+		CHECK(errs == 0 && !memcmp(frame9, back, 9) && !memcmp(params, params2, AMBE_PARAM_BITS),
+		      "dn round-trip trial %u", trial);
+	}
+	// One bit flipped in the field: at most one parameter comes back wrong
+	// (a triplet bit is outvoted; a direct-region bit flips that parameter)
+	for (unsigned trial = 0; trial < 20; trial++) {
+		uint8_t params[AMBE_PARAM_BITS], frame9[9], field[13], back[9], params2[AMBE_PARAM_BITS];
+		unsigned errs = 99, k;
+
+		for (k = 0; k < AMBE_PARAM_BITS; k++)
+			params[k] = (uint8_t)(rng() & 1u);
+		ambeFecEncode(params, frame9);
+		ysf_voice_dn_from_frame(frame9, field);
+		{
+			uint8_t bad[13];
+
+			memcpy(bad, field, 13);
+			flip_bit(bad, rng() % 104);
+			ysf_voice_dn_to_frame(bad, back, &errs);
+			ambeFecDecode(back, params2, NULL);
+			unsigned wrong = 0;
+			for (k = 0; k < AMBE_PARAM_BITS; k++)
+				wrong += params[k] != params2[k];
+			CHECK(wrong <= 1, "dn one bit flip: %u params wrong", wrong);
+		}
+		// The pad bit (103) is ignored on decode
+		{
+			uint8_t bad[13];
+
+			memcpy(bad, field, 13);
+			flip_bit(bad, 103);
+			ysf_voice_dn_to_frame(bad, back, &errs);
+			CHECK(errs == 0 && !memcmp(frame9, back, 9), "dn pad bit ignored");
+		}
+	}
+}
+
+int main(void)
+{
+	testWhitening();
+	testGolay();
+	testFich();
+	testDch();
+	testSyncDibits();
+	testFrame();
+	testTx();
+	testVoiceDn();
+	printf("ysfTest: %d checks, %d failed\n", checks, failures);
+	return failures ? 1 : 0;
+}
