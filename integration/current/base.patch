+// The modes the Mode row steps through, in this order: FM, AM, DMR, P25, NXDN at 4800 and at 9600 bit/s, YSF Wide and YSF Narrow
+enum { CM_FM, CM_AM, CM_DMR, CM_P25, CM_NXDN_4800, CM_NXDN_9600, CM_YSF_WIDE, CM_YSF_NARROW, CM_COUNT, CM_OTHER = 0xFF };
+
+// Whether this build and radio run step m for a channel received on c's frequency. A listen band (the air band, the
+// broadcast band) has its own receiver: FM there is AM or the broadcast tuner, nothing digital
+static bool ced_cm_ok(uint8_t m, const channel_t *c)
+{
+	bool listen = radio_listen_band(c->rx_hz);
+#if CONFIG_ZONE_EDIT
+	// Copy here takes the source's tag as it is (its block is changed after): FM and DMR only, the plain modes
+	if (ced_into && m != CM_FM && m != CM_DMR)
+		return false;
+#endif
+	switch (m) {
+	case CM_FM: return CONFIG_FM;
+#if CONFIG_AM_RX
+	case CM_AM: return radio_am_capable() && !listen;
+#endif
+#if CONFIG_DMR
+	case CM_DMR: return !listen;
+#endif
+#if CONFIG_P25
+	case CM_P25: return radio_p25_fits() && !listen;
+#endif
+#if CONFIG_NXDN
+	case CM_NXDN_4800:
+	case CM_NXDN_9600: return radio_nxdn_fits() && !listen;
+#endif
+#if CONFIG_YSF
+	case CM_YSF_WIDE:
+	case CM_YSF_NARROW: return radio_ysf_fits() && !listen;
+#endif
+	default: return false;
+	}
