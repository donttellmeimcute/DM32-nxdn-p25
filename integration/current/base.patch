+			c->kind = ced_orig.kind;
+			c->system = ced_orig.system;
+			c->mode = ced_orig.mode;
+			c->rx_only = ced_orig.rx_only;
+			return;
+		}
+		ced_cm_set(c, m);
+		return;
+	}
