+// The Mode row's OK: the next step this radio runs. After the last one a channel of a kind the row doesn't offer is
+// back as it was opened (a slip must not cost it its system), else the first step again
+static void ced_mode_step(void)
+{
+	channel_t *c = &ced_ch;
+	uint8_t now = ced_cm_now(c);
+	bool other = ced_cm_now(&ced_orig) == CM_OTHER;
+	uint8_t start = now == CM_OTHER ? CM_COUNT - 1 : now;
+	for (uint8_t i = 1; i <= CM_COUNT; i++) {
+		uint8_t m = (uint8_t)((start + i) % CM_COUNT);
+		if (m == now || !ced_cm_ok(m, c))
