+static void testSingleBurst(void)
+{
+	// The single burst (SB) in burst F: the key ID in bits 10-3, the algorithm's low 3 in bits 2-0. Key ID 7,
+	// AES-256 (algorithm 5) is info 0x03D; key ID 1, algorithm 5 is the vector other AES-256 radios are checked
+	// against, 44 42 88 81
+	CHECK(dmrFecSbEncode(0x03D) == 0x453E8A3Du, "SB encode 7/5 %08X", dmrFecSbEncode(0x03D));
+	CHECK(dmrFecSbEncode(0x00D) == 0x44428881u, "SB encode 1/5 %08X", dmrFecSbEncode(0x00D));
+	// The same row twice (even column parity): a field of all 32 bits set is two rows of all ones, not a burst
+	CHECK(dmrFecSbEncode(0x000) == 0x00000000u, "SB encode 0 %08X", dmrFecSbEncode(0x000));
+
+	// Every info word back, exact and through one bit error anywhere in the field
+	uint16_t info;
+	int bad = 0;
+
+	for (uint16_t w = 0; w < 2048; w++) {
+		uint32_t f = dmrFecSbEncode(w);
+
+		bad += dmrFecSbDecode(f, &info) != 0 || info != w;
+		for (int b = 0; b < 32; b++)
+			bad += dmrFecSbDecode(f ^ (1u << b), &info) != 1 || info != w;
+	}
+	CHECK(bad == 0, "SB decode: %d wrong", bad);
+	// A reverse channel's field is not a single burst: its second row is the complement, not the row itself
+	for (uint8_t c = 0; c < 16; c++)
+		CHECK(dmrFecSbDecode(dmrFecRcEncode(c), &info) < 0, "SB decode: RC command %d taken", c);
+	// The garbage the issue saw (SB 0x546: key ID 0xA8, algorithm 6) decodes as exactly that, not as ours
+	CHECK(dmrFecSbDecode(dmrFecSbEncode(0x546), &info) == 0 && info == 0x546, "SB decode: 0x546");
+}
+
