+uint32_t dmrFecRcEncode(uint8_t command)
+{
+	return bptc16x2Field(dmrFecRcInfo(command), true);
+}
+
+// The single burst (SB) in a voice burst F's embedded signalling: the same single burst BPTC, but with the row
+// sent twice (even column parity), where the reverse channel sends the row and its complement (odd column parity).
+// Which one a receiver expects is the EMB's PI bit (9.3.2): 0, the signalling belongs to this channel, so SB; 1,
+// it belongs to the other one, so RC. A single burst carries no CRC of its own: the 11 bits are the payload, key
+// ID in bits 10-3 and the algorithm's low 3 bits in bits 2-0 (9.3.3, the encryption sync: AES-256 is algorithm 5)
+uint32_t dmrFecSbEncode(uint16_t info)
+{
+	return bptc16x2Field(info, false);
+}
+
+// One 16-bit row of a single burst field, Hamming-corrected: the (15,11,3) code corrects one error in its 15 bits,
+// and a parity bit that still disagrees after that is the one error itself. Returns the errors corrected (0-1),
+// or -1 when uncorrectable
+static int sb_row_correct(uint16_t row, uint16_t *h15_out)
+{
+	uint16_t h15 = (uint16_t)(row >> 1);
+	uint16_t before = h15;
+	int errors;
+
+	if (!dmrFecHamming15113Correct(&h15))
+		return -1;
+	errors = popcount32(before ^ h15);
+	if ((row & 1u) != (popcount32(h15) & 1u)) {
+		if (errors != 0)
+			return -1;	// a second error: the parity bit and a data bit
+		errors = 1;		// the parity bit itself
+	}
+	*h15_out = h15;
+	return errors;
+}
+
+// The 11 info bits in a received single burst field, or -1 when it is not one: each row is Hamming-corrected on
+// its own, and the two corrected rows must agree (even column parity). Returns the bit errors corrected (0-3); a
+// field further than that from any single burst is not trusted
+int dmrFecSbDecode(uint32_t field, uint16_t *info)
+{
+	uint16_t row[2] = { 0, 0 };
+
+	for (int i = 0; i < 32; i++) {
+		uint32_t bit = (field >> (31 - ((i * 17) % 32))) & 1u;
+
+		row[i & 1] |= (uint16_t)(bit << (15 - i / 2));
+	}
+	uint16_t h15[2];
+
+	for (int r = 0; r < 2; r++)
+		if (sb_row_correct(row[r], &h15[r]) < 0)
+			return -1;
+	if (h15[0] != h15[1])
+		return -1;
+	*info = (uint16_t)((h15[0] >> 4) & 0x7FFu);
+	int dist = popcount32(field ^ dmrFecSbEncode(*info));
+
+	return (dist <= 3) ? dist : -1;
+}
